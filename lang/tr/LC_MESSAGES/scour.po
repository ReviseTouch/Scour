# --- the report in the terminal ---

# The bar over the report: what the age of a folder is called.
msgid "age"
msgstr "yaş"

# The terminal legend says the bands short; `this week` above is the
# window's, which has the room for it.
msgid "week"
msgstr "hafta"

msgid "month"
msgstr "ay"

msgid "year"
msgstr "yıl"

# The heading over the kind bar, in the terminal report.
msgid "BY KIND"
msgstr "TÜRE GÖRE"

# The slice for everything the legend had no room to name.
msgid "other"
msgstr "diğer"

# The line under the weighed folders: what is not a row of its own.
msgid "the other {n} folders"
msgstr "diğer {n} klasör"

# The headline, without the markup the page hangs on `<b>`: this window has
# no stylesheet and puts its own colour on the numbers.
msgid "{files} files · {disk} on disk · {n} folders"
msgstr "{files} dosya · diskte {disk} · {n} klasör"

# The same sentence for the window, without the `<code>` and without the
# promise of a scope: the window leaves the report scope where it is.
msgid "Clicking a slice adds a kind: term to the query and opens the search tab."
msgstr "Bir dilime tıklamak sorguya kind: terimini ekler ve arama sekmesini açar."

# Send to: the menu item, the places, and what is said after.
msgid "Send to…"
msgstr "Gönder…"

msgid "Send {n} to…"
msgstr "{n} öğeyi gönder…"

msgid "Desktop (as a link)"
msgstr "Masaüstü (bağlantı olarak)"

msgid "Mail recipient"
msgstr "E-posta alıcısı"

msgid "Bluetooth device"
msgstr "Bluetooth aygıtı"

msgid "Compressed archive"
msgstr "Sıkıştırılmış arşiv"

msgid "nowhere to send to on this machine"
msgstr "bu makinede gönderilecek bir yer yok"

msgid "a link is on the desktop"
msgstr "masaüstüne bağlantı kondu"

msgid "packing into {path}"
msgstr "{path} içine sıkıştırılıyor"

msgid "copying to {path}"
msgstr "{path} konumuna kopyalanıyor"

msgid "handed over"
msgstr "gönderildi"

msgid "that place is not there any more"
msgstr "o yer artık yok"

msgid "only files can be sent there"
msgstr "oraya yalnızca dosya gönderilebilir"

msgid "it is not there"
msgstr "orada değil"

msgid "not on this platform"
msgstr "bu platformda yok"

msgid "it could not be sent"
msgstr "gönderilemedi"

# Deleting for good: beside the trash, and it asks first.
msgid "Delete permanently…"
msgstr "Kalıcı olarak sil…"

msgid "Delete {n} permanently…"
msgstr "{n} öğeyi kalıcı olarak sil…"

msgid "This cannot be undone."
msgstr "Bu geri alınamaz."

msgid "{n} deleted"
msgstr "{n} öğe silindi"

msgid "{n} could not be deleted"
msgstr "{n} öğe silinemedi"

msgid "Delete"
msgstr "Sil"

msgid "SEND TO"
msgstr "GÖNDER"

msgid "drag to widen; double-click for the usual width"
msgstr "genişletmek için sürükleyin; olağan genişlik için çift tıklayın"

msgid "Open the full report in the browser"
msgstr "Tam raporu tarayıcıda aç"
