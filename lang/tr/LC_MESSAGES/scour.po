# --- sentences ---
msgid "a rebuild would speed searches up"
msgstr "yeniden inşa aramaları hızlandırır"

msgid "The index is empty. Run `scour rescan`."
msgstr "Dizin boş. `scour rescan` çalıştırın."

msgid "full scan"
msgstr "tam tarama"

# Deep paging: a path is reconstructed per row to reach the offset, and all
# but a page of them are thrown away.
msgid "paths built"
msgstr "yol kuruldu"

msgid "needs document contents, which this index may not have"
msgstr "belge içeriği gerekiyor, bu dizinde olmayabilir"

msgid "Start `scourd` first — the MCP server is a client of it, like this one."
msgstr "Önce `scourd` başlatın — MCP sunucusu, bunun gibi, onun istemcisidir."

msgid "counts are a lower bound: the scan hit its cap"
msgstr "sayılar alt sınırdır: tarama üst sınırına ulaştı"
