# Turkish translation for Scour.
#
# The msgid is the English source text, not an invented key: a string with no
# entry here degrades to correct English rather than to a bare identifier.
# When the user interface arrives it uses Slint's @tr(), which is gettext and
# is also keyed by the source string — so this same file serves both sides.
msgid ""
msgstr ""
"Project-Id-Version: scour\n"
"Language: tr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

