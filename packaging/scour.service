[Unit]
# Scour, started at boot with the one privilege it needs.
#
# Watching a whole filesystem is one `FAN_MARK_FILESYSTEM` per superblock, and
# placing a mark needs CAP_SYS_ADMIN. `scour-watch` is the only program here
# that ever has it: it opens the fanotify descriptor, sets the marks, drops to
# the user named below and execs `scourd`, which runs unprivileged from then on
# (`CapEff=0`, measured). The helper lives under root-owned /usr/local/libexec;
# never point ExecStart at a user-writable path.
#
# Without the mark there is no watching on Linux: `scourd` reconciles by
# walking when a volume's write counter moves — nothing is missed, changes
# take longer to appear. The mark is what makes it cheap and immediate.
#
# `@USER@`, `@UID@`, `@HOME@` and `@ROOTS@` are filled in by
# packaging/install-service.sh; the user unit must be off, or two writers race
# for the index lock:  systemctl --user disable --now scourd.service
Description=Scour file index
Documentation=https://github.com/ReviseTouch/Scour
# After the session, not at boot: the socket lives in /run/user/@UID@, which
# logind creates at login.
After=local-fs.target user@@UID@.service
Wants=user@@UID@.service

[Service]
Type=simple
# `--as` names who to drop to — whoever owns ~/.config/scour/config.toml and
# the index. The roots are the filesystems to mark; left out, every real
# filesystem would be, `/efi` included.
ExecStart=/usr/local/libexec/scour/scour-watch --as @USER@ @ROOTS@ -- @HOME@/.local/bin/scourd
# Also the safety net for starting before the runtime directory exists.
Restart=on-failure
RestartSec=5
# The index is derived from the filesystem, so nothing here is worth protecting
# from a kill -9; what matters is that only one writer exists, which scourd
# enforces with a lock on its own directory.
KillSignal=SIGTERM
TimeoutStopSec=20
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
