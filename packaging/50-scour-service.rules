// Install only alongside the root-owned helper and unit in install-service.sh.
// This permits lifecycle operations, never unit editing or arbitrary commands.
polkit.addRule(function(action, subject) {
    if (subject.user !== "hasan" ||
        action.id !== "org.freedesktop.systemd1.manage-units" ||
        action.lookup("unit") !== "scour.service") {
        return;
    }
    var verb = action.lookup("verb");
    if (verb === "start" || verb === "stop" || verb === "restart") {
        return polkit.Result.YES;
    }
});
