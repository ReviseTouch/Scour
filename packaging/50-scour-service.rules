// Installed by packaging/install-service.sh beside the root-owned helper and
// unit. Lets one account start, stop and restart scour.service without a
// prompt — never edit units or run anything else as root.
polkit.addRule(function(action, subject) {
    if (subject.user !== "@USER@" ||
        action.id !== "org.freedesktop.systemd1.manage-units" ||
        action.lookup("unit") !== "scour.service") {
        return;
    }
    var verb = action.lookup("verb");
    if (verb === "start" || verb === "stop" || verb === "restart") {
        return polkit.Result.YES;
    }
});
