// Installed by packaging/install-service.sh beside the root-owned helper and
// the scour@.service template. Each account may start, stop and restart its
// own instance — `scour@<name>.service` and no other unit, no other verb,
// nothing else as root. Adding a person needs no change here.
//
// This says nothing about who was provisioned: an instance with no
// /etc/scour/<name>.conf refuses to start, and only the installer writes one.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" ||
        !subject.user ||
        action.lookup("unit") !== "scour@" + subject.user + ".service") {
        return;
    }
    var verb = action.lookup("verb");
    if (verb === "start" || verb === "stop" || verb === "restart") {
        return polkit.Result.YES;
    }
});
