// A word processor's document as the preview draws it: white paper, its
// paragraphs, tables and pictures flowing to the panel's width (`scour-flow`).

import { FlowRow, FlowCell, GridCellView, GridRowView } from "types.slint";
import { ListView } from "std-widgets.slint";
import { PeekRail } from "widgets.slint";

// Paper is paper in a dark theme too: the document's own colours are for it.
global Paper {
    out property <color> ink: #1f2328;
    out property <color> rule: #9aa0a6;
    out property <color> faint: #d0d7de;
    out property <length> margin: 16px;
    // A sheet's lines between cells: lighter than a table's rules.
    out property <color> grid: #e1e4e8;
}

component FlowLine {
    in property <FlowRow> line;
    in property <length> em;
    // A slide's rows sit on its card: inset from the panel's edges, on its
    // colour, in its ink.
    property <length> inset: root.line.carded ? 8px : 0px;
    property <length> pad: root.line.carded ? 14px : Paper.margin;
    property <color> ink: root.line.carded ? root.line.ink : Paper.ink;
    property <length> room: root.width - 2 * root.inset - 2 * root.pad;

    HorizontalLayout {
        padding-left: root.inset;
        padding-right: root.inset;
        // The gap below a card, which is the panel's and not the card's.
        padding-bottom: root.line.kind == 5 ? 10px : 0px;

        Rectangle {
            background: root.line.carded ? root.line.card : transparent;
            border-top-left-radius: root.line.kind == 4 ? 8px : 0px;
            border-top-right-radius: root.line.kind == 4 ? 8px : 0px;
            border-bottom-left-radius: root.line.kind == 5 ? 8px : 0px;
            border-bottom-right-radius: root.line.kind == 5 ? 8px : 0px;

            VerticalLayout {
                if root.line.kind == 0: Rectangle {
                    background: root.line.shaded ? root.line.shade : transparent;
                    HorizontalLayout {
                        padding-left: root.pad + root.line.indent * root.em;
                        padding-right: root.pad;
                        padding-top: root.line.before * root.em;
                        padding-bottom: root.line.after * root.em;
                        if root.line.mark != "": Text {
                            text: root.line.mark;
                            width: 1.6 * root.em;
                            color: root.ink;
                            font-size: root.line.size * root.em;
                            vertical-alignment: top;
                        }
                        StyledText {
                            text: root.line.text;
                            default-color: root.ink;
                            default-font-size: root.line.size * root.em;
                            horizontal-alignment: root.line.align == 1 ? center : root.line.align == 2 ? right : left;
                            // An empty paragraph is a line of space, as it is in the document.
                            min-height: root.line.size * root.em * 1.35;
                        }
                    }
                }

                // Each cell draws its top and left edges, the row its right one, and the
                // table's last row its bottom: one pixel wherever two cells meet.
                if root.line.kind == 1: Rectangle {
                    HorizontalLayout {
                        padding-left: root.pad;
                        padding-right: root.pad;
                        for cell in root.line.cells: Rectangle {
                            width: cell.share * root.room;
                            background: cell.shaded ? cell.shade : transparent;
                            VerticalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                padding-top: 3px;
                                padding-bottom: 3px;
                                StyledText {
                                    text: cell.text;
                                    default-color: root.ink;
                                    default-font-size: 0.95 * root.em;
                                }
                            }
                            if root.line.ruled: Rectangle {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: 1px;
                                background: Paper.rule;
                            }
                            if root.line.ruled: Rectangle {
                                x: 0px;
                                y: 0px;
                                width: 1px;
                                height: parent.height;
                                background: Paper.rule;
                            }
                        }
                    }
                    if root.line.ruled: Rectangle {
                        x: parent.width - root.pad - 1px;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Paper.rule;
                    }
                    if root.line.ruled && root.line.last: Rectangle {
                        x: root.pad;
                        y: parent.height - 1px;
                        width: parent.width - 2 * root.pad;
                        height: 1px;
                        background: Paper.rule;
                    }
                }

                if root.line.kind == 2: HorizontalLayout {
                    padding-left: root.pad;
                    padding-right: root.pad;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    alignment: start;
                    // No taller than this: a tall picture is a screen of one thing.
                    Image {
                        source: root.line.picture;
                        width: min(root.line.pic-w * root.em, root.room,
                            260px * root.line.pic-w / max(0.01, root.line.pic-h));
                        height: self.width * root.line.pic-h / max(0.01, root.line.pic-w);
                        image-fit: contain;
                    }
                }

                if root.line.kind == 3: Rectangle {
                    height: 21px;
                    Rectangle {
                        x: root.pad;
                        y: 10px;
                        width: parent.width - 2 * root.pad;
                        height: 1px;
                        background: Paper.faint;
                    }
                }

                // A card's top, with the slide's number in its corner.
                if root.line.kind == 4: Rectangle {
                    height: 24px;
                    Text {
                        x: parent.width - self.width - 10px;
                        y: 6px;
                        text: root.line.mark;
                        font-size: 11px;
                        color: root.ink;
                        opacity: 0.6;
                    }
                }

                // Its foot.
                if root.line.kind == 5: Rectangle {
                    height: 14px;
                }
            }
        }
    }
}

export component FlowView inherits Rectangle {
    in property <[FlowRow]> rows;
    // A row to open on: the first find. Past it first, so it is above the
    // view and comes in at the top edge, the row before it leading in: the
    // list measures that row itself rather than guessing where it lies.
    in property <int> goto: -1;
    changed goto => {
        if (root.goto >= 0 && root.rows.length > 0) {
            list.content-y = 0px - list.content-height;
            list.ensure-row-visible(max(0, root.goto - 1), ScrollBehavior.instant);
        }
    }
    // A presentation's cards stand on grey, so a white slide is seen as one.
    in property <bool> deck;
    // The body's size: everything else is in ems of it.
    in property <length> em: 13px;
    /// The rows holding a find, as shares of the document's rows.
    in property <[float]> marks;
    background: root.deck ? #eef1f4 : #ffffff;

    // A `ListView` reckons its height from the rows in sight, so in pixels a
    // document of uneven rows is a guess that moves; its place over that
    // height is, steadily, the share of the rows above it. The rail is drawn
    // in that share — the lens, the ticks and a press alike — and laying out
    // every row instead cost 2.2 s and froze the window on a long document
    // (measured 2026-11-28, 4,000 blocks).
    list := ListView {
        width: parent.width - 18px;
        height: parent.height;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        for row in root.rows: FlowLine {
            line: row;
            em: root.em;
        }
    }

    PeekRail {
        x: parent.width - 18px;
        height: parent.height;
        marks: root.marks;
        seen-top: -list.content-y / max(1px, list.content-height);
        seen-tall: list.height / max(1px, list.content-height);
        go(r, pressed) => {
            list.content-y = -clamp(r * list.content-height - list.height / 2,
                0px, max(0px, list.content-height - list.height));
        }
        wheel(dy) => {
            list.content-y = clamp(list.content-y + dy, min(0px, list.height - list.content-height), 0px);
        }
    }
}

// A sheet's cell: one line of text, cut at its edge as a spreadsheet cuts it,
// and the grid's lines on its right and its foot.
component GridBox inherits Rectangle {
    in property <GridCellView> cell;
    in property <length> tall;
    width: root.cell.width;
    height: root.tall;
    background: root.cell.shaded ? root.cell.shade : transparent;
    Text {
        x: 4px;
        width: max(root.cell.width, root.cell.reach) - 8px;
        height: parent.height;
        text: root.cell.text;
        font-size: 12px;
        font-weight: root.cell.bold ? 600 : 400;
        font-italic: root.cell.italic;
        color: root.cell.colored ? root.cell.color : Paper.ink;
        horizontal-alignment: root.cell.align == 1 ? center : root.cell.align == 2 ? right : left;
        vertical-alignment: center;
        overflow: clip;
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Paper.grid;
    }
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Paper.grid;
    }
}

// A spreadsheet's book: its sheets as tabs, the one picked as a grid that
// scrolls both ways, its heading row held at the top.
export component SheetView inherits Rectangle {
    in property <[string]> sheets;
    in property <int> current;
    in property <[GridRowView]> rows;
    in property <[GridCellView]> head;
    in property <length> grid-width;
    /// The rows holding a find, as shares of the sheet: every row is one height.
    in property <[float]> marks;
    // A row to open on, the first holding a find: every row is one height.
    in property <int> goto: -1;
    changed goto => {
        if (root.goto >= 0) {
            grid.content-y = -max(0px, root.goto * root.tall - root.tall);
        }
    }
    callback picked(int);
    property <length> tall: 22px;
    background: #ffffff;

    VerticalLayout {
        if root.sheets.length > 1: Rectangle {
            height: 30px;
            background: #f6f8fa;
            clip: true;
            HorizontalLayout {
                padding-left: 8px;
                padding-top: 6px;
                spacing: 2px;
                alignment: start;
                for name[i] in root.sheets: Rectangle {
                    width: label.preferred-width + 20px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #d0d7de;
                    background: i == root.current ? #ffffff : #eaeef2;
                    label := Text {
                        text: name;
                        font-size: 12px;
                        font-weight: i == root.current ? 600 : 400;
                        color: i == root.current ? Paper.ink : #57606a;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.picked(i); }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #d0d7de;
            }
        }

        Rectangle {
            clip: true;
            property <length> head-tall: root.head.length > 0 ? root.tall : 0px;
            // Every row one height, so the list's own reckoning is exact; its
            // up-and-down scrollbar is the rail beside it.
            grid := ListView {
                y: parent.head-tall;
                width: parent.width - 18px;
                height: parent.height - parent.head-tall;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                for r in root.rows: HorizontalLayout {
                    width: max(root.grid-width, grid.width);
                    height: root.tall;
                    alignment: start;
                    for c in r.cells: GridBox {
                        cell: c;
                        tall: root.tall;
                    }
                }
            }
            // Over the grid and moved with it sideways, so its columns stay
            // over theirs.
            if root.head.length > 0: Rectangle {
                x: 0px;
                y: 0px;
                height: root.tall;
                width: parent.width - 18px;
                background: #ffffff;
                clip: true;
                HorizontalLayout {
                    x: grid.content-x;
                    width: root.grid-width;
                    alignment: start;
                    for c in root.head: GridBox {
                        cell: c;
                        tall: root.tall;
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: #d0d7de;
                }
            }
            PeekRail {
                x: parent.width - 18px;
                y: parent.head-tall;
                height: parent.height - parent.head-tall;
                property <length> sheet: max(1px, root.rows.length * root.tall);
                marks: root.marks;
                seen-top: -grid.content-y / self.sheet;
                seen-tall: grid.height / self.sheet;
                go(r, pressed) => {
                    grid.content-y = -clamp(r * self.sheet - grid.height / 2,
                        0px, max(0px, self.sheet - grid.height));
                }
                wheel(dy) => {
                    grid.content-y = clamp(grid.content-y + dy, min(0px, grid.height - self.sheet), 0px);
                }
            }
        }
    }
}
