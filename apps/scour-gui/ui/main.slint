    in property <string> settings-title;
    in property <string> settings-foot;
    in property <[string]> section-ids: ["general", "search", "view", "disks", "rules", "keys", "index", "performance", "about"];
    // Where the section in sight stands in that list: its title and its lead.
    property <int> section-at: root.settings-section == "search" ? 1
        : root.settings-section == "view" ? 2
        : root.settings-section == "disks" ? 3
        : root.settings-section == "rules" ? 4
        : root.settings-section == "keys" ? 5
        : root.settings-section == "index" ? 6
        : root.settings-section == "performance" ? 7
