// The window. Everything here is driven from Rust: rows arrive as a model,
// counts as properties, and every decision that needs the query language is
// made on the other side and handed over already answered.

import { Theme, Fonts } from "theme.slint";

// Re-exported for the generated Rust API.
export { Theme, Fonts }
import { ListView, ScrollView } from "std-widgets.slint";

/// One cell of one row, already formatted by Rust: text plus what is needed to
/// draw it — an alignment, a colour band, the three pieces of a name.
export struct Cell {
    // Which column this is. The name and its icon are found by this rather
    // than by position, which somebody chooses.
    id: string,
    text: string,
    // Before the match, the match, after it. Empty for every column but `name`.
    pre: string,
    hit: string,
    post: string,
    // Age band of a time column, 0 (minutes) to 5 (older); -1 means no colour.
    age: int,
    // Numbers read right-aligned; words do not.
    right: bool,
    // A monospaced column: sizes, dates, modes, owners.
    mono: bool,
    // Drawn in the quiet ink: a value the volume does not record.
    dim: bool,
    // Hover text, where the column has more to say than fits.
    hint: string,
}

/// One column heading, in the order the table shows them.
export struct HeadInfo {
    id: string,
    label: string,
    // What `sort:` this heading asks for. Empty means it cannot be sorted by.
    sort: string,
    right: bool,
}

export struct Row {
    // One per shown column, in the order they are shown. Rebuilt only when the
    // chosen columns change; widths travel separately in `cw`.
    cells: [Cell],
    // The whole name, whether or not the name column is shown: the tiles have
    // no columns, so what they draw cannot come out of the cell list.
    name: string,
    // The whole path. Not drawn; it is what opening and copying the row read.
    path: string,
    // Arrived since the last answer. Marks the event, not the row: it is shown
    // arriving and then stops being shown.
    fresh: bool,
    // The kind's own token — `folder`, `code`, `build` — never translated; it
    // picks the icon and its colour.
    ktoken: string,
    tint: brush,
    is-dir: bool,
    // Which age band the row falls in, 0 (minutes) to 5 (older).
    age: int,
    // In the selection; several rows can be, and an action takes all of them.
    picked: bool,
    // The desktop's own thumbnail, when one has been made. Filled in after the
    // row lands, not with it: a page is two hundred rows and the eye is on thirty.
    thumb: image,
    // Whether `thumb` holds one, said as a flag: asking the `image` its width
    // once per glyph condition per row took an idle window from 22% to 49%.
    shot: bool,
}

/// One line of the preview panel's fact list: a label and a value, both already
/// formatted. Which facts, and in what order, is `scour_ui::preview::FACTS`.
export struct Fact {
    label: string,
    value: string,
}

// One bar of the time ribbon: how many files fall in it, and which of the six
// age bands it is — the same band the rows' dates are painted with.
export struct Bar {
    count: int,
    // Upper bound in days; `0` for the oldest, which has none.
    days: int,
    band: int,
    // What the bar covers, already worded.
    about: string,
}

// One line of the right-click menu, as `scour_ui::menu` holds it. The window
// does not know what any of these mean: it draws them and sends `id` back.
export struct MenuItem {
    // Sent back on press. Never translated.
    id: string,
    // Already translated, and carrying the count where there is one.
    label: string,
    // Printed at the right, quietly.
    key: string,
    // Draw a rule above this one: it starts a new group.
    rule: bool,
    // Reversible, but it changes something — drawn in the danger colour.
    careful: bool,
    // Starts more programs than there are hands, and asks first — drawn dim.
    heavy: bool,
    // Shown with a tick: a switch rather than an action.
    on: bool,
    // Cannot be pressed — the last column standing is this.
    off: bool,
}

// One skip rule. Off is a note kept beside the index, not a deletion, so the
// groups this window cannot edit can still be switched off.
export struct Rule {
    id: string,
    value: string,
    kind: string,
    off: bool,
    removable: bool,
}

// One folder in the report: what it weighs, what share of its parent that is,
// and how those bytes are spread over the six age bands.
export struct Kid {
    name: string,
    path: string,
    size: string,
    share: string,
    files: string,
    a0: float,
    a1: float,
    a2: float,
    a3: float,
    a4: float,
    a5: float,
}

// One group of files that might be the same file. `proven` is whether the
// checking got as far as reading them: only then is "duplicate" the word.
export struct Dupe {
    size: string,
    times: string,
    certainty: string,
    proven: bool,
    paths: string,
}

// One coloured run of the query, as `Request::Explain` cut it. A window that
// tokenised the query itself would be a second parser.
export struct Span {
    text: string,
    // 0 nothing in particular · 1 field, comparison, `or` · 2 value or phrase
    // 3 wildcard · 4 exclusion · 5 read as text · 6 the word being looked for
    // 7 the syntax between terms, said quietly
    role: int,
    // Part of a term that must NOT match. The role does not say: `pdf` in
    // `!ext:pdf` is a value, and the exclusion role covers the `!` alone.
    not: bool,
    // CHARACTERS of the query before this run, not bytes.
    at: int,
}

export struct Facet {
    // Bar height, 0..1 of the largest count in the section. Computed in Rust:
    // a max over a model is a loop per row per frame.
    share: float,
    label: string,
    token: string,
    count: string,
}


// One tab. Small capitals; the selected one carries the accent line under it.
component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    // The width comes from the word plus its padding: asking the text for the
    // box's width while the box asks the text for its own is a binding loop.
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;

        Text {
            text: root.label;
            color: root.on ? Theme.ink : touch.has-hover ? Theme.ink-2 : Theme.ink-3;
            font-size: 10.5px;
            font-weight: 650;
            letter-spacing: 1.7px;
            vertical-alignment: center;
        }
    }

    if root.on: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.q-not;
    }
}

// One row of the rail: a word, a count, and a bar behind them showing what
// share of the matching set it is. Behind, because a 186px rail has no lane.
component FacetRow inherits Rectangle {
    in property <string> label;
    in property <string> count;
    in property <float> share;
    in property <bool> on;
    callback clicked();

    height: 24px;
    // Tinted and keeping its ink: in the light scheme the tint alone is too
    // close to the hover to tell apart.
    background: root.on ? Theme.selection : touch.has-hover ? Theme.hover : transparent;

    // Inset two pixels top and bottom, at full strength: half an opacity over
    // `line` is invisible in both schemes.
    if root.share > 0: Rectangle {
        x: 0;
        y: 2px;
        height: parent.height - 4px;
        width: parent.width * root.share;
        background: Theme.line;
        border-radius: 2px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;

        Text {
            text: root.label;
            color: root.on ? Theme.ink : Theme.ink-2;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // A width of its own, so the name gives way to it: elide a name,
        // never a number.
        Text {
            text: root.count;
            color: Theme.ink-3;
            font-size: 11.5px;
            font-family: Fonts.mono;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 46px;
        }
    }
}

// A panel over the window: help, the rules, the languages. One component,
// because all three are a card that opens over the list, closes on Escape or
// on a click outside, and does not move what is under it.
component Sheet inherits Rectangle {
    in property <string> title;
    in property <bool> open;

    // Placed by whoever puts it in the window: a component cannot read its own
    // parent's size in Slint.
    in property <length> room-w;
    in property <length> room-h;

    /// Pressed the ×, or clicked outside it.
    callback dismissed();

    visible: root.open;
    x: root.room-w - self.width - 20px;
    y: 64px;
    width: min(400px, root.room-w - 40px);
    // As tall as what is in it, up to a ceiling. Measured from inside the
    // scroller: a `ScrollView` asks for very little, which collapses the panel.
    height: min(root.room-h - 120px, sheet-body.preferred-height + 76px);
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: 4px;
    // No `z`: Slint hoists an element with one into a pass the hit test does
    // not follow, so every press goes through it. Last child is what wins.
    

    // A way out that is visible. Drawn over the layout rather than in it, so
    // the title keeps the full width.
    shut := TouchArea {
        x: parent.width - 30px;
        y: 10px;
        width: 22px;
        height: 22px;
        mouse-cursor: pointer;
        clicked => { root.dismissed(); }
        Rectangle {
            background: shut.has-hover ? Theme.hover : transparent;
            border-radius: 3px;
            Text {
                text: "×";
                color: shut.has-hover ? Theme.ink : Theme.ink-3;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    body := VerticalLayout {
        padding: 16px;
        padding-right: 34px;
        spacing: 8px;

        Text {
            text: root.title;
            color: Theme.ink;
            font-size: 13px;
            font-weight: 650;
            letter-spacing: 2px;
            height: 20px;
        }

        // Scrolls, so what is in the panel is either shown or reachable: the
        // height is free to be whatever fits, and the ceiling above caps it.
        ScrollView {
            vertical-stretch: 1;
            viewport-height: sheet-body.preferred-height;
            sheet-body := VerticalLayout {
                spacing: 8px;
                padding-right: 6px;
                @children
            }
        }
    }
}

// One of the window's own controls. Square, 18px, and the same shape as the
// view switch beside it: something done to the window, not to what it shows.
component Tool inherits Rectangle {
    in property <string> glyph;
    in property <bool> on;
    callback clicked();

    width: 18px;
    height: 18px;
    border-width: 1px;
    border-radius: 3px;
    border-color: root.on ? Theme.q-key : touch.has-hover ? Theme.ink-3 : Theme.line;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.glyph;
        color: root.on ? Theme.q-key : touch.has-hover ? Theme.ink : Theme.ink-3;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

/// A button with a word on it, for the selection bar. Quiet until hovered; it
/// turns the colour of a question while `asking`.
component Push inherits Rectangle {
    in property <string> label;
    in property <bool> asking;
    callback clicked();

    width: text.preferred-width + 24px;
    height: 26px;
    border-width: 1px;
    border-radius: 3px;
    border-color: root.asking ? Theme.q-key : touch.has-hover ? Theme.ink-3 : Theme.line;
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    text := Text {
        text: root.label;
        color: root.asking ? Theme.q-key : touch.has-hover ? Theme.ink : Theme.ink-2;
        font-size: Fonts.small;
        vertical-alignment: center;
        horizontal-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

/// One way of running Scour, and what choosing it would do. The doing is a
/// second press: a press arms the row, the button beside it acts.
component FaceRow inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <string> aside;
    in property <bool> here;
    in property <bool> armed;
    in property <bool> ready: true;
    in property <string> go;
    callback picked();
    callback confirmed();

    height: layout.preferred-height;
    border-radius: 3px;
    background: root.armed ? Theme.hover : touch.has-hover && root.ready ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            if (root.ready) {
                root.picked();
            }
        }
    }

    layout := VerticalLayout {
        padding: 6px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            height: 20px;

            Text {
                text: root.here ? "●" : "○";
                color: root.here ? Theme.q-key : Theme.ink-3;
                font-size: 11px;
                vertical-alignment: center;
                width: 12px;
            }
            Text {
                text: root.label;
                color: root.ready ? Theme.ink : Theme.ink-3;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.aside;
                color: Theme.ink-3;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        // Sentence and button together: the sentence is what it asks for.
        if root.armed: HorizontalLayout {
            spacing: 8px;
            padding-left: 20px;

            Text {
                text: root.note;
                color: Theme.ink-2;
                font-size: 11px;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Push {
                    label: root.go;
                    asking: true;
                    clicked => {
                        root.confirmed();
                    }
                }
            }
        }
    }
}

component RuleRow inherits Rectangle {
    in property <string> value;
    in property <string> word;
    in property <bool> off;
    in property <bool> removable;
    callback toggled();
    callback dropped();

    height: 24px;
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            root.toggled();
        }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 8px;

        // The row is the target, not the box: twelve pixels is hard to hit.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 12px;
                height: 12px;
                border-width: 1px;
                border-radius: 2px;
                border-color: root.off ? Theme.line : Theme.q-key;
                background: root.off ? transparent : Theme.q-key;

                Text {
                    text: root.off ? "" : "✓";
                    color: Theme.panel;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        Text {
            text: root.value;
            color: root.off ? Theme.ink-3 : Theme.ink-2;
            font-family: Fonts.mono;
            font-size: 11.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.off: Text {
            text: root.word;
            color: Theme.q-bad;
            font-size: 11px;
            vertical-alignment: center;
        }

        if root.removable: Rectangle {
            width: 18px;
            border-radius: 3px;
            background: drop.has-hover ? Theme.selection : transparent;

            drop := TouchArea {
                clicked => {
                    root.dropped();
                }
            }

            Text {
                text: "×";
                color: drop.has-hover ? Theme.q-bad : Theme.ink-3;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
    }
}

component Head inherits Rectangle {
    in property <string> text;
    in property <string> sort;
    in property <string> sorted-by;
    in property <int> total-rows;
    in property <int> window-offset;
    in property <length> w;
    // Which column this is, for remembering what it was dragged to. Not `id`,
    // which Slint keeps for element names.
    in property <string> which;
    callback dragged(string, length);
    /// Double-clicked: that column goes back to deciding for itself.
    callback reset(string);
    // `right` alone collides with the alignment enum of the same name.
    in property <bool> align-right;
    /// The rightmost heading, which has no line after it.
    in property <bool> last;
    callback clicked(string);

    // A width, not a stretch: every row and this heading share one number.
    width: root.w;

    // The grip is the edge, 7px: narrower is a target people miss, wider eats
    // the heading beside it.
    grip := TouchArea {
        x: parent.width - 4px;
        width: 7px;
        height: parent.height;
        mouse-cursor: col-resize;

        moved => {
            if (self.pressed) {
                root.dragged(root.which, self.mouse-x - self.pressed-x);
            }
        }
        double-clicked => { root.reset(root.which); }
    }

    // The line between two headings, always drawn, and in the gap rather than
    // inside the heading. Never after the last: there is no column beyond it.
    if !root.last: Rectangle {
        x: parent.width + 3px;
        // Thickens under the hand, before the button goes down.
        y: grip.has-hover || grip.pressed ? 0px : 5px;
        width: grip.has-hover || grip.pressed ? 2px : 1px;
        height: parent.height - 2 * self.y;
        background: grip.has-hover || grip.pressed ? Theme.focus : Theme.line;
    }

    TouchArea {
        clicked => { root.clicked(root.sort); }
        Text {
            width: parent.width;
            // In the text, not beside it: a separate glyph shifts the heading
            // sideways when it becomes the sort.
            text: root.sorted-by == root.sort ? root.text + " ▾" : root.text;
            color: root.sorted-by == root.sort ? Theme.ink-2 : Theme.ink-3;
            font-size: 10px;
            font-weight: 650;
            letter-spacing: 1.4px;
            horizontal-alignment: root.align-right ? right : left;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A name with the match picked out. Monospace: a file name is read character
// by character, an `l` against a `1`.
component Marked inherits HorizontalLayout {
    in property <string> pre;
    in property <string> hit;
    in property <string> post;
    in property <brush> colour: Theme.ink;
    spacing: 0px;

    Text {
        text: root.pre;
        color: root.colour;
        font-family: Fonts.mono;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }

    // Not a conditional element: one of those is left out of the parent's
    // `spacing`, so the name shifts sideways the moment a match appears.
    Rectangle {
        background: root.hit == "" ? transparent : Theme.mark;
        border-radius: 2px;
        width: label.preferred-width;
        // The text's own height: the layout slot is taller than the row.
        height: label.preferred-height;
        y: (parent.height - self.height) / 2;
        label := Text {
            text: root.hit;
            color: Theme.mark-ink;
            font-family: Fonts.mono;
        font-size: 13px;
            vertical-alignment: center;
        }
    }

    Text {
        text: root.post;
        color: root.colour;
        font-family: Fonts.mono;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }

    // Eats the rest of the width so the name stays left.
    Rectangle { }
}

export component MainWindow inherits Window {
    title: "Scour";
    icon: @image-url("../../../assets/scour.svg");
    background: Theme.ground;
    preferred-width: 1100px;
    preferred-height: 680px;
    min-width: 560px;
    min-height: 320px;

    // --- what Rust sets ---------------------------------------------------
    in property <[Row]> rows;
    in property <[Span]> spans;
    in property <[Facet]> facets;
    in property <[Facet]> scopes;
    in property <[Facet]> sizes;
    in property <string> scope-heading;
    in property <string> size-heading;
    in property <[Bar]> bars;
    // The tallest bar, so every other is a share of it. Computed in Rust: a
    // max over a Slint model is a loop per bar per frame.
    in property <int> bar-peak: 1;
    in property <string> ribbon-label;
    in property <string> ribbon-hint;
    in property <string> axis-oldest;
    in property <string> axis-year;
    in property <string> axis-month;
    in property <string> axis-week;
    in property <string> axis-today;
    in property <string> meter;
    // The same line in pieces, when it is the numeric one. See the meter row.
    in property <string> meter-count;
    in property <string> meter-ms;
    in property <string> meter-rows;
    /// How far the walk has got, while the index is being built. Drawn beside
    /// the counts, where somebody waiting is already looking.
    in property <string> scanning;
    in property <string> holding;
    /// Something the window did, said until the next keystroke. Not the meter,
    /// which every answer rewrites, nor the hint, which typing hides.
    in property <string> note;
    in property <string> hint;
    in property <bool> busy;
    in property <string> scope-label;

    // The grid counts lines, not rows: a tile view puts several results on one
    // scrolled line, and the conversion happens at the edges.
    out property <bool> grid: root.view-mode != "detail";
    out property <length> tile-w: root.view-mode == "large" ? 132px : 96px;
    out property <length> tile-h: root.view-mode == "large" ? 172px : 104px;
    out property <length> pic: root.view-mode == "large" ? 110px : 52px;
    out property <int> per-line: max(1, Math.floor(
        (root.width - root.chrome - 40px) / root.tile-w));
    /// The tiles, a line at a time. A model of models: a `for` over a count
    /// builds every element at once, and a `ListView` stops being lazy.
    in property <[[Row]]> lines;

    // The preview panel: a third column holding one row. A mode, not a glance
    // — it stays open and follows the selection. What is drawn in it is what
    // the service says the file is: a picture, some text, or neither.
    in-out property <bool> peeking;
    in property <string> peek-name;
    in property <string> peek-path;
    /// The picture, when the file is one and it could be read.
    in property <image> peek-shot;
    /// Whether `peek-shot` holds one, as a flag: see `Row::shot`.
    in property <bool> peek-has-shot;
    /// The head of the file, when it is text.
    in property <string> peek-text;
    /// Said instead of either, when there is neither.
    in property <string> peek-note;
    in property <[Fact]> peek-facts;
    in property <string> peek-close-title;
    callback peek-toggled();

    // Which column the list is ordered by, as the protocol's own word.
    in property <string> sorted-by;
    // How long the list really is and where the shown window sits in it: a
    // view sized from the model would describe the window, not the result.
    in property <int> total-rows;
    in property <int> window-offset;

    // Everything between the window edge and the list — 20px card margins, 1px
    // border, the 186px rail and divider, 12px list padding, 14px of scrollbar
    // gutter. The columns are sized from this, not from the list: that is a loop.
    property <length> chrome: 40px + 2px + 186px + 1px + 24px + 14px;
    // One gap between each pair of headings, and one more before the picker.
    // Counted, because how many columns there are is a choice.
    property <length> gaps: 8px * max(1, root.heads.length);
    /// The ⋮ at the end of the header row, which is a column's worth of room
    /// that the columns themselves may not have.
    property <length> picker-w: 16px;
    // The preview panel is furniture too: 380px the columns may not divide up.
    property <length> peek-w: root.peeking ? 380px : 0px;

    /// What there is for the columns to divide up.
    out property <length> lane: max(0px,
        root.width - root.chrome - root.gaps - root.picker-w - root.peek-w);
    /// Divide it up again — in `scour_ui::lay_out`, which the page uses too.
    /// Rust, not a binding: it is two passes with a per-column floor and ceiling.
    callback relayout(length);
    changed lane => { root.relayout(root.lane); }

    // The widths every row and the heading are handed, adding up to `lane`
    // exactly. A dragged width wins over a computed one; zero means untouched.
    in-out property <[length]> cw: [240px, 110px, 320px, 120px, 90px];
    // Where each column starts inside a row, from `relayout` with `cw`.
    in-out property <[length]> cx: [12px, 260px, 378px, 706px, 834px];
    // The headings in shown order, handed in from `scour-ui` by `dress()` in
    // `main.rs`, so the header row and every row below it use one list.
    in-out property <[HeadInfo]> heads;
    /// Whether the kind's icon is drawn at the front of each row: only while
    /// the name is the first column, since the room it takes is the name's.
    out property <bool> iconed: root.heads.length > 0 && root.heads[0].id == "name";
    // The two tab words, from the catalogue like every other visible string.
    in property <string> tab-search;
    in property <string> tab-report;
    /// How many rows would fit, plus a little to scroll into. Only the window
    /// knows its height, and a fetched row costs a path rebuilt in the engine.
    /// Counted in rows in both views: a line of tiles is `per-line` results.
    out property <int> visible-rows: root.grid
        ? (Math.floor(tiles.height / root.tile-h) + 2) * root.per-line
        : max(20, Math.floor(list.height / Theme.row-height) + 12);
    // --- the scrollbar ----------------------------------------------------
    // Drawn by this window in a lane of its own: the style's is a hairline over
    // the list, invisible on a dark panel and sitting on the size column. The
    // list gives up 14px; the arithmetic below is the flickable's own.
    property <length> sb-inset: 4px;
    property <length> sb-reach: root.grid ? tiles.viewport-height : list.viewport-height;
    property <length> sb-shown: root.grid ? tiles.visible-height : list.visible-height;
    property <length> sb-span: max(0px, root.sb-reach - root.sb-shown);
    property <length> sb-track: root.sb-shown - 2 * root.sb-inset;
    /// Never shorter than 36px: millions of rows put the thumb below hitting size.
    property <length> sb-thumb: root.sb-span <= 0px ? 0px
        : max(36px, root.sb-track * root.sb-shown / root.sb-reach);
    property <length> sb-travel: max(0px, root.sb-track - root.sb-thumb);
    property <length> sb-at: 0px - (root.grid ? tiles.viewport-y : list.viewport-y);
    property <length> sb-y: root.sb-inset + (root.sb-span <= 0px ? 0px
        : root.sb-travel * min(1.0, max(0.0, root.sb-at / root.sb-span)));

    /// Put the thumb's top at `y` and take the list with it.
    function scroll-thumb-to(y: length) {
        if (root.sb-travel <= 0px) {
            return;
        }
        root.scroll-to(root.sb-span * min(1.0, max(0.0, (y - root.sb-inset) / root.sb-travel)));
    }

    /// Put the list back to the top, or a measured distance down it. A function
    /// rather than a binding: the scroll position is the `ListView`'s to keep.
    public function scroll-to(down: length) {
        list.viewport-y = 0px - down;
        tiles.viewport-y = 0px - down;
        paper.viewport-y = 0px - down;
    }
    /// Scroll the rail from outside, for `SCOUR_GUI_RAIL`.
    public function scroll-rail(down: length) {
        railview.viewport-y = 0px - down;
    }
    /// The first row of the result the list is showing, read off the viewport
    /// so the fetch decision never depends on the model reporting a miss.
    out property <int> first-row: root.grid
        ? max(0, Math.floor((0px - tiles.viewport-y) / root.tile-h)) * root.per-line
        : max(0, Math.floor((0px - list.viewport-y) / Theme.row-height));
    /// The list moved by at least one row. Fires only while scrolling, and at
    /// once; the timer stays as the backstop for a resize.
    callback moved();
    changed first-row => {
        root.moved();
    }
    // Set only when Rust changes the text itself (a facet click), never on
    // every keystroke, or the caret jumps.
    in-out property <string> query;
    in-out property <int> selected: 0;
    in-out property <string> active-facet;

    // --- what Rust listens for --------------------------------------------
    callback query-changed(string);
    callback activated(int);
    callback reveal(int);
    // --- the right-click menu -------------------------------------------
    // The window owns none of the meaning: Rust fills `menu` from
    // `scour_ui::menu` and answers `menu-pick` with the id that comes back.
    in property <[MenuItem]> menu;
    in-out property <bool> menu-open: false;
    /// The whole text of the cell under the pointer, shown when the cell had
    /// to cut it. `tip-pending` is what the pointer is on; `tip-text` is what
    /// is drawn, after a moment's rest or on a click.
    in-out property <string> tip-pending;
    in-out property <string> tip-text;
    in-out property <length> tip-x;
    in-out property <length> tip-y;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    /// A row was right-clicked, at this point on the window.
    callback menu-at(int, length, length);
    /// One of the items was pressed.
    callback menu-pick(string);
    /// The same overlay, holding the column switches instead of row actions.
    in-out property <bool> menu-columns: false;
    callback column-toggled(string);

    // --- asking before something that changes files ----------------------
    // The menu only offers what can be undone, but "safe to undo" is not
    // "meant": twelve rows going at once is worth a sentence and a pause.
    in-out property <bool> ask-open: false;
    in property <string> ask-title;
    in property <string> ask-body;
    in property <string> ask-yes;
    in property <string> ask-no;
    /// The question takes a line of text rather than only a yes: a rename is
    /// the same overlay with a name in the middle of the sentence.
    in-out property <bool> ask-typing: false;
    in-out property <string> ask-text;
    /// True for yes. Sent once, whichever way it goes.
    callback ask-answer(bool);
    callback copy-path(int);
    callback facet-clicked(string);
    callback sort-by(string);
    callback tool-clicked(string);
    callback view-clicked(string);
    in-out property <string> view-mode: "detail";
    // --- the report -------------------------------------------------------
    // Every number in it is the service's: this window formats and draws.
    in-out property <string> tab: "search";
    /// The scope, one segment a button, so any ancestor is one press away.
    in property <[Facet]> crumb;
    in property <string> report-total;
    in property <string> report-files;
    in property <string> report-stale;
    in property <string> report-took;
    in property <[Kid]> kids;
    in property <string> kids-empty;
    /// How wide the age bar is. Fixed, because six widths taken from the width
    /// of the layout that holds them is a binding loop.
    property <length> age-bar: 260px;
    /// The six band words, in the order the colours run.
    in property <[string]> age-words;
    in property <string> head-kinds;
    in property <string> head-biggest;
    in property <string> head-jump;
    in property <string> head-dupes;
    in property <[Facet]> report-kinds;
    in property <[Facet]> report-big;
    in property <string> report-under;
    in property <string> jump-label;
    in property <string> jump-note;
    callback report-search();
    // Which way of running Scour to offer, and which one is running now.
    in-out property <string> armed-face;
    in property <string> faces-title;
    in property <string> face-window;
    in property <string> face-window-aside;
    in property <string> face-tui;
    in property <string> face-tui-note;
    in property <string> face-tui-aside;
    in property <string> face-web;
    in property <string> face-web-note;
    in property <bool> face-tui-ready;
    in property <string> face-go;
    callback face-picked(string);
    // The same file, several times over.
    in property <bool> dupes-open;
    in property <string> dupes-show;
    in property <string> dupes-hide;
    in property <string> dupes-sum;
    in property <string> dupes-note;
    in property <string> dupes-confirm;
    in property <[string]> dupe-floors;
    in property <int> dupe-floor;
    in property <[Dupe]> dupes;
    callback dupes-toggled();
    callback dupes-floored(int);
    callback dupes-read();
    in property <string> head-folder;
    in property <string> head-age;
    // The report's own heading; the table's travel in `heads`.
    in property <string> head-size;
    in property <string> head-share;
    in property <string> head-files;
    callback report-open(string);

    // Which panel is open, if any: "", "help", "faces", "language", "rules".
    in-out property <string> panel: "";
    in property <string> help-title;
    in property <string> help-body;
    in property <string> lang-title;
    in property <string> rules-title;
    in property <string> language;
    in property <[Facet]> languages;
    in property <[Rule]> rules-added;
    in property <[Rule]> rules-config;
    in property <[Rule]> rules-builtin;
    in property <string> rules-added-title;
    in property <string> rules-added-note;
    in property <string> rules-config-title;
    in property <string> rules-config-note;
    in property <string> rules-builtin-title;
    in property <string> rules-builtin-note;
    /// The last rule text short enough to draw. Slint can neither cut a string
    /// nor cap a field, so an over-long edit is put back from here; the software
    /// renderer places glyphs at `i16`, and 400 characters stays inside that.
    private property <string> rule-kept: "";
    in property <string> rules-hint;
    in property <string> rules-add;
    in property <string> rules-off-word;
    callback rule-dropped(string, string);
    callback rule-added(string);
    callback language-picked(string);
    callback rule-toggled(string);
    // --- the selection ----------------------------------------------------
    // Several rows at once, and an action takes all of them. The sentence is
    // written in Rust: counts and a size in a language's own word order.
    in property <int> picked;
    // Three pieces, because the count is drawn brighter and Slint has no rich
    // text. Split at `{n}`, so a language may put the number last.
    in property <string> picked-pre;
    in property <string> picked-n;
    in property <string> picked-post;
    in property <string> pick-copy;
    in property <string> pick-folders;
    in property <string> pick-drop;
    in property <bool> pick-asking;
    /// A row was picked: which, whether to add to the selection, and whether
    /// to take the run from the last one picked.
    callback pick(int, bool, bool);
    callback pick-copied();
    callback pick-opened();
    callback pick-dropped();
    callback bar-clicked(int);
    callback column-dragged(string, length);
    /// Double-clicked an edge: that column stretches with the window again.
    callback column-reset(string);
    /// The ⋮ at the end of the header row: which columns to show. Carries where
    /// it is, since the menu opens under it.
    callback columns-clicked(length, length);
    // No page callbacks: the model's length is the whole result, so the view
    // just scrolls and the window fetches what scrolled into sight.

    public function focus-query() {
        input.focus();
    }

    // What was searched before, already filtered by what is typed.
    in property <[string]> past;
    in-out property <bool> past-open;
    in-out property <int> past-picked;
    // Whether there is a past at all: no arrow when there is nothing to open.
    in property <bool> has-past;
    callback past-toggled();
    callback past-taken(string);
    // A query somebody meant, not one they were halfway through typing: the
    // box searches per keystroke, the history takes only what was committed.
    callback query-committed();

    // What the engine made of the query, as a sentence, and whether any of it
    // is a misreading. Empty when there is nothing worth reading back.
    in property <string> reading;
    in property <bool> reading-warn;

    // `SCOUR_TRACE=1`: print what the two layers of the query field measure on
    // every caret move. They have to agree character for character.
    in property <bool> trace: false;

    /// Put the caret at the end of what is typed. Used by `Enter` on a
    /// suggestion and by `SCOUR_GUI_END`: text set from Rust leaves it at nought.
    public function caret-to-end() {
        // `set-selection-offsets` takes BYTE offsets and clamps, and Slint has
        // no byte count, so anything past the end is the end.
        input.set-selection-offsets(1000000000, 1000000000);
    }

    forward-focus: input;

    // A card on a ground: 20px all round, a 1px line, a 3px corner. No shadow —
    // the compositor draws the window's own, and two read as a border.
    Rectangle {
        x: 20px;
        y: 20px;
        width: parent.width - 40px;
        height: parent.height - 40px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 3px;
        clip: true;

    VerticalLayout {
        spacing: 0px;

        // The query line. Slint's `TextInput` has no range colouring (upstream
        // #9560 puts editable text out of scope), so the colours are a second
        // layer under a transparent input.
        Rectangle {
            // 16px above the box, 12px below, the box 26px of 20px monospace.
            // Taller when the query is read back — see `reading`.
            height: root.reading == "" ? 63px : 82px;
            background: Theme.panel;

            // The line between the query and what is under it. A plain rule:
            // the field's own border is what says where the keyboard is.
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }

            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 16px;
                padding-bottom: 12px;
                spacing: 5px;

            HorizontalLayout {
                // The box's own height, so the reading under it moves nothing.
                height: 35px;
                spacing: 12px;

                // The mark. Letter-spaced small capitals.
                mark := Text {
                    text: "SCOUR";
                    color: Theme.ink-3;
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 3.4px;
                    vertical-alignment: center;
                }

                // The box and its placeholder, stacked: Slint's `TextInput` has
                // no placeholder, so the hint is drawn under it and hidden the
                // moment anything is typed.
                field := Rectangle {
                    horizontal-stretch: 1;
                    // Or the scrolled text paints across the window.
                    clip: true;
                    background: Theme.panel-2;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: input.has-focus ? Theme.focus : Theme.line;
                    animate border-color { duration: 120ms; }
                    // One number for all three layers: the coloured text, the
                    // placeholder and the input must start at the same place.
                    property <length> pad: 9px;
                    // What is visible inside the padding, minus the chevron's
                    // room. Never negative: `cursor-position-changed` derives
                    // `shift` from it, and all three layers move by `shift`.
                    property <length> room: max(0px, field.width - field.pad * 2
                        - (root.has-past ? 24px : 0px));
                    property <length> shift: 0px;
                    // One character's width, measured over forty because a
                    // layout rounds each run to whole pixels and the error
                    // accumulates. Runs are placed by offset times this. One
                    // width for every character: a double-width face slides.
                    property <length> advance: ruler.preferred-width / 40;
                    // Where the caret is, and whether it is in its lit half.
                    property <length> caret-x: field.pad;
                    property <bool> caret-lit: true;

                    // This window draws its own caret: on Linux Slint's takes
                    // its colour from `TextInput::color`, which is transparent
                    // here. 530ms is the desktop's own blink rate.
                    blink := Timer {
                        interval: 530ms;
                        running: input.has-focus;
                        triggered => {
                            field.caret-lit = !field.caret-lit;
                        }
                    }

                    // Forty characters of the query's face, to measure one.
                    ruler := Text {
                        text: "0000000000000000000000000000000000000000";
                        font-family: Fonts.mono;
                        font-size: 20px;
                        font-weight: 600;
                        visible: false;
                    }

                    for sp[i] in root.spans: Text {
                            x: field.pad + field.shift + field.advance * sp.at;
                            height: parent.height;
                            text: sp.text;
                            font-family: Fonts.mono;
                            font-size: 20px;
                            // Operators are heavier: one character that changes
                            // what a whole term means.
                            font-weight: sp.role == 1 || sp.role == 4 ? 700 : 600;
                            vertical-alignment: center;
                            // A misreading is said before a polarity, and an
                            // exclusion before a role: `!kind:zurna` is both,
                            // and unreadable is what matters.
                            color: sp.role == 5 ? Theme.q-bad
                                 : sp.not ? Theme.q-not
                                 : sp.role == 1 ? Theme.q-key
                                 : sp.role == 2 ? Theme.q-val
                                 : sp.role == 3 ? Theme.q-glob
                                 : sp.role == 4 ? Theme.q-not
                                 : sp.role == 6 ? Theme.q-term
                                 : sp.role == 7 ? Theme.ink-3
                                 : Theme.ink;
                    }

                    // What stands in between a keystroke and the runs the
                    // service sends back: the input itself is transparent, so
                    // without this the gap shows nothing at all.
                    if root.spans.length == 0 && root.query != "": Text {
                        x: field.pad + field.shift;
                        width: max(parent.width - field.pad * 2, self.preferred-width);
                        text: root.query;
                        color: Theme.ink;
                        font-family: Fonts.mono;
                        font-size: 20px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    if root.spans.length == 0 && root.query == "": Text {
                        x: field.pad + field.shift;
                        width: parent.width - field.pad * 2;
                        text: root.hint;
                        color: Theme.ink-3;
                        font-family: Fonts.mono;
                        font-size: 20px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                input := TextInput {
                    // A child of a `Rectangle` gets its preferred size, and a
                    // text input's preferred width is its text — which leaves
                    // most of the field with nothing to click.
                    x: field.pad + field.shift;
                    // Never narrower than its text, so it never scrolls itself,
                    // and never narrower than the box, so all of it is clickable.
                    width: max(field.room, self.preferred-width);
                    height: parent.height;
                    text <=> root.query;
                    // Where the caret is, so this window can draw one.
                    cursor-position-changed(p) => {
                        // Keep the caret inside the visible part, and no further
                        // left than the start of the text.
                        if (p.x + field.shift < 0px) {
                            field.shift = -p.x;
                        }
                        if (p.x + field.shift > field.room - 2px) {
                            field.shift = field.room - 2px - p.x;
                        }
                        if (field.shift > 0px) {
                            field.shift = 0px;
                        }
                        field.caret-x = field.pad + field.shift + p.x;
                        if (root.trace) {
                            debug("query field: input caret x " + p.x / 1px
                                + "  by the ruler " + field.advance * root.query.character-count / 1px
                                + "  stand-in width " + self.preferred-width / 1px
                                + "  chars " + root.query.character-count
                                + "  selection " + self.anchor-position-byte-offset
                                + ".." + self.cursor-position_byte-offset);
                        }
                        // Typing restarts the lit half: a caret blinking while
                        // letters arrive reads as a dropped keystroke.
                        field.caret-lit = true;
                        blink.restart();
                    }
                    // Invisible ink: what the reader sees is the coloured layer
                    // underneath. This takes Slint's own caret with it, which
                    // is why the window draws one of its own.
                    color: transparent;
                    font-size: 20px;
                    font-weight: 600;
                    font-family: Fonts.mono;
                    single-line: true;
                    vertical-alignment: center;
                    // Said here: the default comes from a style, and this
                    // window links none.
                    text-cursor-width: 2px;
                    selection-background-color: Theme.selection;
                    // Invisible for the selection too, or selecting draws the
                    // real text opaquely over the coloured layer. The
                    // translucent wash is what says a selection.
                    selection-foreground-color: transparent;

                    edited => {
                        root.query-changed(self.text);
                    }


                    // Down and up move through the results without leaving the
                    // field: type, glance, press Enter.
                    key-pressed(e) => {
                        // `Alt+↓` opens what was searched before; plain `↓`
                        // still walks into the results.
                        if (e.text == Key.DownArrow && e.modifiers.alt) {
                            root.past-toggled();
                            return accept;
                        }
                        // While the list is open the arrows belong to it.
                        if (root.past-open && e.text == Key.DownArrow) {
                            root.past-picked = min(root.past-picked + 1, root.past.length - 1);
                            return accept;
                        }
                        if (root.past-open && e.text == Key.UpArrow) {
                            root.past-picked = max(root.past-picked - 1, 0);
                            return accept;
                        }
                        if (root.past-open && e.text == Key.Return) {
                            root.past-taken(root.past[root.past-picked]);
                            return accept;
                        }
                        if (root.past-open && e.text == Key.Escape) {
                            root.past-open = false;
                            return accept;
                        }
                        if (e.text == Key.DownArrow) {
                            root.selected = min(root.selected + 1, root.rows.length - 1);
                            if ((root.selected + 1) * Theme.row-height + list.viewport-y
                                > list.visible-height) {
                                list.viewport-y = list.visible-height
                                    - (root.selected + 1) * Theme.row-height;
                            }
                            return accept;
                        }
                        if (e.text == Key.UpArrow) {
                            root.selected = max(root.selected - 1, 0);
                            if (root.selected * Theme.row-height + list.viewport-y < 0px) {
                                list.viewport-y = 0px - root.selected * Theme.row-height;
                            }
                            return accept;
                        }
                        // A screenful at a time, and the ends.
                        if (e.text == Key.PageDown || e.text == Key.PageUp) {
                            root.selected = clamp(
                                root.selected + (e.text == Key.PageDown ? root.visible-rows : -root.visible-rows),
                                0,
                                root.rows.length - 1);
                            list.viewport-y = min(0px,
                                -(root.selected * Theme.row-height) + list.visible-height / 2);
                            return accept;
                        }
                        if (e.text == Key.Home || e.text == Key.End) {
                            root.selected = e.text == Key.Home ? 0 : root.rows.length - 1;
                            list.viewport-y = e.text == Key.Home
                                ? 0px
                                : min(0px, list.visible-height - root.rows.length * Theme.row-height);
                            return accept;
                        }
                        if (e.text == Key.Return) {
                            // What was committed to is what the history takes.
                            root.query-committed();
                            root.activated(root.selected);
                            return accept;
                        }
                        if (e.text == Key.Escape && root.panel != "") {
                            // A panel first: Escape closes what is on top.
                            root.panel = "";
                            return accept;
                        }
                        if (e.text == Key.Escape && root.picked > 0) {
                            // Then the selection, before the query: the smaller undo.
                            root.pick-dropped();
                            return accept;
                        }
                        if (e.text == Key.Escape) {
                            if (self.text == "") {
                                return accept;
                            }
                            self.text = "";
                            root.query-changed("");
                            return accept;
                        }
                        return reject;
                    }
                }

                    // What says `Alt+↓` is there. Inside the field at its
                    // trailing edge, because the box stretches and a button
                    // outside it would move with every resize.
                    if root.has-past: Rectangle {
                        x: field.width - 26px;
                        width: 22px;
                        height: 22px;
                        y: (field.height - 22px) / 2;
                        border-radius: 3px;
                        background: chevron.has-hover || root.past-open ? Theme.hover : Theme.panel-2;
                        Text {
                            text: "▾";
                            color: root.past-open ? Theme.ink : Theme.ink-3;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        chevron := TouchArea {
                            // The pointer, not the click: by the time a click
                            // lands, the list has already closed on blur.
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    root.past-toggled();
                                }
                            }
                        }
                    }

                    // Painted last, so a letter cannot cover it.
                    Rectangle {
                        x: field.caret-x;
                        y: (field.height - 24px) / 2;
                        width: 2px;
                        height: 24px;
                        background: Theme.q-key;
                        visible: input.has-focus && field.caret-lit;
                    }

                }
            }

                // What the engine read, in words: the colours say what each
                // piece is, this says why the answer is what it is. Shown only
                // when there is something worth saying — `Role::is_telling`.
                if root.reading != "": Text {
                    text: root.reading;
                    color: root.reading-warn ? Theme.q-bad : Theme.ink-3;
                    font-size: 11.5px;
                    font-weight: 500;
                    letter-spacing: 0.12px;
                    overflow: elide;
                }
            }
        }

        // What is true of the whole window: how many, how long, how big the
        // index is. Above the list, because "is this everything?" is asked
        // before reading rather than after.
        Rectangle {
            height: 30px;
            background: Theme.panel;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line-soft;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;

                // Three claims of different weight: the count is the answer,
                // the cost wears the "today" hue, the walk stays quiet. `meter`
                // holds the sentences that are not numbers; never both at once.
                if root.meter-count != "": HorizontalLayout {
                    spacing: 6px;

                    Text {
                        text: root.meter-count;
                        color: Theme.ink;
                        font-size: 12.5px;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-ms == "" ? "" : "·";
                        color: Theme.line;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-ms;
                        color: Theme.t0;
                        font-size: 11.5px;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-rows == "" ? "" : "·";
                        color: Theme.line;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-rows;
                        color: Theme.ink-3;
                        font-size: 11.5px;
                        letter-spacing: 0.2px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.scanning == "" ? "" : "·";
                        color: Theme.line;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    // The key colour: the one thing on this line still moving.
                    Text {
                        text: root.scanning;
                        color: Theme.q-key;
                        font-size: 11.5px;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                }

                if root.meter-count == "": Text {
                    text: root.meter;
                    color: Theme.ink-3;
                    font-size: 11.5px;
                    letter-spacing: 0.2px;
                    vertical-alignment: center;
                }

                // What the service is holding, not what it just answered.
                Text {
                    text: root.holding == "" ? "" : "  ·  " + root.holding;
                    color: Theme.ink-3;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle { }

                if root.note != "": Text {
                    text: root.note;
                    color: Theme.q-key;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.busy: Text {
                    text: "…";
                    color: Theme.focus;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

                // The window's own controls, then a rule, then the switches for
                // what is being read rather than what the program is doing.
                Rectangle { width: 10px; }

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 2px;
                        Tool { glyph: "⇄"; clicked => { root.tool-clicked("faces"); } }
                        Tool { glyph: "文"; clicked => { root.tool-clicked("language"); } }
                        Tool { glyph: "⊘"; clicked => { root.tool-clicked("rules"); } }
                        Tool { glyph: "⤓"; clicked => { root.tool-clicked("export"); } }
                        Tool { glyph: "?"; clicked => { root.tool-clicked("help"); } }
                    }
                }

                Rectangle { width: 12px; }

                Rectangle {
                    width: 1px;
                    background: Theme.line;
                }

                Rectangle { width: 12px; }

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 2px;
                        // With the view switch: a preview panel changes what is
                        // being read, not what the program is doing.
                        Tool {
                            glyph: "◫";
                            on: root.peeking;
                            clicked => {
                                root.peek-toggled();
                            }
                        }
                        Tool {
                            glyph: "≣";
                            on: root.view-mode == "detail";
                            clicked => {
                                root.view-clicked("detail");
                            }
                        }
                        Tool {
                            glyph: "▦";
                            on: root.view-mode == "icons";
                            clicked => {
                                root.view-clicked("icons");
                            }
                        }
                        Tool {
                            glyph: "▣";
                            on: root.view-mode == "large";
                            clicked => {
                                root.view-clicked("large");
                            }
                        }
                    }
                }
            }
        }

        // Search and report, the window's two tabs.
        Rectangle {
            height: 29px;
            background: Theme.panel;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                padding-left: 20px;
                spacing: 0px;
                alignment: start;

                Tab {
                    label: root.tab-search;
                    on: root.tab != "report";
                    clicked => {
                        root.tab = "search";
                    }
                }
                Tab {
                    label: root.tab-report;
                    on: root.tab == "report";
                    clicked => {
                        root.tab = "report";
                        // Asked for when looked at: weighing a folder is a walk.
                        root.report-open("");
                    }
                }
                Rectangle { }
            }
        }

        // The report: what a folder weighs, where the weight sits, how old it
        // is. One scrolling document, and capped to nothing rather than put in
        // an `if`, because an id inside one is out of scope.
        paper := ScrollView {
            visible: root.tab == "report";
            max-height: root.tab == "report" ? 100000px : 0px;
            min-height: 0px;
            // Said, not inferred: a `ScrollView` does not learn its content's
            // height from a layout inside it, so there would be no overflow.
            viewport-height: sheet.preferred-height;

            sheet := VerticalLayout {
            // Its natural height: a layout inside a `ScrollView` otherwise
            // stretches to fill it, and there is nothing to scroll.
            height: self.preferred-height;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 10px;

            // The scope, one segment a button: any ancestor is one press away.
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                height: 22px;

                for step[i] in root.crumb: Rectangle {
                    width: label.preferred-width + 12px;
                    border-radius: 3px;
                    background: steptouch.has-hover ? Theme.hover : transparent;

                    steptouch := TouchArea {
                        clicked => {
                            root.report-open(step.token);
                        }
                    }

                    label := Text {
                        text: step.label;
                        color: i == root.crumb.length - 1 ? Theme.ink : Theme.ink-3;
                        font-family: Fonts.mono;
                        font-size: 11.5px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }

            // What the whole scope comes to, and three quieter facts under it.
            HorizontalLayout {
                spacing: 16px;
                alignment: start;

                Text {
                    text: root.report-total;
                    color: Theme.ink;
                    font-family: Fonts.mono;
                    font-size: 30px;
                    font-weight: 650;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.report-files;
                        color: Theme.ink-3;
                        font-size: Fonts.small;
                    }
                    Text {
                        text: root.report-stale;
                        color: Theme.ink-3;
                        font-size: Fonts.small;
                    }
                    Text {
                        text: root.report-took;
                        color: Theme.ink-3;
                        font-size: Fonts.small;
                    }
                }
            }

            // The children, heaviest first. The engine ordered them.
            Rectangle {
                height: 24px;
                background: Theme.panel;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }

                HorizontalLayout {
                    spacing: 10px;

                    Text {
                        text: root.head-folder;
                        color: Theme.ink-3;
                        font-size: 10.5px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        width: 34%;
                    }
                    Text {
                        text: root.head-age;
                        color: Theme.ink-3;
                        font-size: 10.5px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        width: root.age-bar;
                    }
                    Text {
                        text: root.head-size;
                        color: Theme.ink-3;
                        font-size: 10.5px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 90px;
                    }
                    Text {
                        text: root.head-share;
                        color: Theme.ink-3;
                        font-size: 10.5px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 70px;
                    }
                    Text {
                        text: root.head-files;
                        color: Theme.ink-3;
                        font-size: 10.5px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 80px;
                    }
                }
            }

            // At most two dozen — `top` in the request says so — so a plain
            // repeater: a `ListView` would scroll inside the report's scroll.
            VerticalLayout {
                spacing: 0px;

                for kid[i] in root.kids: Rectangle {
                    height: 30px;
                    background: kidtouch.has-hover ? Theme.hover : transparent;

                    kidtouch := TouchArea {
                        clicked => {
                            root.report-open(kid.path);
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        Text {
                            text: kid.name;
                            color: Theme.q-key;
                            font-family: Fonts.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            width: 34%;
                        }

                        // The bytes by age, as one bar, in the six colours the
                        // rows and the ribbon use. Placed rather than laid out:
                        // widths taken from the parent's width are a binding loop.
                        VerticalLayout {
                            alignment: center;
                            width: root.age-bar;
                            Rectangle {
                                height: 12px;
                                Rectangle {
                                    x: 0;
                                    width: root.age-bar * kid.a0;
                                    height: parent.height;
                                    background: Theme.t0;
                                }
                                Rectangle {
                                    x: root.age-bar * kid.a0;
                                    width: root.age-bar * kid.a1;
                                    height: parent.height;
                                    background: Theme.t1;
                                }
                                Rectangle {
                                    x: root.age-bar * (kid.a0 + kid.a1);
                                    width: root.age-bar * kid.a2;
                                    height: parent.height;
                                    background: Theme.t2;
                                }
                                Rectangle {
                                    x: root.age-bar * (kid.a0 + kid.a1 + kid.a2);
                                    width: root.age-bar * kid.a3;
                                    height: parent.height;
                                    background: Theme.t3;
                                }
                                Rectangle {
                                    x: root.age-bar * (kid.a0 + kid.a1 + kid.a2 + kid.a3);
                                    width: root.age-bar * kid.a4;
                                    height: parent.height;
                                    background: Theme.t4;
                                }
                                Rectangle {
                                    x: root.age-bar * (kid.a0 + kid.a1 + kid.a2 + kid.a3 + kid.a4);
                                    width: root.age-bar * kid.a5;
                                    height: parent.height;
                                    background: Theme.t5;
                                }
                            }
                        }

                        Text {
                            text: kid.size;
                            color: Theme.ink;
                            font-family: Fonts.mono;
                            font-size: 12px;
                            font-weight: 650;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 90px;
                        }
                        Text {
                            text: kid.share;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 70px;
                        }
                        Text {
                            text: kid.files;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 80px;
                        }
                    }
                }
            }

            if root.kids.length == 0: Text {
                text: root.kids-empty;
                color: Theme.ink-3;
                font-size: Fonts.small;
                height: 40px;
                vertical-alignment: center;
            }

            // What the six colours mean, said once.
            HorizontalLayout {
                height: 30px;
                spacing: 14px;
                alignment: start;

                for word[i] in root.age-words: HorizontalLayout {
                    spacing: 5px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 2px;
                            background: i == 0 ? Theme.t0 : i == 1 ? Theme.t1 : i == 2 ? Theme.t2
                                : i == 3 ? Theme.t3 : i == 4 ? Theme.t4 : Theme.t5;
                        }
                    }
                    Text {
                        text: word;
                        color: Theme.ink-3;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            // Three panels: what kinds the weight is in, the heaviest files
            // under here, and the way into a search scoped to this folder.
            HorizontalLayout {
                spacing: 12px;

                Rectangle {
                    background: Theme.panel-2;
                    border-width: 1px;
                    border-color: Theme.line-soft;
                    border-radius: 3px;
                    // Even thirds, with a floor: a panel that gives way to its
                    // neighbour elides the words it exists to show.
                    horizontal-stretch: 1;
                    min-width: 215px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        Text {
                            text: root.head-kinds;
                            color: Theme.ink-3;
                            font-size: 10.5px;
                            font-weight: 650;
                            letter-spacing: 1.2px;
                        }

                        for kind[i] in root.report-kinds: Rectangle {
                            height: 19px;

                            // Behind the words: a share reads as a length first.
                            Rectangle {
                                x: 0;
                                width: parent.width * kind.share;
                                height: parent.height;
                                background: Theme.line-soft;
                                border-radius: 2px;
                            }

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;

                                Text {
                                    text: kind.label;
                                    color: Theme.ink-2;
                                    font-size: 11.5px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: kind.count;
                                    color: Theme.ink-3;
                                    font-family: Fonts.mono;
                                    font-size: 11.5px;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    width: 72px;
                                }
                            }
                        }
                        Rectangle { }
                    }
                }

                Rectangle {
                    background: Theme.panel-2;
                    border-width: 1px;
                    border-color: Theme.line-soft;
                    border-radius: 3px;
                    // Even thirds, with a floor: a panel that gives way to its
                    // neighbour elides the words it exists to show.
                    horizontal-stretch: 1;
                    min-width: 215px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        Text {
                            text: root.head-biggest;
                            color: Theme.ink-3;
                            font-size: 10.5px;
                            font-weight: 650;
                            letter-spacing: 1.2px;
                        }

                        for big[i] in root.report-big: HorizontalLayout {
                            height: 19px;
                            spacing: 8px;

                            Text {
                                text: big.label;
                                color: Theme.ink-2;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: big.count;
                                color: Theme.ink;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                font-weight: 650;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                width: 76px;
                            }
                        }
                        Rectangle { }
                    }
                }

                Rectangle {
                    background: Theme.panel-2;
                    border-width: 1px;
                    border-color: Theme.line-soft;
                    border-radius: 3px;
                    // Even thirds, with a floor: a panel that gives way to its
                    // neighbour elides the words it exists to show.
                    horizontal-stretch: 1;
                    min-width: 215px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: root.head-jump;
                            color: Theme.ink-3;
                            font-size: 10.5px;
                            font-weight: 650;
                            letter-spacing: 1.2px;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "under:";
                                color: Theme.q-key;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.report-under;
                                color: Theme.ink-2;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            alignment: start;
                            Push {
                                label: root.jump-label;
                                clicked => {
                                    root.report-search();
                                }
                            }
                        }

                        Text {
                            text: root.jump-note;
                            color: Theme.ink-3;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Rectangle { }
                    }
                }
            }

            // The same file, several times over. Not run unasked: it is a walk
            // of every candidate.
            HorizontalLayout {
                spacing: 10px;
                height: 30px;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.head-dupes;
                        color: Theme.ink-3;
                        font-size: 10.5px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.dupes-open ? root.dupes-hide : root.dupes-show;
                        clicked => {
                            root.dupes-toggled();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.dupes-sum;
                        color: Theme.ink-3;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { }

                for floor[i] in root.dupe-floors: VerticalLayout {
                    alignment: center;
                    Push {
                        label: floor;
                        asking: i == root.dupe-floor;
                        clicked => {
                            root.dupes-floored(i);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.dupes-confirm;
                        clicked => {
                            root.dupes-read();
                        }
                    }
                }
            }

            if root.dupes-open: Text {
                text: root.dupes-note;
                color: Theme.ink-3;
                font-size: 11.5px;
                wrap: word-wrap;
            }

            if root.dupes-open: VerticalLayout {
                spacing: 10px;

                for group[i] in root.dupes: VerticalLayout {
                    spacing: 2px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: group.size;
                            color: Theme.ink;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            font-weight: 650;
                        }
                        Text {
                            text: group.times;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                        }
                        Rectangle { }
                        Text {
                            text: group.certainty;
                            color: group.proven ? Theme.t1 : Theme.q-bad;
                            font-family: Fonts.mono;
                            font-size: 11px;
                        }
                    }
                    Text {
                        text: group.paths;
                        color: Theme.ink-3;
                        font-family: Fonts.mono;
                        font-size: 11px;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }
            }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            visible: root.tab != "report";
            max-height: root.tab == "report" ? 0px : 100000px;

            // The rail: what the matching set consists of. Clicking a row adds
            // its term to the query rather than filtering behind its back.
            Rectangle {
                // A fixed track: it carries counts that must not reflow while
                // the list beside it does.
                width: 186px;
                background: Theme.panel-2;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.line;
                }

                // Scrolled: three sections and thirteen kinds do not fit at
                // 700px, and a rail that grew would push the ribbon off.
                railview := ScrollView {
                    // Told how tall it is, or there is no overflow to scroll.
                    viewport-height: rail.preferred-height;

                    rail := VerticalLayout {
                    height: self.preferred-height;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 0px;
                    padding-right: 0px;
                    spacing: 1px;
                    alignment: start;

                    // Indented by a layout, not by an `x`: moving the text
                    // right inside a box that stays put clips the first glyph.
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: root.scope-label;
                            color: Theme.ink-3;
                            font-size: 10px;
                            font-weight: 650;
                            letter-spacing: 1.8px;
                            overflow: elide;
                            height: 15px;
                        }
                    }

                    Rectangle { height: 8px; }

                    for f[i] in root.facets: FacetRow {
                        label: f.label;
                        count: f.count;
                        share: f.share;
                        on: root.active-facet == f.token;
                        clicked => { root.facet-clicked(f.token); }
                    }

                    // Where, not what: the scopes are this desktop's own folders,
                    // answered by the service, which runs where the files are.
                    Rectangle { height: 12px; }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: root.scope-heading;
                            color: Theme.ink-3;
                            font-size: 10px;
                            font-weight: 650;
                            letter-spacing: 1.8px;
                            overflow: elide;
                            height: 15px;
                        }
                    }

                    Rectangle { height: 8px; }

                    for sc[i] in root.scopes: FacetRow {
                        label: sc.label;
                        count: sc.count;
                        share: sc.share;
                        on: root.active-facet == sc.token;
                        clicked => { root.facet-clicked(sc.token); }
                    }

                    // Three bands rather than a histogram: a size filter answers
                    // "what is taking the room" and "what is empty".
                    Rectangle { height: 12px; }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: root.size-heading;
                            color: Theme.ink-3;
                            font-size: 10px;
                            font-weight: 650;
                            letter-spacing: 1.8px;
                            overflow: elide;
                            height: 15px;
                        }
                    }

                    Rectangle { height: 8px; }

                    for sz[i] in root.sizes: FacetRow {
                        label: sz.label;
                        count: sz.count;
                        share: sz.share;
                        on: root.active-facet == sz.token;
                        clicked => { root.facet-clicked(sz.token); }
                    }
                    }

                }
            }

            // The results.
            VerticalLayout {
                spacing: 0px;
                // Allowed to be narrower than its columns, which is what lets
                // the preview panel take its 380px from the list.
                min-width: 0px;

                // Column headings, each of them a sort. Which columns and how
                // wide are `heads` and `cw`, both handed in from `scour-ui`.
                Rectangle {
                    // Taller than a row: a fixed edge the eye returns to.
                    height: 31px;
                    background: Theme.panel;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        for h[i] in root.heads: Head {
                            which: h.id;
                            text: h.label;
                            sort: h.sort;
                            align-right: h.right;
                            // No line after the last: there is no column beyond it.
                            last: i == root.heads.length - 1;
                            w: root.cw[i];
                            sorted-by: root.sorted-by;
                            dragged(c, d) => { root.column-dragged(c, d); }
                            reset(c) => { root.column-reset(c); }
                            clicked(k) => { root.sort-by(k); }
                        }

                        // Where a column would be. Its room is taken out of the
                        // lane — see `picker-w`.
                        Rectangle {
                            width: 16px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.columns-clicked(self.absolute-position.x,
                                        self.absolute-position.y + self.height);
                                }
                                Text {
                                    text: "⋮";
                                    color: parent.has-hover ? Theme.ink : Theme.ink-3;
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                list := ListView {
                    // The window draws its own, in the lane below. See `sb-`.
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    // Capped to nothing rather than put behind an `if`: an id
                    // inside a conditional is out of scope, and both views must
                    // stay readable by name.
                    visible: !root.grid;
                    // With `max-height`: a `ScrollView` asks for fifty pixels
                    // whatever it holds, so capping the height alone leaves a band.
                    min-height: 0px;
                    max-height: root.grid ? 0px : 100000px;

                    // Over the model, not over a count: a `for` on an integer
                    // builds every element at once and `ListView` stops being
                    // lazy. `row_count` is the whole result, so the view sizes
                    // its scrollbar from the real length and asks for what it draws.
                    for here[i] in root.rows: Rectangle {
                        height: Theme.row-height;
                        // Never animated: selecting is where you are, not an
                        // event that happened to the list. The arrival wash is
                        // a separate layer with its own clock, below.
                        background: (here.picked || i == root.selected) ? Theme.selection
                            : rowtouch.has-hover ? Theme.hover
                            : transparent;

                        // The arrival wash: translucent, so a row that is both
                        // new and selected shows both, and it fades away.
                        Rectangle {
                            background: here.fresh ? Theme.t0.with-alpha(0.22) : transparent;
                            animate background { duration: 1600ms; easing: ease-out; }
                        }

                        // Where the keyboard is, which is not what is selected:
                        // a ring, because a fourth shade of blue would read as
                        // "more selected", which is not a thing.
                        if i == root.selected: Rectangle {
                            background: transparent;
                            border-width: 1px;
                            border-color: Theme.focus;
                        }

                        rowtouch := TouchArea {
                            clicked => {
                                root.selected = i;
                                root.focus-query();
                                root.tip-text = root.tip-pending;
                            }
                            double-clicked => {
                                root.selected = i;
                                root.activated(i);
                            }
                            // A press, not a click: a click carries no modifiers
                            // here, and `Ctrl` and `Shift` change what it means.
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down
                                    && e.button == PointerEventButton.left) {
                                    root.selected = i;
                                    root.pick(i, e.modifiers.control || e.modifiers.meta,
                                        e.modifiers.shift);
                                }
                                if (e.button == PointerEventButton.right
                                    && e.kind == PointerEventKind.down) {
                                    root.selected = i;
                                    // Right-clicking outside the selection selects what
                                    // was right-clicked: a menu must be about what is
                                    // under the pointer.
                                    root.menu-at(i, self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }

                        Rectangle {
                            x: 0;
                            // Fixed: the stripe is the age, and an arrival does
                            // not change it. The wash behind the row says that.
                            width: 3px;
                            height: parent.height;
                            background: here.age == 0 ? Theme.t0 : here.age == 1 ? Theme.t1
                                 : here.age == 2 ? Theme.t2 : here.age == 3 ? Theme.t3
                                 : here.age == 4 ? Theme.t4 : Theme.t5;
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;

                            // The kind's icon, spelled out one kind at a time:
                            // `@image-url` is resolved at build time. Tinted
                            // from `scour-ui`. A conditional rather than a zero
                            // width, which would still take the row's spacing.
                            if root.iconed: VerticalLayout {
                                alignment: center;
                                width: 15px;
                            // No thumbnail in a detail row: `thumb` is drawn in
                            // the grid, where a picture is the question.
                            if here.ktoken == "folder": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/folder.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "doc": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/doc.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "code": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/code.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "image": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/image.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "video": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/video.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "media": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/media.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "audio": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/audio.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "archive": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/archive.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "exec": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/exec.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "data": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/data.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "config": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/config.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "font": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/font.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "build": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/build.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "file": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/file.svg");
                                colorize: here.tint;
                            }
                            }

                            // One loop over the cells: which columns are shown
                            // is a person's choice. The name is found by `id`,
                            // and the icon's room comes out of the name's width.
                            for c[ci] in here.cells: HorizontalLayout {
                                // As wide as its heading, icon included: taking
                                // the icon off twice shifts every later column.
                                width: max(0px, root.cw[ci] - (ci == 0 && root.iconed ? 23px : 0px));

                                if c.id == "name": Marked {
                                    pre: c.pre;
                                    hit: c.hit;
                                    post: c.post;
                                    colour: here.is-dir ? Theme.q-key : Theme.ink;
                                    width: parent.width;
                                    // The row's pointer, in this cell, judged
                                    // by the column table rather than by this
                                    // element's geometry: a `changed` binding
                                    // that reads geometry recurses while the
                                    // repeater lays out. The row owns the touch
                                    // area, so no click is taken from it.
                                    property <bool> under: rowtouch.has-hover
                                        && rowtouch.mouse-x >= root.cx[ci]
                                        && rowtouch.mouse-x < root.cx[ci] + root.cw[ci];
                                    changed under => {
                                        if (self.under && self.preferred-width > self.width) {
                                            root.tip-pending = c.pre + c.hit + c.post;
                                            root.tip-x = rowtouch.absolute-position.x + rowtouch.mouse-x + 14px;
                                            root.tip-y = rowtouch.absolute-position.y + rowtouch.height + 2px;
                                        } else if (root.tip-pending == c.pre + c.hit + c.post) {
                                            root.tip-pending = "";
                                            root.tip-text = "";
                                        }
                                    }
                                }

                                if c.id != "name": Text {
                                    width: root.cw[ci];
                                    text: c.text;
                                    // The age is the stamp's own colour; `-1` is
                                    // a column that is not a time at all.
                                    color: c.dim ? Theme.ink-3
                                         : c.age < 0 ? (c.right ? Theme.ink-2 : Theme.ink-3)
                                         : c.age == 0 ? Theme.t0 : c.age == 1 ? Theme.t1
                                         : c.age == 2 ? Theme.t2 : c.age == 3 ? Theme.t3
                                         : c.age == 4 ? Theme.t4 : Theme.t5;
                                    // An empty family is the window's own.
                                    font-family: c.mono ? Fonts.mono : "";
                                    font-size: c.mono ? 11.5px : Fonts.small;
                                    horizontal-alignment: c.right ? right : left;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    property <bool> under: rowtouch.has-hover
                                        && rowtouch.mouse-x >= root.cx[ci]
                                        && rowtouch.mouse-x < root.cx[ci] + root.cw[ci];
                                    changed under => {
                                        if (self.under && self.preferred-width > self.width) {
                                            root.tip-pending = c.text;
                                            root.tip-x = rowtouch.absolute-position.x + rowtouch.mouse-x + 14px;
                                            root.tip-y = rowtouch.absolute-position.y + rowtouch.height + 2px;
                                        } else if (root.tip-pending == c.text) {
                                            root.tip-pending = "";
                                            root.tip-text = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // The same results as tiles. A second list rather than a second
                // shape for the first: a `ListView` is lazy about one repeater.
                // The one not showing is capped to no height rather than put in
                // an `if`, which would take its id out of scope.
                tiles := ListView {
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    visible: root.grid;
                    min-height: 0px;
                    max-height: root.grid ? 100000px : 0px;

                    for line[i] in root.lines: Rectangle {
                        height: root.tile-h;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;

                            for cell[c] in line: Rectangle {
                                width: root.tile-w;
                                height: root.tile-h;
                                // The tile is the selection, not the line: a line
                                // holds several results.
                                background: (cell.picked || (i * root.per-line + c) == root.selected)
                                    ? Theme.selection
                                    : tiletouch.has-hover ? Theme.hover
                                    : transparent;

                                // The arrival wash, on its own layer.
                                Rectangle {
                                    background: cell.fresh
                                        ? Theme.t0.with-alpha(0.22)
                                        : transparent;
                                    animate background { duration: 1600ms; easing: ease-out; }
                                }

                                // And where the keyboard is — see the table's
                                // rows for why a ring rather than a shade.
                                if (i * root.per-line + c) == root.selected: Rectangle {
                                    background: transparent;
                                    border-width: 1px;
                                    border-color: Theme.focus;
                                }

                                tiletouch := TouchArea {
                                    clicked => {
                                        root.selected = i * root.per-line + c;
                                        root.focus-query();
                                    }
                                    double-clicked => {
                                        root.selected = i * root.per-line + c;
                                        root.activated(root.selected);
                                    }
                                    pointer-event(e) => {
                                        if (e.kind != PointerEventKind.down) {
                                            return;
                                        }
                                        root.selected = i * root.per-line + c;
                                        if (e.button == PointerEventButton.right) {
                                            root.menu-at(root.selected,
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                        } else if (e.button == PointerEventButton.left) {
                                            root.pick(root.selected,
                                                e.modifiers.control || e.modifiers.meta,
                                                e.modifiers.shift);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 4px;
                                    alignment: center;

                                    // The picture where there is one, the kind's
                                    // colour where there is not.
                                    Rectangle {
                                        height: root.pic;
                                        if cell.shot: Image {
                                            width: root.pic;
                                            height: root.pic;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: cell.thumb;
                                            // The whole picture: its shape is
                                            // part of what identifies it.
                                            image-fit: contain;
                                        }
                                        if cell.shot == false: Rectangle {
                                            width: root.pic * 0.55;
                                            height: root.pic * 0.55;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 5px;
                                            background: cell.tint;
                                            opacity: 0.5;
                                        }
                                    }

                                    Text {
                                        text: cell.name;
                                        color: cell.is-dir ? Theme.q-key : Theme.ink;
                                        font-family: Fonts.mono;
                                        font-size: root.view-mode == "large" ? 12px : 11px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        height: 30px;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // The scrollbar's lane. Beside the list, never over it; the
            // arithmetic is in the `sb-` properties.
            VerticalLayout {
                width: 14px;

                // Level with the column headings, carrying their rule across.
                Rectangle {
                    height: 31px;
                    background: Theme.panel;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }
                }

                Rectangle {
                    background: Theme.panel;

                    thumb := Rectangle {
                        x: 4px;
                        width: 6px;
                        y: root.sb-y;
                        height: root.sb-thumb;
                        border-radius: 3px;
                        // Quiet until it is wanted.
                        background: grab.pressed ? Theme.ink-2
                            : grab.has-hover ? Theme.ink-3 : Theme.line;
                        visible: root.sb-span > 0px;
                        animate background { duration: 120ms; }
                    }

                    grab := TouchArea {
                        // Where the thumb was when this press began.
                        property <length> from;

                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                // A press on the track takes the thumb to the
                                // pointer; on the thumb it picks it up as it is.
                                if (self.mouse-y < thumb.y
                                    || self.mouse-y > thumb.y + thumb.height) {
                                    root.scroll-thumb-to(self.mouse-y - thumb.height / 2);
                                }
                                self.from = thumb.y;
                            }
                        }

                        moved => {
                            root.scroll-thumb-to(self.from + self.mouse-y - self.pressed-y);
                        }
                    }
                }
            }

            // The preview panel: 380px, shut by default, and the width and the
            // bounds are `scour_ui::preview`'s so every face agrees.
            if root.peeking: Rectangle {
                // Min and max, not `width`: the list's own minimum is wider than
                // the window, and a `width` is a preference the layout squeezes.
                min-width: 380px;
                max-width: 380px;
                horizontal-stretch: 0;
                background: Theme.panel-2;

                Rectangle {
                    x: 0;
                    width: 1px;
                    height: parent.height;
                    background: Theme.line;
                }

                VerticalLayout {
                    padding-left: 1px;
                    spacing: 0px;

                    // The name, and the way out. Wrapped rather than truncated:
                    // the end of a name is what tells two versions apart.
                    Rectangle {
                        height: 46px;
                        background: Theme.panel-2;

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.line;
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 8px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;

                            Text {
                                text: root.peek-name;
                                color: Theme.ink;
                                font-size: 12.5px;
                                font-weight: 600;
                                wrap: word-wrap;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                Tool {
                                    glyph: "×";
                                    clicked => {
                                        root.peek-toggled();
                                    }
                                }
                            }
                        }
                    }

                    // What can be shown of the file. One box, three answers.
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 80px;

                        if root.peek-has-shot: Image {
                            width: parent.width - 24px;
                            height: parent.height - 24px;
                            x: 12px;
                            y: 12px;
                            source: root.peek-shot;
                            // The whole picture: a crop can remove the part being
                            // looked for.
                            image-fit: contain;
                        }

                        if !root.peek-has-shot && root.peek-text != "": Flickable {
                            width: parent.width;
                            height: parent.height;
                            viewport-width: self.width;
                            viewport-height: body.preferred-height;

                            body := VerticalLayout {
                                padding: 12px;
                                alignment: start;
                                Text {
                                    text: root.peek-text;
                                    color: Theme.ink-2;
                                    font-family: Fonts.mono;
                                    font-size: 11.5px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if !root.peek-has-shot && root.peek-text == "": Text {
                            text: root.peek-note;
                            color: Theme.ink-3;
                            font-size: 11.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    // The facts, below the picture. Its own height, because a
                    // path wraps to four lines as readily as one; asking a named
                    // child for `preferred-height` from its parent is a circle.
                    Rectangle {
                        vertical-stretch: 0;
                        background: Theme.panel;

                        Rectangle {
                            y: 0;
                            height: 1px;
                            background: Theme.line;
                        }

                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 9px;
                            padding-bottom: 9px;
                            spacing: 3px;
                            alignment: start;

                            for fact in root.peek-facts: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: fact.label;
                                    color: Theme.ink-3;
                                    font-size: 11px;
                                    width: 74px;
                                    overflow: elide;
                                }
                                Text {
                                    text: fact.value;
                                    color: Theme.ink-2;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }

        // What is selected, and what can be done with it. Absent when nothing
        // is selected.
        if root.picked > 0 && root.tab != "report": Rectangle {
            height: 38px;
            background: Theme.panel-2;

            // The count on the left, the buttons on the right: one is read,
            // the others are aimed at.
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 0px;
                        Text {
                            text: root.picked-pre;
                            color: Theme.ink-3;
                            font-size: Fonts.small;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.picked-n;
                            color: Theme.ink;
                            font-size: Fonts.small;
                            font-weight: 650;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.picked-post;
                            color: Theme.ink-3;
                            font-size: Fonts.small;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { }

                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.pick-copy;
                        clicked => {
                            root.pick-copied();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.pick-folders;
                        asking: root.pick-asking;
                        clicked => {
                            root.pick-opened();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.pick-drop;
                        clicked => {
                            root.pick-dropped();
                        }
                    }
                }
            }
        }

        // The time ribbon. Twenty-four bars on a logarithmic scale, so the last
        // day, week and year all have room on one screen. The edges are
        // `scour_ui::bar_edges`, shared with every other face.
        Rectangle {
            visible: root.tab != "report";
            min-height: root.tab == "report" ? 0px : 107px;
            max-height: root.tab == "report" ? 0px : 107px;
            background: Theme.panel-2;

            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 10px;
                padding-bottom: 12px;
                spacing: 0px;

                HorizontalLayout {
                    Text {
                        text: root.ribbon-label;
                        color: Theme.ink-3;
                        font-size: 10px;
                        font-weight: 650;
                        letter-spacing: 1.8px;
                        vertical-alignment: center;
                        height: 15px;
                    }
                    Rectangle { }
                    Text {
                        text: root.ribbon-hint;
                        color: Theme.ink-3;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 4px; }

                // The bars take what is left; the axis keeps its line.
                HorizontalLayout {
                    spacing: 3px;
                    alignment: stretch;

                    for b[i] in root.bars: Rectangle {
                        horizontal-stretch: 1;

                        // A bar is a filter: clicking adds a `dm:` term to the
                        // text. The oldest has no upper bound, so it does
                        // nothing and says so by not lighting up.
                        bartouch := TouchArea {
                            mouse-cursor: b.days > 0 ? pointer : default;
                            clicked => {
                                if (b.days > 0) {
                                    root.bar-clicked(b.days);
                                }
                            }
                        }
                        // Bottom-aligned, so twenty-four bars read as one shape.
                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                // A fixed ceiling, not a share of the parent:
                                // that is a binding loop. 36px leaves the axis
                                // its line inside the ribbon's 107.
                                height: b.count == 0 ? 2px
                                    : max(4px, 36px * b.count / max(1, root.bar-peak));
                                background: b.count == 0 ? Theme.line
                                    : b.band == 0 ? Theme.t0 : b.band == 1 ? Theme.t1
                                    : b.band == 2 ? Theme.t2 : b.band == 3 ? Theme.t3
                                    : b.band == 4 ? Theme.t4 : Theme.t5;
                                // Lighter under the pointer: a bar that can be
                                // pressed says so before it is.
                                opacity: bartouch.has-hover && b.days > 0 ? 0.75 : 1.0;
                            }
                        }
                    }
                }

                // The axis. Five marks rather than twenty-four: the question is
                // only ever "how far back am I looking".
                HorizontalLayout {
                    padding-top: 3px;

                    Text {
                        text: root.axis-oldest;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: left;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-year;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-month;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-week;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-today;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                    }
                }
            }
        }


    }

        // What was searched before, hanging over what is under the query row —
        // which is why it is drawn here and not inside that row. Placed at the
        // field's own left edge, since the mark beside it has no fixed width.
        // This area puts it away; behind the list, so a press on a line lands.
        if root.past-open: TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.past-open = false;
                }
            }
        }

        if root.past-open && root.past.length > 0: Rectangle {
            x: 20px + mark.width + 12px;
            y: 55px;
            width: min(520px, parent.width - self.x - 20px);
            // Sized to what is in it: a layout gives its parent a minimum
            // height, so a shorter box would be overflowed by its own rows.
            height: root.past.length * 26px + 8px;
            background: Theme.panel-2;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 4px;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                for line[i] in root.past: Rectangle {
                    height: 26px;
                    background: i == root.past-picked ? Theme.selection
                              : row-touch.has-hover ? Theme.hover : transparent;
                    border-radius: 3px;
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        text: line;
                        color: Theme.ink;
                        font-family: Fonts.mono;
                        font-size: 12.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    row-touch := TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.past-taken(line);
                            }
                        }
                    }
                }
            }
        }

        }

        // The panels. Drawn last so they are over the list, and only ever one
        // open at a time.
        Sheet {
            title: root.help-title;
            open: root.panel == "help";
            dismissed => { root.panel = ""; }
            room-w: root.width - 40px;
            room-h: root.height - 40px;

            Text {
                text: root.help-body;
                color: Theme.ink-2;
                font-size: 12.5px;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }

        Sheet {
            title: root.faces-title;
            open: root.panel == "faces";
            room-w: root.width - 40px;
            room-h: root.height - 40px;
            changed open => {
                // Nothing stays armed behind a closed panel.
                root.armed-face = "";
            }

            VerticalLayout {
                spacing: 2px;
                alignment: start;

                FaceRow {
                    label: root.face-window;
                    aside: root.face-window-aside;
                    here: true;
                    ready: false;
                }
                FaceRow {
                    label: root.face-tui;
                    note: root.face-tui-note;
                    aside: root.face-tui-ready ? "" : root.face-tui-aside;
                    ready: root.face-tui-ready;
                    armed: root.armed-face == "tui";
                    go: root.face-go;
                    picked => { root.armed-face = "tui"; }
                    confirmed => { root.face-picked("tui"); }
                }
                FaceRow {
                    label: root.face-web;
                    note: root.face-web-note;
                    armed: root.armed-face == "web";
                    go: root.face-go;
                    picked => { root.armed-face = "web"; }
                    confirmed => { root.face-picked("web"); }
                }
            }
        }

        Sheet {
            title: root.lang-title;
            open: root.panel == "language";
            dismissed => { root.panel = ""; }
            room-w: root.width - 40px;
            room-h: root.height - 40px;

            VerticalLayout {
                spacing: 2px;
                alignment: start;

                for l[i] in root.languages: FacetRow {
                    label: l.label;
                    count: l.count;
                    on: root.language == l.token;
                    clicked => { root.language-picked(l.token); }
                }
            }
        }

        Sheet {
            title: root.rules-title;
            open: root.panel == "rules";
            dismissed => { root.panel = ""; }
            room-w: root.width - 40px;
            room-h: root.height - 40px;
            // The field takes the focus when the panel opens: clicking it does
            // not, because activating the window hands focus to the query line.
            changed open => {
                if (self.open) {
                    fresh.focus();
                } else {
                    root.focus-query();
                }
            }

            // No scroller here: `Sheet` is one, and a `ScrollView` inside a
            // `ScrollView` collapses the outer one to four lines.
            VerticalLayout {
                spacing: 4px;
                alignment: start;

                // Three groups: what somebody added here, what a file says, and
                // what the program skips. Only the first can be deleted.
                Text {
                    text: root.rules-added-title;
                    color: Theme.ink;
                    font-size: 11px;
                    font-weight: 650;
                    letter-spacing: 1.2px;
                }
                Text {
                    text: root.rules-added-note;
                    color: Theme.ink-3;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                for r[i] in root.rules-added: RuleRow {
                    value: r.value;
                    off: r.off;
                    word: root.rules-off-word;
                    removable: true;
                    toggled => {
                        root.rule-toggled(r.id);
                    }
                    dropped => {
                        root.rule-dropped(r.kind, r.value);
                    }
                }

                // A rule is added as a name unless it starts with a slash, in
                // which case it is a path. Nothing subtler is guessed at.
                Rectangle { height: 4px; }

                HorizontalLayout {
                    spacing: 6px;
                    height: 26px;

                    Rectangle {
                        border-width: 1px;
                        border-radius: 3px;
                        border-color: Theme.line;
                        background: Theme.panel;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;

                            fresh := TextInput {
                                color: Theme.ink;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                single-line: true;
                                vertical-alignment: center;
                                selection-background-color: Theme.selection;
                                selection-foreground-color: Theme.ink;
                                edited => {
                                    if (self.text.character-count > 400) {
                                        self.text = root.rule-kept;
                                    } else {
                                        root.rule-kept = self.text;
                                    }
                                }
                                accepted => {
                                    root.rule-added(self.text);
                                    self.text = "";
                                    root.rule-kept = "";
                                }
                            }
                        }

                        // Under the field, not beside it: a layout owns its
                        // children's positions, and this starts where the text does.
                        if fresh.text == "": Text {
                            text: root.rules-hint;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            x: 8px;
                            height: parent.height;
                        }
                    }

                    Push {
                        label: root.rules-add;
                        clicked => {
                            root.rule-added(fresh.text);
                            fresh.text = "";
                        }
                    }
                }

                Rectangle { height: 10px; }

                Text {
                    text: root.rules-config-title;
                    color: Theme.ink;
                    font-size: 11px;
                    font-weight: 650;
                    letter-spacing: 1.2px;
                }
                Text {
                    text: root.rules-config-note;
                    color: Theme.ink-3;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                for r[i] in root.rules-config: RuleRow {
                    value: r.value;
                    off: r.off;
                    word: root.rules-off-word;
                    toggled => {
                        root.rule-toggled(r.id);
                    }
                }

                Rectangle { height: 10px; }

                Text {
                    text: root.rules-builtin-title;
                    color: Theme.ink;
                    font-size: 11px;
                    font-weight: 650;
                    letter-spacing: 1.2px;
                }
                Text {
                    text: root.rules-builtin-note;
                    color: Theme.ink-3;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                for r[i] in root.rules-builtin: RuleRow {
                    value: r.value;
                    off: r.off;
                    word: root.rules-off-word;
                    toggled => {
                        root.rule-toggled(r.id);
                    }
                }
            }
        }

    // --- the question that comes before a change --------------------------
    // Same shape as the menu overlay: a full-window sheet so the click that
    // answers does not also land on the list. This one dims what is behind it.
    if root.ask-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000066;

        TouchArea {
            // Clicking away is "no": a stray press lands on the safe answer.
            clicked => {
                root.ask-open = false;
                root.ask-answer(false);
            }
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 420px;
            height: ask-sheet.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 3px;
            drop-shadow-blur: 26px;
            drop-shadow-color: #00000080;

            // Swallows the click, or the sheet behind answers "no".
            TouchArea { }

            ask-sheet := VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: root.ask-title;
                    color: Theme.ink;
                    font-size: 14px;
                    font-weight: 650;
                    wrap: word-wrap;
                }
                Text {
                    text: root.ask-body;
                    color: Theme.ink-3;
                    font-family: Fonts.mono;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                if root.ask-typing: Rectangle {
                    height: 30px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: Theme.focus;
                    background: Theme.panel-2;
                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        renaming := TextInput {
                            text <=> root.ask-text;
                            color: Theme.ink;
                            font-family: Fonts.mono;
                            font-size: 12.5px;
                            single-line: true;
                            vertical-alignment: center;
                            selection-background-color: Theme.selection;
                            selection-foreground-color: Theme.ink;
                            // Enter is yes.
                            accepted => {
                                root.ask-open = false;
                                root.ask-answer(true);
                            }
                        }
                    }
                }
                Rectangle { height: 4px; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: no-text.preferred-width + 26px;
                        height: 28px;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: Theme.line;
                        background: no-hit.has-hover ? Theme.hover : transparent;
                        no-text := Text {
                            text: root.ask-no;
                            color: Theme.ink-2;
                            font-size: 12.5px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        no-hit := TouchArea {
                            clicked => {
                                root.ask-open = false;
                                root.ask-answer(false);
                            }
                        }
                    }

                    Rectangle {
                        width: yes-text.preferred-width + 26px;
                        height: 28px;
                        border-radius: 3px;
                        background: yes-hit.has-hover
                            ? Theme.danger.transparentize(0.78)
                            : Theme.danger.transparentize(0.88);
                        border-width: 1px;
                        border-color: Theme.danger.transparentize(0.6);
                        yes-text := Text {
                            text: root.ask-yes;
                            color: Theme.danger;
                            font-size: 12.5px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        yes-hit := TouchArea {
                            clicked => {
                                root.ask-open = false;
                                root.ask-answer(true);
                            }
                        }
                    }
                }
            }
        }
    }

    // --- the right-click menu --------------------------------------------
    // Last child of the window, which is what puts it on top: Slint draws
    // siblings in declaration order and has no z-index. The full-window sheet
    // under it stops the dismissing click reaching a row or a heading.
    if root.menu-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.menu-open = false;
                }
            }
        }

        Rectangle {
            // Kept on screen: near the pointer, never past the edge.
            x: min(root.menu-x, root.width - self.width - 8px);
            y: min(root.menu-y, root.height - self.height - 8px);
            width: 258px;
            height: items.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 3px;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000070;
            drop-shadow-offset-y: 6px;

            items := VerticalLayout {
                padding: 5px;

                for it[i] in root.menu: VerticalLayout {
                    // A rule where the group changes: the gap is what a hand
                    // travelling down the list stops at.
                    if it.rule: Rectangle {
                        height: 7px;
                        Rectangle {
                            y: 3px;
                            x: 6px;
                            width: parent.width - 12px;
                            height: 1px;
                            background: Theme.line;
                        }
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: 2px;
                        background: hit.has-hover
                            ? (it.careful ? Theme.danger.transparentize(0.88) : Theme.hover)
                            : transparent;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;

                            // A lane for the tick, kept even when empty, so a
                            // label does not shuffle sideways when switched on.
                            if root.menu-columns: Text {
                                text: it.on ? "✓" : "";
                                color: Theme.q-key;
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 12px;
                            }

                            Text {
                                text: it.label;
                                color: it.off ? Theme.line
                                     : it.careful ? Theme.danger
                                     : it.heavy ? Theme.ink-3
                                     : Theme.ink-2;
                                font-size: 12.5px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            // The shortcut, quieter than the label: it is there
                            // to be learned, not read.
                            Text {
                                text: it.key;
                                color: Theme.ink-3;
                                font-family: Fonts.mono;
                                font-size: 10.5px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        // Declared after the text, so it is above it: order is
                        // what decides which element takes the press.
                        hit := TouchArea {
                            clicked => {
                                root.menu-open = false;
                                if (root.menu-columns) {
                                    root.column-toggled(it.id);
                                } else {
                                    root.menu-pick(it.id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // A moment's rest before the tip appears; a click skips it.
    Timer {
        interval: 450ms;
        running: root.tip-pending != "" && root.tip-text == "";
        triggered => { root.tip-text = root.tip-pending; }
    }

    // The cut text, whole. Below the row and near the pointer, kept on screen;
    // a fixed width so the height can come from the text without a cycle.
    if root.tip-text != "": Rectangle {
        width: min(520px, root.width - 16px);
        height: tip-label.preferred-height + 12px;
        x: max(8px, min(root.tip-x, root.width - self.width - 8px));
        y: root.tip-y + self.height > root.height - 8px
            ? root.tip-y - self.height - Theme.row-height - 4px : root.tip-y;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 3px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000060;
        drop-shadow-offset-y: 4px;
        tip-label := Text {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            text: root.tip-text;
            color: Theme.ink;
            font-family: Fonts.mono;
            font-size: 11.5px;
            wrap: word-wrap;
        }
    }
}
