// The window.
//
// Everything here is driven from Rust: the rows arrive as a model, the counts
// arrive as properties, and every decision that needs the query language —
// what a term means, what colour it is, how a name should be highlighted — is
// made on the other side and handed over already answered. A `.slint` file
// that reasons about queries is a second parser, and two parsers drift.

import { Theme, Fonts } from "theme.slint";

// Re-exported for the generated Rust API; its colours follow Slint's platform
// palette directly.
export { Theme, Fonts }
import { ListView, ScrollView } from "std-widgets.slint";

// One result. Flat, and deliberately: a struct of strings is what crosses the
// language boundary cheaply, and the formatting was done in Rust where the
// catalogue and the size units already live.
export struct Row {
    // The name in three pieces: before the match, the match, after it.
    //
    // Split in Rust rather than here because Slint has no way to take a
    // substring — and that turns out to be the right place anyway. The offsets
    // come out of folded text, Turkish folding changes byte lengths, and
    // mapping them back to the original spelling is `scour-core`'s job.
    pre: string,
    hit: string,
    post: string,
    // The directory, without the name. Shown quieter and to the right.
    folder: string,
    // The whole path. Not drawn — it is what opening, revealing and copying
    // the row read, and it lives on the row so that those can never be looking
    // at a different row from the one under the pointer.
    path: string,
    // Arrived since the last answer. The list updates itself while it is open,
    // and a list that changes under you without saying so is one you stop
    // trusting — so what arrived is shown arriving, and then stops being
    // shown: this marks the event, not the row.
    fresh: bool,
    // The kind's own token — `folder`, `code`, `build` — used to pick the icon
    // and its colour. Separate from `kind` below, which is the translated word
    // a person reads: one is vocabulary, the other is language.
    ktoken: string,
    tint: brush,
    // What kind of thing it is, already translated — the engine's own
    // vocabulary, so the window never invents a word for a kind it does not
    // know about.
    kind: string,
    size: string,
    stamp: string,
    is-dir: bool,
    // Which age band the row falls in, 0 (minutes) to 5 (older).
    age: int,
    // In the selection. Several rows can be, and what is done with them is
    // done to all of them at once — see the bar under the list.
    picked: bool,
    // The desktop's own thumbnail of this file, when one has been made.
    //
    // Filled in after the row lands, not with it: see `pictures` in `main.rs`.
    // A page is two hundred rows and decoding two hundred PNGs to draw thirty
    // of them is thirty milliseconds of somebody's scroll.
    thumb: image,
    // Whether `thumb` holds one, said as a flag.
    //
    // **Asking the image itself was measured and is not free.** The fifteen
    // glyph conditions on every row each asked an `image` for its width, and
    // an idle window with a list on screen went from 22% of a core to 49%. A
    // flag beside it duplicates something only in the sense that costs
    // nothing to keep and something to ask for.
    shot: bool,
}

/// One line of the preview panel's fact list: a label and a value.
///
/// Built in Rust, because every value in it is formatted — a size in binary
/// units, a date in the reader's punctuation, a mode as `rwxr-xr-x` — and a
/// `.slint` file that formatted any of them would be a second implementation
/// of something `scour-ui` already has. Which facts, and in what order, is
/// `scour_ui::preview::FACTS`; the browser page lists the same ones.
export struct Fact {
    label: string,
    value: string,
}

// One facet of the rail: a kind, its count, and the token that filters by it.
// One bar of the time ribbon: how many files fall in it, and which of the six
// age bands it belongs to — the same band the rows' dates are painted with, so
// a bar and the rows it stands for are the same colour.
export struct Bar {
    count: int,
    // The bar's upper bound in days, and `0` for the oldest — which has no
    // bound, so pressing it would select everything.
    days: int,
    band: int,
    // What the bar covers, already worded: "up to 38 days", "older than 730".
    about: string,
}

// One skip rule: what it is, whether it is in force, and whether this window
// is allowed to delete it.
//
// **Off is a note, not a deletion**, and that is what lets the two groups this
// window cannot edit — the program's own set and a hand-written `config.toml`
// — still be switched off. The note is kept beside the index; neither the file
// nor the binary is touched.
export struct Rule {
    id: string,
    value: string,
    kind: string,
    off: bool,
    removable: bool,
}

// One folder in the report: what it weighs, what share of its parent that is,
// and how those bytes are spread over the six age bands.
//
// The bands are six fields rather than an array because the bar that draws
// them is six rectangles, and six named widths read better at the point of use
// than an index into a model would.
export struct Kid {
    name: string,
    path: string,
    size: string,
    share: string,
    files: string,
    a0: float,
    a1: float,
    a2: float,
    a3: float,
    a4: float,
    a5: float,
}

// One group of files that might be the same file.
//
// `certainty` is the engine's own word for how far the checking got, and
// `proven` is whether that word is `content` — read end to end and compared.
// The two are separate because only the second licenses the word "duplicate":
// being the same size is not being the same file.
export struct Dupe {
    size: string,
    times: string,
    certainty: string,
    proven: bool,
    paths: string,
}

// One coloured run of the query, as the engine cut it.
//
// **The engine cuts it, not this window.** A frontend that tokenised the query
// itself would be a second parser, and the day the two disagreed the box would
// be confidently colouring a lie. `Request::Explain` returns the runs; all
// that is left here is a role and a colour.
export struct Span {
    text: string,
    // 0 plain · 1 field · 2 value · 3 wildcard · 4 exclusion · 5 read as text
    role: int,
}

export struct Facet {
    // How tall this row's bar is, 0..1 of the largest count in its section.
    // Computed in Rust: a max over a model is a loop per row per frame.
    share: float,
    label: string,
    token: string,
    count: string,
}

// The age used to be a dot beside the date. It is the date's own colour now —
// the page's answer, and the better one: the eye is already at the stamp to
// find out *when*, so when and how-long-ago are one glance rather than two.
// `Theme.t0`-`t5` are the six bands; `rows::band` decides which.

// One tab. Small capitals, and the selected one carries the line under it —
// the page's shape, where the underline is the only mark and it is the accent
// colour rather than a heavier weight.
component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    // The width comes from the word plus its padding — asking the text for
    // the box's width while the box asks the text for its own is a binding
    // loop, which Slint refuses at compile time rather than at run time.
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;

        Text {
            text: root.label;
            color: root.on ? Theme.ink : touch.has-hover ? Theme.ink-2 : Theme.ink-3;
            font-size: 10.5px;
            font-weight: 650;
            letter-spacing: 1.7px;
            vertical-alignment: center;
        }
    }

    if root.on: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.q-not;
    }
}

// One row of the rail: a word, a count, and a bar behind them showing what
// share of the matching set it is.
//
// The bar sits *behind* the text rather than beside it, which is the page's
// shape: a rail 186px wide cannot spare a lane for a bar, and the eye reads a
// length without being given one.
component FacetRow inherits Rectangle {
    in property <string> label;
    in property <string> count;
    in property <float> share;
    in property <bool> on;
    callback clicked();

    height: 24px;
    // The pressed row is tinted *and* keeps its ink, because in the light
    // scheme a translucent blue over cream is close enough to the hover that
    // the two were telling the reader nothing apart.
    background: root.on ? Theme.selection : touch.has-hover ? Theme.hover : transparent;

    // Inset two pixels top and bottom and squared off at the left, exactly as
    // the page draws it — and at full strength, not at half. Half an opacity
    // over `line` is invisible in both schemes, which is a bar that is drawn,
    // measured, and telling nobody anything.
    if root.share > 0: Rectangle {
        x: 0;
        y: 2px;
        height: parent.height - 4px;
        width: parent.width * root.share;
        background: Theme.line;
        border-radius: 2px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;

        Text {
            text: root.label;
            color: root.on ? Theme.ink : Theme.ink-2;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // **A width of its own, and the name gives way to it.** Without one
        // the two share what is left over, and on a machine whose text is a
        // shade larger than this one's the name takes it all and the count —
        // the thing the row is *for* — is the part that goes. Elide a name;
        // never a number.
        Text {
            text: root.count;
            color: Theme.ink-3;
            font-size: 11.5px;
            font-family: Fonts.mono;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 46px;
        }
    }
}

// One of the window's own controls. Square, 18px, the page's size — and the
// same shape as the view switch beside it, because they are the same kind of
// thing: something done to the window rather than to what it is looking at.
// A panel over the window: help, the rules, the languages.
//
// One component because all three are the same thing — a card that opens over
// the list, closes on Escape or on a click outside, and does not move what is
// under it. The page's `.sheet`, at the page's size.
component Sheet inherits Rectangle {
    in property <string> title;
    in property <bool> open;

    // Placed by whoever puts it in the window: a component cannot read its
    // own parent's size in Slint, and hard-coding one here would be a panel
    // that only fits the window it was written against.
    in property <length> room-w;
    in property <length> room-h;

    visible: root.open;
    x: root.room-w - self.width - 20px;
    y: 64px;
    width: min(400px, root.room-w - 40px);
    height: min(560px, root.room-h - 120px);
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: 4px;
    // **No `z`.** It was here to put the panel over the list, which it did —
    // and Slint hoists an element with a `z` into a pass of its own, where the
    // hit test does not follow it. The panel drew on top and every press went
    // through it to whatever was underneath: not one tick, × or button in any
    // of the three panels had ever worked. Being the last child is what puts
    // it on top, and the panels are the window's last three children.
    

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        Text {
            text: root.title;
            color: Theme.ink;
            font-size: 13px;
            font-weight: 650;
            letter-spacing: 2px;
            height: 20px;
        }

        @children
    }
}

component Tool inherits Rectangle {
    in property <string> glyph;
    in property <bool> on;
    callback clicked();

    width: 18px;
    height: 18px;
    border-width: 1px;
    border-radius: 3px;
    border-color: root.on ? Theme.q-key : touch.has-hover ? Theme.ink-3 : Theme.line;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.glyph;
        color: root.on ? Theme.q-key : touch.has-hover ? Theme.ink : Theme.ink-3;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

/// A button with a word on it, for the selection bar.
///
/// The page's own: quiet until the pointer is over it, and the one that opens
/// several windows turns the colour of a question while it is asking.
component Push inherits Rectangle {
    in property <string> label;
    in property <bool> asking;
    callback clicked();

    width: text.preferred-width + 24px;
    height: 26px;
    border-width: 1px;
    border-radius: 3px;
    border-color: root.asking ? Theme.q-key : touch.has-hover ? Theme.ink-3 : Theme.line;
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    text := Text {
        text: root.label;
        color: root.asking ? Theme.q-key : touch.has-hover ? Theme.ink : Theme.ink-2;
        font-size: Fonts.small;
        vertical-alignment: center;
        horizontal-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

/// One line of the skip list: a box that says whether it is in force, the
/// thing being skipped, and — where this window is allowed to — a way to
/// delete it.
/// One way of running Scour, and what choosing it would do.
///
/// **The doing is a second press.** Two of the three start something — a
/// terminal, a program that listens on a port — and a list where one press
/// starts a listener is a list nobody can read safely. So a press arms the
/// row and says what will happen; the button beside the sentence is the
/// thing that does it.
component FaceRow inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <string> aside;
    in property <bool> here;
    in property <bool> armed;
    in property <bool> ready: true;
    in property <string> go;
    callback picked();
    callback confirmed();

    height: layout.preferred-height;
    border-radius: 3px;
    background: root.armed ? Theme.hover : touch.has-hover && root.ready ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            if (root.ready) {
                root.picked();
            }
        }
    }

    layout := VerticalLayout {
        padding: 6px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            height: 20px;

            Text {
                text: root.here ? "●" : "○";
                color: root.here ? Theme.q-key : Theme.ink-3;
                font-size: 11px;
                vertical-alignment: center;
                width: 12px;
            }
            Text {
                text: root.label;
                color: root.ready ? Theme.ink : Theme.ink-3;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.aside;
                color: Theme.ink-3;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        // The sentence and the button appear together, because the sentence is
        // what the button is asking permission for.
        if root.armed: HorizontalLayout {
            spacing: 8px;
            padding-left: 20px;

            Text {
                text: root.note;
                color: Theme.ink-2;
                font-size: 11px;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Push {
                    label: root.go;
                    asking: true;
                    clicked => {
                        root.confirmed();
                    }
                }
            }
        }
    }
}

component RuleRow inherits Rectangle {
    in property <string> value;
    in property <string> word;
    in property <bool> off;
    in property <bool> removable;
    callback toggled();
    callback dropped();

    height: 24px;
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            root.toggled();
        }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 8px;

        // The box is the whole row's business, so the row is the target: these
        // are short strings and a thirteen-pixel box beside them is a hard
        // thing to hit.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 12px;
                height: 12px;
                border-width: 1px;
                border-radius: 2px;
                border-color: root.off ? Theme.line : Theme.q-key;
                background: root.off ? transparent : Theme.q-key;

                Text {
                    text: root.off ? "" : "✓";
                    color: Theme.panel;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        Text {
            text: root.value;
            color: root.off ? Theme.ink-3 : Theme.ink-2;
            font-family: Fonts.mono;
            font-size: 11.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.off: Text {
            text: root.word;
            color: Theme.q-bad;
            font-size: 11px;
            vertical-alignment: center;
        }

        if root.removable: Rectangle {
            width: 18px;
            border-radius: 3px;
            background: drop.has-hover ? Theme.selection : transparent;

            drop := TouchArea {
                clicked => {
                    root.dropped();
                }
            }

            Text {
                text: "×";
                color: drop.has-hover ? Theme.q-bad : Theme.ink-3;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
    }
}

component Head inherits Rectangle {
    in property <string> text;
    in property <string> sort;
    in property <string> sorted-by;
    // **What the scrollbar is about.** The model is a window of about forty
    // rows that slides; a view sized from the model describes the window, so
    // five million rows read as forty. These two say how long the list really
    // is and where the window sits in it.
    in property <int> total-rows;
    in property <int> window-offset;
    in property <length> w;
    // Which column this is, for remembering what it was dragged to. Not `id`,
    // which Slint keeps for element names, and not `col`, which the grid loop
    // below already uses.
    in property <string> which;
    callback dragged(string, length);
    // `right` alone collides with the alignment enum of the same name.
    in property <bool> align-right;
    callback clicked(string);

    // A width, not a stretch: the numbers are worked out once by the window
    // so that every row and this header agree on them.
    width: root.w;

    // **The grip is the edge, and it is 7px wide.** Narrower than that and it
    // is a target people miss; wider and it eats the heading beside it. The
    // page uses the same idea and the same feel: the column follows the
    // pointer while the button is down, and what it lands on is kept.
    grip := TouchArea {
        x: parent.width - 4px;
        width: 7px;
        height: parent.height;
        mouse-cursor: col-resize;

        moved => {
            if (self.pressed) {
                root.dragged(root.which, self.mouse-x - self.pressed-x);
            }
        }
    }

    if grip.has-hover || grip.pressed: Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.focus;
    }

    TouchArea {
        clicked => { root.clicked(root.sort); }
        Text {
            width: parent.width;
            // The arrow is drawn in the text rather than beside it: a
            // separate glyph has to be laid out, and a heading that shifts
            // sideways when it becomes the sort is a heading that flickers.
            text: root.sorted-by == root.sort ? root.text + " ▾" : root.text;
            color: root.sorted-by == root.sort ? Theme.ink-2 : Theme.ink-3;
            font-size: 10px;
            font-weight: 650;
            letter-spacing: 1.4px;
            horizontal-alignment: root.align-right ? right : left;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A name with the match picked out. Monospace, like the page: a file name is
// read character by character — an `l` against a `1`, a run of digits — and a
// proportional face makes that work.
component Marked inherits HorizontalLayout {
    in property <string> pre;
    in property <string> hit;
    in property <string> post;
    in property <brush> colour: Theme.ink;
    spacing: 0px;

    Text {
        text: root.pre;
        color: root.colour;
        font-family: Fonts.mono;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }

    // Not a conditional element: one of those is left out of the parent's
    // `spacing` and the name would shift sideways the moment a match appears.
    // An empty `Text` costs a layout slot and draws nothing.
    Rectangle {
        background: root.hit == "" ? transparent : Theme.mark;
        border-radius: 2px;
        width: label.preferred-width;
        // Kept to the text's own height: left to itself the wash filled the
        // layout slot and stood taller than the row it is in, which reads as
        // a box drawn over the name rather than under it.
        height: label.preferred-height;
        y: (parent.height - self.height) / 2;
        label := Text {
            text: root.hit;
            color: Theme.mark-ink;
            font-family: Fonts.mono;
        font-size: 13px;
            vertical-alignment: center;
        }
    }

    Text {
        text: root.post;
        color: root.colour;
        font-family: Fonts.mono;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }

    // Eats the rest of the width so the name stays left and the columns after
    // it do not float.
    Rectangle { }
}

export component MainWindow inherits Window {
    title: "Scour";
    background: Theme.ground;
    preferred-width: 1100px;
    preferred-height: 680px;
    min-width: 560px;
    min-height: 320px;

    // --- what Rust sets ---------------------------------------------------
    in property <[Row]> rows;
    in property <[Span]> spans;
    in property <[Facet]> facets;
    in property <[Facet]> scopes;
    in property <[Facet]> sizes;
    in property <string> scope-heading;
    in property <string> size-heading;
    in property <[Bar]> bars;
    // The tallest bar, so every other one is drawn as a share of it. Computed
    // in Rust: a max over a Slint model is a loop per bar per frame.
    in property <int> bar-peak: 1;
    in property <string> ribbon-label;
    in property <string> ribbon-hint;
    in property <string> axis-oldest;
    in property <string> axis-year;
    in property <string> axis-month;
    in property <string> axis-week;
    in property <string> axis-today;
    in property <string> meter;
    // The same line in pieces, when it is the numeric one. See the meter row.
    in property <string> meter-count;
    in property <string> meter-ms;
    in property <string> meter-rows;
    in property <string> holding;
    /// Something the window did, said until the next keystroke.
    ///
    /// Not the meter, which every answer rewrites — with a live list that is
    /// several a second, and the line saying where a file was written was gone
    /// before it could be read. Not the hint either: that is the query box's
    /// placeholder and is invisible the moment anything is typed.
    in property <string> note;
    in property <string> hint;
    in property <bool> busy;
    in property <string> scope-label;

    // The columns, handed in from `scour-ui` so that this window and the
    // browser page cannot disagree about what they are called or how wide
    // they start. See `dress()` in `main.rs`.
    in property <string> head-name;
    in property <string> head-kind;
    in property <string> head-path;
    in property <string> head-mtime;
    in property <string> head-size;
    in property <length> w-name;
    in property <length> w-kind;
    in property <length> w-path;
    in property <length> w-mtime;
    in property <length> w-size;
    // **The grid counts lines, not rows.** A tile view puts several results on
    // one scrolled line, so everything the virtual list rests on — how many
    // fit, which one is on top, how far a page moves — is counted in lines and
    // converted at the edges. Getting this wrong does not look wrong; it
    // scrolls wrong, which is harder to notice and worse to use.
    out property <bool> grid: root.view-mode != "detail";
    out property <length> tile-w: root.view-mode == "large" ? 132px : 96px;
    out property <length> tile-h: root.view-mode == "large" ? 172px : 104px;
    out property <length> pic: root.view-mode == "large" ? 110px : 52px;
    out property <int> per-line: max(1, Math.floor(
        (root.width - root.chrome - 40px) / root.tile-w));
    /// The tiles, a line at a time.
    ///
    /// **A model of models, and that is the whole of the lesson.** The first
    /// tile view laid itself out by looping over a *count* and indexing into
    /// the rows — which builds every element at once, so `ListView` stopped
    /// being lazy and the list stopped fetching. A line is a model now, so
    /// the view asks for the lines it is about to draw and nothing else.
    in property <[[Row]]> lines;

    // ----------------------------------------------------------------
    // The preview panel: a third column holding one row.
    //
    // **A mode, not a glance.** It stays open and follows whatever the
    // selection lands on, which is Everything's preview pane; the browser
    // page's is the same panel with the same facts in the same order. What
    // is drawn in it depends on what the service says the file *is* — a
    // picture, the head of some text, or a line saying neither.
    // ----------------------------------------------------------------
    in-out property <bool> peeking;
    in property <string> peek-name;
    in property <string> peek-path;
    /// The picture, when the file is one and it could be read.
    in property <image> peek-shot;
    /// Whether `peek-shot` holds one — asked as a flag rather than of the
    /// image, for the reason in `Row::shot`.
    in property <bool> peek-has-shot;
    /// The head of the file, when it is text.
    in property <string> peek-text;
    /// Said instead of either, when there is neither.
    in property <string> peek-note;
    in property <[Fact]> peek-facts;
    in property <string> peek-close-title;
    callback peek-toggled();

    // Which column the list is ordered by, as the protocol's own word.
    in property <string> sorted-by;
    // **What the scrollbar is about.** The model is a window of about forty
    // rows that slides; a view sized from the model describes the window, so
    // five million rows read as forty. These two say how long the list really
    // is and where the window sits in it.
    in property <int> total-rows;
    in property <int> window-offset;

    // **The widths are computed once, here, and every row is handed the same
    // numbers.** A `HorizontalLayout` per row works out its own stretch from
    // its own content, so a wide name in row three pushed that row's kind
    // column right while row four's stayed put — a table whose columns do not
    // line up is not a table. The browser page gets this from `<table>`; here
    // it has to be said.
    //
    // Three columns keep the width `scour-ui` gives them. What is left over
    // goes to the two that hold text, and the location gets more of it because
    // a path is longer than a name and elides worse.
    // **Worked out from the window's own width, not the list's.** Asking the
    // list how wide it is makes the rows' widths depend on a layout that
    // depends on the rows' widths, and Slint refuses that at build time. The
    // pieces between the window edge and the list are all fixed and known: the
    // card's 20px margins, its 1px border, the 186px rail with its divider,
    // and the list's own 12px padding on each side.
    // **And the scrollbar's own lane.** It is drawn over the list rather than
    // beside it, so without a gutter it sits on top of the last column — the
    // size column, whose digits are the ones that must not be cut. The page
    // says `scrollbar-gutter: stable` for the same reason; here it is 14px
    // taken off the width the columns divide up, and the header loses it too
    // so the two stay in line.
    property <length> chrome: 40px + 2px + 186px + 1px + 24px + 14px;
    property <length> gaps: 8px * 4;
    property <length> flex: max(240px,
        root.width - root.chrome - root.gaps - root.w-kind - root.w-mtime - root.w-size);
    // **What a person dragged wins over what was computed.** Zero means "not
    // chosen", which is how the settings file says it too — a width of zero is
    // not a column somebody wanted, it is a column nobody has touched.
    in-out property <length> uw-name;
    in-out property <length> uw-kind;
    in-out property <length> uw-path;
    in-out property <length> uw-mtime;
    in-out property <length> uw-size;
    out property <length> cw-name: root.uw-name > 0 ? root.uw-name : root.flex * 0.44;
    out property <length> cw-path: root.uw-path > 0 ? root.uw-path : root.flex * 0.56;
    out property <length> cw-kind: root.uw-kind > 0 ? root.uw-kind : root.w-kind;
    out property <length> cw-mtime: root.uw-mtime > 0 ? root.uw-mtime : root.w-mtime;
    out property <length> cw-size: root.uw-size > 0 ? root.uw-size : root.w-size;
    // The two tab words, from the catalogue like every other visible string.
    in property <string> tab-search;
    in property <string> tab-report;
    /// How many rows would fit, plus a little to scroll into.
    ///
    /// Reported by the window rather than guessed by Rust, because only the
    /// window knows how tall it is — and it changes when somebody drags the
    /// edge. Every row fetched costs a path rebuilt in the engine and six
    /// strings allocated here, so asking for two hundred to draw twenty was
    /// paying nine tenths of that for nothing.
    // **Counted in rows in both views**, because what fetches them counts in
    // rows: a line of tiles is `per-line` results, and the arithmetic that
    // converts is here rather than in six places that would each get it right
    // separately.
    out property <int> visible-rows: root.grid
        ? (Math.floor(tiles.height / root.tile-h) + 2) * root.per-line
        : max(20, Math.floor(list.height / Theme.row-height) + 12);
    // --- the scrollbar ----------------------------------------------------
    //
    // **Drawn by this window, in a lane of its own.** The style's own bar is a
    // two-pixel hairline drawn *over* the list, and both halves of that were
    // wrong here: it is invisible against a dark panel, and it sits on the
    // size column — whose digits are the ones that must not be covered. A
    // gutter cannot fix the second half, because a column somebody has dragged
    // wider makes the rows wider than the list and the overlay lands on them
    // wherever the gutter is.
    //
    // So the list gives up 14px and the bar gets them. The arithmetic is the
    // flickable's own: how far there is to scroll, how much of it is on
    // screen, and where in it the viewport currently sits.
    property <length> sb-inset: 4px;
    property <length> sb-reach: root.grid ? tiles.viewport-height : list.viewport-height;
    property <length> sb-shown: root.grid ? tiles.visible-height : list.visible-height;
    property <length> sb-span: max(0px, root.sb-reach - root.sb-shown);
    property <length> sb-track: root.sb-shown - 2 * root.sb-inset;
    /// Never shorter than this, however long the result is. Two and a half
    /// million rows would otherwise put a thumb on screen too small to hit.
    property <length> sb-thumb: root.sb-span <= 0px ? 0px
        : max(36px, root.sb-track * root.sb-shown / root.sb-reach);
    property <length> sb-travel: max(0px, root.sb-track - root.sb-thumb);
    property <length> sb-at: 0px - (root.grid ? tiles.viewport-y : list.viewport-y);
    property <length> sb-y: root.sb-inset + (root.sb-span <= 0px ? 0px
        : root.sb-travel * min(1.0, max(0.0, root.sb-at / root.sb-span)));

    /// Put the thumb's top at `y` and take the list with it.
    function scroll-thumb-to(y: length) {
        if (root.sb-travel <= 0px) {
            return;
        }
        root.scroll-to(root.sb-span * min(1.0, max(0.0, (y - root.sb-inset) / root.sb-travel)));
    }

    /// Put the list back to the top, or a measured distance down it.
    ///
    /// **A function rather than a property aliased to `viewport-y`.** The
    /// scroll position is the `ListView`'s to keep — it corrects it as it
    /// measures rows, clamps it at both ends, and hands it to the scrollbar.
    /// Two-way binding it out to the window put a second owner on it; setting
    /// it is a thing the window does twice, and only ever on purpose.
    public function scroll-to(down: length) {
        list.viewport-y = 0px - down;
        tiles.viewport-y = 0px - down;
        paper.viewport-y = 0px - down;
    }
    /// The first row of the result the list is showing.
    ///
    /// **What the window polls.** The model can say "I was asked for a row I
    /// do not hold", but only if the view draws that row — and once a page has
    /// landed somewhere the eye is not, it never does, which is a list that
    /// loads its first page and then stops. This is the position itself, read
    /// off the viewport, so the fetch decision never depends on a miss being
    /// reported.
    /// Scroll the rail from outside, for `SCOUR_GUI_RAIL` — which is how
    /// "can the scopes be reached" is checked without a hand on a wheel.
    public function scroll-rail(down: length) {
        railview.viewport-y = 0px - down;
    }
    out property <int> first-row: root.grid
        ? max(0, Math.floor((0px - tiles.viewport-y) / root.tile-h)) * root.per-line
        : max(0, Math.floor((0px - list.viewport-y) / Theme.row-height));
    /// The list moved by at least one row.
    ///
    /// **Why a change handler and not only the timer.** A timer that polls
    /// often enough to be invisible is a timer that wakes the process sixty
    /// times a second for the rest of the day; one that is cheap enough to
    /// leave running adds its own period to every fetch, and at 100ms that is
    /// most of the wait. This fires only while somebody is scrolling, and it
    /// fires at once. The timer stays as the backstop for everything that
    /// changes what is visible without moving the list — a resize, a window
    /// that grew.
    callback moved();
    changed first-row => {
        root.moved();
    }
    // The query as Rust folded it back — set only when Rust changes the text
    // itself (a facet click), never on every keystroke, or the caret jumps.
    in-out property <string> query;
    in-out property <int> selected: 0;
    in-out property <string> active-facet;

    // --- what Rust listens for --------------------------------------------
    callback query-changed(string);
    callback activated(int);
    callback reveal(int);
    callback copy-path(int);
    callback facet-clicked(string);
    callback sort-by(string);
    callback tool-clicked(string);
    callback view-clicked(string);
    in-out property <string> view-mode: "detail";
    // --- the report -------------------------------------------------------
    //
    // The second tab: what a folder weighs, where the weight sits, and how old
    // it is. Every number in it is the service's — this window formats and
    // draws, and computes nothing about a disk.
    in-out property <string> tab: "search";
    /// The scope, one segment a button, so any ancestor is one press away.
    in property <[Facet]> crumb;
    in property <string> report-total;
    in property <string> report-files;
    in property <string> report-stale;
    in property <string> report-took;
    in property <[Kid]> kids;
    in property <string> kids-empty;
    /// How wide the age bar is. Fixed, because six widths taken from the width
    /// of the layout that holds them is a binding loop.
    property <length> age-bar: 260px;
    /// The six band words, in the order the colours run.
    in property <[string]> age-words;
    in property <string> head-kinds;
    in property <string> head-biggest;
    in property <string> head-jump;
    in property <string> head-dupes;
    in property <[Facet]> report-kinds;
    in property <[Facet]> report-big;
    in property <string> report-under;
    in property <string> jump-label;
    in property <string> jump-note;
    callback report-search();
    // Which way of running Scour to offer, and which one is running now.
    in-out property <string> armed-face;
    in property <string> faces-title;
    in property <string> face-window;
    in property <string> face-window-aside;
    in property <string> face-tui;
    in property <string> face-tui-note;
    in property <string> face-tui-aside;
    in property <string> face-web;
    in property <string> face-web-note;
    in property <bool> face-tui-ready;
    in property <string> face-go;
    callback face-picked(string);
    // The same file, several times over.
    in property <bool> dupes-open;
    in property <string> dupes-show;
    in property <string> dupes-hide;
    in property <string> dupes-sum;
    in property <string> dupes-note;
    in property <string> dupes-confirm;
    in property <[string]> dupe-floors;
    in property <int> dupe-floor;
    in property <[Dupe]> dupes;
    callback dupes-toggled();
    callback dupes-floored(int);
    callback dupes-read();
    in property <string> head-folder;
    in property <string> head-age;
    in property <string> head-share;
    in property <string> head-files;
    callback report-open(string);

    // Which panel is open, if any: "", "help", "language", "rules".
    in-out property <string> panel: "";
    in property <string> help-title;
    in property <string> help-body;
    in property <string> lang-title;
    in property <string> rules-title;
    in property <string> language;
    in property <[Facet]> languages;
    in property <[Rule]> rules-added;
    in property <[Rule]> rules-config;
    in property <[Rule]> rules-builtin;
    in property <string> rules-added-title;
    in property <string> rules-added-note;
    in property <string> rules-config-title;
    in property <string> rules-config-note;
    in property <string> rules-builtin-title;
    in property <string> rules-builtin-note;
    in property <string> rules-hint;
    in property <string> rules-add;
    in property <string> rules-off-word;
    callback rule-dropped(string, string);
    callback rule-added(string);
    callback language-picked(string);
    callback rule-toggled(string);
    // --- the selection ----------------------------------------------------
    //
    // Several rows at once, and what is done with them is done to all of them:
    // the same thing the browser page does, and the same words for it. The
    // sentence is written in Rust because it is three counts and a size in a
    // language's own word order, and this window does not spell any of those.
    in property <int> picked;
    // The sentence in three pieces, because the count is drawn brighter than
    // the words around it and Slint has no rich text. The pieces come from
    // the catalogue's own `{n} selected`, split where the number goes — so a
    // language that puts the number last still gets it in the right place.
    in property <string> picked-pre;
    in property <string> picked-n;
    in property <string> picked-post;
    in property <string> pick-copy;
    in property <string> pick-folders;
    in property <string> pick-drop;
    in property <bool> pick-asking;
    /// row, adding, and taking the run from the last one picked.
    callback pick(int, bool, bool);
    callback pick-copied();
    callback pick-opened();
    callback pick-dropped();
    callback bar-clicked(int);
    callback column-dragged(string, length);
    // **No page callbacks.** The list is a model whose length is the whole
    // result, so there is no window for the view to slide and no anchor for it
    // to keep: it scrolls, and the window fetches what scrolled into sight.

    public function focus-query() {
        input.focus();
    }

    forward-focus: input;

    // **The window is a card on a ground, not a full-bleed panel.** Measured
    // off the browser one: 20px of ground all round, a 1px line, a 3px corner.
    // The shadow the page draws is left out — a compositor draws the window's
    // own, and two shadows read as a border.
    Rectangle {
        x: 20px;
        y: 20px;
        width: parent.width - 40px;
        height: parent.height - 40px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 3px;
        clip: true;

    VerticalLayout {
        spacing: 0px;

        // ------------------------------------------------------------------
        // The query line.
        //
        // One `TextInput`, one colour, and that is not a shortcut: Slint's
        // text input has no range colouring at all — upstream #9560 puts
        // editable text out of scope — so the coloured chips the mockup shows
        // need a second layer that does not exist yet.
        //
        // **And one colour is all there is.** This said the field was "painted
        // by the *kind* of what is in it instead, which is one property from
        // Rust" — there is no such property and never was; `input.color` is
        // `Theme.ink` whatever is typed. A mistyped field is searched for as
        // text and this window says nothing about it, where the browser one
        // marks it. Written down because a comment claiming a feature is how a
        // gap stops being looked for.
        // ------------------------------------------------------------------
        Rectangle {
            // 63px, and the numbers under it are the page's: 16px above the
            // box, 12px below, the box itself 26px of 20px monospace. The
            // query line is the largest text in either window on purpose —
            // it is the one thing a person is always looking at.
            height: 63px;
            background: Theme.panel;

            // The line between the query and what is under it. **It used to
            // brighten when the field had focus**, which was the only thing
            // saying so while the field had no edge of its own. The field has
            // one now, and two things saying "the keyboard is here" is one
            // more than a person can read: this went back to being a rule.
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 16px;
                padding-bottom: 12px;
                spacing: 12px;

                // The mark. Letter-spaced small capitals, the same as the page:
                // a name that sits still while everything beside it moves.
                Text {
                    text: "SCOUR";
                    color: Theme.ink-3;
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 3.4px;
                    vertical-alignment: center;
                }

                // The box and its placeholder, stacked. Slint's `TextInput`
                // has no placeholder of its own, so the hint is drawn under it
                // and hidden the moment anything is typed — which is how the
                // page does it too, and why the two look the same when empty.
                // **A box, because a line of text is not one.** The query was
                // twenty-pixel type on the window's own background with a rule
                // under the whole row: it read as a heading that happened to be
                // editable. A ground a shade off the panel, a border, and a
                // corner is the least that says "type here" — and the border
                // is where focus is said, which is the other half of what was
                // missing.
                field := Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.panel-2;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: input.has-focus ? Theme.focus : Theme.line;
                    animate border-color { duration: 120ms; }
                    // **One number, used by all three layers.** The coloured
                    // text, the placeholder and the invisible input have to
                    // line up character for character — that is what makes the
                    // colouring work — so where they start is a property
                    // rather than a figure written three times.
                    property <length> pad: 9px;

                    // **The colours are a layer under a transparent box.**
                    // Slint has no range colouring for editable text — the
                    // upstream issue puts it out of scope — and this is the
                    // browser page's own answer to the same limit: draw the
                    // query again, in colour, exactly under the real one, and
                    // let the caret and the selection show through. Both are
                    // the same monospace at the same size, so the two line up
                    // character for character.
                    HorizontalLayout {
                        x: field.pad;
                        width: parent.width - field.pad * 2;
                        alignment: start;
                        for sp[i] in root.spans: Text {
                            text: sp.text;
                            font-family: Fonts.mono;
                            font-size: 20px;
                            font-weight: 600;
                            vertical-alignment: center;
                            color: sp.role == 1 ? Theme.q-key
                                 : sp.role == 2 ? Theme.q-val
                                 : sp.role == 3 ? Theme.q-glob
                                 : sp.role == 4 ? Theme.q-not
                                 : sp.role == 5 ? Theme.q-bad
                                 : Theme.ink;
                        }
                    }

                    // **Hidden when there is anything to read, not when the
                    // box is empty.** Pressing a rail row puts its term in the
                    // filter slot rather than in the text, so the box stayed
                    // "empty" while the coloured layer under it said `dm:17d`
                    // — and the placeholder sat on top of it.
                    if root.spans.length == 0: Text {
                        x: field.pad;
                        width: parent.width - field.pad * 2;
                        text: root.hint;
                        color: Theme.ink-3;
                        font-family: Fonts.mono;
                        font-size: 20px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                input := TextInput {
                    // **The whole box, not the width of what is typed.** A
                    // child of a `Rectangle` gets its *preferred* size unless
                    // it is given one, and a text input's preferred width is
                    // its text — so this was a few characters wide, sitting at
                    // the left of a field that looked like a field. Everything
                    // that reads as broken about a text box followed from it:
                    // no pointer over the empty part, therefore no I-beam;
                    // nothing to click, therefore no way to put the caret
                    // anywhere; and clicking what looked like the field did
                    // nothing at all. Slint sets the I-beam itself when the
                    // pointer is over a `TextInput` — it simply was not over
                    // one.
                    x: field.pad;
                    width: parent.width - field.pad * 2;
                    height: parent.height;
                    text <=> root.query;
                    // Invisible ink: what the reader sees is the coloured layer
                    // underneath. The caret is drawn by the input itself and is
                    // not affected, which is the whole reason this works.
                    color: transparent;
                    font-size: 20px;
                    font-weight: 600;
                    font-family: Fonts.mono;
                    single-line: true;
                    vertical-alignment: center;
                    // **Two pixels, and said here.** The default comes from a
                    // style, and this window links none — a caret that is
                    // sometimes a hairline and sometimes nothing is not a
                    // thing to leave to a default. At twenty pixels of
                    // monospace, one pixel is a caret you look for.
                    text-cursor-width: 2px;
                    selection-background-color: Theme.selection;
                    selection-foreground-color: Theme.ink;

                    edited => {
                        root.query-changed(self.text);
                    }

                    // Down and up move through the results without leaving the
                    // field, which is the whole interaction: type, glance,
                    // press Enter. Taking focus away to a list and back is what
                    // makes a launcher feel slow.
                    key-pressed(e) => {
                        if (e.text == Key.DownArrow) {
                            root.selected = min(root.selected + 1, root.rows.length - 1);
                            if ((root.selected + 1) * Theme.row-height + list.viewport-y
                                > list.visible-height) {
                                list.viewport-y = list.visible-height
                                    - (root.selected + 1) * Theme.row-height;
                            }
                            return accept;
                        }
                        if (e.text == Key.UpArrow) {
                            root.selected = max(root.selected - 1, 0);
                            if (root.selected * Theme.row-height + list.viewport-y < 0px) {
                                list.viewport-y = 0px - root.selected * Theme.row-height;
                            }
                            return accept;
                        }
                        // **A screenful at a time, and the ends.** The arrows
                        // were the only way down a two-million-row list from
                        // the keyboard; the terminal has had these since it
                        // was written and the window is the one that was
                        // behind.
                        if (e.text == Key.PageDown || e.text == Key.PageUp) {
                            root.selected = clamp(
                                root.selected + (e.text == Key.PageDown ? root.visible-rows : -root.visible-rows),
                                0,
                                root.rows.length - 1);
                            list.viewport-y = min(0px,
                                -(root.selected * Theme.row-height) + list.visible-height / 2);
                            return accept;
                        }
                        if (e.text == Key.Home || e.text == Key.End) {
                            root.selected = e.text == Key.Home ? 0 : root.rows.length - 1;
                            list.viewport-y = e.text == Key.Home
                                ? 0px
                                : min(0px, list.visible-height - root.rows.length * Theme.row-height);
                            return accept;
                        }
                        if (e.text == Key.Return) {
                            root.activated(root.selected);
                            return accept;
                        }
                        if (e.text == Key.Escape && root.panel != "") {
                            // A panel first: Escape closes what is on top,
                            // which is the one thing every window agrees on.
                            root.panel = "";
                            return accept;
                        }
                        if (e.text == Key.Escape && root.picked > 0) {
                            // Then the selection, before the query: dropping
                            // what is picked is the smaller undo, and the one
                            // somebody pressing Escape usually means.
                            root.pick-dropped();
                            return accept;
                        }
                        if (e.text == Key.Escape) {
                            if (self.text == "") {
                                return accept;
                            }
                            self.text = "";
                            root.query-changed("");
                            return accept;
                        }
                        return reject;
                    }
                }

                }
            }
        }

        // ------------------------------------------------------------------
        // What is true of the whole window: how many, how long, how big the
        // index is. **Above the list, not below it**, which is where the page
        // puts it — the numbers answer "is this everything?" and that question
        // is asked before reading, not after.
        // ------------------------------------------------------------------
        Rectangle {
            height: 30px;
            background: Theme.panel;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line-soft;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;

                // **The engine's work, in the page's colours.** Three
                // claims of different weight: how many out of how many is the
                // answer and is drawn as one, what it cost is the number this
                // program is about and wears the "today" hue, and how much of
                // the index was walked is context and stays quiet. One `Text`
                // in one ink said all three in the same voice.
                //
                // `meter` is what is left for the sentences that are not
                // numbers — connecting, refused, the service is not running —
                // and one or the other is showing, never both.
                if root.meter-count != "": HorizontalLayout {
                    spacing: 6px;

                    Text {
                        text: root.meter-count;
                        color: Theme.ink;
                        font-size: 12.5px;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-ms == "" ? "" : "·";
                        color: Theme.line;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-ms;
                        color: Theme.t0;
                        font-size: 11.5px;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-rows == "" ? "" : "·";
                        color: Theme.line;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-rows;
                        color: Theme.ink-3;
                        font-size: 11.5px;
                        letter-spacing: 0.2px;
                        vertical-alignment: center;
                    }
                }

                if root.meter-count == "": Text {
                    text: root.meter;
                    color: Theme.ink-3;
                    font-size: 11.5px;
                    letter-spacing: 0.2px;
                    vertical-alignment: center;
                }

                // What the service is holding, quieter than what it just
                // answered: one is about this query, the other about the index.
                Text {
                    text: root.holding == "" ? "" : "  ·  " + root.holding;
                    color: Theme.ink-3;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle { }

                if root.note != "": Text {
                    text: root.note;
                    color: Theme.q-key;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.busy: Text {
                    text: "…";
                    color: Theme.focus;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

                // The window's own controls, in the page's order: the two that
                // change what the index *is*, then the one that takes it
                // elsewhere, then help. A rule separates them from the view
                // switch — the only control here that changes what you are
                // reading rather than what the program is doing.
                Rectangle { width: 10px; }

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 2px;
                        Tool { glyph: "⇄"; clicked => { root.tool-clicked("faces"); } }
                        Tool { glyph: "文"; clicked => { root.tool-clicked("language"); } }
                        Tool { glyph: "⊘"; clicked => { root.tool-clicked("rules"); } }
                        Tool { glyph: "⤓"; clicked => { root.tool-clicked("export"); } }
                        Tool { glyph: "?"; clicked => { root.tool-clicked("help"); } }
                    }
                }

                Rectangle { width: 12px; }

                Rectangle {
                    width: 1px;
                    background: Theme.line;
                }

                Rectangle { width: 12px; }

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 2px;
                        // **With the view switch, not with the tools.** The
                        // rule beside these separates the controls that change
                        // what the program is doing from the ones that change
                        // what you are reading, and a preview panel is the
                        // second kind.
                        Tool {
                            glyph: "◫";
                            on: root.peeking;
                            clicked => {
                                root.peek-toggled();
                            }
                        }
                        Tool {
                            glyph: "≣";
                            on: root.view-mode == "detail";
                            clicked => {
                                root.view-clicked("detail");
                            }
                        }
                        Tool {
                            glyph: "▦";
                            on: root.view-mode == "icons";
                            clicked => {
                                root.view-clicked("icons");
                            }
                        }
                        Tool {
                            glyph: "▣";
                            on: root.view-mode == "large";
                            clicked => {
                                root.view-clicked("large");
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------------
        // Search and report. The second one is not built yet and says so by
        // being unclickable rather than by opening something empty.
        // ------------------------------------------------------------------
        Rectangle {
            height: 29px;
            background: Theme.panel;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                padding-left: 20px;
                spacing: 0px;
                alignment: start;

                Tab {
                    label: root.tab-search;
                    on: root.tab != "report";
                    clicked => {
                        root.tab = "search";
                    }
                }
                Tab {
                    label: root.tab-report;
                    on: root.tab == "report";
                    clicked => {
                        root.tab = "report";
                        // Asked for when it is looked at, not before: weighing
                        // a folder is a walk of everything under it.
                        root.report-open("");
                    }
                }
                Rectangle { }
            }
        }

        // ------------------------------------------------------------------
        // The report. What a folder weighs, where the weight sits, and how old
        // it is — the second tab, and the other half of what this program is
        // for: a search answers "where is it", this answers "what is all this".
        //
        // Capped to nothing while the search tab is showing, for the reason
        // the two lists are: an id inside an `if` is out of scope, and the
        // window has to be able to reach both.
        // ------------------------------------------------------------------
        // **One scrolling document**, the way the page's report is: the
        // panels and the duplicate list are below the fold on any window
        // shorter than a desk, and a report you cannot reach the bottom of is
        // a report with the answer cut off.
        paper := ScrollView {
            visible: root.tab == "report";
            max-height: root.tab == "report" ? 100000px : 0px;
            min-height: 0px;
            // **Said, not inferred.** A `ScrollView` does not learn how tall
            // its content is from a layout inside it: without this the
            // viewport is the view, there is no overflow, and the panels below
            // the fold are unreachable rather than merely off screen.
            viewport-height: sheet.preferred-height;

            sheet := VerticalLayout {
            // **Its natural height, not the view's.** A layout inside a
            // `ScrollView` stretches to fill it like any other child, so the
            // report was being squeezed into one screen — the panels cut off
            // at the bottom and nothing to scroll to, because there was no
            // overflow to scroll.
            height: self.preferred-height;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 10px;

            // The scope, one segment a button: any ancestor is one press away.
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                height: 22px;

                for step[i] in root.crumb: Rectangle {
                    width: label.preferred-width + 12px;
                    border-radius: 3px;
                    background: steptouch.has-hover ? Theme.hover : transparent;

                    steptouch := TouchArea {
                        clicked => {
                            root.report-open(step.token);
                        }
                    }

                    label := Text {
                        text: step.label;
                        color: i == root.crumb.length - 1 ? Theme.ink : Theme.ink-3;
                        font-family: Fonts.mono;
                        font-size: 11.5px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }

            // What the whole scope comes to, and three quieter facts under it.
            HorizontalLayout {
                spacing: 16px;
                alignment: start;

                Text {
                    text: root.report-total;
                    color: Theme.ink;
                    font-family: Fonts.mono;
                    font-size: 30px;
                    font-weight: 650;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.report-files;
                        color: Theme.ink-3;
                        font-size: Fonts.small;
                    }
                    Text {
                        text: root.report-stale;
                        color: Theme.ink-3;
                        font-size: Fonts.small;
                    }
                    Text {
                        text: root.report-took;
                        color: Theme.ink-3;
                        font-size: Fonts.small;
                    }
                }
            }

            // The children, heaviest first. The engine ordered them; this
            // draws what it was handed and sorts nothing.
            Rectangle {
                height: 24px;
                background: Theme.panel;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }

                HorizontalLayout {
                    spacing: 10px;

                    Text {
                        text: root.head-folder;
                        color: Theme.ink-3;
                        font-size: 10.5px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        width: 34%;
                    }
                    Text {
                        text: root.head-age;
                        color: Theme.ink-3;
                        font-size: 10.5px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        width: root.age-bar;
                    }
                    Text {
                        text: root.head-size;
                        color: Theme.ink-3;
                        font-size: 10.5px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 90px;
                    }
                    Text {
                        text: root.head-share;
                        color: Theme.ink-3;
                        font-size: 10.5px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 70px;
                    }
                    Text {
                        text: root.head-files;
                        color: Theme.ink-3;
                        font-size: 10.5px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 80px;
                    }
                }
            }

            // At most two dozen of them — `top` in the request says so — so
            // this is a plain repeater and the report scrolls as one document,
            // the way the page's does. A `ListView` here would be a second
            // scrolling thing inside the first.
            VerticalLayout {
                spacing: 0px;

                for kid[i] in root.kids: Rectangle {
                    height: 30px;
                    background: kidtouch.has-hover ? Theme.hover : transparent;

                    kidtouch := TouchArea {
                        clicked => {
                            root.report-open(kid.path);
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        Text {
                            text: kid.name;
                            color: Theme.q-key;
                            font-family: Fonts.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            width: 34%;
                        }

                        // The bytes by age, as one bar. The same six colours
                        // the rows' dates and the ribbon use, so a wall of
                        // orange means the same thing everywhere in the window.
                        //
                        // **Placed, not laid out.** Six widths taken from the
                        // width of the thing that holds them is a binding
                        // loop, and Slint refuses it at build time: a layout
                        // asks its children how wide they want to be, and they
                        // were answering "as wide as you are".
                        VerticalLayout {
                            alignment: center;
                            width: root.age-bar;
                            Rectangle {
                                height: 12px;
                                Rectangle {
                                    x: 0;
                                    width: root.age-bar * kid.a0;
                                    height: parent.height;
                                    background: Theme.t0;
                                }
                                Rectangle {
                                    x: root.age-bar * kid.a0;
                                    width: root.age-bar * kid.a1;
                                    height: parent.height;
                                    background: Theme.t1;
                                }
                                Rectangle {
                                    x: root.age-bar * (kid.a0 + kid.a1);
                                    width: root.age-bar * kid.a2;
                                    height: parent.height;
                                    background: Theme.t2;
                                }
                                Rectangle {
                                    x: root.age-bar * (kid.a0 + kid.a1 + kid.a2);
                                    width: root.age-bar * kid.a3;
                                    height: parent.height;
                                    background: Theme.t3;
                                }
                                Rectangle {
                                    x: root.age-bar * (kid.a0 + kid.a1 + kid.a2 + kid.a3);
                                    width: root.age-bar * kid.a4;
                                    height: parent.height;
                                    background: Theme.t4;
                                }
                                Rectangle {
                                    x: root.age-bar * (kid.a0 + kid.a1 + kid.a2 + kid.a3 + kid.a4);
                                    width: root.age-bar * kid.a5;
                                    height: parent.height;
                                    background: Theme.t5;
                                }
                            }
                        }

                        Text {
                            text: kid.size;
                            color: Theme.ink;
                            font-family: Fonts.mono;
                            font-size: 12px;
                            font-weight: 650;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 90px;
                        }
                        Text {
                            text: kid.share;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 70px;
                        }
                        Text {
                            text: kid.files;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 80px;
                        }
                    }
                }
            }

            if root.kids.length == 0: Text {
                text: root.kids-empty;
                color: Theme.ink-3;
                font-size: Fonts.small;
                height: 40px;
                vertical-alignment: center;
            }

            // What the six colours mean, said once.
            HorizontalLayout {
                height: 30px;
                spacing: 14px;
                alignment: start;

                for word[i] in root.age-words: HorizontalLayout {
                    spacing: 5px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 2px;
                            background: i == 0 ? Theme.t0 : i == 1 ? Theme.t1 : i == 2 ? Theme.t2
                                : i == 3 ? Theme.t3 : i == 4 ? Theme.t4 : Theme.t5;
                        }
                    }
                    Text {
                        text: word;
                        color: Theme.ink-3;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            // Three panels, the page's own: what kinds the weight is in, the
            // heaviest files under here, and the way from this folder into a
            // search scoped to it.
            HorizontalLayout {
                spacing: 12px;

                Rectangle {
                    background: Theme.panel-2;
                    border-width: 1px;
                    border-color: Theme.line-soft;
                    border-radius: 3px;
                    // Even thirds, and none of them narrower than the page's
                    // own floor: a panel that gives way to its neighbour ends
                    // up eliding the words it exists to show.
                    horizontal-stretch: 1;
                    min-width: 215px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        Text {
                            text: root.head-kinds;
                            color: Theme.ink-3;
                            font-size: 10.5px;
                            font-weight: 650;
                            letter-spacing: 1.2px;
                        }

                        for kind[i] in root.report-kinds: Rectangle {
                            height: 19px;

                            // The bar behind the words, as the page has it: a
                            // share is read from a length before it is read
                            // from a number.
                            Rectangle {
                                x: 0;
                                width: parent.width * kind.share;
                                height: parent.height;
                                background: Theme.line-soft;
                                border-radius: 2px;
                            }

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;

                                Text {
                                    text: kind.label;
                                    color: Theme.ink-2;
                                    font-size: 11.5px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: kind.count;
                                    color: Theme.ink-3;
                                    font-family: Fonts.mono;
                                    font-size: 11.5px;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    width: 72px;
                                }
                            }
                        }
                        Rectangle { }
                    }
                }

                Rectangle {
                    background: Theme.panel-2;
                    border-width: 1px;
                    border-color: Theme.line-soft;
                    border-radius: 3px;
                    // Even thirds, and none of them narrower than the page's
                    // own floor: a panel that gives way to its neighbour ends
                    // up eliding the words it exists to show.
                    horizontal-stretch: 1;
                    min-width: 215px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        Text {
                            text: root.head-biggest;
                            color: Theme.ink-3;
                            font-size: 10.5px;
                            font-weight: 650;
                            letter-spacing: 1.2px;
                        }

                        for big[i] in root.report-big: HorizontalLayout {
                            height: 19px;
                            spacing: 8px;

                            Text {
                                text: big.label;
                                color: Theme.ink-2;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: big.count;
                                color: Theme.ink;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                font-weight: 650;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                width: 76px;
                            }
                        }
                        Rectangle { }
                    }
                }

                Rectangle {
                    background: Theme.panel-2;
                    border-width: 1px;
                    border-color: Theme.line-soft;
                    border-radius: 3px;
                    // Even thirds, and none of them narrower than the page's
                    // own floor: a panel that gives way to its neighbour ends
                    // up eliding the words it exists to show.
                    horizontal-stretch: 1;
                    min-width: 215px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: root.head-jump;
                            color: Theme.ink-3;
                            font-size: 10.5px;
                            font-weight: 650;
                            letter-spacing: 1.2px;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "under:";
                                color: Theme.q-key;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.report-under;
                                color: Theme.ink-2;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            alignment: start;
                            Push {
                                label: root.jump-label;
                                clicked => {
                                    root.report-search();
                                }
                            }
                        }

                        Text {
                            text: root.jump-note;
                            color: Theme.ink-3;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Rectangle { }
                    }
                }
            }

            // The same file, several times over. Not run unasked: it is a walk
            // of every candidate, and looking at what a folder weighs should
            // not start one.
            HorizontalLayout {
                spacing: 10px;
                height: 30px;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.head-dupes;
                        color: Theme.ink-3;
                        font-size: 10.5px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.dupes-open ? root.dupes-hide : root.dupes-show;
                        clicked => {
                            root.dupes-toggled();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.dupes-sum;
                        color: Theme.ink-3;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { }

                for floor[i] in root.dupe-floors: VerticalLayout {
                    alignment: center;
                    Push {
                        label: floor;
                        asking: i == root.dupe-floor;
                        clicked => {
                            root.dupes-floored(i);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.dupes-confirm;
                        clicked => {
                            root.dupes-read();
                        }
                    }
                }
            }

            if root.dupes-open: Text {
                text: root.dupes-note;
                color: Theme.ink-3;
                font-size: 11.5px;
                wrap: word-wrap;
            }

            if root.dupes-open: VerticalLayout {
                spacing: 10px;

                for group[i] in root.dupes: VerticalLayout {
                    spacing: 2px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: group.size;
                            color: Theme.ink;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            font-weight: 650;
                        }
                        Text {
                            text: group.times;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                        }
                        Rectangle { }
                        Text {
                            text: group.certainty;
                            color: group.proven ? Theme.t1 : Theme.q-bad;
                            font-family: Fonts.mono;
                            font-size: 11px;
                        }
                    }
                    Text {
                        text: group.paths;
                        color: Theme.ink-3;
                        font-family: Fonts.mono;
                        font-size: 11px;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }
            }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            visible: root.tab != "report";
            max-height: root.tab == "report" ? 0px : 100000px;

            // --------------------------------------------------------------
            // The rail: what the matching set consists of.
            //
            // Every row is a `kind:` term and clicking one adds it to the
            // query rather than filtering behind the query's back — so what
            // is on screen is always exactly what the text says.
            // --------------------------------------------------------------
            Rectangle {
                // 186px and a shade darker than the list, both measured off
                // the page. The rail is a fixed track: it carries counts that
                // must not reflow while the list beside it does.
                width: 186px;
                background: Theme.panel-2;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.line;
                }

                // **Scrolled, because it is taller than the window.** Three
                // sections and thirteen kinds do not fit at 700px, and a rail
                // that simply grew pushed the time ribbon off the bottom of
                // the window — drawn, laid out, and nowhere to be seen.
                railview := ScrollView {
                    // **And it has to be told how tall it is.** A `ScrollView`
                    // does not learn that from a layout inside it: the
                    // viewport stayed the height of the view, so there was no
                    // overflow to scroll and the sections below the fold —
                    // the scopes, the sizes — were not cut off so much as
                    // unreachable. The same two lines the report needed.
                    viewport-height: rail.preferred-height;

                    rail := VerticalLayout {
                    height: self.preferred-height;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 0px;
                    padding-right: 0px;
                    spacing: 1px;
                    alignment: start;

                    // Letter-spaced small capitals, 10px — the page's section
                    // heading, and the only text in the window smaller than
                    // the counts it introduces.
                    // **Indented by a layout, not by an `x`.** Moving the
                    // text right while the box it is in stays where it was
                    // leaves the first glyph sitting on the edge that clips —
                    // the `T` of `Tür` came out with the left arm of its
                    // crossbar shaved off, which is a thing you see and cannot
                    // name until you know where to look.
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: root.scope-label;
                            color: Theme.ink-3;
                            font-size: 10px;
                            font-weight: 650;
                            letter-spacing: 1.8px;
                            overflow: elide;
                            height: 15px;
                        }
                    }

                    Rectangle { height: 8px; }

                    for f[i] in root.facets: FacetRow {
                        label: f.label;
                        count: f.count;
                        share: f.share;
                        on: root.active-facet == f.token;
                        clicked => { root.facet-clicked(f.token); }
                    }

                    // **Where, not what.** The scopes are this desktop's own
                    // folders — the service answers `places` because it runs
                    // where the files are, and a window guessing at
                    // `~/Documents` would be wrong in every language but one.
                    Rectangle { height: 12px; }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: root.scope-heading;
                            color: Theme.ink-3;
                            font-size: 10px;
                            font-weight: 650;
                            letter-spacing: 1.8px;
                            overflow: elide;
                            height: 15px;
                        }
                    }

                    Rectangle { height: 8px; }

                    for sc[i] in root.scopes: FacetRow {
                        label: sc.label;
                        count: sc.count;
                        share: sc.share;
                        on: root.active-facet == sc.token;
                        clicked => { root.facet-clicked(sc.token); }
                    }

                    // Three bands rather than a histogram: a size filter
                    // answers "what is taking the room" and "what is empty",
                    // and everything between is served better by sorting.
                    Rectangle { height: 12px; }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: root.size-heading;
                            color: Theme.ink-3;
                            font-size: 10px;
                            font-weight: 650;
                            letter-spacing: 1.8px;
                            overflow: elide;
                            height: 15px;
                        }
                    }

                    Rectangle { height: 8px; }

                    for sz[i] in root.sizes: FacetRow {
                        label: sz.label;
                        count: sz.count;
                        share: sz.share;
                        on: root.active-facet == sz.token;
                        clicked => { root.facet-clicked(sz.token); }
                    }
                    }

                }
            }

            // --------------------------------------------------------------
            // The results.
            // --------------------------------------------------------------
            VerticalLayout {
                spacing: 0px;
                // **Allowed to be narrower than its columns.** The five column
                // widths add up to more than a window, so this layout's own
                // minimum is wider than the space it is in — and a sibling
                // asking for three hundred and eighty pixels got fifty. The
                // list has always been free to be cut off on the right; saying
                // so is what lets the preview panel have its width.
                min-width: 0px;

                // Column headers, and each is a sort.
                //
                // **Five columns, the widths handed in from `scour-ui`.** The
                // browser page shows exactly these five in exactly this order,
                // and the order is the order of the question a person is
                // asking: what is it called, what kind of thing is it, where
                // does it live, when did it change, how big is it.
                Rectangle {
                    // 31px, off the page. Taller than a row on purpose: the
                    // header is a fixed edge the eye returns to.
                    height: 31px;
                    background: Theme.panel;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        Head { which: "name"; dragged(c, d) => { root.column-dragged(c, d); } text: root.head-name; sort: "name"; w: root.cw-name;
                               sorted-by: root.sorted-by; clicked(k) => { root.sort-by(k); } }
                        Head { which: "kind"; dragged(c, d) => { root.column-dragged(c, d); } text: root.head-kind; sort: "kind"; w: root.cw-kind;
                               sorted-by: root.sorted-by; clicked(k) => { root.sort-by(k); } }
                        Head { which: "path"; dragged(c, d) => { root.column-dragged(c, d); } text: root.head-path; sort: "path"; w: root.cw-path;
                               sorted-by: root.sorted-by; clicked(k) => { root.sort-by(k); } }
                        Head { which: "mtime"; dragged(c, d) => { root.column-dragged(c, d); } text: root.head-mtime; sort: "modified"; w: root.cw-mtime;
                               sorted-by: root.sorted-by; clicked(k) => { root.sort-by(k); } }
                        Head { which: "size"; dragged(c, d) => { root.column-dragged(c, d); } text: root.head-size; sort: "size"; w: root.cw-size; align-right: true;
                               sorted-by: root.sorted-by; clicked(k) => { root.sort-by(k); } }
                    }
                }

                list := ListView {
                    // The window draws its own, in the lane below. See `sb-`.
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    // Capped to nothing while the tiles are showing, rather
                    // than put behind an `if`: an id inside a conditional is
                    // out of scope for everything that has to read the list's
                    // position, and both views have to be readable.
                    visible: !root.grid;
                    // **And `min-height` with it.** A `ScrollView` asks for
                    // fifty pixels whatever it holds, so capping the height
                    // alone left the view that is not showing occupying a
                    // band of empty panel above the one that is.
                    min-height: 0px;
                    max-height: root.grid ? 0px : 100000px;

                    // **Over the model, not over a count.** A `for` on an
                    // integer builds every element at once, which took the
                    // virtualisation out of the list the moment the grid was
                    // added: two hundred rows became two hundred live
                    // elements, and scrolling stopped fetching. The model is
                    // what `ListView` knows how to be lazy about.
                    // **The view pulls.** `root.rows` is a model whose
                    // `row_count` is the whole result, so `ListView` sizes
                    // itself and its scrollbar from the real length and asks
                    // for exactly the rows it is about to draw. Nothing here
                    // places a row or moves a viewport any more.
                    for here[i] in root.rows: Rectangle {
                        height: Theme.row-height;
                        // **Only in the table.** A line of tiles holds several
                        // results, so painting the line for one of them lit up
                        // everything beside it — the selection has to be the
                        // tile, and it is, below.
                        //
                        // **And not animated.** This used to carry the arrival
                        // wash as well, on one `animate` of 1.6 seconds — so
                        // pressing a row faded the selection in over a second
                        // and a half, and running down the list with the arrows
                        // left a comet tail of half-lit rows behind the one
                        // actually selected. Selecting is not an event that
                        // happened *to* the list; it is where you are, and
                        // where you are is not a thing to animate. The browser
                        // page never did: its wash is a keyframe animation and
                        // its selection is a plain background.
                        background: (here.picked || i == root.selected) ? Theme.selection
                            : rowtouch.has-hover ? Theme.hover
                            : transparent;

                        // The wash, on its own layer and its own clock. It
                        // fades rather than staying — a permanent badge would
                        // still be there tomorrow — and it is translucent, so
                        // a row that is both new and selected shows both.
                        Rectangle {
                            background: here.fresh ? Theme.t0.with-alpha(0.22) : transparent;
                            animate background { duration: 1600ms; easing: ease-out; }
                        }

                        // **Where the keyboard is, which is not the same
                        // question as what is selected.** Pick three rows and
                        // all three fill blue; without this, the one the
                        // arrows will move from looks exactly like the two
                        // that will not. A ring rather than a fourth shade of
                        // the same blue — a shade says "more selected", which
                        // is not a thing, and this says "here".
                        //
                        // The focus colour, because that is what it is: the
                        // query field underlines itself in the same one.
                        if i == root.selected: Rectangle {
                            background: transparent;
                            border-width: 1px;
                            border-color: Theme.focus;
                        }

                        rowtouch := TouchArea {
                            clicked => {
                                root.selected = i;
                                root.focus-query();
                            }
                            double-clicked => {
                                root.selected = i;
                                root.activated(i);
                            }
                            // **Picking is a press, not a click**, because a
                            // click carries no modifiers here: plain replaces
                            // the selection, `Ctrl` adds one, `Shift` takes
                            // the run from the last one picked.
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down
                                    && e.button == PointerEventButton.left) {
                                    root.selected = i;
                                    root.pick(i, e.modifiers.control || e.modifiers.meta,
                                        e.modifiers.shift);
                                }
                                if (e.button == PointerEventButton.right
                                    && e.kind == PointerEventKind.down) {
                                    root.selected = i;
                                    root.copy-path(i);
                                }
                            }
                        }

                        Rectangle {
                            x: 0;
                            // **A fixed 3px.** It grew to 5 while a row was
                            // new, which put two marks for one event on top of
                            // each other and made a list of arrivals look like
                            // a list with a ragged edge. The arrival is the
                            // wash behind the row; the stripe is the age, and
                            // the age did not change.
                            width: 3px;
                            height: parent.height;
                            background: here.age == 0 ? Theme.t0 : here.age == 1 ? Theme.t1
                                 : here.age == 2 ? Theme.t2 : here.age == 3 ? Theme.t3
                                 : here.age == 4 ? Theme.t4 : Theme.t5;
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;

                            // **The kind's icon, and it has to be spelled out
                            // one kind at a time.** `@image-url` is resolved at
                            // build time, so there is no way to index into a
                            // set of them from a property — the alternative is
                            // loading fourteen SVGs at run time and handing
                            // each row an `image`, which is fourteen decodes
                            // and a cache to get wrong. Fourteen `if`s are
                            // fourteen comparisons per visible row, which at
                            // thirty rows is nothing.
                            //
                            // Tinted rather than drawn in colour: the files are
                            // the page's own, black on nothing, and the hue is
                            // `scour-ui`'s so the two windows agree.
                            VerticalLayout {
                                alignment: center;
                                width: 15px;
                            // **No picture here, and that is the owner's
                            // call.** A detail row is read as a name, a place
                            // and a date; fifteen pixels of photograph beside
                            // them is a thing to look at where nobody is
                            // looking. The grid is where a picture answers the
                            // question being asked, and that is where `thumb`
                            // is drawn — the browser page still puts one in
                            // its list, which is the one place these two
                            // deliberately differ.
                            if here.ktoken == "folder": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/folder.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "doc": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/doc.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "code": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/code.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "image": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/image.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "video": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/video.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "media": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/media.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "audio": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/audio.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "archive": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/archive.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "exec": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/exec.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "data": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/data.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "config": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/config.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "font": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/font.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "build": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/build.svg");
                                colorize: here.tint;
                            }
                            if here.ktoken == "file": Image {
                                width: 15px;
                                height: 15px;
                                source: @image-url("icons/file.svg");
                                colorize: here.tint;
                            }
                            }

                            // The name, with the match picked out. A folder is
                            // drawn in the query's key colour, which is what
                            // the page does: the one distinction worth a
                            // colour in a list of names is "this one opens".
                            // **The icon's 15px and its gap come out of this
                            // column, not out of the row.** They were an extra
                            // child beside the five the headings describe, so
                            // every row was 23px wider than the header above
                            // it: the list scrolled sideways under a bar
                            // nobody asked for, and each heading sat 23px to
                            // the left of the column it names. The page puts
                            // the icon inside the name cell for the same
                            // reason.
                            Marked {
                                pre: here.pre;
                                hit: here.hit;
                                post: here.post;
                                colour: here.is-dir ? Theme.q-key : Theme.ink;
                                width: max(0px, root.cw-name - 15px - 8px);
                            }

                            Text {
                                width: root.cw-kind;
                                text: here.kind;
                                color: Theme.ink-3;
                                font-size: Fonts.small;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                width: root.cw-path;
                                text: here.folder;
                                color: Theme.ink-3;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            // **The age is the date's colour, not a dot beside
                            // it.** The page paints the stamp itself, and it
                            // reads better: the eye is already there to find
                            // out when, so the answer and how-long-ago are one
                            // glance rather than two.
                            Text {
                                width: root.cw-mtime;
                                text: here.stamp;
                                font-family: Fonts.mono;
                                color: here.age == 0 ? Theme.t0 : here.age == 1 ? Theme.t1
                                     : here.age == 2 ? Theme.t2 : here.age == 3 ? Theme.t3
                                     : here.age == 4 ? Theme.t4 : Theme.t5;
                                font-size: Fonts.small;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                width: root.cw-size;
                                text: here.size;
                                color: Theme.ink-2;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // ------------------------------------------------------
                // The same results as tiles, when that is what was asked for.
                //
                // **A second list rather than a second shape for the first.**
                // A `ListView` lays out one repeater; two `for`s inside one of
                // them is not a thing it can be lazy about. So there are two,
                // each over its own model, and the one that is not showing is
                // capped to no height — which leaves both reachable by name,
                // where an `if` would put the active one's id out of scope.
                // ------------------------------------------------------
                tiles := ListView {
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    visible: root.grid;
                    min-height: 0px;
                    max-height: root.grid ? 100000px : 0px;

                    for line[i] in root.lines: Rectangle {
                        height: root.tile-h;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;

                            for cell[c] in line: Rectangle {
                                width: root.tile-w;
                                height: root.tile-h;
                                // **The tile is the selection, not the line.**
                                // A line holds several results, so painting the
                                // line for one of them lights up everything
                                // beside it.
                                // Instant, for the reason the table's rows are:
                                // see the comment there.
                                background: (cell.picked || (i * root.per-line + c) == root.selected)
                                    ? Theme.selection
                                    : tiletouch.has-hover ? Theme.hover
                                    : transparent;

                                // The arrival wash, on its own layer.
                                Rectangle {
                                    background: cell.fresh
                                        ? Theme.t0.with-alpha(0.22)
                                        : transparent;
                                    animate background { duration: 1600ms; easing: ease-out; }
                                }

                                // And where the keyboard is — see the table's
                                // rows for why a ring rather than a shade.
                                if (i * root.per-line + c) == root.selected: Rectangle {
                                    background: transparent;
                                    border-width: 1px;
                                    border-color: Theme.focus;
                                }

                                tiletouch := TouchArea {
                                    clicked => {
                                        root.selected = i * root.per-line + c;
                                        root.focus-query();
                                    }
                                    double-clicked => {
                                        root.selected = i * root.per-line + c;
                                        root.activated(root.selected);
                                    }
                                    pointer-event(e) => {
                                        if (e.kind != PointerEventKind.down) {
                                            return;
                                        }
                                        root.selected = i * root.per-line + c;
                                        if (e.button == PointerEventButton.right) {
                                            root.copy-path(root.selected);
                                        } else if (e.button == PointerEventButton.left) {
                                            root.pick(root.selected,
                                                e.modifiers.control || e.modifiers.meta,
                                                e.modifiers.shift);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 4px;
                                    alignment: center;

                                    // **The picture where there is one, the
                                    // kind's colour where there is not.** A
                                    // wall of squares is read by hue before it
                                    // is read by name; a wall of photographs
                                    // is read by the photographs, which is the
                                    // reason a tile view exists at all.
                                    Rectangle {
                                        height: root.pic;
                                        if cell.shot: Image {
                                            width: root.pic;
                                            height: root.pic;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: cell.thumb;
                                            // The whole picture, not a crop:
                                            // in a grid the shape of a
                                            // photograph is part of what
                                            // identifies it, and a cropped
                                            // wall of squares gives that up.
                                            image-fit: contain;
                                        }
                                        if cell.shot == false: Rectangle {
                                            width: root.pic * 0.55;
                                            height: root.pic * 0.55;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 5px;
                                            background: cell.tint;
                                            opacity: 0.5;
                                        }
                                    }

                                    Text {
                                        text: cell.pre + cell.hit + cell.post;
                                        color: cell.is-dir ? Theme.q-key : Theme.ink;
                                        font-family: Fonts.mono;
                                        font-size: root.view-mode == "large" ? 12px : 11px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        height: 30px;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // --------------------------------------------------------------
            // The scrollbar's lane. Beside the list, never over it — see the
            // `sb-` properties for why, and for the arithmetic.
            // --------------------------------------------------------------
            VerticalLayout {
                width: 14px;

                // Level with the column headings, and carrying their rule
                // across so the line under them does not stop short.
                Rectangle {
                    height: 31px;
                    background: Theme.panel;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }
                }

                Rectangle {
                    background: Theme.panel;

                    thumb := Rectangle {
                        x: 4px;
                        width: 6px;
                        y: root.sb-y;
                        height: root.sb-thumb;
                        border-radius: 3px;
                        // Quiet until it is wanted, like the page's own.
                        background: grab.pressed ? Theme.ink-2
                            : grab.has-hover ? Theme.ink-3 : Theme.line;
                        visible: root.sb-span > 0px;
                        animate background { duration: 120ms; }
                    }

                    grab := TouchArea {
                        // Where the thumb was when this press began.
                        property <length> from;

                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                // A press on the track takes the thumb to the
                                // pointer; a press on the thumb picks it up
                                // where it is. Either way the drag continues
                                // from there.
                                if (self.mouse-y < thumb.y
                                    || self.mouse-y > thumb.y + thumb.height) {
                                    root.scroll-thumb-to(self.mouse-y - thumb.height / 2);
                                }
                                self.from = thumb.y;
                            }
                        }

                        moved => {
                            root.scroll-thumb-to(self.from + self.mouse-y - self.pressed-y);
                        }
                    }
                }
            }

            // --------------------------------------------------------------
            // The preview panel.
            //
            // **Three hundred and eighty pixels, and shut by default.** Most
            // of what a list like this is used for is finding a path and
            // getting out of the way, and a panel that is always there costs
            // the list a third of its width to say something about one row.
            // The width and the bounds are `scour_ui::preview`'s, so the
            // browser page's panel is this one.
            // --------------------------------------------------------------
            if root.peeking: Rectangle {
                // **Min and max, not `width`.** The list beside it is five
                // columns of fixed width, so its own minimum is wider than the
                // window: a `width` here is a preference the layout is free to
                // squeeze, and it squeezed this to fifty pixels. A minimum is
                // not a preference.
                min-width: 380px;
                max-width: 380px;
                horizontal-stretch: 0;
                background: Theme.panel-2;

                Rectangle {
                    x: 0;
                    width: 1px;
                    height: parent.height;
                    background: Theme.line;
                }

                VerticalLayout {
                    padding-left: 1px;
                    spacing: 0px;

                    // The name, and the way out. The name **wraps rather than
                    // truncating**: the end of a name is what tells
                    // `rapor-v2.pdf` from `rapor-v3.pdf`, and a header has room
                    // for two lines. The page learned this the same way.
                    Rectangle {
                        height: 46px;
                        background: Theme.panel-2;

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.line;
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 8px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;

                            Text {
                                text: root.peek-name;
                                color: Theme.ink;
                                font-size: 12.5px;
                                font-weight: 600;
                                wrap: word-wrap;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                Tool {
                                    glyph: "×";
                                    clicked => {
                                        root.peek-toggled();
                                    }
                                }
                            }
                        }
                    }

                    // What can be shown of the file. One box, three answers.
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 80px;

                        if root.peek-has-shot: Image {
                            width: parent.width - 24px;
                            height: parent.height - 24px;
                            x: 12px;
                            y: 12px;
                            source: root.peek-shot;
                            // The whole picture: a preview is being looked at
                            // to decide whether this is the right file, and a
                            // crop can remove the part that answers it.
                            image-fit: contain;
                        }

                        if !root.peek-has-shot && root.peek-text != "": Flickable {
                            width: parent.width;
                            height: parent.height;
                            viewport-width: self.width;
                            viewport-height: body.preferred-height;

                            body := VerticalLayout {
                                padding: 12px;
                                alignment: start;
                                Text {
                                    text: root.peek-text;
                                    color: Theme.ink-2;
                                    font-family: Fonts.mono;
                                    font-size: 11.5px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if !root.peek-has-shot && root.peek-text == "": Text {
                            text: root.peek-note;
                            color: Theme.ink-3;
                            font-size: 11.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    // The facts. Below the picture rather than beside it,
                    // because a fact is read after the thing it is about.
                    // **Its own height, taken from what is in it.** A path
                    // wraps to four lines as readily as one, and a box sized
                    // by counting rows cut the last fact off. Asking the
                    // layout inside for its height is the way — asking a named
                    // child for `preferred-height` from its own parent is a
                    // circle, and Slint's answer to a circle is a panel that
                    // does not draw at all.
                    Rectangle {
                        vertical-stretch: 0;
                        background: Theme.panel;

                        Rectangle {
                            y: 0;
                            height: 1px;
                            background: Theme.line;
                        }

                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 9px;
                            padding-bottom: 9px;
                            spacing: 3px;
                            alignment: start;

                            for fact in root.peek-facts: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: fact.label;
                                    color: Theme.ink-3;
                                    font-size: 11px;
                                    width: 74px;
                                    overflow: elide;
                                }
                                Text {
                                    text: fact.value;
                                    color: Theme.ink-2;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------------
        // What is selected, and what can be done with it.
        //
        // Absent when nothing is: a bar that is always there is a strip of
        // window spent on a question nobody asked. The page puts it in the
        // same place and words it the same way.
        // ------------------------------------------------------------------
        if root.picked > 0 && root.tab != "report": Rectangle {
            height: 38px;
            background: Theme.panel-2;

            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            // **What is selected on the left, what can be done with it on the
            // right.** Not packed together at one end: the count is read and
            // the buttons are aimed at, and a reader's eye should not have to
            // travel past three buttons to find out how many.
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 0px;
                        Text {
                            text: root.picked-pre;
                            color: Theme.ink-3;
                            font-size: Fonts.small;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.picked-n;
                            color: Theme.ink;
                            font-size: Fonts.small;
                            font-weight: 650;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.picked-post;
                            color: Theme.ink-3;
                            font-size: Fonts.small;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { }

                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.pick-copy;
                        clicked => {
                            root.pick-copied();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.pick-folders;
                        asking: root.pick-asking;
                        clicked => {
                            root.pick-opened();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.pick-drop;
                        clicked => {
                            root.pick-dropped();
                        }
                    }
                }
            }
        }

        // ------------------------------------------------------------------
        // The time ribbon. 107px, off the page.
        //
        // Twenty-four bars on a logarithmic scale, so the last day, the last
        // week and the last year all have room on one screen — a linear one
        // spends twenty-three of them on "older than a month", which is the
        // part nobody is looking for. The edges come from `scour-ui`, which is
        // also where the page gets them.
        // ------------------------------------------------------------------
        Rectangle {
            visible: root.tab != "report";
            min-height: root.tab == "report" ? 0px : 107px;
            max-height: root.tab == "report" ? 0px : 107px;
            background: Theme.panel-2;

            Rectangle {
                height: 1px;
                background: Theme.line;
            }

            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 10px;
                padding-bottom: 12px;
                spacing: 0px;

                HorizontalLayout {
                    Text {
                        text: root.ribbon-label;
                        color: Theme.ink-3;
                        font-size: 10px;
                        font-weight: 650;
                        letter-spacing: 1.8px;
                        vertical-alignment: center;
                        height: 15px;
                    }
                    Rectangle { }
                    Text {
                        text: root.ribbon-hint;
                        color: Theme.ink-3;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 4px; }

                // **The bars take what is left, the axis keeps its line.**
                // Fixed at 42px they filled the ribbon and pushed the axis out
                // of it — drawn, laid out, and clipped by the height above.
                HorizontalLayout {
                    spacing: 3px;
                    alignment: stretch;

                    for b[i] in root.bars: Rectangle {
                        horizontal-stretch: 1;

                        // A bar is a filter, the same as a rail row: clicking
                        // it adds a `dm:` term to the *text*, so what is on
                        // screen is always exactly what the query says. The
                        // oldest bar has no upper bound — `dm:730d` would
                        // select everything — so it does nothing and says so
                        // by not lighting up.
                        bartouch := TouchArea {
                            mouse-cursor: b.days > 0 ? pointer : default;
                            clicked => {
                                if (b.days > 0) {
                                    root.bar-clicked(b.days);
                                }
                            }
                        }
                        // Bottom-aligned: the bars grow up from a shared floor,
                        // which is what makes twenty-four of them readable as
                        // one shape rather than twenty-four rectangles.
                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                // A fixed ceiling, not a share of the parent:
                                // asking the row how tall it is while the row
                                // is sized by its tallest bar is a loop Slint
                                // rejects at build time. 36px is what leaves
                                // the axis its line inside the page's 107.
                                height: b.count == 0 ? 2px
                                    : max(4px, 36px * b.count / max(1, root.bar-peak));
                                background: b.count == 0 ? Theme.line
                                    : b.band == 0 ? Theme.t0 : b.band == 1 ? Theme.t1
                                    : b.band == 2 ? Theme.t2 : b.band == 3 ? Theme.t3
                                    : b.band == 4 ? Theme.t4 : Theme.t5;
                                // Lighter under the pointer, so a bar that can
                                // be pressed says so before it is.
                                opacity: bartouch.has-hover && b.days > 0 ? 0.75 : 1.0;
                            }
                        }
                    }
                }

                // The axis. Five marks rather than twenty-four: the scale is
                // logarithmic and labelling every bar would be a wall of
                // numbers, where the question is only ever "how far back am I
                // looking".
                HorizontalLayout {
                    padding-top: 3px;

                    Text {
                        text: root.axis-oldest;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: left;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-year;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-month;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-week;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-today;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                    }
                }
            }
        }


    }

        }

        // ------------------------------------------------------------------
        // The panels. Drawn last so they are over the list, and only one of
        // them is ever open — a second card behind the first is a card nobody
        // can reach.
        // ------------------------------------------------------------------
        Sheet {
            title: root.help-title;
            open: root.panel == "help";
            room-w: root.width - 40px;
            room-h: root.height - 40px;

            Text {
                text: root.help-body;
                color: Theme.ink-2;
                font-size: 12.5px;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }

        Sheet {
            title: root.faces-title;
            open: root.panel == "faces";
            room-w: root.width - 40px;
            room-h: root.height - 40px;
            changed open => {
                // Nothing stays armed behind a closed panel.
                root.armed-face = "";
            }

            VerticalLayout {
                spacing: 2px;
                alignment: start;

                FaceRow {
                    label: root.face-window;
                    aside: root.face-window-aside;
                    here: true;
                    ready: false;
                }
                FaceRow {
                    label: root.face-tui;
                    note: root.face-tui-note;
                    aside: root.face-tui-ready ? "" : root.face-tui-aside;
                    ready: root.face-tui-ready;
                    armed: root.armed-face == "tui";
                    go: root.face-go;
                    picked => { root.armed-face = "tui"; }
                    confirmed => { root.face-picked("tui"); }
                }
                FaceRow {
                    label: root.face-web;
                    note: root.face-web-note;
                    armed: root.armed-face == "web";
                    go: root.face-go;
                    picked => { root.armed-face = "web"; }
                    confirmed => { root.face-picked("web"); }
                }
            }
        }

        Sheet {
            title: root.lang-title;
            open: root.panel == "language";
            room-w: root.width - 40px;
            room-h: root.height - 40px;

            VerticalLayout {
                spacing: 2px;
                alignment: start;

                for l[i] in root.languages: FacetRow {
                    label: l.label;
                    count: l.count;
                    on: root.language == l.token;
                    clicked => { root.language-picked(l.token); }
                }
            }
        }

        Sheet {
            title: root.rules-title;
            open: root.panel == "rules";
            room-w: root.width - 40px;
            room-h: root.height - 40px;
            // **The field takes the focus when the panel opens.** Clicking it
            // does not: the window hands focus to the query line whenever it
            // is activated, so a click that both raises the window and lands
            // in the field ends with the caret back in the query.
            changed open => {
                if (self.open) {
                    fresh.focus();
                } else {
                    root.focus-query();
                }
            }

            ScrollView {
                viewport-height: sheetlist.preferred-height;

                sheetlist := VerticalLayout {
                    spacing: 4px;
                    alignment: start;

                    // **Three groups, because they are three different kinds
                    // of thing** — what somebody added here, what a file says,
                    // and what the program itself skips — and only the first
                    // can be deleted. A flat list said none of that, and there
                    // was no way to tell a rule in force from one switched off.
                    Text {
                        text: root.rules-added-title;
                        color: Theme.ink;
                        font-size: 11px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                    }
                    Text {
                        text: root.rules-added-note;
                        color: Theme.ink-3;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    for r[i] in root.rules-added: RuleRow {
                        value: r.value;
                        off: r.off;
                        word: root.rules-off-word;
                        removable: true;
                        toggled => {
                            root.rule-toggled(r.id);
                        }
                        dropped => {
                            root.rule-dropped(r.kind, r.value);
                        }
                    }

                    // A rule is added as a *name* whatever it looks like,
                    // because that is the rule people mean: matched wherever
                    // it appears. One that starts with a slash is a path, and
                    // guessing between them by anything subtler would be a
                    // rule nobody was told about.
                    Rectangle { height: 4px; }

                    HorizontalLayout {
                        spacing: 6px;
                        height: 26px;

                        Rectangle {
                            border-width: 1px;
                            border-radius: 3px;
                            border-color: Theme.line;
                            background: Theme.panel;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;

                                fresh := TextInput {
                                    color: Theme.ink;
                                    font-family: Fonts.mono;
                                    font-size: 11.5px;
                                    single-line: true;
                                    vertical-alignment: center;
                                    selection-background-color: Theme.selection;
                                    selection-foreground-color: Theme.ink;
                                    accepted => {
                                        root.rule-added(self.text);
                                        self.text = "";
                                    }
                                }
                            }

                            // The placeholder sits *under* the field rather
                            // than beside it: a layout owns its children's
                            // positions, and this one has to start where the
                            // text does.
                            if fresh.text == "": Text {
                                text: root.rules-hint;
                                color: Theme.ink-3;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                x: 8px;
                                height: parent.height;
                            }
                        }

                        Push {
                            label: root.rules-add;
                            clicked => {
                                root.rule-added(fresh.text);
                                fresh.text = "";
                            }
                        }
                    }

                    Rectangle { height: 10px; }

                    Text {
                        text: root.rules-config-title;
                        color: Theme.ink;
                        font-size: 11px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                    }
                    Text {
                        text: root.rules-config-note;
                        color: Theme.ink-3;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    for r[i] in root.rules-config: RuleRow {
                        value: r.value;
                        off: r.off;
                        word: root.rules-off-word;
                        toggled => {
                            root.rule-toggled(r.id);
                        }
                    }

                    Rectangle { height: 10px; }

                    Text {
                        text: root.rules-builtin-title;
                        color: Theme.ink;
                        font-size: 11px;
                        font-weight: 650;
                        letter-spacing: 1.2px;
                    }
                    Text {
                        text: root.rules-builtin-note;
                        color: Theme.ink-3;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    for r[i] in root.rules-builtin: RuleRow {
                        value: r.value;
                        off: r.off;
                        word: root.rules-off-word;
                        toggled => {
                            root.rule-toggled(r.id);
                        }
                    }
                }
            }
        }
}
