    in property <string> set-folders-note;
    in property <[string]> folders;
    in property <string> folder-hint;
    in property <string> folder-add;
    in property <string> folder-error;
    in-out property <string> folder-typed;
    in property <string> about-body;
    callback settings-picked(string);
    callback theme-picked(string);
    callback face-default-picked(string);
    callback policy-picked(string, string);
    callback folder-added(string);
    callback folder-dropped(string);
    // Walk this disk's or folder's root again, now.
    callback rescan-root(string);
    changed panel => {
        // Nothing stays armed behind a closed page.
        if (self.panel != "settings") {
            root.armed-face = "";
        }
    }
    in property <string> help-title;
    in property <string> help-body;
    in property <string> lang-title;
    in property <string> rules-title;
    in property <string> language;
    in property <[Facet]> languages;
    in property <[Rule]> rules-added;
    in property <[Rule]> rules-config;
    in property <[Rule]> rules-builtin;
    in property <string> rules-added-title;
    in property <string> rules-added-note;
    in property <string> rules-config-title;
    in property <string> rules-config-note;
    in property <string> rules-builtin-title;
    in property <string> rules-builtin-note;
    /// The last rule text short enough to draw. Slint can neither cut a string
    /// nor cap a field, so an over-long edit is put back from here; the software
    /// renderer places glyphs at `i16`, and 400 characters stays inside that.
    private property <string> rule-kept: "";
    in property <string> rules-hint;
    in property <string> rules-add;
    in property <string> rules-off-word;
    callback rule-dropped(string, string);
    callback rule-added(string);
    callback language-picked(string);
    callback rule-toggled(string);
    // --- the disks ---------------------------------------------------------
    in property <[Disk]> disks;
    in property <string> disks-title;
    in property <string> disks-note;
    in property <string> disks-after;
    in property <string> disks-none;
    /// The question about a disk that came; empty while none is waiting.
    in property <string> disk-question;
    in property <string> disk-yes;
    in property <string> disk-later;
    in property <string> disk-never;
    /// A disk switched in the panel: its id, and whether it is now indexed.
    callback disk-toggled(string, bool);
    /// `index`, `later` or `leave`, about the disk the question names.
    callback disk-answered(string);
    // --- the desktop's key ------------------------------------------------
    // Every one of these is written from Rust after a worker has spoken to the
    // desktop: nothing here asks, and nothing here parses a combination.
    in property <string> key-title;
    /// The bound key, "not bound", or the sentence for a desktop that cannot be
    /// bound from here. Empty until the first answer arrives.
    in property <string> key-state;
    /// What to bind by hand, when this program cannot. Empty otherwise.
    in property <string> key-command;
    in property <string> key-copy;
    in property <bool> key-can-bind;
    in property <bool> key-bound;
    in property <string> key-hint;
    /// The parse error as the combination is typed, and the neutral spelling
    /// that would be written. Only one of the two is ever set.
    in property <string> key-error;
    in property <string> key-preview;
    in property <string> key-bind;
    in property <string> key-remove;
    /// KDE's line, after a binding that is not in force yet.
    in property <string> key-later;
    in-out property <string> key-typed: "";
    /// The last combination short enough to draw; see `rule-kept` for why.
    private property <string> key-kept: "";
    callback key-typed-changed(string);
    callback key-bind-pressed();
    callback key-remove-pressed();
    callback key-command-copied();
    // The first-run offer under the list. `key-nudge` is Rust's decision; the
    // error keeps the strip where the line was when a bind failed.
    in property <bool> key-nudge;
    in property <string> key-nudge-text;
    in property <string> key-nudge-yes;
    in property <string> key-nudge-no;
    /// A second yes, when there are two ways to say it: on Windows the first
    /// line offers the service and, short of that, starting with Windows.
    in property <string> key-nudge-other;
    callback key-nudged-other();
    in property <string> key-nudge-error;
    /// True for "bind it", false for "not now". Sent once, either way.
    callback key-nudged(bool);
    // --- the selection ----------------------------------------------------
    // Several rows at once, and an action takes all of them. The sentence is
    // written in Rust: counts and a size in a language's own word order.
    in property <int> picked;
    // Three pieces, because the count is drawn brighter and Slint has no rich
    // text. Split at `{n}`, so a language may put the number last.
    in property <string> picked-pre;
    in property <string> picked-n;
    in property <string> picked-post;
    in property <string> pick-copy;
    in property <string> pick-folders;
    in property <string> pick-drop;
    in property <bool> pick-asking;
    /// False past `scour_ui::OPEN_FOLDERS_MOST` folders.
    in property <bool> pick-folders-ok: true;
    property <bool> sel-shown: root.picked > 0 && root.tab != "report" && root.panel == "";
    /// A row was picked: which, whether to add to the selection, and whether
    /// to take the run from the last one picked.
    callback pick(int, bool, bool);
    /// A row pulled far enough to be a drag: the row, and where the pointer is.
    callback drag-out(int, length, length);
    /// Set when a press has become a drag, until the press ends.
    in-out property <bool> dragging-out;
    callback pick-copied();
    callback pick-opened();
    callback pick-dropped();
    callback pick-focused();
    callback bar-clicked(int);
    callback column-dragged(string, length);
    /// Double-clicked an edge: that column stretches with the window again.
    callback column-reset(string);
    /// The ⋮ at the end of the header row: which columns to show. Carries where
    /// it is, since the menu opens under it.
    callback columns-clicked(length, length);
    // No page callbacks: the model's length is the whole result, so the view
    // just scrolls and the window fetches what scrolled into sight.

    public function focus-query() {
        input.focus();
    }

    /// The search tabs: each one's name on the strip, and which is in front.
    /// `tabs-on` is the settings' switch: off, no strip, no keys, no button.
    in property <bool> tabs-on: true;
    in property <string> set-tabs;
    in property <string> set-tabs-note;
    callback tabs-picked(bool);
    in property <[string]> tab-labels;
    in property <int> tab-active;
    callback tab-new();
    callback tab-picked(int);
    callback tab-closed(int);
    /// The next tab along (`1`) or the previous (`-1`), wrapping.
    callback tab-step(int);

    /// The query field's own edits, for its right-click menu.
    public function query-edit(what: string) {
        input.focus();
        if (what == "cut") {
            input.cut();
        } else if (what == "copy") {
            input.copy();
        } else if (what == "paste") {
            input.paste-here();
        } else if (what == "select-all") {
            input.select-all();
        } else if (what == "clear") {
            root.query = "";
            root.query-changed("");
        }
    }
    /// The query field was right-clicked, here.
    callback query-menu-at(length, length);

    // What was searched before, already filtered by what is typed.
    in property <[string]> past;
    in-out property <bool> past-open;
    in-out property <int> past-picked;
    // Whether there is a past at all: no arrow when there is nothing to open.
    in property <bool> has-past;
    callback past-toggled();
    callback past-taken(string);
    // A query somebody meant, not one they were halfway through typing: the
    // box searches per keystroke, the history takes only what was committed.
    callback query-committed();

    // What the engine made of the query, as a sentence, and whether any of it
    // is a misreading. Empty when there is nothing worth reading back.
    in property <string> reading;
    in property <bool> reading-warn;
    /// The terms of the query that name a field, each a chip whose `×` takes
    /// it out of the text in one press. Asked of Rust with the text, so the
    /// row follows every keystroke.

    // `SCOUR_TRACE=1`: print what the two layers of the query field measure on
    // every caret move. They have to agree character for character.
    in property <bool> trace: false;

    /// Put the caret at the end of what is typed. Used by `Enter` on a
    /// suggestion and by `SCOUR_GUI_END`: text set from Rust leaves it at nought.
    public function caret-to-end() {
        // `set-selection-offsets` takes BYTE offsets and clamps, and Slint has
        // no byte count, so anything past the end is the end.
        input.set-selection-offsets(1000000000, 1000000000);
    }

    forward-focus: input;

    // The ground round the card closes an open panel too; the card has its
    // own catch, under its panels.
    if root.panel != "": TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.panel = ""; }
    }

    // A card on a ground: 20px all round, a 1px line, a 3px corner. No shadow —
    // the compositor draws the window's own, and two read as a border.
    // Edge to edge, as a desktop window is: the card used to sit on a 20px
    // ground with a corner, which read as a page in a browser.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.panel;
        clip: true;

    VerticalLayout {
        spacing: 0px;

        // The search tabs, always: a strip that appears only with a second tab
        // was never found (17 November). One tab has no ×. On its right what
        // the list is and how it is shown, and the window's own two buttons.
        Rectangle {
            height: 36px;
            background: Theme.ground;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }
            // Under the tabs: a double-click on the empty strip opens one.
            TouchArea {
                double-clicked => { root.tab-new(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 2px;
                if root.tabs-on && root.tab != "report": HorizontalLayout {
                spacing: 2px;
                for label[i] in root.tab-labels: VerticalLayout {
                    alignment: center;
                    SearchTabChip {
                        label: label;
                        on: i == root.tab-active;
                        closable: root.tab-labels.length > 1;
                        picked => { root.tab-picked(i); }
                        closed => { root.tab-closed(i); }
                    }
                }
                }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    // Its own width, whatever the chips leave.
                    horizontal-stretch: 0;
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Choice {
                            height: 24px;
                            horizontal-stretch: 0;
                            labels: [root.tab-search, root.tab-report];
                            values: ["search", "report"];
                            value: root.tab == "report" ? "report" : "search";
                            picked(v) => {
                                root.tab = v;
                                // Asked for when looked at: weighing a folder is a walk.
                                if (v == "report") {
                                    root.report-open("");
                                }
                            }
                        }
                    }
                    if root.tab == "report" && root.report-web-ready: VerticalLayout {
                        alignment: center;
                        TextTool {
                            label: root.report-web;
                            clicked => { root.report-in-browser(); }
                        }
                    }
                    if root.tab != "report": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            width: views.preferred-width;
                            border-radius: 6px;
                            border-width: Theme.hair;
                            border-color: Theme.line;
                            views := HorizontalLayout {
                                padding: 1px;
                                spacing: 1px;
                                Tool {
                                    width: 26px;
                                    height: 20px;
                                    icon: @image-url("icons/tools/detail.svg");
                                    has-icon: true;
                                    on: root.view-mode == "detail";
                                    clicked => { root.view-clicked("detail"); }
                                }
                                Tool {
                                    width: 26px;
                                    height: 20px;
                                    icon: @image-url("icons/tools/icons.svg");
                                    has-icon: true;
                                    on: root.view-mode == "icons";
                                    clicked => { root.view-clicked("icons"); }
                                }
                                Tool {
                                    width: 26px;
                                    height: 20px;
                                    icon: @image-url("icons/tools/large.svg");
                                    has-icon: true;
                                    on: root.view-mode == "large";
                                    clicked => { root.view-clicked("large"); }
                                }
                            }
                        }
                    }
                    if root.tab != "report": VerticalLayout {
                        alignment: center;
                        TextTool {
                            label: root.word-peek;
                            on: root.peeking;
                            clicked => { root.peek-toggled(); }
                        }
                    }
                    if root.tabs-on && root.tab != "report": VerticalLayout {
                        alignment: center;
                        TextTool {
                            label: "+ " + root.word-tab;
                            clicked => { root.tab-new(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Tool {
                            width: 24px;
                            height: 24px;
                            icon: @image-url("icons/tools/export.svg");
                            has-icon: true;
                            clicked => { root.tool-clicked("export"); }
                        }
                    }
                    // Faces, language, disks, skips and the keys: one page.
                    VerticalLayout {
                        alignment: center;
                        Tool {
                            width: 24px;
                            height: 24px;
                            icon: @image-url("icons/tools/settings.svg");
                            has-icon: true;
                            on: root.disk-question != "";
                            clicked => { root.tool-clicked("settings"); }
                        }
                    }
                }
            }
        }

        // The query line. Slint's `TextInput` has no range colouring (upstream
        // #9560 puts editable text out of scope), so the colours are a second
        // layer under a transparent input.
        Rectangle {
            // 16px above the box, 12px below, the box 26px of 20px monospace.
            // Taller when the query is read back — see `reading`.
            // The bar, a line taller for each line the query wraps onto, and
            // the narrowing line under it, which is always there.
            height: (root.q-shown - 1) * root.q-pitch + 100px + root.q-inside;
            background: Theme.ground;

            // The line between the query and what is under it. A plain rule:
            // the field's own border is what says where the keyboard is.
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }

            VerticalLayout {
                spacing: 0px;

            HorizontalLayout {
                // The box's own height, so the line under it moves nothing.
                height: 66px + (root.q-shown - 1) * root.q-pitch + root.q-inside;
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 10px;

                // The mark: the desktop's icon, then letter-spaced small capitals.
                mark := HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    width: 180px - 26px;
                    Image {
                        source: @image-url("../../../assets/scour.svg");
                        width: 20px;
                        height: 20px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Scour";
                        color: Theme.ink;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                // The field, and under it — inside the same box — the line
                // that searches what the files hold.
                VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                // The box and its placeholder, stacked: Slint's `TextInput` has
                // no placeholder, so the hint is drawn under it and hidden the
                // moment anything is typed.
                field := Rectangle {
                    horizontal-stretch: 1;
                    // Unclipped: the buttons over a term stand above the box.
                    // Nothing else reaches past it — lines past the third are
                    // not drawn, and the text never scrolls sideways.
                    clip: false;
                    height: 46px + (root.q-shown - 1) * root.q-pitch;
                    background: Theme.panel;
                    border-top-left-radius: 8px;
                    border-top-right-radius: 8px;
                    border-bottom-left-radius: root.grep-open ? 0px : 8px;
                    border-bottom-right-radius: root.grep-open ? 0px : 8px;
                    border-width: Theme.hair;
                    border-color: input.has-focus ? Theme.focus : Theme.line;
                    animate border-color { duration: 120ms; }
                    // One number for every layer: the runs, the capsules, the
                    // caret and a press are all placed from it.
                    property <length> pad: 9px;
                    // What a line holds: the width less the padding and the
                    // past's button at the end.
                    property <length> room: max(0px, field.width - field.pad * 2
                        - (root.has-past ? 24px : 0px));
                    // One character's width, measured over forty because a
                    // layout rounds each run to whole pixels and the error
                    // accumulates. One width for every character: the query's
                    // face is monospace, and Rust wraps it by that.
                    property <length> advance: ruler.preferred-width / 40;
                    property <int> cols: max(8, Math.floor(field.room / max(1px, field.advance)));
                    changed cols => { root.q-cols(self.cols); }
                    init => { root.q-cols(self.cols); }
                    // The lines start this far down, so one line sits in the
                    // middle of the box as it always did.
                    property <length> top: (field.height - root.q-shown * root.q-pitch) / 2;
                    property <bool> caret-lit: true;
                    property <bool> pair-keep: false;
                    property <bool> pair-active: root.hov-on || pair.over;
                    changed pair-active => {
                        if (self.pair-active) {
                            field.pair-keep = true;
                        }
                    }
                    pair-linger := Timer {
                        interval: 220ms;
                        running: !field.pair-active && field.pair-keep;
                        triggered => {
                            field.pair-keep = false;
                            if (!pair.over) { root.q-hover(-1, -1); }
                        }
                    }

                    // This window draws its own caret: on Linux Slint's takes
                    // its colour from `TextInput::color`, which is transparent
                    // here. 530ms is the desktop's own blink rate.
                    blink := Timer {
                        interval: 530ms;
                        running: input.has-focus;
                        triggered => {
                            field.caret-lit = !field.caret-lit;
                        }
                    }

                    // Forty characters of the query's face, to measure one.
                    ruler := Text {
                        text: "0000000000000000000000000000000000000000";
                        font-family: Fonts.mono;
                        font-size: 16px;
                        font-weight: 500;
                        visible: false;
                    }

                    // A filter is a capsule: a tint and a hairline ring, a
                    // header and what it holds. Rust places every part; the
                    // letters over it move with the columns it was given.
                    for c in root.caps: Rectangle {
                        x: field.pad + c.x - 3px;
                        y: field.top + (c.line - root.q-first) * root.q-pitch + 2px;
                        width: c.w + 6px;
                        height: root.q-pitch - 4px;
                        visible: c.line >= root.q-first && c.line < root.q-first + root.q-shown;
                        border-radius: 8px;
                        // The one being written wears the field's own focus.
                        property <bool> writing: c.edit && input.has-focus;
                        // Where the header ends, from this rectangle's edge.
                        property <length> hx: c.icon ? c.hw - 6px : c.hw - 1px;
                        property <brush> ring: c.tone == 1 ? Theme.cap-read-ring
                            : c.tone == 2 ? Theme.cap-neg-ring
                            : c.tone == 3 ? Theme.line : Theme.cap-ring;
                        // A fuzzy capsule holds its word: a firmer ring round both.
                        border-width: self.writing ? 2px : c.field == "fuzzy" ? 1.5px : 1px;
                        clip: true;
                        // Tone 3 is a filter with nothing in it, left out of
                        // the search: a ring and no tint.
                        background: c.tone == 1 ? Theme.cap-read : c.tone == 2 ? Theme.cap-neg
                            : c.tone == 3 ? transparent : Theme.cap;
                        border-color: self.writing ? Theme.focus : c.hov ? Theme.ink-3 : self.ring;

                        // The header's tint, its left corners the capsule's own: a
                        // clip does not round them, and square ones stood out.
                        if c.head > 0: Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.hx;
                            height: parent.height;
                            opacity: 0.55;
                            background: parent.ring;
                            border-top-left-radius: 7px;
                            border-bottom-left-radius: 7px;
                        }
                        if c.head > 0: Rectangle {
                            x: parent.hx;
                            y: 0px;
                            width: 1px;
                            height: parent.height;
                            background: parent.ring;
                        }
                        // The well: a place to type, inside the ring.
                        if self.writing && c.head > 0: Rectangle {
                            x: parent.hx + 1px;
                            y: 2px;
                            width: parent.width - self.x - 2px;
                            height: parent.height - 4px;
                            border-top-right-radius: 6px;
                            border-bottom-right-radius: 6px;
                            background: Theme.panel;
                        }
                        if c.hint != "": Text {
                            x: c.hw + 9px;
                            height: parent.height;
                            text: c.hint;
                            color: Theme.ink-3;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        if c.nice != "": Text {
                            x: c.hw + 3px;
                            height: parent.height;
                            text: c.nice;
                            color: c.tone == 2 ? Theme.q-not : Theme.ink;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        // An excluded filter: what it holds is struck through.
                        if c.tone == 2 && c.icon && c.whole: Rectangle {
                            x: c.hw + 1px;
                            y: parent.height / 2;
                            width: parent.width - self.x - 9px;
                            height: 1px;
                            background: Theme.q-not;
                        }
                    }

                    // The words the capsules show in the window's own face,
                    // measured here: Rust places columns and cannot.
                    for m[mi] in root.q-measure: Text {
                        visible: false;
                        text: m.text;
                        font-size: m.big ? 15px : 12px;
                        font-weight: 600;
                        property <length> wide: self.preferred-width;
                        init => { root.q-measured(mi, self.wide); }
                        changed wide => { root.q-measured(mi, self.wide); }
                    }

                    // The selection, a line at a time.
                    for s in root.sels: Rectangle {
                        x: field.pad + s.x;
                        y: field.top + (s.line - root.q-first) * root.q-pitch + 3px;
                        width: s.w;
                        height: root.q-pitch - 6px;
                        visible: s.line >= root.q-first && s.line < root.q-first + root.q-shown;
                        background: Theme.selection;
                    }

                    for sp[i] in root.spans: Text {
                            x: field.pad + sp.x;
                            y: field.top + (sp.line - root.q-first) * root.q-pitch;
                            height: root.q-pitch;
                            visible: sp.line >= root.q-first && sp.line < root.q-first + root.q-shown;
                            text: sp.text;
                            font-family: Fonts.mono;
                            // A header small and close: the capsule's room is
                            // for what it holds. Rust measures it the same way.
                            font-size: sp.small ? 12.5px : 16px;
                            letter-spacing: sp.small ? -0.5px : 0px;
                            // Operators are heavier: one character that changes
                            // what a whole term means.
                            font-weight: sp.role == 1 || sp.role == 4 || sp.role == 8 ? 600 : 500;
                            vertical-alignment: center;
                            // A misreading is said before a polarity, and an
                            // exclusion before a role: `!kind:zurna` is both,
                            // and unreadable is what matters.
                            color: sp.role == 5 ? Theme.q-bad
                                 : sp.not ? Theme.q-not
                                 : sp.role == 1 ? Theme.q-key
                                 : sp.role == 2 ? Theme.q-val
                                 : sp.role == 3 ? Theme.q-glob
                                 : sp.role == 4 ? Theme.q-not
                                 : sp.role == 6 ? Theme.q-term
                                 : sp.role == 7 ? Theme.ink-3
                                 : sp.role == 8 ? Theme.q-key
                                 : Theme.ink;
                    }

                    // A filter's header, once written, is drawn as what it
                    // does and what it is called — a clock and "Modified" for
                    // `dm:`, a folder and "Location" for `under:`, ≈ alone for
                    // `fuzzy:` — on the capsule's own tint.
                    for c[ci] in root.caps: cap-head := Rectangle {
                        visible: c.icon && c.line >= root.q-first && c.line < root.q-first + root.q-shown;
                        x: field.pad + c.x - 3px;
                        y: field.top + (c.line - root.q-first) * root.q-pitch + 2px;
                        width: c.hw - 6px;
                        height: root.q-pitch - 4px;
                        property <brush> ink: c.tone == 2 ? Theme.q-not : c.tone == 1 ? Theme.q-bad
                            : c.tone == 3 ? Theme.ink-3 : Theme.q-key;
                        property <bool> over: self.visible && q-press.has-hover
                            && q-press.mouse-x >= self.x && q-press.mouse-x < self.x + self.width
                            && q-press.mouse-y >= self.y && q-press.mouse-y < self.y + self.height;
                        changed over => {
                            if (self.over) {
                                root.tip-owner = -100 - ci;
                                root.tip-mono = false;
                                root.tip-pending = c.tip;
                                root.tip-x = self.absolute-position.x;
                                root.tip-y = self.absolute-position.y + self.height + 8px;
                            } else if (root.tip-owner == -100 - ci) {
                                root.tip-owner = -1;
                                root.tip-pending = "";
                                root.tip-text = "";
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            padding-left: 6px;
                            spacing: 5px;
                            // An excluded filter keeps its `!` in front of the drawing.
                            if c.tone == 2: Text {
                                text: "!";
                                color: Theme.q-not;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: c.field == "fuzzy" ? @image-url("icons/tools/lens-fuzzy.svg")
                                        : c.field == "under" || c.field == "parent" ? @image-url("icons/tools/folder.svg")
                                        : c.field == "dm" ? @image-url("icons/tools/lens-time.svg")
                                        : c.field == "kind" ? @image-url("icons/tools/field-kind.svg")
                                        : c.field == "ext" ? @image-url("icons/tools/field-ext.svg")
                                        : c.field == "size" ? @image-url("icons/tools/field-size.svg")
                                        : @image-url("icons/tools/lens-content.svg");
                                    colorize: cap-head.ink;
                                }
                            }
                            if c.label != "": Text {
                                text: c.label;
                                color: cap-head.ink;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.spans.length == 0 && root.query == "": Text {
                        x: field.pad;
                        width: field.room;
                        text: root.hint;
                        color: Theme.ink-3;
                        font-family: Fonts.mono;
                        font-size: 16px;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                input := TextInput {
                    // One invisible line that owns the text, the keys, the
                    // clipboard and the input method. What is drawn is the
                    // layers above, placed by Rust; presses go to `press`.
                    x: field.pad;
                    y: field.top;
                    width: max(field.room, self.preferred-width);
                    height: root.q-pitch;
                    text <=> root.query;
                    // Where the caret and the selection are, for Rust to draw.
                    cursor-position-changed(p) => {
                        root.q-caret(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                        if (root.trace) {
                            debug("query field: caret " + self.cursor-position-byte-offset
                                + "  selection " + self.anchor-position-byte-offset
                                + "  chars " + root.query.character-count);
                        }
                        // Typing restarts the lit half: a caret blinking while
                        // letters arrive reads as a dropped keystroke.
                        field.caret-lit = true;
                        blink.restart();
                    }
                    changed has-focus => {
                        if (!self.has-focus) {
                            root.lens-close();
                            root.plus-asked = false;
                        }
                        root.q-focus-moved();
                    }
                    color: transparent;
                    font-size: 16px;
                    font-weight: 500;
                    font-family: Fonts.mono;
                    single-line: true;
                    vertical-alignment: center;
                    text-cursor-width: 0px;
                    // The selection is drawn above, a line at a time.
                    selection-background-color: transparent;
                    selection-foreground-color: transparent;

                    edited => {
                        field.pair-keep = false;
                        root.plus-asked = false;
                        root.query-changed(self.text);
                    }
                    function paste-here() {
                        let r = Clip.paste-into(self.text, self.anchor-position-byte-offset,
                            self.cursor-position-byte-offset, true);
                        if (!r.ok) {
                            self.paste();
                            return;
                        }
                        self.text = r.text;
                        self.set-selection-offsets(r.caret, r.caret);
                        root.query-changed(self.text);
                    }

                    // Down and up move through the results without leaving the
                    // field: type, glance, press Enter.
                    key-pressed(e) => {
                        // While the lens is open the arrows, Tab, Enter and
                        // Escape are its own.
                        // Backspace and Delete do not take a capsule's frame apart.
                        if (e.text == Key.Backspace && !e.modifiers.control && !e.modifiers.alt
                                && root.q-backspace()) {
                            return accept;
                        }
                        if (e.text == Key.Delete && !e.modifiers.control && !e.modifiers.alt
                                && root.q-delete()) {
                            return accept;
                        }
                        if (!e.modifiers.control && !e.modifiers.alt && e.text != ""
                                && e.text != Key.Return && e.text != Key.Tab && e.text != Key.Escape
                                && self.anchor-position-byte-offset == self.cursor-position-byte-offset
                                && root.q-before-char(e.text)) {
                            return accept;
                        }
                        // Tab leaves the term, lens or not: the caret goes outside it.
                        if (e.text == Key.Tab && !e.modifiers.shift && !e.modifiers.control
                                && !e.modifiers.alt && root.lens-exit()) {
                            return accept;
                        }
                        if (root.lens-open) {
                            if (e.text == Key.DownArrow && !e.modifiers.alt) { root.lens-step(1); return accept; }
                            if (e.text == Key.UpArrow && !e.modifiers.alt) { root.lens-step(-1); return accept; }
                            // → goes into a folder, or adds one more value to a list.
                            if (e.text == Key.RightArrow && root.lens-right()) { return accept; }
                            if (e.text == Key.Return) { root.lens-pick(root.lens-sel, false); return accept; }
                            if (e.text == Key.Escape) { root.lens-escape(); return accept; }
                        }
                        // Ctrl+Space: the lens of the term under the caret, or
                        // the filters a query can take.
                        if (e.modifiers.control && e.text == " ") {
                            root.lens-toggle();
                            return accept;
                        }
                        // Ctrl+C with nothing selected here copies what is
                        // selected in the preview: the drag there may not have
                        // taken the keyboard with it.
                        if (e.modifiers.control && (e.text == "c" || e.text == "C")
                                && self.anchor-position-byte-offset == self.cursor-position-byte-offset
                                && root.peek-from != root.peek-to) {
                            root.copy-span(root.peek-text, root.peek-from, root.peek-to);
                            return accept;
                        }
                        // Caps Lock: Slint takes its editing keys in lower case
                        // only, so `V` pasted nothing. See `Field`.
                        if (e.modifiers.control && !e.modifiers.shift) {
                            if (e.text == "v" || e.text == "V") { self.paste-here(); return accept; }
                            if (e.text == "C") { self.copy(); return accept; }
                            if (e.text == "X") { self.cut(); return accept; }
                            if (e.text == "A") { self.select-all(); return accept; }
                        }
                        // The tabs, with a browser's keys. Lower and upper case:
                        // Slint reads no Caps Lock for us. See `Field`.
                        if (root.tabs-on && e.modifiers.control && !e.modifiers.alt) {
                            if (e.text == "t" || e.text == "T") { root.tab-new(); return accept; }
                            if (e.text == "w" || e.text == "W") { root.tab-closed(root.tab-active); return accept; }
                            if (e.text == Key.Tab) { root.tab-step(e.modifiers.shift ? -1 : 1); return accept; }
                            if (e.text == Key.Backtab) { root.tab-step(-1); return accept; }
                            if (e.text == Key.PageDown) { root.tab-step(1); return accept; }
                            if (e.text == Key.PageUp) { root.tab-step(-1); return accept; }
                            if (e.text == "1") { root.tab-picked(0); return accept; }
                            if (e.text == "2") { root.tab-picked(1); return accept; }
                            if (e.text == "3") { root.tab-picked(2); return accept; }
                            if (e.text == "4") { root.tab-picked(3); return accept; }
                            if (e.text == "5") { root.tab-picked(4); return accept; }
                            if (e.text == "6") { root.tab-picked(5); return accept; }
                            if (e.text == "7") { root.tab-picked(6); return accept; }
                            if (e.text == "8") { root.tab-picked(7); return accept; }
                            if (e.text == "9") { root.tab-picked(root.tab-labels.length - 1); return accept; }
                        }
                        // `Alt+↓` opens what was searched before; plain `↓`
                        // still walks into the results.
                        if (e.text == Key.DownArrow && e.modifiers.alt) {
                            root.past-toggled();
                            return accept;
                        }
                        // While the list is open the arrows belong to it.
                        if (root.past-open && e.text == Key.DownArrow) {
                            root.past-picked = min(root.past-picked + 1, root.past.length - 1);
                            return accept;
                        }
                        if (root.past-open && e.text == Key.UpArrow) {
                            root.past-picked = max(root.past-picked - 1, 0);
                            return accept;
                        }
                        if (root.past-open && e.text == Key.Return) {
                            root.past-taken(root.past[root.past-picked]);
                            return accept;
                        }
                        if (root.past-open && e.text == Key.Escape) {
                            root.past-open = false;
                            return accept;
                        }
                        // The stream of files is the list while it is shown.
                        if (root.grep-active && (e.text == Key.DownArrow || e.text == Key.UpArrow)) {
                            root.grep-step(e.text == Key.DownArrow ? 1 : -1);
                            return accept;
                        }
                        if (e.text == Key.DownArrow) {
                            root.selected = min(root.selected + 1, root.rows.length - 1);
                            root.navigated(root.selected);
                            if ((root.selected + 1) * Theme.row-height + list.viewport-y
                                > list.visible-height) {
                                list.viewport-y = list.visible-height
                                    - (root.selected + 1) * Theme.row-height;
                            }
                            return accept;
                        }
                        if (e.text == Key.UpArrow) {
                            root.selected = max(root.selected - 1, 0);
                            root.navigated(root.selected);
                            if (root.selected * Theme.row-height + list.viewport-y < 0px) {
                                list.viewport-y = 0px - root.selected * Theme.row-height;
                            }
                            return accept;
                        }
                        // A screenful at a time, and the ends.
                        if (e.text == Key.PageDown || e.text == Key.PageUp) {
                            root.selected = clamp(
                                root.selected + (e.text == Key.PageDown ? root.visible-rows : -root.visible-rows),
                                0,
                                root.rows.length - 1);
                            root.navigated(root.selected);
                            list.viewport-y = min(0px,
                                -(root.selected * Theme.row-height) + list.visible-height / 2);
                            return accept;
                        }
                        if (e.text == Key.Home || e.text == Key.End) {
                            root.selected = e.text == Key.Home ? 0 : root.rows.length - 1;
                            root.navigated(root.selected);
                            list.viewport-y = e.text == Key.Home
                                ? 0px
                                : min(0px, list.visible-height - root.rows.length * Theme.row-height);
                            return accept;
                        }
                        // The keys the menu says, where the field does not need
                        // them for its own text.
                        if (e.modifiers.control && (e.text == "+" || e.text == "=")) {
                            root.zoom-step(1);
                            return accept;
                        }
                        if (e.modifiers.control && e.text == "-") {
                            root.zoom-step(-1);
                            return accept;
                        }
                        if (e.modifiers.control && e.text == "0") {
                            root.zoom-step(0);
                            return accept;
                        }
                        if (e.text == Key.F2) {
                            root.key-action("rename");
                            return accept;
                        }
                        // Ctrl+G or Ctrl+Shift+F toggles the on-demand Grep capsule.
                        if (e.modifiers.control && !e.modifiers.alt
                                && (e.text == "g" || e.text == "G"
                                    || (e.modifiers.shift && (e.text == "f" || e.text == "F")))) {
                            root.grep-toggled();
                            return accept;
                        }
                        if (e.text == Key.Return && e.modifiers.control) {
                            root.key-action("folder");
                            return accept;
                        }
                        if (e.text == Key.Return) {
                            if (root.rows.length == 0 && root.similar-said != "") {
                                root.similar-clicked();
                                return accept;
                            }
                            // What was committed to is what the history takes.
                            root.query-committed();
                            root.activated(root.selected);
                            return accept;
                        }
                        if (e.text == Key.Escape && root.ask-open) {
                            // A question first: Escape is its no.
                            root.ask-open = false;
                            root.ask-answer(false);
                            return accept;
                        }
                        // Ctrl+, opens the settings, as in most programs.
                        if (e.text == "," && e.modifiers.control) {
                            root.tool-clicked("settings");
                            return accept;
                        }
                        if (e.text == Key.Escape && root.panel != "") {
                            // A panel first: Escape closes what is on top.
                            root.panel = "";
                            return accept;
                        }
                        if (e.text == Key.Escape && root.picked > 0) {
                            // Then the selection, before the query: the smaller undo.
                            root.pick-dropped();
                            return accept;
                        }
                        if (e.text == Key.Escape) {
                            if (self.text == "") {
                                return accept;
                            }
                            self.text = "";
                            root.query-changed("");
                            return accept;
                        }
                        return reject;
                    }
                }

                // Presses, drags and the pointer's place, by line and column:
                // the input underneath is one line, the drawing is up to three.
                q-press := TouchArea {
                    x: 0;
                    y: 0;
                    width: parent.width - (root.has-past ? 24px : 0px);
                    height: parent.height;
                    mouse-cursor: text;
                    property <int> anchor: 0;
                    function line-at(y: length) -> int {
                        return clamp(Math.floor((y - field.top) / root.q-pitch), 0, root.q-shown - 1);
                    }
                    function col-at(x: length) -> int {
                        return root.q-col(self.line-at(self.mouse-y), x - field.pad, true);
                    }
                    function track() {
                        if (self.pressed) {
                            input.set-selection-offsets(self.anchor,
                                root.q-hit(self.line-at(self.mouse-y), self.col-at(self.mouse-x)));
                        } else if (self.has-hover && !pair.over) {
                            root.q-hover(self.line-at(self.mouse-y),
                                root.q-col(self.line-at(self.mouse-y), self.mouse-x - field.pad, false));
                        }
                    }
                    changed mouse-x => { self.track(); }
                    changed mouse-y => { self.track(); }
                    changed has-hover => {
                        if (!self.has-hover && !pair.over) { root.q-hover(-1, -1); }
                    }
                    pointer-event(e) => {
                        if (e.kind != PointerEventKind.down) { return; }
                        input.focus();
                        if (e.button == PointerEventButton.right) {
                            root.query-menu-at(self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                            return;
                        }
                        if (e.button != PointerEventButton.left) { return; }
                        let o = root.q-hit(self.line-at(self.mouse-y), self.col-at(self.mouse-x));
                        if (e.modifiers.shift) {
                            input.set-selection-offsets(input.anchor-position-byte-offset, o);
                            return;
                        }
                        self.anchor = o;
                        input.set-selection-offsets(o, o);
                        root.plus-asked = true;
                        // A filter opens its lens when it is pressed.
                        root.q-pressed(self.line-at(self.mouse-y),
                            root.q-col(self.line-at(self.mouse-y), self.mouse-x - field.pad, false));
                    }
                    double-clicked => {
                        let w = root.q-word(self.line-at(self.mouse-y), self.col-at(self.mouse-x));
                        input.set-selection-offsets(w.from, w.to);
                    }
                }

                    // What says `Alt+↓` is there. Inside the field at its
                    // trailing edge, because the box stretches and a button
                    // outside it would move with every resize.
                    if root.has-past: Rectangle {
                        x: field.width - 26px;
                        width: 22px;
                        height: 22px;
                        y: (field.height - 22px) / 2;
                        border-radius: 3px;
                        background: chevron.has-hover || root.past-open ? Theme.hover : Theme.panel-2;
                        Image {
                            source: @image-url("icons/tools/chevron.svg");
                            colorize: root.past-open ? Theme.ink : Theme.ink-3;
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        chevron := TouchArea {
                            // The pointer, not the click: by the time a click
                            // lands, the list has already closed on blur.
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    root.past-toggled();
                                }
                            }
                        }
                    }

                    // Painted last, so a letter cannot cover it.
                    Rectangle {
                        x: field.pad + root.caret-x - 1px;
                        y: field.top + (root.caret-line - root.q-first) * root.q-pitch + 5px;
                        width: 2px;
                        height: root.q-pitch - 10px;
                        background: Theme.q-key;
                        visible: input.has-focus && field.caret-lit && root.sels.length == 0
                            && root.caret-line >= root.q-first && root.caret-line < root.q-first + root.q-shown;
                    }

                    // Over the caret after a press: a filter, here, in one more.
                    if root.plus-asked && input.has-focus && root.sels.length == 0 && !root.lens-open
                        && root.caret-line >= root.q-first && root.caret-line < root.q-first + root.q-shown: Rectangle {
                        x: clamp(field.pad + root.caret-x - 11px, 0px, field.width - 22px);
                        y: field.top + (root.caret-line - root.q-first) * root.q-pitch - 22px;
                        width: 22px;
                        height: 20px;
                        border-radius: 10px;
                        background: plus-hit.has-hover ? Theme.cap : Theme.panel;
                        border-width: 1px;
                        border-color: plus-hit.has-hover ? Theme.cap-ring : Theme.line;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000030;
                        drop-shadow-offset-y: 1px;
                        Text {
                            text: "+";
                            color: plus-hit.has-hover ? Theme.q-key : Theme.ink-2;
                            font-size: 15px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        plus-hit := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    root.plus-asked = false;
                                    root.lens-launch();
                                }
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.tip-owner = -3;
                                    root.tip-mono = false;
                                    root.tip-pending = root.word-add-filter;
                                    root.tip-x = self.absolute-position.x;
                                    root.tip-y = self.absolute-position.y - 30px;
                                } else if (root.tip-owner == -3) {
                                    root.tip-owner = -1;
                                    root.tip-pending = "";
                                    root.tip-text = "";
                                }
                            }
                        }
                    }

                    // Over the right end of the term the pointer is on: take
                    // it out, exclude it, or read a word a letter off.
                    pair := Rectangle {
                        property <bool> fz-hov: false;
                        property <bool> over: pair-bridge.has-hover
                            || (root.hov-fz && self.fz-hov)
                            || pair-neg.hovered
                            || pair-drop.hovered;
                        // Above the term, a capsule's as a word's: nothing is laid
                        // over what it holds, and nothing in the line moves.
                        visible: root.hov-on || self.over || field.pair-keep;
                        x: clamp(field.pad + root.hov-x - self.width + 5px, 0px, field.width - self.width);
                        y: field.top + root.hov-line * root.q-pitch - 24px;
                        width: pair-row.preferred-width + 4px;
                        height: 26px;
                        border-radius: 13px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.line;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000030;
                        drop-shadow-offset-y: 1px;
                        pair-bridge := TouchArea {
                            x: -8px;
                            y: -4px;
                            width: parent.width + 16px;
                            height: parent.height + 16px;
                        }
                        pair-row := HorizontalLayout {
                            padding: 2px;
                            spacing: 2px;
                            if root.hov-fz: PairButton {
                                label: "≈";
                                on: root.hov-fz-on;
                                changed hovered => { pair.fz-hov = self.hovered; }
                                pressed => { root.term-act("fz"); }
                            }
                            pair-neg := PairButton {
                                label: root.hov-not ? "+" : "!";
                                kind: 1;
                                pressed => { root.term-act("neg"); }
                            }
                            pair-drop := PairButton {
                                label: "✕";
                                kind: 2;
                                pressed => {
                                    field.pair-keep = false;
                                    root.term-act("drop");
                                }
                            }
                        }
                    }

                }

                // What the files hold is written, not chosen: it is a line
                // of its own under the field, in the same box, with the ways
                // of reading beside it. Hidden until asked for.
                Rectangle {
                    visible: root.grep-open;
                    height: root.q-inside;
                    background: Theme.cap-read;
                    border-bottom-left-radius: 8px;
                    border-bottom-right-radius: 8px;
                    border-width: Theme.hair;
                    border-color: grep-input.has-focus ? Theme.q-bad : Theme.cap-read-ring;
                    clip: true;

                    // Inside the border, and the tint's corner as round as the
                    // box's: `clip` does not follow a radius, and a square
                    // tint showed past the corner.
                    HorizontalLayout {
                        padding-left: Theme.hair;
                        padding-top: Theme.hair;
                        padding-bottom: Theme.hair;
                        padding-right: 6px;
                        spacing: 6px;
                        Rectangle {
                            width: inside-head.preferred-width + 22px;
                            Rectangle {
                                opacity: 0.55;
                                background: Theme.cap-read-ring;
                                border-bottom-left-radius: 8px - Theme.hair;
                            }
                            inside-head := HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        width: 16px;
                                        height: 16px;
                                        source: @image-url("icons/tools/lens-content.svg");
                                        colorize: Theme.q-bad;
                                    }
                                }
                                Text {
                                    text: root.word-inside;
                                    color: Theme.q-bad;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            clip: true;
                            if root.grep-pattern == "": Text {
                                width: parent.width;
                                height: parent.height;
                                text: root.word-grep-ph;
                                color: Theme.ink-3;
                                font-family: Fonts.mono;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            grep-input := TextInput {
                                width: parent.width;
                                height: parent.height;
                                text <=> root.grep-pattern;
                                font-family: Fonts.mono;
                                font-size: 14px;
                                color: Theme.ink;
                                selection-background-color: Theme.selection;
                                selection-foreground-color: Theme.ink;
                                single-line: true;
                                vertical-alignment: center;
                                edited => { root.grep-edited(self.text); }
                                key-pressed(e) => {
                                    if (e.text == Key.Escape) {
                                        root.grep-toggled();
                                        return accept;
                                    }
                                    if (e.modifiers.control && (e.text == "g" || e.text == "G")) {
                                        root.grep-toggled();
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                        }
                        // The ways of reading, as one group, centred in the
                        // line's height: a layout sets its children's `y`.
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 6px;
                                for m in [
                                    { id: "text", label: root.word-text },
                                    { id: "regex", label: root.word-regex },
                                    { id: "hex", label: root.word-hex },
                                ]: Rectangle {
                                    height: 22px;
                                    width: mlbl.preferred-width + 10px;
                                    border-radius: 5px;
                                    background: root.grep-mode == m.id ? Theme.cap-read-ring : mtouch.has-hover ? Theme.hover : transparent;
                                    border-width: Theme.hair;
                                    border-color: Theme.cap-read-ring;
                                    mlbl := Text {
                                        text: m.label;
                                        color: root.grep-mode == m.id ? Theme.ink : Theme.ink-3;
                                        font-family: Fonts.mono;
                                        font-size: 10.5px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    mtouch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.grep-mode-picked(m.id); }
                                    }
                                }
                                Rectangle {
                                    height: 22px;
                                    width: 24px;
                                    border-radius: 5px;
                                    background: root.grep-case ? Theme.cap-read-ring : ctouch.has-hover ? Theme.hover : transparent;
                                    border-width: Theme.hair;
                                    border-color: Theme.cap-read-ring;
                                    Text {
                                        text: "Aa";
                                        color: root.grep-case ? Theme.ink : Theme.ink-3;
                                        font-family: Fonts.mono;
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    ctouch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.grep-case-toggled(); }
                                    }
                                }
                                Rectangle {
                                    height: 22px;
                                    width: 24px;
                                    border-radius: 5px;
                                    background: root.grep-binary ? Theme.cap-read-ring : btouch.has-hover ? Theme.hover : transparent;
                                    border-width: Theme.hair;
                                    border-color: Theme.cap-read-ring;
                                    Text {
                                        text: "01";
                                        color: root.grep-binary ? Theme.ink : Theme.ink-3;
                                        font-family: Fonts.mono;
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    btouch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.grep-bin-toggled(); }
                                    }
                                }
                                Rectangle {
                                    height: 22px;
                                    width: 24px;
                                    border-radius: 5px;
                                    background: root.grep-markup ? Theme.cap-read-ring : xtouch.has-hover ? Theme.hover : transparent;
                                    border-width: Theme.hair;
                                    border-color: Theme.cap-read-ring;
                                    Text {
                                        text: "<>";
                                        color: root.grep-markup ? Theme.ink : Theme.ink-3;
                                        font-family: Fonts.mono;
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    xtouch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.grep-markup-toggled(); }
                                    }
                                }
                            }
                        }
                        Text {
                            text: root.grep-meter;
                            color: Theme.q-bad;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        // Centred like the ways of reading.
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    height: 22px;
                                    width: 20px;
                                    border-radius: 5px;
                                    background: gxtouch.has-hover ? Theme.hover : transparent;
                                    Text {
                                        text: "×";
                                        color: gxtouch.has-hover ? Theme.ink : Theme.ink-3;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    gxtouch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.grep-toggled(); }
                                    }
                                }
                            }
                        }
                    }
                }
                }

                // One way into the filters, the same list `:` opens: where,
                // when, what kind, how big, a letter off, inside the file.
                filter-button := Rectangle {
                    height: 46px;
                    width: 46px;
                    border-radius: 8px;
                    border-width: Theme.hair;
                    border-color: filter-hit.has-hover ? Theme.ink-3 : Theme.line;
                    background: filter-hit.has-hover ? Theme.hover : Theme.panel;
                    // One picture, the filters' own; `:` and the list say the rest.
                    Image {
                        width: 20px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("icons/tools/filter.svg");
                        colorize: filter-hit.has-hover ? Theme.ink : Theme.ink-2;
                    }
                    filter-hit := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                input.focus();
                                root.lens-launch();
                            }
                        }
                    }
                }
            }

                // Under the bar, always one line: what would narrow the list on
                // the left; on the right what is being read and how it is shown.
                Rectangle {
                    height: 34px;
                    Rectangle {
                        y: 0px;
                        height: 1px;
                        background: Theme.line;
                    }
                    HorizontalLayout {
                        spacing: 0px;
                        // In the window's own corner: the rail on the left put
                        // out and back, as » in the other corner opens the list.
                        VerticalLayout {
                            alignment: center;
                            padding-left: 8px;
                            Tool {
                                width: 26px;
                                height: 24px;
                                icon: @image-url("icons/tools/rail.svg");
                                has-icon: true;
                                on: root.rail-shown;
                                clicked => {
                                    root.rail-shown = !root.rail-shown;
                                    root.panes-changed();
                                }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            padding-left: 8px;
                            padding-right: 12px;
                            spacing: 8px;
                        if root.fix-said != "": Rectangle {
                            width: fix-text.preferred-width + 12px;
                            height: 18px;
                            y: 8px;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: Theme.q-bad;
                            fix-text := Text {
                                text: root.fix-said;
                                color: Theme.q-bad;
                                font-family: Fonts.mono;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.fix-taken(); }
                            }
                        }
                        if root.chips.length > 0 && root.fix-said == "" && !root.reading-warn: Text {
                            text: root.word-narrow;
                            color: Theme.ink-3;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if root.chips.length > 0 && root.fix-said == "" && !root.reading-warn: chip-flick := Flickable {
                            horizontal-stretch: 1;
                            interactive: false;
                            viewport-width: chip-row.preferred-width;
                            // The wheel moves the line sideways: it holds more
                            // than a window is wide.
                            function nudge(dx: length) {
                                chip-flick.viewport-x = clamp(chip-flick.viewport-x + dx,
                                    min(0px, chip-flick.width - chip-row.preferred-width), 0px);
                            }
                            chip-row := HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                // Every chip is one click: the term goes in, with Alt it
                                // goes in excluded. Where a kind of chip begins, its picture.
                                for c[ci] in root.chips: Rectangle {
                                    property <bool> lead: ci == 0 || root.chips[ci - 1].icon != c.icon;
                                    property <length> lead-w: self.lead ? (ci == 0 ? 22px : 30px) : 0px;
                                    y: 6px;
                                    height: 22px;
                                    width: self.lead-w + chip-text.preferred-width + chip-n.preferred-width + 21px;
                                    if self.lead: Rectangle {
                                        x: 0px;
                                        width: parent.lead-w;
                                        if ci > 0: Rectangle {
                                            x: 6px;
                                            width: 1px;
                                            height: 14px;
                                            y: 4px;
                                            background: Theme.line;
                                        }
                                        Image {
                                            x: ci > 0 ? 14px : 2px;
                                            y: 3px;
                                            width: 16px;
                                            height: 16px;
                                            colorize: Theme.ink-3;
                                            source: c.icon == "kind" ? @image-url("icons/tools/field-kind.svg")
                                                : c.icon == "ext" ? @image-url("icons/tools/field-ext.svg")
                                                : c.icon == "dm" ? @image-url("icons/tools/lens-time.svg")
                                                : c.icon == "size" ? @image-url("icons/tools/field-size.svg")
                                                : @image-url("icons/tools/folder.svg");
                                        }
                                    }
                                    Rectangle {
                                        x: parent.lead-w;
                                        width: parent.width - parent.lead-w;
                                        border-radius: 6px;
                                        border-width: Theme.hair;
                                        border-color: chip-touch.has-hover ? Theme.ink-3 : Theme.line;
                                        background: chip-touch.has-hover ? Theme.hover : transparent;
                                        chip-text := Text {
                                            x: 8px;
                                            text: c.label;
                                            color: chip-touch.has-hover ? Theme.ink : Theme.ink-2;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        chip-n := Text {
                                            x: 8px + chip-text.preferred-width + 5px;
                                            text: c.count;
                                            color: Theme.ink-3;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        chip-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            scroll-event(e) => {
                                                chip-flick.nudge(e.delta-x + e.delta-y);
                                                accept
                                            }
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                    root.narrow-taken(c.token, e.modifiers.alt);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.chips.length == 0 || root.fix-said != "" || root.reading-warn: Text {
                            text: root.reading;
                            color: root.reading-warn ? Theme.q-bad : Theme.ink-3;
                            font-size: 11.5px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        }
                        // In the corner: every way to narrow as a list, the
                        // ones the line has no room for too.
                        if root.chips.length > 0: VerticalLayout {
                            alignment: center;
                            padding-left: 2px;
                            padding-right: 8px;
                            more := Tool {
                                width: 26px;
                                height: 24px;
                                glyph: "»";
                                clicked => { more-list.show(); }
                            }
                            more-list := PopupWindow {
                                x: more.width - 260px;
                                y: more.height + 4px;
                                width: 260px;
                                height: min(360px, root.chips.length * 28px + 12px);
                                Rectangle {
                                    background: Theme.panel;
                                    border-radius: 8px;
                                    border-width: Theme.hair;
                                    border-color: Theme.line;
                                    drop-shadow-blur: 12px;
                                    drop-shadow-color: #00000030;
                                    ScrollView {
                                        x: 0px;
                                        y: 6px;
                                        height: parent.height - 12px;
                                        viewport-height: root.chips.length * 28px;
                                        for c[ci] in root.chips: Rectangle {
                                            y: ci * 28px;
                                            height: 28px;
                                            background: more-touch.has-hover ? Theme.hover : transparent;
                                            Image {
                                                x: 10px;
                                                y: 6px;
                                                width: 16px;
                                                height: 16px;
                                                colorize: Theme.ink-3;
                                                source: c.icon == "kind" ? @image-url("icons/tools/field-kind.svg")
                                                    : c.icon == "ext" ? @image-url("icons/tools/field-ext.svg")
                                                    : c.icon == "dm" ? @image-url("icons/tools/lens-time.svg")
                                                    : c.icon == "size" ? @image-url("icons/tools/field-size.svg")
                                                    : @image-url("icons/tools/folder.svg");
                                            }
                                            Text {
                                                x: 34px;
                                                width: parent.width - 34px - 70px;
                                                text: c.label;
                                                color: more-touch.has-hover ? Theme.ink : Theme.ink-2;
                                                font-size: 12.5px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            Text {
                                                x: parent.width - 64px;
                                                width: 54px;
                                                text: c.count;
                                                color: Theme.ink-3;
                                                font-size: 12px;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                            more-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                                                        root.narrow-taken(c.token, e.modifiers.alt);
                                                        more-list.close();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // A disk that came and has not been answered for, one at a time.
        if root.disk-question != "": Rectangle {
            height: 36px;
            background: Theme.panel;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 8px;

                Text {
                    text: root.disk-question;
                    color: Theme.ink;
                    font-size: Fonts.small;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.disk-yes;
                        asking: true;
                        clicked => { root.disk-answered("index"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.disk-later;
                        clicked => { root.disk-answered("later"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.disk-never;
                        clicked => { root.disk-answered("leave"); }
                    }
                }
            }
        }

        // The report: what a folder weighs, where the weight sits, how old it
        // is. One scrolling document, and capped to nothing rather than put in
        // an `if`, because an id inside one is out of scope.
        paper := ReportPaper {
            tab <=> root.tab;
            crumb: root.crumb;
            report-open(a0) => { root.report-open(a0); }
            report-total: root.report-total;
            report-files: root.report-files;
            report-took: root.report-took;
            age-segs: root.age-segs;
            strip-width <=> root.strip-width;
            report-resized() => { root.report-resized(); }
            age-key: root.age-key;
            head-bytes: root.head-bytes;
            kids-aside: root.kids-aside;
            kid-segs: root.kid-segs;
            head-folder: root.head-folder;
            head-age: root.head-age;
            age-bar: root.age-bar;
            head-size: root.head-size;
            head-share: root.head-share;
            head-files: root.head-files;
            kids: root.kids;
            kids-empty: root.kids-empty;
            kids-note: root.kids-note;
            head-kinds: root.head-kinds;
            kinds-sampled: root.kinds-sampled;
            report-kinds: root.report-kinds;
            kinds-count: root.kinds-count;
            kinds-word: root.kinds-word;
            facet-clicked(a0) => { root.facet-clicked(a0); }
            kinds-note: root.kinds-note;
            head-biggest: root.head-biggest;
            report-big: root.report-big;
            big-menu-at(a0, a1, a2) => { root.big-menu-at(a0, a1, a2); }
            biggest-note: root.biggest-note;
            head-jump: root.head-jump;
            report-under: root.report-under;
            jump-label: root.jump-label;
            report-search() => { root.report-search(); }
            jump-note: root.jump-note;
            head-dupes: root.head-dupes;
            dupes-open: root.dupes-open;
            dupes-hide: root.dupes-hide;
            dupes-show: root.dupes-show;
            dupes-toggled() => { root.dupes-toggled(); }
            dupes-sum: root.dupes-sum;
            dupe-floors: root.dupe-floors;
            dupe-floor: root.dupe-floor;
            dupes-floored(a0) => { root.dupes-floored(a0); }
            dupes-confirm: root.dupes-confirm;
            dupes-read() => { root.dupes-read(); }
            dupes-note: root.dupes-note;
            dupes: root.dupes;
        }

        HorizontalLayout {
            spacing: 0px;
            visible: root.tab != "report";
            max-height: root.tab == "report" ? 0px : 100000px;

            // The rail: what the matching set consists of. Clicking a row adds
            // its term to the query rather than filtering behind its back.
            // Capped to nothing rather than put behind an `if`: `railview`
            // inside a conditional is out of scope for `scroll-rail`.
            Rectangle {
                // A fixed track: it carries counts that must not reflow while
                // the list beside it does.
                width: root.rail-w;
                background: Theme.ground;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.line;
                }

                // The rail put away: its whole edge brings it back.
                rail-back := TouchArea {
                    visible: false;
                    width: parent.width - 1px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.rail-shown = true;
                        root.panes-changed();
                    }
                    Rectangle {
                        background: rail-back.has-hover ? Theme.hover : transparent;
                    }
                    Text {
                        text: "›";
                        color: rail-back.has-hover ? Theme.ink : Theme.ink-3;
                        font-size: 15px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Scrolled: three sections and thirteen kinds do not fit at
                // 700px, and a rail that grew would push the ribbon off.
                railview := ScrollView {
                    visible: root.rail-shown;
                    // Told how tall it is, or there is no overflow to scroll.
                    viewport-height: rail.preferred-height;

                    rail := VerticalLayout {
                    height: self.preferred-height;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 0px;
                    padding-right: 0px;
                    spacing: 1px;
                    alignment: start;

                    // Where, not what: the scopes are this desktop's own folders,
                    // answered by the service, which runs where the files are.

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        Text {
                            text: root.scope-heading;
                            color: Theme.ink-3;
                            font-size: 12px;
                            font-weight: 500;
                            overflow: elide;
                            height: 18px;
                            horizontal-stretch: 1;
                        }
                        // Put the rail away; the status bar brings it back.
                        rail-x := TouchArea {
                            width: 22px;
                            height: 18px;
                            mouse-cursor: pointer;
                            clicked => {
                                root.rail-shown = false;
                                root.panes-changed();
                            }
                            Text {
                                text: "‹";
                                color: rail-x.has-hover ? Theme.ink : Theme.ink-3;
                                font-size: 15px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { height: 8px; }

                    for sc[i] in root.scopes: FacetRow {
                        icon: "place";
                        label: sc.label;
                        count: sc.count;
                        share: sc.share;
                        on: root.term-on(root.query, sc.token);
                        clicked => { root.facet-clicked(sc.token); }
                    }

                    Rectangle { height: 14px; }

                    // Indented by a layout, not by an `x`: moving the text
                    // right inside a box that stays put clips the first glyph.
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: root.scope-label;
                            color: Theme.ink-3;
                            font-size: 12px;
                            font-weight: 500;
                            overflow: elide;
                            height: 18px;
                        }
                    }

                    Rectangle { height: 8px; }

                    for f[i] in root.facets: FacetRow {
                        icon: f.icon;
                        label: f.label;
                        count: f.count;
                        share: f.share;
                        on: root.term-on(root.query, f.token);
                        clicked => { root.facet-clicked(f.token); }
                    }

                    // Three bands rather than a histogram: a size filter answers
                    // "what is taking the room" and "what is empty".
                    Rectangle { height: 12px; }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: root.size-heading;
                            color: Theme.ink-3;
                            font-size: 12px;
                            font-weight: 500;
                            overflow: elide;
                            height: 18px;
                        }
                    }

                    Rectangle { height: 8px; }

                    for sz[i] in root.sizes: FacetRow {
                        icon: "size";
                        label: sz.label;
                        count: sz.count;
                        share: sz.share;
                        on: root.term-on(root.query, sz.token);
                        clicked => { root.facet-clicked(sz.token); }
                    }
                    }

                }
            }

            // The results.
            VerticalLayout {
                spacing: 0px;
                // Allowed to be narrower than its columns, which is what lets
                // the preview panel take its 380px from the list.
                min-width: 0px;

                // Column headings, each of them a sort. Which columns and how
                // wide are `heads` and `cw`, both handed in from `scour-ui`.
                Rectangle {
                    // Shorter than a row and quieter: a ruler, not a row.
                    height: 28px;
                    background: Theme.panel;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        for h[i] in root.heads: Head {
                            which: h.id;
                            text: h.label;
                            sort: h.sort;
                            align-right: h.right;
                            // No line after the last: there is no column beyond it.
                            last: i == root.heads.length - 1;
                            w: root.cw[i];
                            sorted-by: root.sorted-by;
                            sorted-down: root.sorted-down;
                            dragged(c, d) => { root.column-dragged(c, d); }
                            reset(c) => { root.column-reset(c); }
                            clicked(k) => { root.sort-by(k); }
                        }

                        // Where a column would be. Its room is taken out of the
                        // lane — see `picker-w`.
                        Rectangle {
                            width: 16px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.columns-clicked(self.absolute-position.x,
                                        self.absolute-position.y + self.height);
                                }
                                Image {
                                    source: @image-url("icons/tools/columns.svg");
                                    colorize: parent.has-hover ? Theme.ink : Theme.ink-3;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }

                list := ScrollView {
                    // The window draws its own, in the lane below. See `sb-`.
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    // Capped to nothing rather than put behind an `if`: an id
                    // inside a conditional is out of scope, and both views must
                    // stay readable by name.
                    visible: !root.grid && !root.grep-active;
                    // With `max-height`: a `ScrollView` asks for fifty pixels
                    // whatever it holds, so capping the height alone leaves a band.
                    min-height: 0px;
                    max-height: (root.grid || root.grep-active) ? 0px : 100000px;

                    // Slots that are never destroyed, not a `ListView`: that one
                    // drops the row scrolling out and builds the one scrolling
                    // in, and Slint repaints the whole window for every element
                    // it frees. Rust moves a slot to its new row — see `Slots`.
                    // The length is the whole result, so the scrollbar is too.
                    viewport-height: root.rows.length * Theme.row-height;
                    viewport-width: max(self.visible-width, root.row-w);
                    // The slots' origin, at the first row they cover. Inside it a
                    // slot is at most a screen down: positions a million rows
                    // down are past what a 32-bit float keeps to the pixel, and
                    // rows placed there drew 16px apart instead of 30.
                    Rectangle {
                        y: root.slot-from * Theme.row-height;
                        width: parent.width;
                        height: root.slots.length * Theme.row-height;
                        for slot in root.slots: slot-box := Rectangle {
                            property <int> i: slot.i;
                            property <Row> here: slot.row;
                            property <bool> path-hovered: false;
                            visible: slot.i >= 0;
                            x: 0px;
                            y: (i - root.slot-from) * Theme.row-height;
                            width: parent.width;
                            height: Theme.row-height;
                            // Never animated: selecting is where you are, not an
                            // event that happened to the list. The arrival wash is
                            // a separate layer with its own clock, below.
                            background: (here.picked || i == root.selected) ? Theme.selection
                                : rowtouch.has-hover ? Theme.hover
                                : transparent;

                            // The grid, when the settings ask for it: shown, not
                            // built, so a slot is never rebuilt — see `pool`.
                            Rectangle {
                                visible: root.grid-lines;
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.line-soft;
                            }
                            for h[ci] in root.heads: Rectangle {
                                visible: root.grid-columns && ci < root.heads.length - 1;
                                x: root.cx[ci] + root.cw[ci] + 4px;
                                y: 0px;
                                width: 1px;
                                height: parent.height;
                                background: Theme.line-soft;
                            }

                            // The arrival wash: translucent, so a row that is both
                            // new and selected shows both, and it fades away. Not
                            // while the list moves: a slot handed from a new row
                            // to an old one would fade on the wrong row.
                            Rectangle {
                                background: here.fresh ? Theme.t0.with-alpha(0.22) : transparent;
                                animate background {
                                    duration: root.moving ? 0ms : 1600ms;
                                    easing: ease-out;
                                }
                            }

                            // Where the keyboard is, which is not what is selected:
                            // a ring, because a fourth shade of blue would read as
                            // "more selected", which is not a thing.
                            // Shown, not built: a slot is never rebuilt, see `pool`.
                            Rectangle {
                                visible: i == root.selected && !here.picked;
                                background: transparent;
                                border-width: Theme.hair;
                                border-color: Theme.line;
                            }

                            rowtouch := TouchArea {
                                mouse-cursor: slot-box.path-hovered ? pointer : default;
                                clicked => {
                                    root.selected = i;
                                    root.focus-query();
                                    root.tip-text = root.tip-pending;
                                }
                                double-clicked => {
                                    root.selected = i;
                                    root.opened-at(i, self.mouse-x);
                                }
                                // Eight pixels from the press: past a click's wobble,
                                // short of anything a hand means as a selection.
                                moved => {
                                    if (!root.dragging-out
                                        && (abs(self.mouse-x - self.pressed-x) > 8px
                                            || abs(self.mouse-y - self.pressed-y) > 8px)) {
                                        root.dragging-out = true;
                                        root.drag-out(i, self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    }
                                }
                                // A press, not a click: a click carries no modifiers
                                // here, and `Ctrl` and `Shift` change what it means.
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.up) {
                                        root.dragging-out = false;
                                    }
                                    if (e.kind == PointerEventKind.down
                                        && e.button == PointerEventButton.left) {
                                        root.selected = i;
                                        root.pick(i, e.modifiers.control || e.modifiers.meta,
                                            e.modifiers.shift);
                                    }
                                    if (e.button == PointerEventButton.right
                                        && e.kind == PointerEventKind.down) {
                                        root.selected = i;
                                        // Right-clicking outside the selection selects what
                                        // was right-clicked: a menu must be about what is
                                        // under the pointer.
                                        root.menu-at(i, self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    }
                                }
                            }

                            // Where the file holds the text, under its name: the
                            // line's number, then the line with the find marked.
                            // Shown, not built, so a slot is never rebuilt.
                            Rectangle {
                                visible: root.tall && here.found.length > 0;
                                x: 12px + (root.iconed ? 42px : 0px);
                                y: root.base-row - 4px;
                                width: max(0px, parent.width - self.x - 12px);
                                height: Theme.row-height - root.base-row;
                                Text {
                                    x: 0px;
                                    width: 44px;
                                    height: parent.height;
                                    text: here.found.length > 0 ? here.found[0].line : "";
                                    color: Theme.ink-3;
                                    font-family: Fonts.mono;
                                    font-size: 11.5px;
                                    vertical-alignment: center;
                                }
                                Marked {
                                    x: 48px;
                                    width: max(0px, parent.width - 48px);
                                    height: parent.height;
                                    pre: here.found.length > 0 ? here.found[0].pre : "";
                                    hit: here.found.length > 0 ? here.found[0].hit : "";
                                    post: here.found.length > 0 ? here.found[0].post : "";
                                    colour: Theme.ink-2;
                                }
                            }

                            // The file's own line. On a tall row it keeps the
                            // usual height at the top, and the find goes below.
                            HorizontalLayout {
                                y: 0px;
                                height: root.tall ? root.base-row : Theme.row-height;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                // The kind's icon, spelled out one kind at a time:
                                // `@image-url` is resolved at build time. Tinted
                                // from `scour-ui`. A conditional rather than a zero
                                // width, which would still take the row's spacing.
                                if root.iconed: VerticalLayout {
                                    alignment: center;
                                    width: 34px;
                                    if root.system-icons && here.has-sys-icon: Image {
                                        x: 9px;
                                        width: 16px;
                                        height: 16px;
                                        source: here.sys-icon;
                                        image-fit: contain;
                                    }
                                    if !(root.system-icons && here.has-sys-icon): FileBadge {
                                        ktoken: here.ktoken;
                                        tint: here.tint;
                                        ext: here.ext;
                                    }
                                }

                                // One loop over the cells: which columns are shown
                                // is a person's choice. The name is found by `id`,
                                // and the icon's room comes out of the name's width.
                                // Over the headings, which change only when the columns
                                // do: a loop over the row's own cells would rebuild
                                // every cell of a slot each time the slot moved on.
                                for h[ci] in root.heads: HorizontalLayout {
                                    property <Cell> c: here.cells[ci];
                                    // As wide as its heading, icon included: taking
                                    // the icon off twice shifts every later column.
                                    width: max(0px, root.cw[ci] - (ci == 0 && root.iconed ? 42px : 0px));

                                    if h.id == "name": Marked {
                                        pre: c.pre;
                                        hit: c.hit;
                                        post: c.post;
                                        colour: Theme.ink;
                                        mono: false;
                                        size: 14px;
                                        weight: 500;
                                        width: parent.width;
                                        property <bool> under: rowtouch.has-hover
                                            && rowtouch.mouse-x >= root.cx[ci]
                                            && rowtouch.mouse-x < root.cx[ci] + root.cw[ci];
                                        changed under => {
                                            if (self.under && self.preferred-width > self.width) {
                                                root.tip-owner = i * 32 + ci;
                                                root.tip-mono = false;
                                                root.tip-pending = c.pre + c.hit + c.post;
                                                root.tip-x = rowtouch.absolute-position.x + rowtouch.mouse-x + 14px;
                                                root.tip-y = rowtouch.absolute-position.y + rowtouch.height + 2px;
                                                if (root.tip-text != "") {
                                                    root.tip-text = root.tip-pending;
                                                }
                                            } else if (self.under || root.tip-owner == i * 32 + ci) {
                                                root.tip-owner = -1;
                                                root.tip-pending = "";
                                                root.tip-text = "";
                                            }
                                        }
                                    }

                                    if h.id != "name": Rectangle {
                                        width: root.cw[ci];
                                        property <bool> is-path: h.id == "path";
                                        property <bool> under: rowtouch.has-hover
                                            && rowtouch.mouse-x >= root.cx[ci]
                                            && rowtouch.mouse-x < root.cx[ci] + root.cw[ci];
                                        changed under => {
                                            if (self.is-path) {
                                                slot-box.path-hovered = self.under;
                                            }
                                            if (self.under && (c.hint != "" || cell-txt.preferred-width > cell-txt.width)) {
                                                root.tip-owner = i * 32 + ci;
                                                root.tip-mono = c.mono && c.hint == "";
                                                root.tip-pending = c.hint != "" ? c.hint : c.text;
                                                root.tip-x = rowtouch.absolute-position.x + rowtouch.mouse-x + 14px;
                                                root.tip-y = rowtouch.absolute-position.y + rowtouch.height + 2px;
                                                if (root.tip-text != "") {
                                                    root.tip-text = root.tip-pending;
                                                }
                                            } else if (self.under || root.tip-owner == i * 32 + ci) {
                                                root.tip-owner = -1;
                                                root.tip-pending = "";
                                                root.tip-text = "";
                                            }
                                        }
                                        if self.is-path && self.under: Rectangle {
                                            x: -4px;
                                            y: 0px;
                                            width: parent.width + 8px;
                                            height: parent.height;
                                            background: Theme.q-key.with-alpha(
                                                (here.picked || i == root.selected) ? 0.16 : 0.11);
                                        }
                                        cell-txt := Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: c.text;
                                            // Only the folder is monospace: a path is read
                                            // a character at a time, a date or a size at a glance.
                                            color: parent.is-path && parent.under ? Theme.q-key
                                                 : c.dim ? Theme.ink-3
                                                 : c.mono ? Theme.ink-2 : Theme.ink-3;
                                            font-family: parent.is-path ? Fonts.mono : "";
                                            font-size: parent.is-path ? 12px : c.mono ? 12.5px : Fonts.small;
                                            horizontal-alignment: c.right ? right : left;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        if self.is-path && self.under && c.text != "": Rectangle {
                                            x: 0px;
                                            y: parent.height / 2 + 7px;
                                            width: min(cell-txt.preferred-width, parent.width);
                                            height: 1px;
                                            background: Theme.q-key.with-alpha(0.75);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // The same results as tiles. A second list rather than a second
                // shape for the first: a `ListView` is lazy about one repeater.
                // The one not showing is capped to no height rather than put in
                // an `if`, which would take its id out of scope.
                tiles := ListView {
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    visible: root.grid && !root.grep-active;
                    min-height: 0px;
                    max-height: (root.grid && !root.grep-active) ? 100000px : 0px;

                    for line[i] in root.lines: Rectangle {
                        height: root.tile-h;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;

                            for cell[c] in line: Rectangle {
                                width: root.tile-w;
                                height: root.tile-h;
                                // The tile is the selection, not the line: a line
                                // holds several results.
                                background: (cell.picked || (i * root.per-line + c) == root.selected)
                                    ? Theme.selection
                                    : tiletouch.has-hover ? Theme.hover
                                    : transparent;

                                // The arrival wash, on its own layer.
                                Rectangle {
                                    background: cell.fresh
                                        ? Theme.t0.with-alpha(0.22)
                                        : transparent;
                                    animate background { duration: 1600ms; easing: ease-out; }
                                }

                                // And where the keyboard is — see the table's
                                // rows for why a ring rather than a shade.
                                if (i * root.per-line + c) == root.selected: Rectangle {
                                    background: transparent;
                                    border-width: Theme.hair;
                                    border-color: Theme.focus;
                                }

                                tiletouch := TouchArea {
                                    clicked => {
                                        root.selected = i * root.per-line + c;
                                        root.focus-query();
                                    }
                                    double-clicked => {
                                        root.selected = i * root.per-line + c;
                                        root.activated(root.selected);
                                    }
                                    moved => {
                                        if (!root.dragging-out
                                            && (abs(self.mouse-x - self.pressed-x) > 8px
                                                || abs(self.mouse-y - self.pressed-y) > 8px)) {
                                            root.dragging-out = true;
                                            root.drag-out(i * root.per-line + c,
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.up) {
                                            root.dragging-out = false;
                                        }
                                        if (e.kind != PointerEventKind.down) {
                                            return;
                                        }
                                        root.selected = i * root.per-line + c;
                                        if (e.button == PointerEventButton.right) {
                                            root.menu-at(root.selected,
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                        } else if (e.button == PointerEventButton.left) {
                                            root.pick(root.selected,
                                                e.modifiers.control || e.modifiers.meta,
                                                e.modifiers.shift);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 4px;
                                    alignment: center;

                                    // The picture where there is one, the kind's
                                    // colour where there is not.
                                    Rectangle {
                                        height: root.pic;
                                        if cell.shot: Image {
                                            width: root.pic;
                                            height: root.pic;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: cell.thumb;
                                            // The whole picture: its shape is
                                            // part of what identifies it.
                                            image-fit: contain;
                                        }
                                        if cell.shot == false && root.system-icons && cell.has-sys-icon: Image {
                                            width: root.pic * 0.72;
                                            height: root.pic * 0.72;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: cell.sys-icon;
                                            image-fit: contain;
                                        }
                                        if cell.shot == false && !(root.system-icons && cell.has-sys-icon): Rectangle {
                                            width: root.pic * 0.55;
                                            height: root.pic * 0.55;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 5px;
                                            background: cell.tint;
                                            opacity: 0.5;
                                        }
                                    }

                                    Text {
                                        text: cell.name;
                                        color: Theme.ink;
                                        font-family: Fonts.mono;
                                        font-size: root.view-mode == "large" ? 12px : 11px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        height: 30px;
                                    }
                                }
                            }
                        }
                    }
                }
                // Stream of files and matching lines when the Grep capsule is active.
                VerticalLayout {
                    visible: root.grep-active;
                    min-height: 0px;
                    max-height: root.grep-active ? 100000px : 0px;
                    vertical-stretch: root.grep-active ? 1 : 0;

                    Rectangle {
                        height: 36px;
                        background: Theme.ground;
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.line;
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            Text {
                                text: root.grep-summary;
                                color: Theme.ink-2;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if root.grep-more-on: VerticalLayout {
                                alignment: center;
                                Push {
                                    label: root.word-read-more + " →";
                                    asking: true;
                                    clicked => { root.grep-more(); }
                                }
                            }
                        }
                    }

                    if root.grep-empty != "": Rectangle {
                        vertical-stretch: 1;
                        Text {
                            text: root.grep-empty;
                            color: Theme.ink-3;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if root.grep-empty == "": ListView {
                        vertical-stretch: 1;
                        for gitem in root.grep-items: Rectangle {
                            height: gitem.header ? 32px : 25px;
                            background: gitem.file-idx == root.grep-sel ? Theme.selection
                                : ghit.has-hover ? Theme.hover : gitem.header ? Theme.ground : transparent;
                            if gitem.header: Rectangle {
                                y: 0px;
                                height: 1px;
                                background: Theme.line-soft;
                            }
                            if gitem.header: HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                if root.iconed: VerticalLayout {
                                    alignment: center;
                                    width: 34px;
                                    FileBadge {
                                        ktoken: gitem.ktoken;
                                        tint: gitem.tint;
                                        ext: gitem.ext;
                                    }
                                }
                                for h[ci] in root.heads: HorizontalLayout {
                                    property <Cell> gc: ci < gitem.cells.length ? gitem.cells[ci] : { text: "" };
                                    width: max(0px, root.cw[ci] - (ci == 0 && root.iconed ? 42px : 0px));
                                    if h.id == "name": Text {
                                        width: parent.width;
                                        text: gc.pre + gc.hit + gc.post + "  (" + gitem.count + ")";
                                        color: Theme.ink;
                                        font-family: Fonts.mono;
                                        font-size: 12.5px;
                                        font-weight: 650;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if h.id != "name": Text {
                                        width: parent.width;
                                        text: gc.text;
                                        color: h.id == "path" ? Theme.ink-3 : Theme.ink-2;
                                        font-family: gc.mono ? Fonts.mono : "";
                                        font-size: gc.mono ? 11.5px : Fonts.small;
                                        horizontal-alignment: gc.right ? right : left;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                            if !gitem.header: HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 14px;
                                spacing: 10px;
                                Text {
                                    width: 44px;
                                    text: gitem.line;
                                    color: Theme.ink-3;
                                    font-family: Fonts.mono;
                                    font-size: 11.5px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Marked {
                                    horizontal-stretch: 1;
                                    height: parent.height;
                                    pre: gitem.pre;
                                    hit: gitem.hit;
                                    post: gitem.post;
                                    colour: Theme.ink-2;
                                }
                            }
                            ghit := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.grep-clicked(gitem.file-idx); }
                                double-clicked => { root.grep-opened(gitem.file-idx); }
                            }
                        }
                    }
                }

                // The first-run offer, under the list: bind a key once, and no
                // face asks again. It stays while an error has to be read.
                if root.key-nudge || root.key-nudge-error != "": Rectangle {
                    height: 38px;
                    background: Theme.panel;

                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.line;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.key-nudge-error != ""
                                    ? root.key-nudge-error : root.key-nudge-text;
                                color: root.key-nudge-error != "" ? Theme.q-not : Theme.ink-2;
                                font-size: 11.5px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { }

                        if root.key-nudge: VerticalLayout {
                            alignment: center;
                            Push {
                                label: root.key-nudge-yes;
                                clicked => { root.key-nudged(true); }
                            }
                        }

                        if root.key-nudge && root.key-nudge-other != "": VerticalLayout {
                            alignment: center;
                            Push {
                                label: root.key-nudge-other;
                                clicked => { root.key-nudged-other(); }
                            }
                        }

                        if root.key-nudge: VerticalLayout {
                            alignment: center;
                            Push {
                                label: root.key-nudge-no;
                                clicked => { root.key-nudged(false); }
                            }
                        }
                    }
                }
            }

            // The scrollbar's lane. Beside the list, never over it; the
            // arithmetic is in the `sb-` properties.
            VerticalLayout {
                width: 14px;

                // Level with the column headings, carrying their rule across.
                Rectangle {
                    height: 31px;
                    background: Theme.panel;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }
                }

                Rectangle {
                    background: Theme.panel;

                    thumb := Rectangle {
                        x: 4px;
                        width: 6px;
                        y: root.sb-y;
                        height: root.sb-thumb;
                        border-radius: 3px;
                        // Quiet until it is wanted.
                        background: grab.pressed ? Theme.ink-2
                            : grab.has-hover ? Theme.ink-3 : Theme.line;
                        visible: root.sb-span > 0px;
                        animate background { duration: 120ms; }
                    }

                    grab := TouchArea {
                        // Where the thumb was when this press began.
                        property <length> from;

                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                // A press on the track takes the thumb to the
                                // pointer; on the thumb it picks it up as it is.
                                if (self.mouse-y < thumb.y
                                    || self.mouse-y > thumb.y + thumb.height) {
                                    root.scroll-thumb-to(self.mouse-y - thumb.height / 2);
                                }
                                self.from = thumb.y;
                            }
                        }

                        moved => {
                            root.scroll-thumb-to(self.from + self.mouse-y - self.pressed-y);
                        }
                    }
                }
            }

            // The preview panel: 380px, shut by default, and the width and the
            // bounds are `scour_ui::preview`'s so every face agrees.
            if root.peeking: Rectangle {
                // Min and max, not `width`: the list's own minimum is wider than
                // the window, and a `width` is a preference the layout squeezes.
                min-width: root.peek-width;
                max-width: root.peek-width;
                horizontal-stretch: 0;
                background: Theme.panel-2;

                Rectangle {
                    x: 0;
                    width: peekgrip.has-hover || peekgrip.pressed ? 2px : 1px;
                    height: parent.height;
                    background: peekgrip.has-hover || peekgrip.pressed ? Theme.focus : Theme.line;
                }

                VerticalLayout {
                    padding-left: 1px;
                    spacing: 0px;

                    // The name, and the way out. Wrapped rather than truncated:
                    // the end of a name is what tells two versions apart.
                    Rectangle {
                        height: 46px;
                        background: Theme.panel-2;

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.line;
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 8px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;

                            Text {
                                text: root.peek-name;
                                color: Theme.ink;
                                font-size: 12.5px;
                                font-weight: 600;
                                wrap: word-wrap;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                Tool {
                                    glyph: "×";
                                    clicked => {
                                        root.peek-toggled();
                                    }
                                }
                            }
                        }
                    }

                    // What can be shown of the file: pages, picture, text, or note.
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 80px;

                        if root.peek-pages.length > 0: doc-box := Rectangle {
                            width: parent.width;
                            height: parent.height;
                            property <length> card-w: max(80px, self.width - 28px);
                            property <length> slot-h: max(80px, self.card-w * root.peek-aspect) + 12px;
                            property <int> current-page: clamp(
                                Math.floor((-doc-view.viewport-y + doc-view.visible-height * 0.35) / self.slot-h),
                                0,
                                max(0, root.peek-pages.length - 1));

                            changed current-page => {
                                root.peek-page-scrolled(self.current-page);
                            }

                            doc-view := ListView {
                                width: parent.width;
                                height: parent.height;
                                for page[idx] in root.peek-pages: Rectangle {
                                    width: doc-view.visible-width;
                                    height: doc-box.slot-h;

                                    Rectangle {
                                        x: 10px;
                                        y: 6px;
                                        width: max(60px, parent.width - 20px);
                                        height: parent.height - 12px;
                                        background: #ffffff;
                                        border-width: Theme.hair;
                                        border-color: Theme.line;
                                        border-radius: 3px;

                                        if page.ready: Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: page.shot;
                                            image-fit: contain;
                                        }

                                        if !page.ready: Text {
                                            text: page.number;
                                            color: #888888;
                                            font-size: 11.5px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                x: parent.width - self.width - 18px;
                                y: 10px;
                                width: page-badge.preferred-width + 14px;
                                height: 22px;
                                border-radius: 11px;
                                background: Theme.dark ? #16181dd9 : #ffffffd9;
                                border-width: Theme.hair;
                                border-color: Theme.line;
                                page-badge := Text {
                                    text: (doc-box.current-page + 1) + " / " + root.peek-pages.length;
                                    color: Theme.ink;
                                    font-family: Fonts.mono;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.peek-pages.length == 0 && root.peek-has-shot: Image {
                            width: parent.width - 24px;
                            height: parent.height - 24px;
                            x: 12px;
                            y: 12px;
                            source: root.peek-shot;
                            // The whole picture: a crop can remove the part being
                            // looked for.
                            image-fit: contain;
                        }

                        if root.peek-pages.length == 0 && !root.peek-has-shot && root.peek-text != "": Flickable {
                            width: parent.width;
                            height: parent.height;
                            // The wheel scrolls; a drag selects. An interactive
                            // flickable takes the drag for itself.
                            interactive: false;
                            viewport-width: self.width;
                            viewport-height: body.preferred-height;

                            body := VerticalLayout {
                                padding: 12px;
                                alignment: start;
                                // A field that cannot be typed into, so the text
                                // can be selected and copied.
                                TextInput {
                                    text: root.peek-text;
                                    read-only: true;
                                    // Read as the caret moves, not on change: a
                                    // `changed` handler missed the last step of a drag.
                                    cursor-position-changed(p) => {
                                        root.peek-from = self.anchor-position-byte-offset;
                                        root.peek-to = self.cursor-position-byte-offset;
                                    }
                                    key-pressed(e) => {
                                        if (e.modifiers.control && (e.text == "c" || e.text == "C")) {
                                            root.copy-span(self.text, self.anchor-position-byte-offset,
                                                self.cursor-position-byte-offset);
                                            return accept;
                                        }
                                        return reject;
                                    }
                                    single-line: false;
                                    color: Theme.ink-2;
                                    font-family: Fonts.mono;
                                    font-size: 11.5px;
                                    wrap: word-wrap;
                                    selection-background-color: Theme.selection;
                                    selection-foreground-color: Theme.ink;
                                }
                            }
                        }

                        if root.peek-pages.length == 0 && !root.peek-has-shot && root.peek-text == "": Text {
                            text: root.peek-note;
                            color: Theme.ink-3;
                            font-size: 11.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    // Where the file holds the text a `content:` query asked
                    // for: each place's line number and the line, the find marked.
                    if root.peek-found.length > 0: Rectangle {
                        vertical-stretch: 0;
                        background: Theme.panel;

                        Rectangle {
                            y: 0;
                            height: 1px;
                            background: Theme.line;
                        }

                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 9px;
                            padding-bottom: 9px;
                            spacing: 2px;
                            alignment: start;

                            Text {
                                text: root.word-found;
                                color: Theme.ink-3;
                                font-size: 11px;
                            }
                            for f in root.peek-found: Rectangle {
                                height: 20px;
                                Text {
                                    x: 0px;
                                    width: 40px;
                                    height: parent.height;
                                    text: f.line;
                                    color: Theme.ink-3;
                                    font-family: Fonts.mono;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Marked {
                                    x: 48px;
                                    width: max(0px, parent.width - 48px);
                                    height: parent.height;
                                    pre: f.pre;
                                    hit: f.hit;
                                    post: f.post;
                                    colour: Theme.ink-2;
                                }
                            }
                        }
                    }

                    // The facts, below the picture. Its own height, because a
                    // path wraps to four lines as readily as one; asking a named
                    // child for `preferred-height` from its parent is a circle.
                    Rectangle {
                        vertical-stretch: 0;
                        background: Theme.panel;

                        Rectangle {
                            y: 0;
                            height: 1px;
                            background: Theme.line;
                        }

                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 9px;
                            padding-bottom: 9px;
                            spacing: 3px;
                            alignment: start;

                            for fact in root.peek-facts: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: fact.label;
                                    color: Theme.ink-3;
                                    font-size: 11px;
                                    width: 74px;
                                    overflow: elide;
                                }
                                Text {
                                    text: fact.value;
                                    color: Theme.ink-2;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            
                // The edge that sets the width, 7px like a column's, and last so
                // it is above what the panel holds. The panel's edge moves with
                // the pointer, so each move is measured from where it now is.
                peekgrip := TouchArea {
                    x: 0;
                    width: 7px;
                    height: parent.height;
                    mouse-cursor: col-resize;
                    moved => {
                        if (self.pressed) {
                            root.peek-width = max(root.peek-min,
                                min(root.peek-max, root.peek-width - (self.mouse-x - self.pressed-x)));
                        }
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up) {
                            root.peek-resized(root.peek-width / 1px);
                        }
                    }
                    double-clicked => {
                        root.peek-width = 380px;
                        root.peek-resized(0);
                    }
                }
            }
        }

        // The time ribbon. Twenty-four bars on a logarithmic scale, so the last
        // day, week and year all have room on one screen. The edges are
        // `scour_ui::bar_edges`, shared with every other face.
        Rectangle {
            visible: root.tab != "report" && root.ribbon-shown;
            min-height: root.tab == "report" || !root.ribbon-shown ? 0px : 76px;
            max-height: root.tab == "report" || !root.ribbon-shown ? 0px : 76px;
            background: Theme.panel;

            // `y` said: a rectangle with only a height is centred in its
            // parent, and this line ran through the middle of the bars.
            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.line;
            }

            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 0px;

                HorizontalLayout {
                    Text {
                        text: root.ribbon-label;
                        color: Theme.ink-3;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                        height: 18px;
                    }
                    Rectangle { }
                    Text {
                        text: root.ribbon-hint;
                        color: Theme.ink-3;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    ribbon-x := TouchArea {
                        width: 22px;
                        height: 18px;
                        mouse-cursor: pointer;
                        clicked => {
                            root.ribbon-shown = false;
                            root.panes-changed();
                        }
                        Text {
                            text: "×";
                            color: ribbon-x.has-hover ? Theme.ink : Theme.ink-3;
                            font-size: 14px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 4px; }

                // The bars take what is left; the axis keeps its line.
                HorizontalLayout {
                    spacing: 3px;
                    alignment: stretch;

                    for b[i] in root.bars: Rectangle {
                        horizontal-stretch: 1;

                        // A bar is a filter: clicking adds a `dm:` term to the
                        // text. The oldest has no upper bound, so it does
                        // nothing and says so by not lighting up.
                        bartouch := TouchArea {
                            mouse-cursor: b.days > 0 ? pointer : default;
                            clicked => {
                                if (b.days > 0) {
                                    root.bar-clicked(b.days);
                                }
                            }
                        }
                        // Bottom-aligned, so twenty-four bars read as one shape.
                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                // A fixed ceiling, not a share of the parent:
                                // that is a binding loop. 22px leaves the axis
                                // its line inside the ribbon's 76.
                                height: b.count == 0 ? 2px
                                    : max(3px, 22px * b.count / max(1, root.bar-peak));
                                // One ink: the axis says how old, not the colour.
                                background: b.count == 0 ? Theme.line : Theme.ink-3;
                                // Lighter under the pointer: a bar that can be
                                // pressed says so before it is.
                                opacity: bartouch.has-hover && b.days > 0 ? 0.75 : 1.0;
                            }
                        }
                    }
                }

                // The axis. Five marks rather than twenty-four: the question is
                // only ever "how far back am I looking".
                HorizontalLayout {
                    padding-top: 3px;

                    Text {
                        text: root.axis-oldest;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: left;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-year;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-month;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-week;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-today;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        // The status bar: how many, how long, how big the index is. At the
        // foot, as a desktop puts it; the answer's count is its first word.
        Rectangle {
            height: 28px;
            background: Theme.ground;

            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;

                // Three claims of different weight: the count is the answer,
                // the cost wears the "today" hue, the walk stays quiet. `meter`
                // holds the sentences that are not numbers; never both at once.
                if root.notice != "": Text {
                    text: root.notice;
                    color: Theme.ink-2;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

                if root.notice == "" && root.meter-count != "": HorizontalLayout {
                    spacing: 6px;

                    Text {
                        text: root.meter-count;
                        color: Theme.ink;
                        font-size: 12.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-ms == "" ? "" : "·";
                        color: Theme.line;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-ms;
                        color: Theme.ink-3;
                        font-size: 11.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-rows == "" ? "" : "·";
                        color: Theme.line;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    // Turning while files are read, and only then: a timer
                    // that ran always would be a window that never rests.
                    if root.reading-stage == 1: Text {
                        property <int> turn;
                        property <[string]> frames: ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
                        text: self.frames[self.turn];
                        color: Theme.q-key;
                        font-size: 12px;
                        vertical-alignment: center;
                        Timer {
                            interval: 90ms;
                            running: true;
                            triggered => { parent.turn = Math.mod(parent.turn + 1, 10); }
                        }
                    }
                    Text {
                        text: root.meter-rows;
                        color: root.reading-stage == 1 ? Theme.q-key : Theme.ink-3;
                        font-size: 11.5px;
                        font-weight: root.reading-stage == 1 ? 600 : 400;
                        vertical-alignment: center;
                    }
                    if root.reading-stage == 2: VerticalLayout {
                        alignment: center;
                        Push {
                            label: root.read-on;
                            plain: true;
                            clicked => { root.reread(false); }
                        }
                    }
                    if root.reading-stage > 0: VerticalLayout {
                        alignment: center;
                        Push {
                            label: root.read-again;
                            plain: true;
                            clicked => { root.reread(true); }
                        }
                    }
                    Text {
                        text: root.scanning == "" ? "" : "·";
                        color: Theme.line;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    // The key colour: the one thing on this line still moving.
                    Text {
                        text: root.scanning;
                        color: Theme.q-key;
                        font-size: 11.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                if root.notice == "" && root.meter-count == "": Text {
                    text: root.meter;
                    color: Theme.ink-3;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

                // What the service is holding, not what it just answered.
                Text {
                    text: root.holding == "" ? "" : "  ·  " + root.holding;
                    color: Theme.ink-3;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle { }

                // A disk waiting for an answer, how every word is read, and
                // the two keys worth knowing. The rail and the ribbon, put
                // away, come back from Settings → List.
                if root.disk-said != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        width: disk-text.preferred-width + 16px;
                        border-radius: 6px;
                        border-width: Theme.hair;
                        border-color: Theme.q-bad;
                        disk-text := Text {
                            text: root.disk-said;
                            color: Theme.q-bad;
                            font-size: 11.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.tool-clicked("settings");
                                root.settings-section = "disks";
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        width: nar-text.preferred-width + 16px;
                        border-radius: 6px;
                        border-width: Theme.hair;
                        border-color: root.narrow-shown ? Theme.cap-ring : nar-touch.has-hover ? Theme.ink-3 : Theme.line;
                        background: root.narrow-shown ? Theme.cap : transparent;
                        nar-text := Text {
                            text: root.word-narrow-pill;
                            color: root.narrow-shown ? Theme.q-key : nar-touch.has-hover ? Theme.ink : Theme.ink-2;
                            font-size: 11.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        nar-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.narrow-toggled(); }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        width: typos-text.preferred-width + 16px;
                        border-radius: 6px;
                        border-width: Theme.hair;
                        border-color: typos-touch.has-hover ? Theme.ink-3 : Theme.line;
                        typos-text := Text {
                            text: root.typos-said;
                            color: typos-touch.has-hover ? Theme.ink : Theme.ink-2;
                            font-size: 11.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        typos-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.typos-picked(root.typos-choice == "" ? "always"
                                    : root.typos-choice == "always" ? "off" : "");
                            }
                        }
                    }
                }
                Text {
                    text: ":  " + root.word-filter-key + "    Alt+T  " + root.word-tab-key;
                    color: Theme.ink-3;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

                if root.note != "": Text {
                    text: root.note;
                    color: Theme.q-key;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.busy: Text {
                    text: "…";
                    color: Theme.focus;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

            }
        }

    }

        // What is selected, flush on top of the status bar at the left edge
        // like a browser's link preview: never hides the status line.
        if root.sel-shown: Rectangle {
            x: -Theme.hair;
            y: parent.height - 28px - self.height + Theme.hair;
            width: min(sel-line.preferred-width, max(180px, parent.width - root.peek-w - 12px));
            height: 28px;
            background: Theme.dark ? Theme.panel-2 : Theme.panel;
            border-width: Theme.hair;
            border-color: Theme.line;
            border-top-right-radius: 6px;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: -2px;
            drop-shadow-color: #0000001a;

            TouchArea {}

            sel-line := HorizontalLayout {
                padding-left: 10px + Theme.hair;
                padding-right: 10px;
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: "×";
                        plain: true;
                        clicked => { root.pick-dropped(); }
                    }
                }
                Rectangle {
                    border-radius: 4px;
                    background: pick-jump.has-hover ? Theme.hover : transparent;
                    pick-jump := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick-focused(); }
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: start;
                        Text {
                            text: root.picked-pre;
                            color: pick-jump.has-hover ? Theme.ink
                                : root.picked-n == "" ? Theme.ink-2 : Theme.ink-3;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: min(420px, max(80px, root.width - root.peek-w - 420px));
                        }
                        Text {
                            text: root.picked-n;
                            color: Theme.ink;
                            font-size: 12px;
                            font-weight: 650;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.picked-post;
                            color: pick-jump.has-hover ? Theme.ink-2 : Theme.ink-3;
                            font-size: 11.5px;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { width: 6px; }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.pick-copy;
                        plain: true;
                        clicked => { root.pick-copied(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.pick-folders;
                        plain: true;
                        asking: root.pick-asking;
                        enabled: root.pick-folders-ok;
                        clicked => { root.pick-opened(); }
                    }
                }
            }
        }

        // What was searched before, hanging over what is under the query row —
        // which is why it is drawn here and not inside that row. Placed at the
        // field's own left edge, since the mark beside it has no fixed width.
        // This area puts it away; behind the list, so a press on a line lands.
        if root.past-open: TouchArea {
            width: parent.width;
            height: parent.height;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.past-open = false;
                }
            }
        }

        if root.past-open && root.past.length > 0: Rectangle {
            width: min(320px, max(220px, field.width * 0.55));
            x: clamp(field.absolute-position.x + field.width - self.width,
                8px, parent.width - self.width - 8px);
            y: field.absolute-position.y + field.height + 4px;
            height: min(root.past.length * 24px + 8px, 152px);
            background: Theme.panel-2;
            border-width: Theme.hair;
            border-color: Theme.line;
            border-radius: 8px;
            clip: true;
            drop-shadow-blur: 14px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 4px;

            TouchArea {}

            past-scroll := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-height: root.past.length * 24px + 8px;
                property <int> follow: root.past-picked;
                changed follow => {
                    let top = 4px + self.follow * 24px;
                    if (top + self.viewport-y < 0px) {
                        self.viewport-y = -top;
                    } else if (top + 24px + self.viewport-y > self.height) {
                        self.viewport-y = self.height - top - 24px;
                    }
                }
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;
                    for line[i] in root.past: Rectangle {
                        height: 24px;
                        background: i == root.past-picked ? Theme.selection
                                  : row-touch.has-hover ? Theme.hover : transparent;
                        border-radius: 4px;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: line;
                            color: Theme.ink;
                            font-family: Fonts.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    root.past-taken(line);
                                }
                            }
                        }
                    }
                }
            }
        }

        }

        // The lens: under the term the caret is on, expanding to a 2-column
        // Miller place explorer or interactive sparkline histogram when needed.
        if root.lens-open && (root.lens-kind == "place" || root.lens-rows.length > 0): Rectangle {
            x: clamp(field.absolute-position.x + field.pad + root.lens-x - 12px,
                8px, root.width - self.width - 8px);
            y: field.absolute-position.y + field.top + (root.lens-line + 1) * root.q-pitch + 4px;
            width: root.lens-kind == "place" ? min(680px, root.width - 20px)
                : (root.lens-kind == "time" || root.lens-kind == "size") ? min(470px, root.width - 20px)
                : min(430px, root.width - 20px);
            height: root.lens-kind == "place" ? min(370px, root.height - self.y - 16px)
                : min(lens-body.preferred-height, 410px);
            background: Theme.panel-2;
            border-width: Theme.hair;
            border-color: Theme.line;
            border-radius: 10px;
            clip: true;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0000005c;
            drop-shadow-offset-y: 6px;

            TouchArea {}

            if root.lens-kind == "place": VerticalLayout {
                HorizontalLayout {
                    vertical-stretch: 1;
                    // Left column: Disks + Places + OS Folder Picker
                    Rectangle {
                        width: 215px;
                        background: Theme.ground;
                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            height: parent.height;
                            background: Theme.line;
                        }
                        VerticalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 2px;
                            Flickable {
                                vertical-stretch: 1;
                                viewport-height: pleft-col.preferred-height;
                                pleft-col := VerticalLayout {
                                    for pl in root.lens-places: VerticalLayout {
                                        if pl.group != "": Rectangle {
                                            height: 20px;
                                            Text {
                                                x: 12px;
                                                text: pl.group;
                                                color: Theme.ink-3;
                                                font-size: 10.5px;
                                                font-weight: 650;
                                                vertical-alignment: bottom;
                                            }
                                        }
                                        Rectangle {
                                            height: 26px;
                                            background: pl.active ? Theme.selection : plhit.has-hover ? Theme.hover : transparent;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 10px;
                                                spacing: 6px;
                                                Text {
                                                    text: pl.label;
                                                    color: Theme.ink;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                                Text {
                                                    text: pl.sub;
                                                    color: pl.ask-disk ? Theme.q-key : Theme.ink-3;
                                                    font-family: Fonts.mono;
                                                    font-size: 10.5px;
                                                    font-weight: pl.ask-disk ? 600 : 400;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            plhit := TouchArea {
                                                mouse-cursor: pointer;
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                        root.lens-place-act(pl.ask-disk ? "disk" : "dir", pl.target);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Rectangle {
                                    height: 28px;
                                    border-radius: 6px;
                                    border-width: Theme.hair;
                                    border-color: pickhit.has-hover ? Theme.ink-3 : Theme.line;
                                    background: pickhit.has-hover ? Theme.hover : Theme.panel;
                                    Text {
                                        text: "📁 " + root.word-choose-folder;
                                        color: Theme.ink-2;
                                        font-size: 12px;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    pickhit := TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                root.lens-place-act("pick", root.lens-place-cur);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Right column: Breadcrumb + Direct switch + Weighted subfolders
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Rectangle {
                            height: 30px;
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.line-soft;
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 3px;
                                if root.lens-place-up != "": Rectangle {
                                    width: 20px;
                                    border-radius: 4px;
                                    background: uphit.has-hover ? Theme.hover : transparent;
                                    Text {
                                        text: "‹";
                                        color: Theme.ink-2;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    uphit := TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                root.lens-place-act("dir", root.lens-place-up);
                                            }
                                        }
                                    }
                                }
                                Flickable {
                                    horizontal-stretch: 1;
                                    interactive: false;
                                    viewport-width: crumb-row.preferred-width;
                                    crumb-row := HorizontalLayout {
                                        spacing: 2px;
                                        alignment: start;
                                        for cr[ci] in root.lens-crumbs: HorizontalLayout {
                                            spacing: 2px;
                                            if ci > 0: Text {
                                                text: "/";
                                                color: Theme.ink-3;
                                                font-family: Fonts.mono;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: crtxt.preferred-width + 8px;
                                                border-radius: 4px;
                                                background: crhit.has-hover ? Theme.hover : transparent;
                                                crtxt := Text {
                                                    text: cr.label;
                                                    color: ci == root.lens-crumbs.length - 1 ? Theme.ink : Theme.ink-2;
                                                    font-family: Fonts.mono;
                                                    font-size: 11.5px;
                                                    font-weight: ci == root.lens-crumbs.length - 1 ? 650 : 500;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                crhit := TouchArea {
                                                    mouse-cursor: pointer;
                                                    pointer-event(e) => {
                                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                            root.lens-place-act("dir", cr.path);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 20px;
                                        width: dirtxt.preferred-width + 12px;
                                        border-radius: 5px;
                                        border-width: Theme.hair;
                                        border-color: root.lens-place-direct ? Theme.cap-ring : Theme.line;
                                        background: root.lens-place-direct ? Theme.cap : dirhit.has-hover ? Theme.hover : transparent;
                                        dirtxt := Text {
                                            text: root.word-direct-only;
                                            color: root.lens-place-direct ? Theme.q-key : Theme.ink-3;
                                            font-size: 10.5px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        dirhit := TouchArea {
                                            mouse-cursor: pointer;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                    root.lens-place-act("flip", root.lens-place-cur);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Apply current folder row
                        Rectangle {
                            height: 28px;
                            background: curhit.has-hover ? Theme.selection : transparent;
                            curhit := TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        root.lens-place-act("choose", root.lens-place-cur);
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                Text {
                                    text: "✓ " + root.word-this-folder + " (" + root.lens-place-shown + ")";
                                    color: Theme.q-key;
                                    font-family: Fonts.mono;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                PairButton {
                                    y: 6px;
                                    label: "+";
                                    pressed => { root.lens-place-act("inc", root.lens-place-cur); }
                                }
                                PairButton {
                                    y: 6px;
                                    label: "!";
                                    pressed => { root.lens-place-act("exc", root.lens-place-cur); }
                                }
                            }
                        }

                        Flickable {
                            vertical-stretch: 1;
                            viewport-height: pdir-col.preferred-height;
                            pdir-col := VerticalLayout {
                                for d in root.lens-dirs: Rectangle {
                                    height: 26px;
                                    background: dhit.has-hover ? Theme.hover : transparent;
                                    if d.bar > 0: Rectangle {
                                        x: 8px;
                                        y: 3px;
                                        height: 20px;
                                        width: (parent.width - 16px) * d.bar * 0.88;
                                        border-radius: 3px;
                                        background: Theme.line-soft;
                                    }
                                    dhit := TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                root.lens-place-act("dir", d.path);
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        Text {
                                            text: d.name;
                                            color: Theme.ink;
                                            font-family: Fonts.mono;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: d.meta;
                                            color: Theme.ink-3;
                                            font-family: Fonts.mono;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        PairButton {
                                            y: 5px;
                                            label: "+";
                                            pressed => { root.lens-place-act("inc", d.path); }
                                        }
                                        PairButton {
                                            y: 5px;
                                            label: "!";
                                            pressed => { root.lens-place-act("exc", d.path); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    height: 26px;
                    Text {
                        text: root.lens-foot;
                        color: Theme.ink-3;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            lens-flick := Flickable {
                visible: root.lens-kind != "place";
                viewport-height: lens-body.preferred-height;
                property <int> sel: root.lens-sel;
                changed sel => {
                    let at = 30px + self.sel * 26px;
                    if (at + 30px + self.viewport-y > self.height) {
                        self.viewport-y = self.height - at - 30px;
                    }
                    if (at + self.viewport-y < 30px) {
                        self.viewport-y = min(0px, 30px - at);
                    }
                }
                lens-body := VerticalLayout {
                    padding-top: 4px;
                    padding-bottom: 4px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        height: 24px;
                        Text {
                            text: root.lens-title;
                            color: Theme.ink-2;
                            font-size: 11.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if !root.cal-open: Text {
                            text: root.lens-said;
                            color: Theme.ink-3;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        if root.lens-kind == "time": HorizontalLayout {
                            padding-left: 8px;
                            VerticalLayout {
                                alignment: center;
                                // Said plainly: a picture and the accent, so a
                                // calendar is seen to be there.
                                cal-button := Rectangle {
                                    height: 26px;
                                    width: cal-row.preferred-width + 20px;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: Theme.cap-ring;
                                    background: root.cal-open ? Theme.cap-ring : cal-touch.has-hover ? Theme.hover : Theme.cap;
                                    cal-row := HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                width: 14px;
                                                height: 14px;
                                                source: @image-url("icons/tools/lens-time.svg");
                                                colorize: Theme.q-key;
                                            }
                                        }
                                        Text {
                                            text: root.word-calendar;
                                            color: Theme.q-key;
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    cal-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.cal-open = !root.cal-open;
                                            root.cal-from = -1;
                                            root.cal-to = -1;
                                            if (root.cal-open) {
                                                root.cal-opened();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Two months side by side: a press picks the first day, a
                    // second the last, the days between lit as the pointer moves.
                    if root.cal-open && root.lens-kind == "time": VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 2px;
                        padding-bottom: 8px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 20px;
                            alignment: center;
                            for mo[mi] in root.cal-months: VerticalLayout {
                                spacing: 2px;
                                HorizontalLayout {
                                    height: 26px;
                                    if mi == 0: CalArrow {
                                        label: "‹";
                                        clicked => { root.cal-shift(-1); }
                                    }
                                    if mi != 0: Rectangle { width: 24px; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: mo.title;
                                        color: Theme.ink;
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    if mi == root.cal-months.length - 1: CalArrow {
                                        label: "›";
                                        clicked => { root.cal-shift(1); }
                                    }
                                    if mi != root.cal-months.length - 1: Rectangle { width: 24px; }
                                }
                                HorizontalLayout {
                                    for wd in root.cal-week: Text {
                                        width: 28px;
                                        height: 18px;
                                        text: wd;
                                        color: Theme.ink-3;
                                        font-size: 10.5px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                for wk in [0, 1, 2, 3, 4, 5]: HorizontalLayout {
                                    for dd in [0, 1, 2, 3, 4, 5, 6]: CalCell {
                                        day: mo.days[wk * 7 + dd];
                                        from: root.cal-from;
                                        to: root.cal-to;
                                        hover: root.cal-hover;
                                        entered(n) => { root.cal-hover = n; }
                                        left(n) => {
                                            if (root.cal-hover == n) {
                                                root.cal-hover = -1;
                                            }
                                        }
                                        picked(n) => {
                                            if (root.cal-from < 0 || root.cal-to >= 0) {
                                                root.cal-from = n;
                                                root.cal-to = -1;
                                            } else {
                                                root.cal-to = n;
                                                root.lens-cal-range(root.cal-from, n);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Text {
                            text: root.cal-hint;
                            color: Theme.ink-3;
                            font-size: 10.5px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    // Interactive Sparkline Scrubber for Time & Size lenses
                    if !root.cal-open && (root.lens-kind == "time" || root.lens-kind == "size") && root.lens-rows.length > 0: VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 6px;
                        spacing: 3px;
                        spark-box := Rectangle {
                            height: 48px;
                            property <bool> dragging: false;
                            property <int> drag-a: root.lens-sel;
                            property <int> drag-b: root.lens-sel;
                            HorizontalLayout {
                                spacing: 5px;
                                for srow[si] in root.lens-rows: Rectangle {
                                    horizontal-stretch: 1;
                                    property <bool> lit: spark-box.dragging
                                        ? (si >= min(spark-box.drag-a, spark-box.drag-b) && si <= max(spark-box.drag-a, spark-box.drag-b))
                                        : si == root.lens-sel;
                                    Rectangle {
                                        width: parent.width;
                                        height: max(4px, (parent.height - 6px) * max(0.08, srow.bar));
                                        y: parent.height - self.height;
                                        border-radius: 3px;
                                        background: parent.lit ? Theme.q-key : Theme.k3.with-alpha(0.65);
                                    }
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                function idx-at(x: length) -> int {
                                    return clamp(
                                        Math.floor(x * root.lens-rows.length / max(1px, spark-box.width)),
                                        0,
                                        max(0, root.lens-rows.length - 1));
                                }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        let idx = self.idx-at(self.mouse-x);
                                        spark-box.dragging = true;
                                        spark-box.drag-a = idx;
                                        spark-box.drag-b = idx;
                                    }
                                    if (e.kind == PointerEventKind.up && spark-box.dragging) {
                                        spark-box.dragging = false;
                                        root.lens-spark-range(spark-box.drag-a, spark-box.drag-b);
                                    }
                                }
                                moved => {
                                    if (spark-box.dragging) {
                                        spark-box.drag-b = self.idx-at(self.mouse-x);
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 5px;
                            for srow in root.lens-rows: Text {
                                horizontal-stretch: 1;
                                text: srow.hint != "" ? srow.hint : srow.label;
                                color: Theme.ink-3;
                                font-family: Fonts.mono;
                                font-size: 10px;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: root.word-spark-hint;
                            color: Theme.ink-3;
                            font-size: 10.5px;
                            horizontal-alignment: right;
                        }
                        Rectangle { height: 1px; background: Theme.line-soft; }
                    }

                    if !(root.cal-open && root.lens-kind == "time"): VerticalLayout {
                        for row[i] in root.lens-rows: VerticalLayout {
                            if row.group != "": Rectangle {
                                height: row.group == " " ? 7px : 20px;
                                Rectangle {
                                    visible: row.group == " ";
                                    y: 3px;
                                    height: 1px;
                                    background: Theme.line;
                                }
                                Text {
                                    x: 12px;
                                    visible: row.group != " ";
                                    text: row.group;
                                    color: Theme.ink-3;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: bottom;
                                    height: parent.height - 2px;
                                }
                            }
                            Rectangle {
                                height: 26px;
                                background: i == root.lens-sel ? Theme.selection
                                          : lens-touch.has-hover ? Theme.hover : transparent;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 7px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: row.label;
                                            color: row.zero || row.wait ? Theme.ink-3 : Theme.ink;
                                            font-size: 12.5px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: row.hint;
                                            color: Theme.ink-3;
                                            font-family: Fonts.mono;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    if row.reads: Text {
                                        text: root.lens-foot == "" ? "" : root.lens-reads;
                                        color: Theme.q-bad;
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                    }
                                    if !row.reads: Rectangle {
                                        width: 56px;
                                        Rectangle {
                                            y: (parent.height - 5px) / 2;
                                            height: 5px;
                                            border-radius: 3px;
                                            background: row.n == "" ? transparent : Theme.line-soft;
                                            Rectangle {
                                                x: 0;
                                                width: parent.width * row.bar;
                                                height: parent.height;
                                                border-radius: 3px;
                                                background: Theme.k3;
                                            }
                                        }
                                    }
                                    if !row.reads: Text {
                                        width: 72px;
                                        text: row.n;
                                        color: row.zero ? Theme.ink-3 : Theme.ink-2;
                                        font-family: Fonts.mono;
                                        font-size: 11.5px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                                lens-touch := TouchArea {
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                            root.lens-pick(i, row.stays);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.lens-kind == "word": HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 6px;
                        Text {
                            text: root.typos-said;
                            color: Theme.ink-2;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Push {
                            label: root.typos-choice == "always" ? "✓" : "≈";
                            plain: true;
                            clicked => {
                                root.typos-picked(root.typos-choice == "" ? "always"
                                    : root.typos-choice == "always" ? "off" : "");
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 6px;
                        padding-bottom: 2px;
                        Text {
                            text: root.lens-foot;
                            color: Theme.ink-3;
                            font-size: 11.5px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // A press anywhere outside an open panel closes it, and goes no
        // further: it is not also a press on the row under it. Before the
        // panels, so a press on one reaches the panel first.
        if root.panel != "": TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { root.panel = ""; }
        }

        // The panels were here; the settings are a page of their own, below.
    // --- the question that comes before a change --------------------------
    // Same shape as the menu overlay: a full-window sheet so the click that
    // answers does not also land on the list. This one dims what is behind it.
    if root.ask-open: AskSheet {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        ask-open <=> root.ask-open;
        ask-answer(a0) => { root.ask-answer(a0); }
        ask-title: root.ask-title;
        ask-body: root.ask-body;
        ask-typing <=> root.ask-typing;
        ask-text <=> root.ask-text;
        focus-query() => { root.focus-query(); }
        ask-no: root.ask-no;
        ask-yes: root.ask-yes;
    }

    // --- the settings page -------------------------------------------------
    // Over everything but the menu and the question, which can open from it.
    if root.panel == "settings": SettingsPage {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        panel <=> root.panel;
        settings-title: root.settings-title;
        section-labels: root.section-labels;
        settings-section <=> root.settings-section;
        settings-picked(a0) => { root.settings-picked(a0); }
        disk-question: root.disk-question;
        armed-face <=> root.armed-face;
        restart-as: root.restart-as;
        face-tui: root.face-tui;
        face-web: root.face-web;
        word-restart: root.word-restart;
        face-picked(a0) => { root.face-picked(a0); }
        settings-foot: root.settings-foot;
        section-at: root.section-at;
        section-leads: root.section-leads;
        service-offered: root.service-offered;
        service-state: root.service-state;
        service-note: root.service-note;
        service-push: root.service-push;
        service-busy: root.service-busy;
        service-switch() => { root.service-switch(); }
        service-active: root.service-active;
        set-autostart: root.set-autostart;
        set-autostart-note: root.set-autostart-note;
        grid-labels: root.grid-labels;
        autostart-on: root.autostart-on;
        autostart-picked(a0) => { root.autostart-picked(a0); }
        set-language: root.set-language;
        set-language-note: root.set-language-note;
        lang-labels: root.lang-labels;
        lang-tokens: root.lang-tokens;
        language-choice: root.language-choice;
        language-picked(a0) => { root.language-picked(a0); }
        set-face: root.set-face;
        set-face-note: root.set-face-note;
        face-labels: root.face-labels;
        face-default: root.face-default;
        face-default-picked(a0) => { root.face-default-picked(a0); }
        set-theme: root.set-theme;
        set-theme-note: root.set-theme-note;
        theme-labels: root.theme-labels;
        theme-picked(a0) => { root.theme-picked(a0); }
        set-zoom: root.set-zoom;
        set-zoom-note: root.set-zoom-note;
        zoom-labels: root.zoom-labels;
        zoom-choice: root.zoom-choice;
        zoom-picked(a0) => { root.zoom-picked(a0); }
        set-switch: root.set-switch;
        face-window: root.face-window;
        face-window-aside: root.face-window-aside;
        face-tui-note: root.face-tui-note;
        face-tui-ready: root.face-tui-ready;
        face-tui-aside: root.face-tui-aside;
        face-web-note: root.face-web-note;
        set-layout: root.set-layout;
        layout-labels: root.layout-labels;
        view-mode <=> root.view-mode;
        view-clicked(a0) => { root.view-clicked(a0); }
        set-columns: root.set-columns;
        set-columns-note: root.set-columns-note;
        set-columns-push: root.set-columns-push;
        columns-clicked(a0, a1) => { root.columns-clicked(a0, a1); }
        set-preview: root.set-preview;
        set-preview-note: root.set-preview-note;
        preview-on: root.preview-on;
        peek-toggled() => { root.peek-toggled(); }
        set-refresh: root.set-refresh;
        set-refresh-note: root.set-refresh-note;
        refresh-labels: root.refresh-labels;
        refresh-choice: root.refresh-choice;
        refresh-picked(a0) => { root.refresh-picked(a0); }
        set-system-icons: root.set-system-icons;
        set-system-icons-note: root.set-system-icons-note;
        system-icons: root.system-icons;
        system-icons-picked(a0) => { root.system-icons-picked(a0); }
        set-rail: root.set-rail;
        set-rail-note: root.set-rail-note;
        rail-shown <=> root.rail-shown;
        panes-changed() => { root.panes-changed(); }
        set-ribbon: root.set-ribbon;
        set-ribbon-note: root.set-ribbon-note;
        ribbon-shown <=> root.ribbon-shown;
        set-grid: root.set-grid;
        set-grid-note: root.set-grid-note;
        grid-lines: root.grid-lines;
        grid-picked(a0) => { root.grid-picked(a0); }
        set-grid-columns: root.set-grid-columns;
        set-grid-columns-note: root.set-grid-columns-note;
        grid-columns: root.grid-columns;
        grid-columns-picked(a0) => { root.grid-columns-picked(a0); }
        set-accents: root.set-accents;
        set-accents-note: root.set-accents-note;
        accents-ignored: root.accents-ignored;
        accents-picked(a0) => { root.accents-picked(a0); }
        set-typos: root.set-typos;
        set-typos-note: root.set-typos-note;
        typos-labels: root.typos-labels;
        typos-choice: root.typos-choice;
        typos-picked(a0) => { root.typos-picked(a0); }
        set-typos-rule: root.set-typos-rule;
        set-typos-rule-note: root.set-typos-rule-note;
        typos-rule-labels: root.typos-rule-labels;
        typos-strict: root.typos-strict;
        typos-strict-picked(a0) => { root.typos-strict-picked(a0); }
        set-field-words: root.set-field-words;
        set-field-words-note: root.set-field-words-note;
        field-words-labels: root.field-words-labels;
        field-words: root.field-words;
        field-words-picked(a0) => { root.field-words-picked(a0); }
        set-tabs: root.set-tabs;
        set-tabs-note: root.set-tabs-note;
        tabs-on: root.tabs-on;
        tabs-picked(a0) => { root.tabs-picked(a0); }
        set-search-hint: root.set-search-hint;
        disk-later: root.disk-later;
        disk-answered(a0) => { root.disk-answered(a0); }
        disk-never: root.disk-never;
        disk-yes: root.disk-yes;
        disks-note: root.disks-note;
        disks: root.disks;
        disk-toggled(a0, a1) => { root.disk-toggled(a0, a1); }
        rescan-root(a0) => { root.rescan-root(a0); }
        disks-none: root.disks-none;
        disks-after: root.disks-after;
        set-later: root.set-later;
        set-removable: root.set-removable;
        set-removable-note: root.set-removable-note;
        removable-labels: root.removable-labels;
        removable-choice: root.removable-choice;
        policy-picked(a0, a1) => { root.policy-picked(a0, a1); }
        set-network: root.set-network;
        set-network-note: root.set-network-note;
        network-labels: root.network-labels;
        network-choice: root.network-choice;
        set-optical: root.set-optical;
        set-optical-note: root.set-optical-note;
        optical-labels: root.optical-labels;
        optical-choice: root.optical-choice;
        set-folders: root.set-folders;
        set-folders-note: root.set-folders-note;
        folder-rows: root.folder-rows;
        folder-on-labels: root.folder-on-labels;
        folder-switched(a0, a1) => { root.folder-switched(a0, a1); }
        folder-watch-labels: root.folder-watch-labels;
        folder-watched(a0, a1) => { root.folder-watched(a0, a1); }
        folder-dropped(a0) => { root.folder-dropped(a0); }
        folder-typed <=> root.folder-typed;
        folder-added(a0) => { root.folder-added(a0); }
        folder-hint: root.folder-hint;
        folder-add: root.folder-add;
        folder-error: root.folder-error;
        set-every: root.set-every;
        set-every-note: root.set-every-note;
        every-labels: root.every-labels;
        every-choice: root.every-choice;
        rules-added-title: root.rules-added-title;
        rules-added-note: root.rules-added-note;
        rules-added: root.rules-added;
        rules-off-word: root.rules-off-word;
        rule-toggled(a0) => { root.rule-toggled(a0); }
        rule-dropped(a0, a1) => { root.rule-dropped(a0, a1); }
        rule-kept <=> root.rule-kept;
        rule-added(a0) => { root.rule-added(a0); }
        rules-hint: root.rules-hint;
        rules-add: root.rules-add;
        rules-config-title: root.rules-config-title;
        rules-config-note: root.rules-config-note;
        rules-config: root.rules-config;
        rules-builtin-title: root.rules-builtin-title;
        rules-builtin-note: root.rules-builtin-note;
        rules-builtin: root.rules-builtin;
        key-title: root.key-title;
        key-bound: root.key-bound;
        key-state: root.key-state;
        key-command: root.key-command;
        key-copy: root.key-copy;
        key-command-copied() => { root.key-command-copied(); }
        key-can-bind: root.key-can-bind;
        key-typed <=> root.key-typed;
        key-kept <=> root.key-kept;
        key-typed-changed(a0) => { root.key-typed-changed(a0); }
        key-bind-pressed() => { root.key-bind-pressed(); }
        key-hint: root.key-hint;
        key-bind: root.key-bind;
        key-remove: root.key-remove;
        key-remove-pressed() => { root.key-remove-pressed(); }
        key-error: root.key-error;
        key-preview: root.key-preview;
        key-later: root.key-later;
        set-help: root.set-help;
        help-body: root.help-body;
        set-memory: root.set-memory;
        set-memory-note: root.set-memory-note;
        memory-labels: root.memory-labels;
        memory-choice: root.memory-choice;
        perf-picked(a0, a1) => { root.perf-picked(a0, a1); }
        set-narrow: root.set-narrow;
        set-narrow-note: root.set-narrow-note;
        narrow-on: root.narrow-on;
        set-threads: root.set-threads;
        set-threads-note: root.set-threads-note;
        threads-labels: root.threads-labels;
        threads-choice: root.threads-choice;
        set-fresh: root.set-fresh;
        set-fresh-note: root.set-fresh-note;
        fresh-labels: root.fresh-labels;
        fresh-choice: root.fresh-choice;
        set-index-where: root.set-index-where;
        index-dir: root.index-dir;
        index-facts: root.index-facts;
        set-index-open: root.set-index-open;
        index-open() => { root.index-open(); }
        set-index-tidy: root.set-index-tidy;
        set-index-tidy-note: root.set-index-tidy-note;
        set-index-tidy-push: root.set-index-tidy-push;
        index-tidy() => { root.index-tidy(); }
        set-texts: root.set-texts;
        set-texts-note: root.set-texts-note;
        texts-on: root.texts-on;
        set-texts-kept: root.set-texts-kept;
        texts-facts: root.texts-facts;
        set-texts-clear: root.set-texts-clear;
        texts-forget() => { root.texts-forget(); }
        set-texts-ahead: root.set-texts-ahead;
        set-texts-ahead-note: root.set-texts-ahead-note;
        texts-ahead-on: root.texts-ahead-on;
        set-texts-move: root.set-texts-move;
        texts-move() => { root.texts-move(); }
        set-index-reset: root.set-index-reset;
        set-index-reset-sure: root.set-index-reset-sure;
        set-index-reset-note: root.set-index-reset-note;
        set-index-reset-push: root.set-index-reset-push;
        set-index-cancel: root.set-index-cancel;
        set-index-reset-yes: root.set-index-reset-yes;
        index-reset() => { root.index-reset(); }
        index-said: root.index-said;
        about-body: root.about-body;
    }

    // Elevated Zero-Hit Similar Rescue Card when a search finds nothing.
    // Away while the lens is open: drawn above the card, they would lie over it.
    if root.similar-said != "" && root.panel == "" && !root.grep-active && !root.lens-open: Rectangle {
        x: list.absolute-position.x + (list.width - self.width) / 2;
        y: list.absolute-position.y + 68px;
        width: min(500px, list.width - 32px);
        height: sim-col.preferred-height + 24px;
        background: Theme.ground;
        border-radius: 10px;
        border-width: Theme.hair;
        border-color: Theme.line;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000033;
        drop-shadow-offset-y: 4px;

        sim-col := VerticalLayout {
            x: 16px;
            y: 12px;
            width: parent.width - 32px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.similar-said;
                    color: Theme.ink;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Rectangle {
                    height: 20px;
                    width: sqtxt.preferred-width + 12px;
                    border-radius: 5px;
                    background: Theme.cap;
                    sqtxt := Text {
                        text: root.similar-query;
                        color: Theme.q-key;
                        font-family: Fonts.mono;
                        font-size: 11.5px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Push {
                    label: root.similar-show;
                    asking: true;
                    clicked => { root.similar-clicked(); }
                }
                Push {
                    label: root.word-similar-always;
                    clicked => { root.typos-picked("always"); }
                }
            }
        }
    }

    // Nothing found: each filter, left out on its own, and what would then be
    // found. A press takes that filter out.
    if root.offers.length > 0 && root.panel == "" && !root.grep-active && !root.lens-open: Rectangle {
        x: list.absolute-position.x + (list.width - self.width) / 2;
        y: list.absolute-position.y + (root.similar-said != "" ? 168px : 104px);
        width: max(offers-col.preferred-width, 200px);
        height: offers-col.preferred-height;
        offers-col := VerticalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: root.offers-said;
                color: Theme.ink-3;
                font-size: 12.5px;
                horizontal-alignment: center;
            }
            for o[i] in root.offers: Rectangle {
                height: 26px;
                border-radius: 6px;
                border-width: Theme.hair;
                border-color: offer-touch.has-hover ? Theme.ink-3 : Theme.line;
                background: Theme.panel;
                // A layout, so the button is as wide as what it says.
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: o;
                        color: offer-touch.has-hover ? Theme.ink : Theme.ink-2;
                        font-size: 12.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                offer-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.offer-taken(i); }
                }
            }
        }
    }

    // Back to the top in one click, once the list has left it: how many files
    // arrived above meanwhile, when some did. Over the list's corner, above
    // everything but the menu.
    if root.first-row > 0 && root.panel == "": top-pill := Rectangle {
        x: (root.grid ? tiles.absolute-position.x + tiles.width : list.absolute-position.x + list.width)
            - self.width - 14px;
        y: (root.grid ? tiles.absolute-position.y + tiles.height : list.absolute-position.y + list.height)
            - self.height - 14px;
        width: pill-text.preferred-width + 26px;
        height: 30px;
        border-radius: 15px;
        // A shade darker than the list under it, so it reads as a button.
        background: pill-hit.has-hover ? Theme.hover : Theme.panel-2;
        border-width: Theme.hair;
        border-color: root.new-above > 0 ? Theme.q-key : Theme.ink-3;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #0000002e;
        pill-text := Text {
            text: root.new-above > 0
                ? "↑ " + root.new-above + " " + root.word-new
                : "↑ " + root.word-top;
            color: root.new-above > 0 ? Theme.q-key : Theme.ink;
            font-size: 12.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        pill-hit := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.new-above = 0;
                root.scroll-to(0px);
            }
        }
    }

    // --- the right-click menu --------------------------------------------
    // Last child of the window, which is what puts it on top: Slint draws
    // siblings in declaration order and has no z-index. The full-window sheet
    // under it stops the dismissing click reaching a row or a heading.
    if root.menu-open: RowMenu {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        menu-open <=> root.menu-open;
        menu-x <=> root.menu-x;
        menu-y <=> root.menu-y;
        menu-columns <=> root.menu-columns;
        menu-title: root.menu-title;
        menu-ktoken: root.menu-ktoken;
        menu-tint: root.menu-tint;
        menu-detail: root.menu-detail;
        menu-strip: root.menu-strip;
        menu-pick(a0) => { root.menu-pick(a0); }
        menu: root.menu;
        column-toggled(a0) => { root.column-toggled(a0); }
    }

    // Never drawn: what `name-advance` and `cell-advance` measure.
    name-probe := Text {
        visible: false;
        text: "00000000000000000000";
        font-family: Fonts.mono;
        font-size: 13px;
    }
    kind-probe := Text {
        visible: false;
        text: root.kind-words;
        font-size: Fonts.small;
    }
    cell-probe := Text {
        visible: false;
        text: "00000000000000000000";
        font-family: Fonts.mono;
        font-size: 11.5px;
    }

    // A moment's rest before the tip appears; a click skips it.
    Timer {
        interval: 450ms;
        running: root.tip-pending != "" && root.tip-text == "";
        triggered => { root.tip-text = root.tip-pending; }
    }

    // Cell tooltip sized dynamically to its content up to the window's width;
    // `tip-probe` has no wrap so `preferred-width` avoids any layout cycle.
    tip-probe := Text {
        visible: false;
        text: root.tip-text;
        font-family: root.tip-mono ? Fonts.mono : "";
        font-size: root.tip-mono ? 11.5px : Fonts.small;
        overflow: elide;
    }

    if root.tip-text != "": Rectangle {
        property <length> cap-w: max(120px, min(880px, root.width - 16px));
        width: clamp(tip-probe.preferred-width + 22px, 44px, self.cap-w);
        height: tip-label.preferred-height + 12px;
        x: max(8px, min(root.tip-x, root.width - self.width - 8px));
        y: root.tip-y + self.height > root.height - 8px
            ? root.tip-y - self.height - Theme.row-height - 4px : root.tip-y;
        background: Theme.panel;
        border-width: Theme.hair;
        border-color: Theme.line;
        border-radius: 4px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000060;
        drop-shadow-offset-y: 4px;
        tip-label := Text {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            text: root.tip-text;
            color: Theme.ink;
            font-family: root.tip-mono ? Fonts.mono : "";
            font-size: root.tip-mono ? 11.5px : Fonts.small;
            wrap: word-wrap;
        }
    }
}
