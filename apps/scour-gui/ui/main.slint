// The window. Everything here is driven from Rust: rows arrive as a model,
// counts as properties, and every decision that needs the query language is
// made on the other side and handed over already answered.

import { Theme, Fonts } from "theme.slint";

// Re-exported for the generated Rust API.
export { Theme, Fonts }
import { DragTray } from "tray.slint";
export { DragTray }
import { ListView, ScrollView } from "std-widgets.slint";

/// One cell of one row, already formatted by Rust: text plus what is needed to
/// draw it — an alignment, a colour band, the three pieces of a name.
export struct Cell {
    // Which column this is. The name and its icon are found by this rather
    // than by position, which somebody chooses.
    id: string,
    text: string,
    // Before the match, the match, after it. Empty for every column but `name`.
    pre: string,
    hit: string,
    post: string,
    // Age band of a time column, 0 (minutes) to 5 (older); -1 means no colour.
    age: int,
    // Numbers read right-aligned; words do not.
    right: bool,
    // A monospaced column: sizes, dates, modes, owners.
    mono: bool,
    // Drawn in the quiet ink: a value the volume does not record.
    dim: bool,
    // Hover text, where the column has more to say than fits.
    hint: string,
}

/// One column heading, in the order the table shows them.
export struct HeadInfo {
    id: string,
    label: string,
    // What `sort:` this heading asks for. Empty means it cannot be sorted by.
    sort: string,
    right: bool,
}

/// One place a `content:` query found its text in a file: the line's number
/// and the line cut in three at the find. See `scour_core::FoundLine`.
export struct Found {
    line: string,
    pre: string,
    hit: string,
    post: string,
}

export struct PlaceLeft {
    group: string,
    label: string,
    sub: string,
    target: string,
    ask-disk: bool,
    active: bool,
}

export struct PlaceCrumb {
    label: string,
    path: string,
}

export struct PlaceDir {
    name: string,
    path: string,
    meta: string,
    bar: float,
}

export struct GrepItem {
    header: bool,
    file-idx: int,
    cells: [Cell],
    ktoken: string,
    tint: brush,
    // The extension as the icon spells it, `PDF`; empty when it has none.
    ext: string,
    name: string,
    dir: string,
    count: string,
    line: string,
    pre: string,
    hit: string,
    post: string,
}

export struct Row {
    // One per shown column, in the order they are shown. Rebuilt only when the
    // chosen columns change; widths travel separately in `cw`.
    cells: [Cell],
    // Where a `content:` query found its text in this file; empty otherwise.
    found: [Found],
    // The whole name, whether or not the name column is shown: the tiles have
    // no columns, so what they draw cannot come out of the cell list.
    name: string,
    // The whole path. Not drawn; it is what opening and copying the row read.
    path: string,
    // Arrived since the last answer. Marks the event, not the row: it is shown
    // arriving and then stops being shown.
    fresh: bool,
    // The kind's own token — `folder`, `code`, `build` — never translated; it
    // picks the icon and its colour.
    ktoken: string,
    tint: brush,
    // The extension as the icon spells it, `PDF`, or empty: a folder, a name
    // with none, or one too long to fit on the icon.
    ext: string,
    is-dir: bool,
    // Which age band the row falls in, 0 (minutes) to 5 (older).
    age: int,
    // In the selection; several rows can be, and an action takes all of them.
    picked: bool,
    // The desktop's own thumbnail, when one has been made. Filled in after the
    // row lands, not with it: a page is two hundred rows and the eye is on thirty.
    thumb: image,
    // Whether `thumb` holds one, said as a flag: asking the `image` its width
    // once per glyph condition per row took an idle window from 22% to 49%.
    shot: bool,
    // The desktop's native file or folder icon, when `system-icons` is on.
    sys-icon: image,
    has-sys-icon: bool,
    // Opening it would start a program (`scour_core::runs_when_opened`): a
    // double-click shows it in its folder instead.
    runs: bool,
}

/// A slot of the detail list and the row it is showing; `i` is -1 past the
/// end. See `Slots` in `rows.rs`.
export struct Slot {
    i: int,
    row: Row,
}

/// One line of the preview panel's fact list: a label and a value, both already
/// formatted. Which facts, and in what order, is `scour_ui::preview::FACTS`.
export struct Fact {
    label: string,
    value: string,
}

/// One page of a scrollable document preview (PDF or Office).
export struct PeekPage {
    number: int,
    ready: bool,
    shot: image,
}

// One bar of the time ribbon: how many files fall in it, and which of the six
// age bands it is — the same band the rows' dates are painted with.
export struct Bar {
    count: int,
    // Upper bound in days; `0` for the oldest, which has none.
    days: int,
    band: int,
    // What the bar covers, already worded.
    about: string,
}

// One line of the right-click menu, as `scour_ui::menu` holds it. The window
// does not know what any of these mean: it draws them and sends `id` back.
export struct MenuItem {
    // Sent back on press. Never translated.
    id: string,
    // Already translated, and carrying the count where there is one.
    label: string,
    // Printed at the right, quietly.
    key: string,
    // Draw a rule above this one: it starts a new group.
    rule: bool,
    // Reversible, but it changes something — drawn in the danger colour.
    careful: bool,
    // Starts more programs than there are hands, and asks first — drawn dim.
    heavy: bool,
    // Shown with a tick: a switch rather than an action.
    on: bool,
    // Cannot be pressed — the last column standing is this.
    off: bool,
    // Which drawing stands beside it, by `scour_ui::menu` name; empty for none.
    icon: string,
}

// One skip rule. Off is a note kept beside the index, not a deletion, so the
// groups this window cannot edit can still be switched off.
export struct Rule {
    id: string,
    value: string,
    kind: string,
    off: bool,
    removable: bool,
}

// One disk: whether it is indexed, what it is, and where it is mounted. A disk
// `config.toml` names is `fixed`: only the file changes it.
export struct Disk {
    id: string,
    name: string,
    aside: string,
    roots: string,
    on: bool,
    fixed: bool,
    // How it is kept up to date: files, watched live or last walked, last change.
    status: string,
    walking: bool,
    // The root a refresh walks again.
    root: string,
}

// One folder in the report: what it weighs, what share of its parent that is,
// and how those bytes are spread over the six age bands.
export struct Kid {
    name: string,
    path: string,
    size: string,
    share: string,
    files: string,
    // The bar behind the name: this folder against the heaviest one. Computed
    // in Rust, as `Facet.share` is, and for the same reason.
    bar: float,
    // The last row — everything not given a row of its own. It has no age
    // strip, no file count and nothing to descend into.
    rest: bool,
    a0: float,
    a1: float,
    a2: float,
    a3: float,
    a4: float,
    a5: float,
}

// One piece of a segmented bar, as fractions of the bar's whole length, with
// the tone to paint it and the word it is wide enough to carry. Which tones
// the index means is the strip's own business: the age strip reads `t0..t5`,
// the folder strip `k0..k5` and 6 for the folded rest.
export struct Seg {
    start: float,
    width: float,
    tone: int,
    // Empty unless the segment is wide enough — decided in Rust against the
    // strip's own width, because a text measuring itself inside a box whose
    // width comes from the parent is the binding loop this window has hit.
    label: string,
}

// One slice of the report's ring: the arc as SVG commands in the ring's own
// 150-unit box, and the legend line beside it. The commands are built in Rust
// so the arithmetic lives with the rest of the shares.
export struct Slice {
    commands: string,
    tone: int,
    label: string,
    count: string,
    percent: string,
    // The query term a press adds. Empty for the folded rest, which is not one.
    token: string,
}

// One of the heaviest files: its name, the folder it sits in under the scope,
// what it weighs, and the bar behind it against the largest.
export struct Big {
    name: string,
    dir: string,
    size: string,
    share: float,
    path: string,
}

// One group of files that might be the same file. `proven` is whether the
// checking got as far as reading them: only then is "duplicate" the word.
export struct Dupe {
    size: string,
    times: string,
    certainty: string,
    proven: bool,
    paths: string,
}

// One coloured run of the query, as `Request::Explain` cut it. A window that
// tokenised the query itself would be a second parser.
export struct Span {
    text: string,
    // 0 nothing in particular · 1 field, comparison, `or` · 2 value or phrase
    // 3 wildcard · 4 exclusion · 5 read as text · 6 the word being looked for
    // 7 the syntax between terms, said quietly
    role: int,
    // Part of a term that must NOT match. The role does not say: `pdf` in
    // `!ext:pdf` is a value, and the exclusion role covers the `!` alone.
    not: bool,
    // The column it starts at, in CHARACTERS, on its `line`.
    at: int,
    // Which drawn line of the query it is on, counted from the first.
    line: int,
    // Where it is drawn, from the field's padding: columns are not all one
    // width, a filter's header is narrower. Rust places it.
    x: length,
    // Part of a header: drawn small and close.
    small: bool,
}

// A capsule behind a filter in the query, one per line it is drawn on.
export struct Cap {
    line: int,
    at: int,
    len: int,
    // Characters of the locked `field:` header on this line.
    head: int,
    // 0 a filter · 1 `content:`, which reads files · 2 excluded
    tone: int,
    // The pointer is on it.
    hov: bool,
    // The filter's field, by its canonical name: `dm`, `under`, `fuzzy`…
    field: string,
    // Its header drawn as what it does — a clock, a folder, ≈ — when the
    // caret is not in it and the settings ask for drawings.
    icon: bool,
    // What the drawing stands for, under the pointer.
    tip: string,
    // Where it starts, how wide, and how wide its header, from the padding.
    x: length,
    w: length,
    hw: length,
    // The caret is in it: its value as typed, in a well to type in.
    edit: bool,
    // This piece holds the term's start, or its end: the `!` goes over the
    // one, the `×` in the other.
    first: bool,
    last: bool,
    // The whole term is on this line, and where the term is in the query.
    whole: bool,
    from: int,
    to: int,
    // What it holds as typed; in words, when its lens has words for it; and
    // what an empty one asks for.
    raw: string,
    nice: string,
    hint: string,
    // The name beside the header's picture.
    label: string,
    // How wide Rust wants the header, the words, and the room after the
    // last letter. Its own numbers, on their way to the columns.
    head-w: length,
    nice-w: length,
    tail: length,
}

// A word a capsule shows in the window's own face, for the window to measure:
// a header's name, or `big`, what a filter holds said in words.
export struct QMeasure {
    text: string,
    big: bool,
}

// Part of the query's selection, on one line.
export struct Sel {
    line: int,
    at: int,
    len: int,
    x: length,
    w: length,
}

// Byte offsets into the query, from and to.
export struct Reach {
    from: int,
    to: int,
}

// One line of the lens under a term.
// A day of the time lens's calendar, counted from the epoch so two compare.
export struct CalDay {
    n: int,
    label: string,
    // In the month shown, not the edge of the one before or after.
    here: bool,
    today: bool,
    future: bool,
}

export struct CalMonth {
    title: string,
    days: [CalDay],
}

export struct LensRow {
    label: string,
    hint: string,
    // A heading drawn above it; one space is a rule alone.
    group: string,
    // What choosing it would leave, said; empty when not counted.
    n: string,
    // That number against the largest in the lens.
    bar: float,
    zero: bool,
    // Waiting for an answer: not a choice yet.
    wait: bool,
    // Choosing it reads files, so it has no number.
    reads: bool,
    // Tab writes it and keeps the lens open.
    stays: bool,
}

export struct FolderRow {
    path: string,
    on: bool,
    watched: bool,
    status: string,
    problem: bool,
    walking: bool,
    // A source of its own, so a refresh means something.
    walkable: bool,
}

export struct Facet {
    // Bar height, 0..1 of the largest count in the section. Computed in Rust:
    // a max over a model is a loop per row per frame.
    share: float,
    label: string,
    token: string,
    count: string,
    // A kind's own token, which picks its icon; empty elsewhere.
    icon: string,
}


// One row of the rail: an icon, a word, a count, and a bar under them showing
// what share of the matching set it is. Under, because a narrow rail has no lane.
component FacetRow inherits Rectangle {
    in property <string> label;
    in property <string> count;
    in property <float> share;
    in property <bool> on;
    // A kind's token, the list's own icon for it; `place` or `size` for the
    // other two sections.
    in property <string> icon;
    callback clicked();

    height: 24px;
    // Tinted and keeping its ink: in the light scheme the tint alone is too
    // close to the hover to tell apart.
    background: root.on ? Theme.selection : touch.has-hover ? Theme.hover : transparent;

    // Inset two pixels top and bottom, at full strength: half an opacity over
    // `line` is invisible in both schemes.
    // A hairline under the row, not a block behind it: the share is a hint.
    if root.share > 0: Rectangle {
        x: 12px;
        y: parent.height - 3px;
        height: 2px;
        width: (parent.width - 24px) * root.share;
        background: Theme.line;
        border-radius: 1px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        // The same icons the list draws beside each file, quiet here: the
        // rail is for reading words, and the colour is the list's.
        VerticalLayout {
            alignment: center;
            Image {
                width: 14px;
                height: 14px;
                colorize: root.on ? Theme.ink : Theme.ink-3;
                source: root.icon == "folder" || root.icon == "place" ? @image-url("icons/folder.svg")
                    : root.icon == "doc" ? @image-url("icons/doc.svg")
                    : root.icon == "code" ? @image-url("icons/code.svg")
                    : root.icon == "image" ? @image-url("icons/image.svg")
                    : root.icon == "video" ? @image-url("icons/video.svg")
                    : root.icon == "media" ? @image-url("icons/media.svg")
                    : root.icon == "audio" ? @image-url("icons/audio.svg")
                    : root.icon == "archive" ? @image-url("icons/archive.svg")
                    : root.icon == "exec" ? @image-url("icons/exec.svg")
                    : root.icon == "data" ? @image-url("icons/data.svg")
                    : root.icon == "config" ? @image-url("icons/config.svg")
                    : root.icon == "font" ? @image-url("icons/font.svg")
                    : root.icon == "build" ? @image-url("icons/build.svg")
                    : root.icon == "size" ? @image-url("../../../crates/scour-ui/icons/menu/weight.svg")
                    : @image-url("icons/file.svg");
            }
        }

        Text {
            text: root.label;
            color: root.on ? Theme.ink : Theme.ink-2;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        // A width of its own, so the name gives way to it: elide a name,
        // never a number.
        Text {
            text: root.count;
            color: Theme.ink-3;
            font-size: 11.5px;
            font-family: Fonts.mono;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 34px;
        }
    }
}

// What a paste makes of a field: its new text and where the caret goes. `ok`
// false means the clipboard could not be read this way, and the field asks
// Slint's own.
export struct Spliced {
    ok: bool,
    text: string,
    caret: int,
}

// Pasting, for every field: the clipboard is read in Rust (see `paste.rs`),
// and a `TextInput` has no way to insert text but this.
export global Clip {
    callback paste-into(string, int, int, bool) -> Spliced;
}

// The report's two ramps, by index. A brush cannot travel in a model: which
// scheme is showing is decided here, and Rust sends the step instead.
global Tones {
    public pure function age(i: int) -> brush {
        return i == 0 ? Theme.t0 : i == 1 ? Theme.t1 : i == 2 ? Theme.t2
            : i == 3 ? Theme.t3 : i == 4 ? Theme.t4 : Theme.t5;
    }

    // Six steps of one hue, then the folded rest.
    public pure function kind(i: int) -> brush {
        return i == 0 ? Theme.k0 : i == 1 ? Theme.k1 : i == 2 ? Theme.k2
            : i == 3 ? Theme.k3 : i == 4 ? Theme.k4 : i == 5 ? Theme.k5 : Theme.kx;
    }

    // A word inside a band is the hole the band is cut from. No single ink
    // reads on both ends of a six-step ramp, and the ramps invert between
    // the schemes.
    out property <brush> on-band: Theme.dark ? Theme.ground : Theme.panel;
}

// A bar cut into segments, each a fraction of the whole. The segments are
// placed, not laid out, and `min-width` is said out loud: a strip whose width
// came from the children that read it back is the binding loop this window
// has already paid for.
component Strip inherits Rectangle {
    in property <[Seg]> segments;
    /// Which ramp the `tone` indexes: the folder bar and the ring, or the age.
    in property <bool> kinds;

    height: 22px;
    min-width: 0px;
    border-radius: 3px;
    background: Theme.line-soft;
    clip: true;

    for seg[i] in root.segments: Rectangle {
        x: root.width * seg.start;
        width: root.width * seg.width;
        height: root.height;
        background: root.kinds ? Tones.kind(seg.tone) : Tones.age(seg.tone);

        // Rust leaves it empty when the segment is too narrow to read.
        if seg.label != "": Text {
            x: 8px;
            width: max(0px, parent.width - 10px);
            height: parent.height;
            text: seg.label;
            color: Tones.on-band;
            font-size: 11.5px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A section heading: small capitals, with a quieter aside beside it.
component Heading inherits HorizontalLayout {
    in property <string> label;
    in property <string> aside;

    spacing: 8px;
    alignment: start;
    height: 26px;

    VerticalLayout {
        alignment: center;
        Text {
            text: root.label;
            color: Theme.ink-3;
            font-size: 12px;
            font-weight: 500;
        }
    }
    VerticalLayout {
        alignment: center;
        Text {
            text: root.aside;
            color: Theme.ink-3;
            font-size: 11px;
        }
    }
}

// A sentence under a section, saying what the picture above it means.
component Note inherits Text {
    color: Theme.ink-3;
    font-size: 11px;
    wrap: word-wrap;
}

// A panel over the window: help, the rules, the languages. One component,
// because all three are a card that opens over the list, closes on Escape or
// on a click outside, and does not move what is under it.
// One of the window's own controls. Square, 18px, and the same shape as the
// view switch beside it: something done to the window, not to what it shows.
component Tool inherits Rectangle {
    in property <string> glyph;
    /// Drawn instead of the glyph when given: a symbol is only as good as the
    /// fonts of the machine, and Windows' have none of these.
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> on;
    callback clicked();

    // A header bar's button: no frame until it is on, a wash under the hand.
    width: 28px;
    height: 28px;
    border-radius: 7px;
    border-width: root.on ? Theme.hair : 0px;
    border-color: Theme.line;
    background: root.on ? Theme.panel-2 : touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    if !root.has-icon: Text {
        text: root.glyph;
        color: root.on || touch.has-hover ? Theme.ink : Theme.ink-2;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    if root.has-icon: Image {
        source: root.icon;
        colorize: root.on || touch.has-hover ? Theme.ink : Theme.ink-2;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// A small button that says what it does in a word, for the line under the
// query: framed, and filled while it is on.
component TextTool inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();
    height: 24px;
    width: tt-label.preferred-width + 18px;
    border-radius: 6px;
    border-width: Theme.hair;
    border-color: tt-touch.has-hover ? Theme.ink-3 : Theme.line;
    background: root.on ? Theme.panel-2 : tt-touch.has-hover ? Theme.hover : transparent;
    tt-label := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.on || tt-touch.has-hover ? Theme.ink : Theme.ink-3;
        font-size: 12px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    tt-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// One search tab on the strip: its query as its name, a × while it is in
/// front or under the hand, and the middle button closes it as a browser's does.
component SearchTabChip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    /// False for the only tab: there is always a query line.
    in property <bool> closable: true;
    callback picked();
    callback closed();

    height: 28px;
    min-width: 96px;
    max-width: 220px;
    preferred-width: name.preferred-width + 48px;
    border-radius: 7px;
    border-width: root.on ? Theme.hair : 0px;
    border-color: Theme.line;
    background: root.on ? Theme.panel : touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.picked();
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                root.closed();
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 4px;
        name := Text {
            text: root.label;
            color: root.on ? Theme.ink : Theme.ink-2;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 5px;
                background: x-touch.has-hover ? Theme.line : transparent;
                visible: root.closable;
                opacity: root.on || touch.has-hover || x-touch.has-hover ? 1 : 0;
                x-touch := TouchArea {
                    clicked => { root.closed(); }
                }
                Image {
                    source: @image-url("icons/tools/close.svg");
                    colorize: Theme.ink-2;
                    width: 12px;
                    height: 12px;
                    x: 4px;
                    y: 4px;
                }
            }
        }
    }
}

/// A button with a word on it, for the selection bar. Quiet until hovered; it
/// turns the colour of a question while `asking`.
component Push inherits Rectangle {
    in property <string> label;
    in property <bool> asking;
    /// Shown but not pressable: what it would do is out of reach just now.
    in property <bool> enabled: true;
    /// No frame: a way out rather than a thing to do, set apart from the rest.
    in property <bool> plain;
    callback clicked();

    width: text.preferred-width + 24px;
    height: 26px;
    border-width: root.plain ? 0px : Theme.hair;
    border-radius: 3px;
    border-color: root.asking ? Theme.q-key : touch.has-hover && root.enabled ? Theme.ink-3 : Theme.line;
    background: touch.has-hover && root.enabled ? Theme.hover : transparent;
    opacity: root.enabled ? 1 : 0.45;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    text := Text {
        text: root.label;
        color: root.asking ? Theme.q-key : touch.has-hover ? Theme.ink : Theme.ink-2;
        font-size: Fonts.small;
        vertical-alignment: center;
        horizontal-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

/// One way of running Scour, and what choosing it would do. The doing is a
/// second press: a press arms the row, the button beside it acts.
component FaceRow inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <string> aside;
    in property <bool> here;
    in property <bool> armed;
    in property <bool> ready: true;
    in property <string> go;
    callback picked();
    callback confirmed();

    height: layout.preferred-height;
    border-radius: 3px;
    background: root.armed ? Theme.hover : touch.has-hover && root.ready ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            if (root.ready) {
                root.picked();
            }
        }
    }

    layout := VerticalLayout {
        padding: 6px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            height: 20px;

            Text {
                text: root.here ? "●" : "○";
                color: root.here ? Theme.q-key : Theme.ink-3;
                font-size: 11px;
                vertical-alignment: center;
                width: 12px;
            }
            Text {
                text: root.label;
                color: root.ready ? Theme.ink : Theme.ink-3;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.aside;
                color: Theme.ink-3;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        // Sentence and button together: the sentence is what it asks for.
        if root.armed: HorizontalLayout {
            spacing: 8px;
            padding-left: 20px;

            Text {
                text: root.note;
                color: Theme.ink-2;
                font-size: 11px;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            if root.go != "": VerticalLayout {
                alignment: center;
                Push {
                    label: root.go;
                    asking: true;
                    clicked => {
                        root.confirmed();
                    }
                }
            }
        }
    }
}

component RuleRow inherits Rectangle {
    in property <string> value;
    in property <string> word;
    in property <bool> off;
    in property <bool> removable;
    callback toggled();
    callback dropped();

    height: 24px;
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            root.toggled();
        }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 8px;

        // The row is the target, not the box: twelve pixels is hard to hit.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 12px;
                height: 12px;
                border-width: Theme.hair;
                border-radius: 2px;
                border-color: root.off ? Theme.line : Theme.q-key;
                background: root.off ? transparent : Theme.q-key;

                Text {
                    text: root.off ? "" : "✓";
                    color: Theme.panel;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        Text {
            text: root.value;
            color: root.off ? Theme.ink-3 : Theme.ink-2;
            font-family: Fonts.mono;
            font-size: 11.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.off: Text {
            text: root.word;
            color: Theme.q-bad;
            font-size: 11px;
            vertical-alignment: center;
        }

        if root.removable: Rectangle {
            width: 18px;
            border-radius: 3px;
            background: drop.has-hover ? Theme.selection : transparent;

            drop := TouchArea {
                clicked => {
                    root.dropped();
                }
            }

            Text {
                text: "×";
                color: drop.has-hover ? Theme.q-bad : Theme.ink-3;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
    }
}

/// A disk in the disks panel: the row switches it, three lines say which.
component DiskRow inherits Rectangle {
    in property <string> name;
    in property <string> aside;
    in property <string> roots;
    in property <bool> on;
    in property <bool> fixed;
    in property <string> status;
    in property <bool> walking;
    callback toggled();
    callback refresh();

    height: layout.preferred-height;
    border-radius: 3px;
    background: touch.has-hover && !root.fixed ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => {
            if (!root.fixed) {
                root.toggled();
            }
        }
    }

    layout := HorizontalLayout {
        padding: 4px;
        spacing: 8px;

        VerticalLayout {
            alignment: start;
            padding-top: 3px;
            Rectangle {
                width: 12px;
                height: 12px;
                border-width: Theme.hair;
                border-radius: 2px;
                border-color: !root.on ? Theme.line : root.fixed ? Theme.ink-3 : Theme.q-key;
                background: !root.on ? transparent : root.fixed ? Theme.ink-3 : Theme.q-key;

                Text {
                    text: root.on ? "✓" : "";
                    color: Theme.panel;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 1;

            Text {
                text: root.name;
                color: root.on ? Theme.ink : Theme.ink-2;
                font-size: 12px;
                overflow: elide;
            }
            Text {
                text: root.aside;
                color: Theme.ink-3;
                font-size: 11px;
                overflow: elide;
            }
            Text {
                text: root.roots;
                color: Theme.ink-3;
                font-family: Fonts.mono;
                font-size: 11px;
                overflow: elide;
            }
            if root.status != "": Text {
                text: root.status;
                color: Theme.ink-3;
                font-size: 11px;
                overflow: elide;
            }
        }

        // Walk it again now. Above the row's own touch, which switches it.
        if root.on: VerticalLayout {
            alignment: center;
            Push {
                label: "↻";
                enabled: !root.walking;
                clicked => { root.refresh(); }
            }
        }
    }
}

/// A filter in the query, and the `×` that takes it out.
// One of the buttons over a term: round, a glyph, pressed on the way down so
// the field keeps the keyboard.
component PairButton inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <int> kind: 0;
    out property <bool> hovered <=> hit.has-hover;
    callback pressed();
    // Big enough to hit without aiming: a miss lands in the text and selects it.
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: on ? Theme.q-key
        : hit.has-hover ? (root.kind == 2 ? Theme.q-bad : root.kind == 1 ? Theme.q-not : Theme.ink-3)
        : Theme.line-soft;
    Text {
        text: root.label;
        color: root.on || hit.has-hover ? Theme.panel : Theme.ink-2;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    hit := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pressed();
            }
        }
    }
}

component Head inherits Rectangle {
    in property <string> text;
    in property <string> sort;
    in property <string> sorted-by;
    in property <bool> sorted-down;
    in property <int> total-rows;
    in property <int> window-offset;
    in property <length> w;
    // Which column this is, for remembering what it was dragged to. Not `id`,
    // which Slint keeps for element names.
    in property <string> which;
    callback dragged(string, length);
    /// Double-clicked: that column goes back to deciding for itself.
    callback reset(string);
    // `right` alone collides with the alignment enum of the same name.
    in property <bool> align-right;
    /// The rightmost heading, which has no line after it.
    in property <bool> last;
    callback clicked(string);

    // A width, not a stretch: every row and this heading share one number.
    width: root.w;

    // The grip is the edge, 7px: narrower is a target people miss, wider eats
    // the heading beside it.
    grip := TouchArea {
        x: parent.width - 4px;
        width: 7px;
        height: parent.height;
        mouse-cursor: col-resize;

        moved => {
            if (self.pressed) {
                root.dragged(root.which, self.mouse-x - self.pressed-x);
            }
        }
        double-clicked => { root.reset(root.which); }
    }

    // The line between two headings, always drawn, and in the gap rather than
    // inside the heading. Never after the last: there is no column beyond it.
    if !root.last: Rectangle {
        x: parent.width + 3px;
        // Thickens under the hand, before the button goes down.
        y: grip.has-hover || grip.pressed ? 0px : 5px;
        width: grip.has-hover || grip.pressed ? 2px : 1px;
        height: parent.height - 2 * self.y;
        background: grip.has-hover || grip.pressed ? Theme.focus : Theme.line;
    }

    TouchArea {
        clicked => { root.clicked(root.sort); }
        Text {
            width: parent.width;
            // In the text, not beside it: a separate glyph shifts the heading
            // sideways when it becomes the sort.
            text: root.sorted-by != root.sort ? root.text
                : root.sorted-down ? root.text + " ▾" : root.text + " ▴";
            color: root.sorted-by == root.sort ? Theme.ink-2 : Theme.ink-3;
            font-size: 11.5px;
            font-weight: 500;
            horizontal-alignment: root.align-right ? right : left;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A name, or a line out of a file, with the match picked out.
component Marked inherits Rectangle {
    in property <string> pre;
    in property <string> hit;
    in property <string> post;
    in property <brush> colour: Theme.ink;
    // A name is drawn in the face's own type; a line out of a file in the
    // monospace it was written in.
    in property <bool> mono: true;
    in property <length> size: 13px;
    in property <int> weight: 400;
    // What the whole name would take, for the tooltip's "does it fit".
    preferred-width: before.preferred-width + label.preferred-width + after.preferred-width;
    // **Placed by hand and clipped**: in a layout the marked part kept its
    // own width and a name matched whole ran over the next columns. Each
    // part gets what is left after the ones before it, so a long name is cut
    // from its end, the mark included.
    clip: true;
    property <length> pre-w: min(before.preferred-width, root.width);
    property <length> hit-w: min(label.preferred-width, root.width - self.pre-w);

    before := Text {
        x: 0px;
        width: root.pre-w;
        height: root.height;
        text: root.pre;
        color: root.colour;
        font-family: root.mono ? Fonts.mono : "";
        font-size: root.size;
        font-weight: root.weight;
        overflow: elide;
        vertical-alignment: center;
    }

    // Not a conditional element, so a slot is never rebuilt when a match
    // appears; an empty mark is a transparent box of no width.
    Rectangle {
        x: root.pre-w;
        width: root.hit-w;
        height: label.preferred-height;
        y: (root.height - self.height) / 2;
        background: root.hit == "" ? transparent : Theme.mark;
        border-radius: 2px;
        clip: true;
        label := Text {
            width: parent.width;
            text: root.hit;
            color: Theme.mark-ink;
            font-family: root.mono ? Fonts.mono : "";
            font-size: root.size;
            font-weight: root.weight;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    after := Text {
        x: root.pre-w + root.hit-w;
        width: max(0px, root.width - root.pre-w - root.hit-w);
        height: root.height;
        text: root.post;
        color: root.colour;
        font-family: root.mono ? Fonts.mono : "";
        font-size: root.size;
        font-weight: root.weight;
        overflow: elide;
        vertical-alignment: center;
    }
}

// One of the menu's drawings, by its `scour_ui::menu` name. The files are
// `scour-ui`'s, which hands the same ones to the page. `@image-url` is
// resolved at build time, so every name is spelled out.
component MenuIcon inherits Image {
    in property <string> name;
    source: root.name == "open" ? @image-url("../../../crates/scour-ui/icons/menu/open.svg")
        : root.name == "apps" ? @image-url("../../../crates/scour-ui/icons/menu/apps.svg")
        : root.name == "folder" ? @image-url("../../../crates/scour-ui/icons/menu/folder.svg")
        : root.name == "up" ? @image-url("../../../crates/scour-ui/icons/menu/up.svg")
        : root.name == "search" ? @image-url("../../../crates/scour-ui/icons/menu/search.svg")
        : root.name == "kind" ? @image-url("../../../crates/scour-ui/icons/menu/kind.svg")
        : root.name == "dupes" ? @image-url("../../../crates/scour-ui/icons/menu/dupes.svg")
        : root.name == "weight" ? @image-url("../../../crates/scour-ui/icons/menu/weight.svg")
        : root.name == "skip" ? @image-url("../../../crates/scour-ui/icons/menu/skip.svg")
        : root.name == "path" ? @image-url("../../../crates/scour-ui/icons/menu/path.svg")
        : root.name == "name" ? @image-url("../../../crates/scour-ui/icons/menu/name.svg")
        : root.name == "copy" ? @image-url("../../../crates/scour-ui/icons/menu/copy.svg")
        : root.name == "drag" ? @image-url("../../../crates/scour-ui/icons/menu/drag.svg")
        : root.name == "send" ? @image-url("../../../crates/scour-ui/icons/menu/send.svg")
        : root.name == "rename" ? @image-url("../../../crates/scour-ui/icons/menu/rename.svg")
        : root.name == "trash" ? @image-url("../../../crates/scour-ui/icons/menu/trash.svg")
        : root.name == "delete" ? @image-url("../../../crates/scour-ui/icons/menu/delete.svg")
        : root.name == "info" ? @image-url("../../../crates/scour-ui/icons/menu/info.svg")
        : root.name == "csv" ? @image-url("../../../crates/scour-ui/icons/menu/csv.svg")
        : root.name == "clear" ? @image-url("../../../crates/scour-ui/icons/menu/clear.svg")
        : root.name == "stack" ? @image-url("../../../crates/scour-ui/icons/menu/stack.svg")
        : root.name == "chevron" ? @image-url("../../../crates/scour-ui/icons/menu/chevron.svg")
        : @image-url("");
}

// A kind's drawing, by its `scour_ui` token. `@image-url` is resolved at
// build time, so every token is spelled out.
component KindIcon inherits Image {
    in property <string> ktoken;
    source: root.ktoken == "folder" ? @image-url("icons/folder.svg")
        : root.ktoken == "doc" ? @image-url("icons/doc.svg")
        : root.ktoken == "code" ? @image-url("icons/code.svg")
        : root.ktoken == "image" ? @image-url("icons/image.svg")
        : root.ktoken == "video" ? @image-url("icons/video.svg")
        : root.ktoken == "media" ? @image-url("icons/media.svg")
        : root.ktoken == "audio" ? @image-url("icons/audio.svg")
        : root.ktoken == "archive" ? @image-url("icons/archive.svg")
        : root.ktoken == "exec" ? @image-url("icons/exec.svg")
        : root.ktoken == "data" ? @image-url("icons/data.svg")
        : root.ktoken == "config" ? @image-url("icons/config.svg")
        : root.ktoken == "font" ? @image-url("icons/font.svg")
        : root.ktoken == "build" ? @image-url("icons/build.svg")
        : @image-url("icons/file.svg");
}

// A file's icon is its extension, written in the kind's colour on a tag:
// `PDF` and `DOCX` are told apart at a glance, and the type needs no column.
// A folder, or a name with no extension, keeps the kind's drawing.
component FileBadge inherits Rectangle {
    in property <string> ktoken;
    in property <brush> tint;
    in property <string> ext;
    width: 34px;
    height: 18px;

    if root.ext == "": KindIcon {
        x: 9px;
        y: 1px;
        width: 16px;
        height: 16px;
        ktoken: root.ktoken;
        colorize: root.tint;
    }
    if root.ext != "": Rectangle {
        width: min(root.width, max(24px, label.preferred-width + 8px));
        x: 0px;
        border-radius: 4px;
        background: root.tint.with-alpha(Theme.dark ? 0.16 : 0.10);
        border-width: Theme.hair;
        border-color: root.tint.with-alpha(0.45);
        label := Text {
            width: parent.width;
            height: parent.height;
            text: root.ext;
            color: root.tint;
            font-size: root.ext.character-count > 4 ? 9px : 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// One section in the settings' side list.
component NavRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> on;
    in property <string> badge;
    callback clicked();
    height: 34px;
    border-radius: 6px;
    background: root.on ? (Theme.dark ? Theme.line : Theme.hover)
        : nav-hit.has-hover ? (Theme.dark ? Theme.line-soft : Theme.hover) : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Image {
                width: 16px;
                height: 16px;
                source: root.icon;
                colorize: root.on || nav-hit.has-hover ? Theme.ink : Theme.ink-2;
            }
        }
        Text {
            text: root.label;
            color: root.on ? Theme.ink : Theme.ink-2;
            font-size: 13.5px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.badge != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: max(18px, badge-text.preferred-width + 10px);
                border-radius: 9px;
                background: Theme.focus;
                badge-text := Text {
                    text: root.badge;
                    color: Theme.ground;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    nav-hit := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A choice of a few, side by side: the one in force is raised.
component Choice inherits Rectangle {
    in property <[string]> labels;
    in property <[string]> values;
    in property <string> value;
    callback picked(string);
    height: 32px;
    border-radius: 7px;
    border-width: Theme.hair;
    border-color: Theme.line;
    background: Theme.dark ? Theme.ground : Theme.panel-2;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for l[i] in root.labels: Rectangle {
            border-radius: 5px;
            background: root.values[i] == root.value ? (Theme.dark ? Theme.line : Theme.panel)
                : seg-hit.has-hover ? Theme.hover : transparent;
            min-width: seg-label.preferred-width + 22px;
            seg-label := Text {
                text: l;
                color: root.values[i] == root.value || seg-hit.has-hover ? Theme.ink : Theme.ink-2;
                font-size: 12.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            seg-hit := TouchArea {
                clicked => { root.picked(root.values[i]); }
            }
        }
    }
}

// One setting: what it is and a line on what it does, the control at the right.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> note;
    min-height: 54px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.label;
                color: Theme.ink;
                font-size: 13.5px;
            }
            if root.note != "": Text {
                text: root.note;
                color: Theme.ink-3;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// A group of settings on a raised card, a hairline between rows.
component Card inherits Rectangle {
    background: Theme.dark ? Theme.panel : Theme.panel;
    border-width: Theme.hair;
    border-color: Theme.line;
    border-radius: 8px;
    VerticalLayout {
        padding: 2px;
        @children
    }
}

// Small capitals over a group of settings.
component SectionHead inherits Text {
    color: Theme.ink-3;
    font-size: 11px;
    height: 26px;
    vertical-alignment: bottom;
}

// A field somebody types into. Slint matches its editing keys in lower case
// only: with Caps Lock on, Ctrl+V arrives as `V` and pasted nothing. The four
// that matter are answered here for either case, and a paste goes through
// `Clip` rather than Slint's own clipboard.
component Field inherits TextInput {
    function paste-here() {
        let r = Clip.paste-into(self.text, self.anchor-position-byte-offset,
            self.cursor-position-byte-offset, self.single-line);
        if (!r.ok) {
            self.paste();
            return;
        }
        self.text = r.text;
        self.set-selection-offsets(r.caret, r.caret);
        self.edited();
    }
    key-pressed(e) => {
        if (e.modifiers.control && !e.modifiers.shift) {
            if (e.text == "v" || e.text == "V") { self.paste-here(); return accept; }
            if (e.text == "C") { self.copy(); return accept; }
            if (e.text == "X") { self.cut(); return accept; }
            if (e.text == "A") { self.select-all(); return accept; }
        }
        return reject;
    }
}

// A month back or forward in the time lens's calendar.
component CalArrow inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: arrow-hit.has-hover ? Theme.hover : transparent;
    Text {
        text: root.label;
        color: arrow-hit.has-hover ? Theme.ink : Theme.ink-2;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    arrow-hit := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A day in the calendar. Lit between the first day picked and the one under
// the pointer, or the last picked; the two ends filled.
component CalCell inherits Rectangle {
    in property <CalDay> day;
    in property <int> from;
    in property <int> to;
    in property <int> hover;
    callback entered(int);
    callback left(int);
    callback picked(int);
    property <int> other: root.to >= 0 ? root.to : root.hover >= 0 ? root.hover : root.from;
    property <int> lo: min(root.from, root.other);
    property <int> hi: max(root.from, root.other);
    property <bool> picking: root.from >= 0;
    property <bool> end: root.picking && (root.day.n == root.lo || root.day.n == root.hi);
    property <bool> inside: root.picking && root.day.n > root.lo && root.day.n < root.hi;
    width: 28px;
    height: 26px;
    // The band between the ends, square so the days join into one stretch.
    Rectangle {
        y: 2px;
        height: parent.height - 4px;
        background: root.inside ? Theme.cap : transparent;
    }
    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: 6px;
        background: root.end ? Theme.q-key : cell-hit.has-hover ? Theme.hover : transparent;
        border-width: root.day.today && !root.end ? 1px : 0px;
        border-color: Theme.q-key;
        Text {
            text: root.day.label;
            color: root.end ? Theme.panel
                : !root.day.here || root.day.future ? Theme.ink-3
                : root.day.today ? Theme.q-key : Theme.ink;
            opacity: root.day.here ? 1 : 0.55;
            font-size: 11.5px;
            font-weight: root.day.today || root.end ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    cell-hit := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover) {
                root.entered(root.day.n);
            } else {
                root.left(root.day.n);
            }
        }
        clicked => { root.picked(root.day.n); }
    }
}

export component MainWindow inherits Window {
    title: "Scour";
    icon: @image-url("../../../assets/scour.svg");
    background: Theme.ground;
    preferred-width: 1100px;
    preferred-height: 680px;
    min-width: 560px;
    min-height: 320px;

    /// The window was resized. Rust writes the size down so the next run opens
    /// at it; the numbers above are only what a first run gets.
    callback resized();
    changed width => { root.resized(); }
    changed height => { root.resized(); }

    // --- what Rust sets ---------------------------------------------------
    in property <[Row]> rows;
    in property <[Span]> spans;
    // The query bar, as Rust lays it out: see `qbar.rs`.
    in property <[Cap]> caps;
    in property <[QMeasure]> q-measure;
    // Whether the keyboard is in the query: a filter is being written only then.
    out property <bool> q-focused: input.has-focus;
    callback q-focus-moved();
    callback q-measured(int, length);
    in property <string> grep-meter;
    in property <string> word-inside: "Inside";
    in property <[Sel]> sels;
    // Lines the field shows (one to three), and the first of them.
    in property <int> q-shown: 1;
    in property <int> q-first: 0;
    in property <int> caret-line;
    in property <int> caret-col;
    in property <length> caret-x;
    in property <length> hov-x;
    in property <length> lens-x;
    /// One line of the query: tall enough that a capsule is easy to hit.
    out property <length> q-pitch: 36px;
    // The line under the field that searches inside the files, when open.
    out property <length> q-inside: root.grep-open ? 36px : 0px;
    /// One character of the query's face, for Rust to place things with.
    out property <length> q-advance: ruler.preferred-width / 40;
    /// The column under a point of a shown line; `round` for the gap nearest.
    pure callback q-col(int, length, bool) -> int;
    // Characters a line holds, measured here and wrapped by there.
    callback q-cols(int);
    callback q-caret(int, int);
    // A shown line and a column to a byte offset of the query.
    pure callback q-hit(int, int) -> int;
    // The term or value around a line and column, for a double press.
    pure callback q-word(int, int) -> Reach;
    callback q-hover(int, int);
    callback q-pressed(int, int);
    // The term under the pointer, and where its buttons go.
    in property <bool> hov-on;
    in property <string> word-add-filter: "Add a filter";
    /// A press in the query asks for the + above the caret; typing puts it away.
    property <bool> plus-asked: false;
    in property <int> hov-line;
    in property <int> hov-col;
    in property <bool> hov-not;
    in property <bool> hov-fz;
    // The term is a capsule: its buttons stand in it, over its right end.
    in property <bool> hov-cap;
    // The caret is in the hovered term: it is being written, and its buttons
    // would stand over what is typed.
    in property <bool> hov-edit;
    in property <bool> hov-fz-on;
    callback term-act(string);
    // A capsule's own buttons, naming the term by its byte offsets.
    callback cap-act(string, int, int);
    // Where Rust wants the selection/caret after it wrote or clamped the query.
    in property <int> anchor-to: -1;
    in property <int> caret-to;
    in property <int> caret-ask;
    changed caret-ask => {
        input.set-selection-offsets(
            root.anchor-to >= 0 ? root.anchor-to : root.caret-to,
            root.caret-to);
    }
    // The lens.
    in property <bool> lens-open;
    in property <bool> lens-launching;
    in property <string> lens-kind;
    in property <[LensRow]> lens-rows;
    in property <[PlaceLeft]> lens-places;
    in property <[PlaceCrumb]> lens-crumbs;
    in property <[PlaceDir]> lens-dirs;
    in property <string> lens-place-cur;
    in property <string> lens-place-shown;
    in property <string> lens-place-up;
    in property <bool> lens-place-direct;
    in property <int> lens-sel;
    in property <string> lens-title;
    // The time lens's calendar: two months, a range picked with two presses.
    in property <[CalMonth]> cal-months;
    in property <[string]> cal-week;
    in property <string> word-calendar: "Calendar";
    in property <string> cal-hint;
    in-out property <bool> cal-open;
    in-out property <int> cal-from: -1;
    in-out property <int> cal-to: -1;
    in-out property <int> cal-hover: -1;
    callback cal-opened();
    callback cal-shift(int);
    callback lens-cal-range(int, int);
    changed lens-open => {
        if (!self.lens-open) {
            self.cal-open = false;
            self.cal-from = -1;
            self.cal-to = -1;
            self.cal-hover = -1;
        }
    }
    in property <string> lens-said;
    in property <string> lens-foot;
    in property <string> lens-reads;
    in property <int> lens-line;
    in property <int> lens-col;
    in property <bool> loc-on;
    in property <bool> time-on;
    in property <bool> fuzzy-on;
    in property <bool> narrow-shown;
    in property <string> word-loc: "Location";
    in property <string> word-time: "Modified";
    in property <string> word-fuzzy: "Fuzzy";
    in property <string> word-grep: "Grep";
    in property <string> word-grep-ph: "Search inside matching files…";
    in property <string> word-text: "Text";
    in property <string> word-regex: "Regex";
    in property <string> word-hex: "Hex";
    in property <string> word-read-more: "Read more";
    in property <string> word-choose-folder: "Choose folder…";
    in property <string> word-this-folder: "this folder";
    in property <string> word-subfolders: "Subfolders";
    in property <string> word-direct-only: "only what is directly inside";
    in property <string> word-spark-hint: "Click or drag across bars to pick a range";
    in property <string> word-similar-always: "Always forgive typos";
    in property <string> word-narrow-pill: "Narrow";
    in-out property <bool> grep-open;
    in property <bool> grep-active;
    // The file of the stream the preview is on.
    in property <int> grep-sel: -1;
    callback grep-step(int);
    in-out property <string> grep-pattern;
    in property <string> grep-mode: "text";
    in property <bool> grep-case;
    in property <bool> grep-binary;
    in property <int> grep-focus-ask;
    in property <string> grep-summary;
    in property <string> grep-empty;
    in property <bool> grep-more-on;
    in property <[GrepItem]> grep-items;
    in property <string> similar-query;
    changed grep-focus-ask => { grep-input.focus(); grep-input.select-all(); }
    callback lens-step(int);
    callback lens-pick(int, bool);
    callback lens-close();
    callback lens-field(string);
    callback lens-fuzzy();
    callback lens-spark-range(int, int);
    callback lens-place-act(string, string);
    callback narrow-toggled();
    callback grep-toggled();
    callback grep-edited(string);
    callback grep-mode-picked(string);
    callback grep-case-toggled();
    callback grep-bin-toggled();
    callback grep-more();
    callback grep-clicked(int);
    callback grep-opened(int);
    // Leave the term the caret ends: the lens shuts, a space follows it.
    callback lens-exit() -> bool;
    callback lens-escape();
    callback q-backspace() -> bool;
    callback q-delete() -> bool;
    callback q-before-char(string) -> bool;
    callback lens-right() -> bool;
    callback lens-toggle();
    callback lens-launch();
    // With nothing found: one filter left out at a time, and what it finds.
    in property <string> offers-said;
    in property <[string]> offers;
    callback offer-taken(int);
    // A field name one letter off a real one, and the spelling it meant.
    in property <string> fix-said;
    callback fix-taken();
    in property <[Facet]> facets;
    in property <[Facet]> scopes;
    in property <[Facet]> sizes;
    in property <string> scope-heading;
    in property <string> size-heading;
    in property <[Bar]> bars;
    // The tallest bar, so every other is a share of it. Computed in Rust: a
    // max over a Slint model is a loop per bar per frame.
    in property <int> bar-peak: 1;
    in property <string> ribbon-label;
    in property <string> ribbon-hint;
    in property <string> axis-oldest;
    in property <string> axis-year;
    in property <string> axis-month;
    in property <string> axis-week;
    in property <string> axis-today;
    in property <string> meter;
    // What a person's last act came to — moved to the trash, copied, not run —
    // shown over the meter for a few seconds, so the search that follows the
    // act does not write over it at once. Rust clears it.
    in property <string> notice;
    // The same line in pieces, when it is the numeric one. See the meter row.
    in property <string> meter-count;
    in property <string> meter-ms;
    in property <string> meter-rows;
    /// A `content:` query's reading: 0 none, 1 running, 2 stopped half-way,
    /// 3 every file read.
    in property <int> reading-stage;
    in property <string> read-on;
    in property <string> read-again;
    /// `true` forgets what was found and reads the files again.
    callback reread(bool);
    /// How far the walk has got, while the index is being built. Drawn beside
    /// the counts, where somebody waiting is already looking.
    in property <string> scanning;
    in property <string> holding;
    /// Something the window did, said until the next keystroke. Not the meter,
    /// which every answer rewrites, nor the hint, which typing hides.
    in property <string> note;
    in property <string> hint;
    in property <bool> busy;
    in property <string> scope-label;

    // The grid counts lines, not rows: a tile view puts several results on one
    // scrolled line, and the conversion happens at the edges.
    out property <bool> grid: root.view-mode != "detail";
    out property <length> tile-w: root.view-mode == "large" ? 132px : 96px;
    out property <length> tile-h: root.view-mode == "large" ? 172px : 104px;
    out property <length> pic: root.view-mode == "large" ? 110px : 52px;
    out property <int> per-line: max(1, Math.floor(
        (root.width - root.chrome) / root.tile-w));
    /// The tiles, a line at a time. A model of models: a `for` over a count
    /// builds every element at once, and a `ListView` stops being lazy.
    in property <[[Row]]> lines;

    // The preview panel: a third column holding one row. A mode, not a glance
    // — it stays open and follows the selection. What is drawn in it is what
    // the service says the file is: a picture, some text, or neither.
    in-out property <bool> peeking;
    in property <string> peek-name;
    in property <string> peek-path;
    /// The picture, when the file is one and it could be read.
    in property <image> peek-shot;
    /// Whether `peek-shot` holds one, as a flag: see `Row::shot`.
    in property <bool> peek-has-shot;
    /// The head of the file, when it is text.
    in property <string> peek-text;
    /// What is selected in the preview's text, as byte offsets into it: kept
    /// here because the field is inside an `if`, out of reach by name.
    in-out property <int> peek-from;
    in-out property <int> peek-to;
    /// Copy this much of a text, by byte offsets, through the desktop's own
    /// clipboard helper.
    callback copy-span(string, int, int);
    /// Said instead of either, when there is neither.
    in property <string> peek-note;
    in property <[PeekPage]> peek-pages;
    in property <float> peek-aspect: 1.414;
    callback peek-page-scrolled(int);
    in property <[Fact]> peek-facts;
    /// Where the file in the preview holds the text a `content:` query asked
    /// for, and the heading over them.
    in property <[Found]> peek-found;
    in property <string> word-found;
    /// A `content:` query is in force: each row is two lines, the file and
    /// where it holds the text. `Theme.row-height` grows with it.
    in property <bool> tall;
    /// A row's height when it is one line, which `Theme.row-height` is not
    /// while the rows are tall.
    in property <length> base-row: 30px;
    in property <string> peek-close-title;
    callback peek-toggled();

    // Which column the list is ordered by, as the protocol's own word.
    in property <string> sorted-by;
    in property <bool> sorted-down: true;
    // How long the list really is and where the shown window sits in it: a
    // view sized from the model would describe the window, not the result.
    in property <int> total-rows;
    in property <int> window-offset;

    // Everything between the window edge and the list — the sidebar and its
    // divider, 12px list padding, 14px of scrollbar
    // gutter. The columns are sized from this, not from the list: that is a loop.
    property <length> chrome: root.rail-w + 1px + 24px + 14px;
    /// The sidebar's width, which the header's mark matches so the field
    /// starts where the list does.
    // Put away, the rail leaves nothing: Settings → List brings it back.
    out property <length> rail-w: root.rail-shown ? 180px : 0px;
    /// The rail and the time ribbon, each put away or brought back by a person;
    /// kept in the shared settings.
    in-out property <bool> rail-shown: false;
    in-out property <bool> ribbon-shown: false;
    // The narrowing line under the bar: what the results hold, each a term.
    in property <[Facet]> chips;
    in property <string> word-narrow;
    in property <string> word-filter-button;
    in property <string> word-peek: "Preview";
    in property <string> word-tab: "Tab";
    callback narrow-taken(string, bool);
    // The status bar's right end.
    in property <string> typos-said;
    in property <string> disk-said;
    in property <string> word-filter-key;
    in property <string> word-tab-key;
    in property <string> set-rail;
    in property <string> set-rail-note;
    in property <string> set-ribbon;
    in property <string> set-ribbon-note;
    callback panes-changed();
    in property <string> word-show-rail;
    in property <string> word-show-ribbon;
    // One gap between each pair of headings, and one more before the picker.
    // Counted, because how many columns there are is a choice.
    property <length> gaps: 8px * max(1, root.heads.length);
    /// The ⋮ at the end of the header row, which is a column's worth of room
    /// that the columns themselves may not have.
    property <length> picker-w: 16px;
    // The preview panel is furniture too: a width the columns may not divide up,
    // dragged at its left edge within `scour_ui::preview`'s bounds.
    in-out property <length> peek-width: 380px;
    in property <length> peek-min: 200px;
    in property <length> peek-max: 600px;
    /// Let go after a drag; zero is a double-click, back to the usual width.
    callback peek-resized(int);
    property <length> peek-w: root.peeking ? root.peek-width : 0px;

    /// What there is for the columns to divide up.
    out property <length> lane: max(0px,
        root.width - root.chrome - root.gaps - root.picker-w - root.peek-w);
    /// Divide it up again — in `scour_ui::lay_out`, which the page uses too.
    /// Rust, not a binding: it is two passes with a per-column floor and ceiling.
    callback relayout(length);
    changed lane => { root.relayout(root.lane); }
    /// One character of the monospaced face at the two sizes the rows draw it
    /// in, measured rather than guessed: Rust sizes the name and the location
    /// to the widest text they hold, and every face's mono is its own width.
    out property <length> name-advance: name-probe.preferred-width / 20;
    out property <length> cell-advance: cell-probe.preferred-width / 20;
    /// Every kind's word, one a line, in the language shown: the kind column
    /// is as wide as the widest of them and stays so, whatever the answer.
    in property <string> kind-words;
    out property <length> kind-width: kind-probe.preferred-width;

    // The widths every row and the heading are handed, adding up to `lane`
    // exactly. A dragged width wins over a computed one; zero means untouched.
    in-out property <[length]> cw: [240px, 110px, 320px, 120px, 90px];
    // Where each column starts inside a row, from `relayout` with `cw`.
    in-out property <[length]> cx: [12px, 260px, 378px, 706px, 834px];
    // The headings in shown order, handed in from `scour-ui` by `dress()` in
    // `main.rs`, so the header row and every row below it use one list.
    in-out property <[HeadInfo]> heads;
    /// Whether the kind's icon is drawn at the front of each row: only while
    /// the name is the first column, since the room it takes is the name's.
    out property <bool> iconed: root.heads.length > 0 && root.heads[0].id == "name";
    // The two tab words, from the catalogue like every other visible string.
    in property <string> tab-search;
    in property <string> tab-report;
    /// How many rows would fit, plus a little to scroll into. Only the window
    /// knows its height, and a fetched row costs a path rebuilt in the engine.
    /// Counted in rows in both views: a line of tiles is `per-line` results.
    out property <int> visible-rows: root.grid
        ? (Math.floor(tiles.height / root.tile-h) + 2) * root.per-line
        : max(20, Math.floor(list.height / Theme.row-height) + 12);
    // --- the scrollbar ----------------------------------------------------
    // Drawn by this window in a lane of its own: the style's is a hairline over
    // the list, invisible on a dark panel and sitting on the size column. The
    // list gives up 14px; the arithmetic below is the flickable's own.
    property <length> sb-inset: 4px;
    property <length> sb-reach: root.grid ? tiles.viewport-height : list.viewport-height;
    property <length> sb-shown: root.grid ? tiles.visible-height : list.visible-height;
    property <length> sb-span: max(0px, root.sb-reach - root.sb-shown);
    property <length> sb-track: root.sb-shown - 2 * root.sb-inset;
    /// Never shorter than 36px: millions of rows put the thumb below hitting size.
    property <length> sb-thumb: root.sb-span <= 0px ? 0px
        : max(36px, root.sb-track * root.sb-shown / root.sb-reach);
    property <length> sb-travel: max(0px, root.sb-track - root.sb-thumb);
    property <length> sb-at: 0px - (root.grid ? tiles.viewport-y : list.viewport-y);
    property <length> sb-y: root.sb-inset + (root.sb-span <= 0px ? 0px
        : root.sb-travel * min(1.0, max(0.0, root.sb-at / root.sb-span)));

    /// Put the thumb's top at `y` and take the list with it.
    function scroll-thumb-to(y: length) {
        if (root.sb-travel <= 0px) {
            return;
        }
        root.scroll-to(root.sb-span * min(1.0, max(0.0, (y - root.sb-inset) / root.sb-travel)));
    }

    /// Put the list back to the top, or a measured distance down it. A function
    /// rather than a binding: the scroll position is the `ListView`'s to keep.
    public function scroll-to(down: length) {
        list.viewport-y = 0px - down;
        tiles.viewport-y = 0px - down;
        paper.viewport-y = 0px - down;
    }
    /// Scroll the rail from outside, for `SCOUR_GUI_RAIL`.
    public function scroll-rail(down: length) {
        railview.viewport-y = 0px - down;
    }
    /// The first row of the result the list is showing, read off the viewport
    /// so the fetch decision never depends on the model reporting a miss.
    /// The detail list's slots, filled from Rust: see `Slots` in `rows.rs`.
    in property <[Slot]> slots;
    /// The first row the slots cover, set by Rust with them.
    in property <int> slot-from;
    /// The list moved a moment ago; set and cleared by Rust.
    in property <bool> moving;
    /// How many slots the list wants: a screenful, a row half off the top, and
    /// one each way to spare. Read by Rust, which places them.
    out property <int> pool: Math.ceil(list.visible-height / Theme.row-height) + 3;
    /// How far down the detail list is, for keeping the row being read in
    /// place when rows arrive above it.
    out property <length> list-down: 0px - list.viewport-y;
    out property <length> view-down: root.sb-at;
    out property <length> list-shown: root.sb-shown;
    callback navigated(int);
    // A resize changes how many slots there are, before any timer comes round.
    changed pool => { root.moved(); }
    /// How wide a row is, from the columns: as a `ListView` read it off the rows.
    property <length> row-w: root.cw.length == 0 ? 0px
        : root.cx[root.cw.length - 1] + root.cw[root.cw.length - 1] + 12px;
    out property <int> first-row: root.grid
        ? max(0, Math.floor((0px - tiles.viewport-y) / root.tile-h)) * root.per-line
        : max(0, Math.floor((0px - list.viewport-y) / Theme.row-height));
    /// The list moved by at least one row. Fires only while scrolling, and at
    /// once; the timer stays as the backstop for a resize.
    callback moved();
    changed first-row => {
        root.moved();
        if (root.first-row == 0) {
            root.new-above = 0;
        }
    }
    /// Rows that arrived above the one being read since the list left the top,
    /// counted by Rust as it keeps that row in place. Cleared at the top.
    in-out property <int> new-above;
    in property <string> word-top;
    in property <string> word-new;
    // Set only when Rust changes the text itself (a facet click), never on
    // every keystroke, or the caret jumps.
    in-out property <string> query;
    in-out property <int> selected: 0;
    /// Whether a rail term is in the query as typed. Asked of Rust, which
    /// knows how a term is spelled; handed the text, so it is asked again
    /// whenever the text changes.
    pure callback term-on(string, string) -> bool;

    // --- what Rust listens for --------------------------------------------
    callback query-changed(string);
    callback activated(int);
    /// A double-click on a row, and where along it: the location column shows
    /// the row in its folder, the rest open it as `activated` does.
    callback opened-at(int, length);
    callback reveal(int);
    // --- the right-click menu -------------------------------------------
    // The window owns none of the meaning: Rust fills `menu` from
    // `scour_ui::menu` and answers `menu-pick` with the id that comes back.
    in property <[MenuItem]> menu;
    in-out property <bool> menu-open: false;
    /// The few that sit across the top, a word each under a drawing.
    in property <[MenuItem]> menu-strip;
    /// What the menu is about: a row's name and where it is, or a selection.
    in property <string> menu-title;
    in property <string> menu-detail;
    in property <string> menu-ktoken;
    in property <brush> menu-tint;
    /// The whole text of the cell under the pointer, shown when the cell had
    /// to cut it. `tip-pending` is what the pointer is on; `tip-text` is what
    /// is drawn, after a moment's rest or on a click.
    in-out property <string> tip-pending;
    in-out property <string> tip-text;
    in-out property <length> tip-x;
    in-out property <length> tip-y;
    in-out property <bool> tip-mono;
    in-out property <int> tip-owner: -1;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    /// A row was right-clicked, at this point on the window.
    callback menu-at(int, length, length);
    /// One of the items was pressed.
    callback menu-pick(string);
    /// A menu item asked for by its key rather than by the menu: about the
    /// row the list has selected, whatever menu was last open.
    callback key-action(string);
    /// Ctrl with + or - (1, -1), or 0: everything bigger, smaller, as it was.
    callback zoom-step(int);
    /// The same overlay, holding the column switches instead of row actions.
    in-out property <bool> menu-columns: false;
    callback column-toggled(string);

    // --- asking before something that changes files ----------------------
    // The menu only offers what can be undone, but "safe to undo" is not
    // "meant": twelve rows going at once is worth a sentence and a pause.
    in-out property <bool> ask-open: false;
    in property <string> ask-title;
    in property <string> ask-body;
    in property <string> ask-yes;
    in property <string> ask-no;
    /// The question takes a line of text rather than only a yes: a rename is
