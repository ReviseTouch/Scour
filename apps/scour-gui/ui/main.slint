    in-out property <length> strip-width: 0px;
    /// The strips changed width. Rust relabels them from the reply it kept.
    callback report-resized();
    /// The scope's bytes by age, and the same six as a legend.
    in property <[Seg]> age-segs;
    in property <[Facet]> age-key;
    /// The shown children and the folded rest, as one bar.
    in property <[Seg]> kid-segs;
    in property <string> head-bytes;
