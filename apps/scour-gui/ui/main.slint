    in property <string> picked-pre;
    in property <string> picked-n;
    in property <string> picked-post;
    in property <string> pick-copy;
    in property <string> pick-folders;
    in property <string> pick-drop;
    in property <bool> pick-asking;
    /// False past `scour_ui::OPEN_FOLDERS_MOST` folders.
    in property <bool> pick-folders-ok: true;
    property <bool> sel-shown: root.picked > 0 && root.tab != "report" && root.panel == "";
    /// A row was picked: which, whether to add to the selection, and whether
    /// to take the run from the last one picked.
    callback pick(int, bool, bool);
    /// A row pulled far enough to be a drag: the row, and where the pointer is.
    callback drag-out(int, length, length);
    /// Set when a press has become a drag, until the press ends.
    in-out property <bool> dragging-out;
    callback pick-copied();
    callback pick-opened();
    callback pick-dropped();
    callback pick-focused();
    callback bar-clicked(int);
    callback column-dragged(string, length);
    /// Double-clicked an edge: that column stretches with the window again.
    callback column-reset(string);
    /// The ⋮ at the end of the header row: which columns to show. Carries where
    /// it is, since the menu opens under it.
    callback columns-clicked(length, length);
    // No page callbacks: the model's length is the whole result, so the view
    // just scrolls and the window fetches what scrolled into sight.

    public function focus-query() {
        input.focus();
    }

    /// The search tabs: each one's name on the strip, and which is in front.
    /// `tabs-on` is the settings' switch: off, no strip, no keys, no button.
    in property <bool> tabs-on: true;
    in property <string> set-tabs;
    in property <string> set-tabs-note;
    callback tabs-picked(bool);
    in property <[string]> tab-labels;
    in property <int> tab-active;
    callback tab-new();
    callback tab-picked(int);
    callback tab-closed(int);
    /// The next tab along (`1`) or the previous (`-1`), wrapping.
    callback tab-step(int);

    /// The query field's own edits, for its right-click menu.
    public function query-edit(what: string) {
        input.focus();
        if (what == "cut") {
            input.cut();
        } else if (what == "copy") {
            input.copy();
        } else if (what == "paste") {
            input.paste-here();
        } else if (what == "select-all") {
            input.select-all();
        } else if (what == "clear") {
            root.query = "";
            root.query-changed("");
        }
    }
    /// The query field was right-clicked, here.
    callback query-menu-at(length, length);

    // What was searched before, already filtered by what is typed.
    in property <[string]> past;
    in-out property <bool> past-open;
    in-out property <int> past-picked;
    // Whether there is a past at all: no arrow when there is nothing to open.
    in property <bool> has-past;
    callback past-toggled();
    callback past-taken(string);
    // A query somebody meant, not one they were halfway through typing: the
    // box searches per keystroke, the history takes only what was committed.
    callback query-committed();

    // What the engine made of the query, as a sentence, and whether any of it
    // is a misreading. Empty when there is nothing worth reading back.
    in property <string> reading;
    in property <bool> reading-warn;
    /// The terms of the query that name a field, each a chip whose `×` takes
    /// it out of the text in one press. Asked of Rust with the text, so the
    /// row follows every keystroke.

    // `SCOUR_TRACE=1`: print what the two layers of the query field measure on
    // every caret move. They have to agree character for character.
    in property <bool> trace: false;

    /// Put the caret at the end of what is typed. Used by `Enter` on a
    /// suggestion and by `SCOUR_GUI_END`: text set from Rust leaves it at nought.
    public function caret-to-end() {
        // `set-selection-offsets` takes BYTE offsets and clamps, and Slint has
        // no byte count, so anything past the end is the end.
        input.set-selection-offsets(1000000000, 1000000000);
    }

    forward-focus: input;

    // The ground round the card closes an open panel too; the card has its
    // own catch, under its panels.
    if root.panel != "": TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.panel = ""; }
    }

    // A card on a ground: 20px all round, a 1px line, a 3px corner. No shadow —
    // the compositor draws the window's own, and two read as a border.
    // Edge to edge, as a desktop window is: the card used to sit on a 20px
    // ground with a corner, which read as a page in a browser.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.panel;
        clip: true;

    VerticalLayout {
        spacing: 0px;

        // The search tabs, always: a strip that appears only with a second tab
        // was never found (17 November). One tab has no ×. On its right what
        // the list is and how it is shown, and the window's own two buttons.
        Rectangle {
            height: 36px;
            background: Theme.ground;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }
            // Under the tabs: a double-click on the empty strip opens one.
            TouchArea {
                double-clicked => { root.tab-new(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 2px;
                if root.tabs-on && root.tab != "report": HorizontalLayout {
                spacing: 2px;
                for label[i] in root.tab-labels: VerticalLayout {
                    alignment: center;
                    SearchTabChip {
                        label: label;
                        on: i == root.tab-active;
                        closable: root.tab-labels.length > 1;
                        picked => { root.tab-picked(i); }
                        closed => { root.tab-closed(i); }
                    }
                }
                }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    // Its own width, whatever the chips leave.
                    horizontal-stretch: 0;
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Choice {
                            height: 24px;
                            horizontal-stretch: 0;
                            labels: [root.tab-search, root.tab-report];
                            values: ["search", "report"];
                            value: root.tab == "report" ? "report" : "search";
                            picked(v) => {
                                root.tab = v;
                                // Asked for when looked at: weighing a folder is a walk.
                                if (v == "report") {
                                    root.report-open("");
                                }
                            }
                        }
                    }
                    if root.tab == "report" && root.report-web-ready: VerticalLayout {
                        alignment: center;
                        TextTool {
                            label: root.report-web;
                            clicked => { root.report-in-browser(); }
                        }
                    }
                    if root.tab != "report": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            width: views.preferred-width;
                            border-radius: 6px;
                            border-width: Theme.hair;
                            border-color: Theme.line;
                            views := HorizontalLayout {
                                padding: 1px;
                                spacing: 1px;
                                Tool {
                                    width: 26px;
                                    height: 20px;
                                    icon: @image-url("icons/tools/detail.svg");
                                    has-icon: true;
                                    on: root.view-mode == "detail";
                                    clicked => { root.view-clicked("detail"); }
                                }
                                Tool {
                                    width: 26px;
                                    height: 20px;
                                    icon: @image-url("icons/tools/icons.svg");
                                    has-icon: true;
                                    on: root.view-mode == "icons";
                                    clicked => { root.view-clicked("icons"); }
                                }
                                Tool {
                                    width: 26px;
                                    height: 20px;
                                    icon: @image-url("icons/tools/large.svg");
                                    has-icon: true;
                                    on: root.view-mode == "large";
                                    clicked => { root.view-clicked("large"); }
                                }
                            }
                        }
                    }
                    if root.tab != "report": VerticalLayout {
                        alignment: center;
                        TextTool {
                            label: root.word-peek;
                            on: root.peeking;
                            clicked => { root.peek-toggled(); }
                        }
                    }
                    if root.tabs-on && root.tab != "report": VerticalLayout {
                        alignment: center;
                        TextTool {
                            label: "+ " + root.word-tab;
                            clicked => { root.tab-new(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Tool {
                            width: 24px;
                            height: 24px;
                            icon: @image-url("icons/tools/export.svg");
                            has-icon: true;
                            clicked => { root.tool-clicked("export"); }
                        }
                    }
                    // Faces, language, disks, skips and the keys: one page.
                    VerticalLayout {
                        alignment: center;
                        Tool {
                            width: 24px;
                            height: 24px;
                            icon: @image-url("icons/tools/settings.svg");
                            has-icon: true;
                            on: root.disk-question != "";
                            clicked => { root.tool-clicked("settings"); }
                        }
                    }
                }
            }
        }

        // The query line. Slint's `TextInput` has no range colouring (upstream
        // #9560 puts editable text out of scope), so the colours are a second
        // layer under a transparent input.
        Rectangle {
            // 16px above the box, 12px below, the box 26px of 20px monospace.
            // Taller when the query is read back — see `reading`.
            // The bar, a line taller for each line the query wraps onto, and
            // the narrowing line under it, which is always there.
            height: (root.q-shown - 1) * root.q-pitch + 100px + root.q-inside;
            background: Theme.ground;

            // The line between the query and what is under it. A plain rule:
            // the field's own border is what says where the keyboard is.
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }

            VerticalLayout {
                spacing: 0px;

            HorizontalLayout {
                // The box's own height, so the line under it moves nothing.
                height: 66px + (root.q-shown - 1) * root.q-pitch + root.q-inside;
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 10px;

                // The mark: the desktop's icon, then letter-spaced small capitals.
                mark := HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    width: 180px - 26px;
                    Image {
                        source: @image-url("../../../assets/scour.svg");
                        width: 20px;
                        height: 20px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Scour";
                        color: Theme.ink;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                // The field, and under it — inside the same box — the line
                // that searches what the files hold.
                VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                // The box and its placeholder, stacked: Slint's `TextInput` has
                // no placeholder, so the hint is drawn under it and hidden the
                // moment anything is typed.
                field := Rectangle {
                    horizontal-stretch: 1;
                    // Unclipped: the buttons over a term stand above the box.
                    // Nothing else reaches past it — lines past the third are
                    // not drawn, and the text never scrolls sideways.
                    clip: false;
                    height: 46px + (root.q-shown - 1) * root.q-pitch;
                    background: Theme.panel;
                    border-top-left-radius: 8px;
                    border-top-right-radius: 8px;
                    border-bottom-left-radius: root.grep-open ? 0px : 8px;
                    border-bottom-right-radius: root.grep-open ? 0px : 8px;
                    border-width: Theme.hair;
                    border-color: input.has-focus ? Theme.focus : Theme.line;
                    animate border-color { duration: 120ms; }
                    // One number for every layer: the runs, the capsules, the
                    // caret and a press are all placed from it.
                    property <length> pad: 9px;
                    // What a line holds: the width less the padding and the
                    // past's button at the end.
                    property <length> room: max(0px, field.width - field.pad * 2
                        - (root.has-past ? 24px : 0px));
                    // One character's width, measured over forty because a
                    // layout rounds each run to whole pixels and the error
                    // accumulates. One width for every character: the query's
                    // face is monospace, and Rust wraps it by that.
                    property <length> advance: ruler.preferred-width / 40;
                    property <int> cols: max(8, Math.floor(field.room / max(1px, field.advance)));
                    changed cols => { root.q-cols(self.cols); }
                    init => { root.q-cols(self.cols); }
                    // The lines start this far down, so one line sits in the
                    // middle of the box as it always did.
                    property <length> top: (field.height - root.q-shown * root.q-pitch) / 2;
                    property <bool> caret-lit: true;
                    property <bool> pair-keep: false;
                    property <bool> pair-active: root.hov-on || pair.over;
                    changed pair-active => {
                        if (self.pair-active) {
                            field.pair-keep = true;
                        }
                    }
                    pair-linger := Timer {
                        interval: 220ms;
                        running: !field.pair-active && field.pair-keep;
                        triggered => {
                            field.pair-keep = false;
                            if (!pair.over) { root.q-hover(-1, -1); }
                        }
                    }

                    // This window draws its own caret: on Linux Slint's takes
                    // its colour from `TextInput::color`, which is transparent
                    // here. 530ms is the desktop's own blink rate.
                    blink := Timer {
                        interval: 530ms;
                        running: input.has-focus;
                        triggered => {
                            field.caret-lit = !field.caret-lit;
                        }
                    }

                    // Forty characters of the query's face, to measure one.
                    ruler := Text {
                        text: "0000000000000000000000000000000000000000";
                        font-family: Fonts.mono;
                        font-size: 16px;
                        font-weight: 500;
                        visible: false;
                    }

                    // A filter is a capsule: a tint and a hairline ring, a
                    // header and what it holds. Rust places every part; the
                    // letters over it move with the columns it was given.
                    for c in root.caps: Rectangle {
                        x: field.pad + c.x - 3px;
                        y: field.top + (c.line - root.q-first) * root.q-pitch + 2px;
                        width: c.w + 6px;
                        height: root.q-pitch - 4px;
                        visible: c.line >= root.q-first && c.line < root.q-first + root.q-shown;
                        border-radius: 8px;
                        // The one being written wears the field's own focus.
                        property <bool> writing: c.edit && input.has-focus;
                        // Where the header ends, from this rectangle's edge.
                        property <length> hx: c.icon ? c.hw - 6px : c.hw - 1px;
                        property <brush> ring: c.tone == 1 ? Theme.cap-read-ring
                            : c.tone == 2 ? Theme.cap-neg-ring
                            : c.tone == 3 ? Theme.line : Theme.cap-ring;
                        // A fuzzy capsule holds its word: a firmer ring round both.
                        border-width: self.writing ? 2px : c.field == "fuzzy" ? 1.5px : 1px;
                        clip: true;
                        // Tone 3 is a filter with nothing in it, left out of
                        // the search: a ring and no tint.
                        background: c.tone == 1 ? Theme.cap-read : c.tone == 2 ? Theme.cap-neg
                            : c.tone == 3 ? transparent : Theme.cap;
                        border-color: self.writing ? Theme.focus : c.hov ? Theme.ink-3 : self.ring;

                        // The header's tint, its left corners the capsule's own: a
                        // clip does not round them, and square ones stood out.
                        if c.head > 0: Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.hx;
                            height: parent.height;
                            opacity: 0.55;
                            background: parent.ring;
                            border-top-left-radius: 7px;
                            border-bottom-left-radius: 7px;
                        }
                        if c.head > 0: Rectangle {
                            x: parent.hx;
                            y: 0px;
                            width: 1px;
                            height: parent.height;
                            background: parent.ring;
                        }
                        // The well: a place to type, inside the ring.
                        if self.writing && c.head > 0: Rectangle {
                            x: parent.hx + 1px;
                            y: 2px;
                            width: parent.width - self.x - 2px;
                            height: parent.height - 4px;
                            border-top-right-radius: 6px;
                            border-bottom-right-radius: 6px;
                            background: Theme.panel;
                        }
                        if c.hint != "": Text {
                            x: c.hw + 9px;
                            height: parent.height;
                            text: c.hint;
                            color: Theme.ink-3;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        if c.nice != "": Text {
                            x: c.hw + 3px;
                            height: parent.height;
                            text: c.nice;
                            color: c.tone == 2 ? Theme.q-not : Theme.ink;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        // An excluded filter: what it holds is struck through.
                        if c.tone == 2 && c.icon && c.whole: Rectangle {
                            x: c.hw + 1px;
                            y: parent.height / 2;
                            width: parent.width - self.x - 9px;
                            height: 1px;
                            background: Theme.q-not;
                        }
                    }

                    // The words the capsules show in the window's own face,
                    // measured here: Rust places columns and cannot.
                    for m[mi] in root.q-measure: Text {
                        visible: false;
                        text: m.text;
                        font-size: m.big ? 15px : 12px;
                        font-weight: 600;
                        property <length> wide: self.preferred-width;
                        init => { root.q-measured(mi, self.wide); }
                        changed wide => { root.q-measured(mi, self.wide); }
                    }

                    // The selection, a line at a time.
                    for s in root.sels: Rectangle {
                        x: field.pad + s.x;
                        y: field.top + (s.line - root.q-first) * root.q-pitch + 3px;
                        width: s.w;
                        height: root.q-pitch - 6px;
                        visible: s.line >= root.q-first && s.line < root.q-first + root.q-shown;
                        background: Theme.selection;
                    }

                    for sp[i] in root.spans: Text {
                            x: field.pad + sp.x;
                            y: field.top + (sp.line - root.q-first) * root.q-pitch;
                            height: root.q-pitch;
                            visible: sp.line >= root.q-first && sp.line < root.q-first + root.q-shown;
                            text: sp.text;
                            font-family: Fonts.mono;
                            // A header small and close: the capsule's room is
                            // for what it holds. Rust measures it the same way.
                            font-size: sp.small ? 12.5px : 16px;
                            letter-spacing: sp.small ? -0.5px : 0px;
                            // Operators are heavier: one character that changes
                            // what a whole term means.
                            font-weight: sp.role == 1 || sp.role == 4 || sp.role == 8 ? 600 : 500;
                            vertical-alignment: center;
                            // A misreading is said before a polarity, and an
                            // exclusion before a role: `!kind:zurna` is both,
                            // and unreadable is what matters.
                            color: sp.role == 5 ? Theme.q-bad
                                 : sp.not ? Theme.q-not
                                 : sp.role == 1 ? Theme.q-key
                                 : sp.role == 2 ? Theme.q-val
                                 : sp.role == 3 ? Theme.q-glob
                                 : sp.role == 4 ? Theme.q-not
                                 : sp.role == 6 ? Theme.q-term
                                 : sp.role == 7 ? Theme.ink-3
                                 : sp.role == 8 ? Theme.q-key
                                 : Theme.ink;
                    }

                    // A filter's header, once written, is drawn as what it
                    // does and what it is called — a clock and "Modified" for
                    // `dm:`, a folder and "Location" for `under:`, ≈ alone for
                    // `fuzzy:` — on the capsule's own tint.
                    for c[ci] in root.caps: cap-head := Rectangle {
                        visible: c.icon && c.line >= root.q-first && c.line < root.q-first + root.q-shown;
                        x: field.pad + c.x - 3px;
                        y: field.top + (c.line - root.q-first) * root.q-pitch + 2px;
                        width: c.hw - 6px;
                        height: root.q-pitch - 4px;
                        property <brush> ink: c.tone == 2 ? Theme.q-not : c.tone == 1 ? Theme.q-bad
                            : c.tone == 3 ? Theme.ink-3 : Theme.q-key;
                        property <bool> over: self.visible && q-press.has-hover
                            && q-press.mouse-x >= self.x && q-press.mouse-x < self.x + self.width
                            && q-press.mouse-y >= self.y && q-press.mouse-y < self.y + self.height;
                        changed over => {
                            if (self.over) {
                                root.tip-owner = -100 - ci;
                                root.tip-mono = false;
                                root.tip-pending = c.tip;
                                root.tip-x = self.absolute-position.x;
                                root.tip-y = self.absolute-position.y + self.height + 8px;
                            } else if (root.tip-owner == -100 - ci) {
                                root.tip-owner = -1;
                                root.tip-pending = "";
                                root.tip-text = "";
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            padding-left: 6px;
                            spacing: 5px;
                            // An excluded filter keeps its `!` in front of the drawing.
                            if c.tone == 2: Text {
                                text: "!";
                                color: Theme.q-not;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 16px;
                                    height: 16px;
                                    source: c.field == "fuzzy" ? @image-url("icons/tools/lens-fuzzy.svg")
                                        : c.field == "under" || c.field == "parent" ? @image-url("icons/tools/folder.svg")
                                        : c.field == "dm" ? @image-url("icons/tools/lens-time.svg")
                                        : c.field == "kind" ? @image-url("icons/tools/field-kind.svg")
                                        : c.field == "ext" ? @image-url("icons/tools/field-ext.svg")
                                        : c.field == "size" ? @image-url("icons/tools/field-size.svg")
                                        : @image-url("icons/tools/lens-content.svg");
                                    colorize: cap-head.ink;
                                }
                            }
                            if c.label != "": Text {
                                text: c.label;
                                color: cap-head.ink;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.spans.length == 0 && root.query == "": Text {
                        x: field.pad;
                        width: field.room;
                        text: root.hint;
                        color: Theme.ink-3;
                        font-family: Fonts.mono;
                        font-size: 16px;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                input := TextInput {
                    // One invisible line that owns the text, the keys, the
                    // clipboard and the input method. What is drawn is the
                    // layers above, placed by Rust; presses go to `press`.
                    x: field.pad;
                    y: field.top;
                    width: max(field.room, self.preferred-width);
                    height: root.q-pitch;
                    text <=> root.query;
                    // Where the caret and the selection are, for Rust to draw.
                    cursor-position-changed(p) => {
                        root.q-caret(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                        if (root.trace) {
                            debug("query field: caret " + self.cursor-position-byte-offset
                                + "  selection " + self.anchor-position-byte-offset
                                + "  chars " + root.query.character-count);
                        }
                        // Typing restarts the lit half: a caret blinking while
                        // letters arrive reads as a dropped keystroke.
                        field.caret-lit = true;
                        blink.restart();
                    }
                    changed has-focus => {
                        if (!self.has-focus) {
                            root.lens-close();
                            root.plus-asked = false;
                        }
                        root.q-focus-moved();
                    }
                    color: transparent;
                    font-size: 16px;
                    font-weight: 500;
                    font-family: Fonts.mono;
                    single-line: true;
                    vertical-alignment: center;
                    text-cursor-width: 0px;
                    // The selection is drawn above, a line at a time.
                    selection-background-color: transparent;
                    selection-foreground-color: transparent;

                    edited => {
                        field.pair-keep = false;
                        root.plus-asked = false;
                        root.query-changed(self.text);
                    }
                    function paste-here() {
                        let r = Clip.paste-into(self.text, self.anchor-position-byte-offset,
                            self.cursor-position-byte-offset, true);
                        if (!r.ok) {
                            self.paste();
                            return;
                        }
                        self.text = r.text;
                        self.set-selection-offsets(r.caret, r.caret);
                        root.query-changed(self.text);
                    }

                    // Down and up move through the results without leaving the
                    // field: type, glance, press Enter.
                    key-pressed(e) => {
                        // While the lens is open the arrows, Tab, Enter and
                        // Escape are its own.
                        // Backspace and Delete do not take a capsule's frame apart.
                        if (e.text == Key.Backspace && !e.modifiers.control && !e.modifiers.alt
                                && root.q-backspace()) {
                            return accept;
                        }
                        if (e.text == Key.Delete && !e.modifiers.control && !e.modifiers.alt
                                && root.q-delete()) {
                            return accept;
                        }
                        if (!e.modifiers.control && !e.modifiers.alt && e.text != ""
                                && e.text != Key.Return && e.text != Key.Tab && e.text != Key.Escape
                                && self.anchor-position-byte-offset == self.cursor-position-byte-offset
                                && root.q-before-char(e.text)) {
                            return accept;
                        }
                        // Tab leaves the term, lens or not: the caret goes outside it.
                        if (e.text == Key.Tab && !e.modifiers.shift && !e.modifiers.control
                                && !e.modifiers.alt && root.lens-exit()) {
                            return accept;
                        }
                        if (root.lens-open) {
                            if (e.text == Key.DownArrow && !e.modifiers.alt) { root.lens-step(1); return accept; }
                            if (e.text == Key.UpArrow && !e.modifiers.alt) { root.lens-step(-1); return accept; }
                            // → goes into a folder, or adds one more value to a list.
                            if (e.text == Key.RightArrow && root.lens-right()) { return accept; }
                            if (e.text == Key.Return) { root.lens-pick(root.lens-sel, false); return accept; }
                            if (e.text == Key.Escape) { root.lens-escape(); return accept; }
                        }
                        // Ctrl+Space: the lens of the term under the caret, or
                        // the filters a query can take.
                        if (e.modifiers.control && e.text == " ") {
                            root.lens-toggle();
                            return accept;
                        }
                        // Ctrl+C with nothing selected here copies what is
                        // selected in the preview: the drag there may not have
                        // taken the keyboard with it.
                        if (e.modifiers.control && (e.text == "c" || e.text == "C")
                                && self.anchor-position-byte-offset == self.cursor-position-byte-offset
                                && root.peek-from != root.peek-to) {
                            root.copy-span(root.peek-text, root.peek-from, root.peek-to);
                            return accept;
                        }
                        // Caps Lock: Slint takes its editing keys in lower case
                        // only, so `V` pasted nothing. See `Field`.
                        if (e.modifiers.control && !e.modifiers.shift) {
                            if (e.text == "v" || e.text == "V") { self.paste-here(); return accept; }
                            if (e.text == "C") { self.copy(); return accept; }
                            if (e.text == "X") { self.cut(); return accept; }
                            if (e.text == "A") { self.select-all(); return accept; }
                        }
                        // The tabs, with a browser's keys. Lower and upper case:
                        // Slint reads no Caps Lock for us. See `Field`.
                        if (root.tabs-on && e.modifiers.control && !e.modifiers.alt) {
                            if (e.text == "t" || e.text == "T") { root.tab-new(); return accept; }
                            if (e.text == "w" || e.text == "W") { root.tab-closed(root.tab-active); return accept; }
                            if (e.text == Key.Tab) { root.tab-step(e.modifiers.shift ? -1 : 1); return accept; }
                            if (e.text == Key.Backtab) { root.tab-step(-1); return accept; }
                            if (e.text == Key.PageDown) { root.tab-step(1); return accept; }
                            if (e.text == Key.PageUp) { root.tab-step(-1); return accept; }
                            if (e.text == "1") { root.tab-picked(0); return accept; }
                            if (e.text == "2") { root.tab-picked(1); return accept; }
                            if (e.text == "3") { root.tab-picked(2); return accept; }
                            if (e.text == "4") { root.tab-picked(3); return accept; }
                            if (e.text == "5") { root.tab-picked(4); return accept; }
                            if (e.text == "6") { root.tab-picked(5); return accept; }
                            if (e.text == "7") { root.tab-picked(6); return accept; }
                            if (e.text == "8") { root.tab-picked(7); return accept; }
                            if (e.text == "9") { root.tab-picked(root.tab-labels.length - 1); return accept; }
                        }
                        // `Alt+↓` opens what was searched before; plain `↓`
                        // still walks into the results.
                        if (e.text == Key.DownArrow && e.modifiers.alt) {
                            root.past-toggled();
                            return accept;
                        }
                        // While the list is open the arrows belong to it.
                        if (root.past-open && e.text == Key.DownArrow) {
                            root.past-picked = min(root.past-picked + 1, root.past.length - 1);
                            return accept;
                        }
                        if (root.past-open && e.text == Key.UpArrow) {
                            root.past-picked = max(root.past-picked - 1, 0);
                            return accept;
                        }
                        if (root.past-open && e.text == Key.Return) {
                            root.past-taken(root.past[root.past-picked]);
                            return accept;
                        }
                        if (root.past-open && e.text == Key.Escape) {
                            root.past-open = false;
                            return accept;
                        }
                        // The stream of files is the list while it is shown.
                        if (root.grep-active && (e.text == Key.DownArrow || e.text == Key.UpArrow)) {
                            root.grep-step(e.text == Key.DownArrow ? 1 : -1);
                            return accept;
                        }
                        if (e.text == Key.DownArrow) {
                            root.selected = min(root.selected + 1, root.rows.length - 1);
                            root.navigated(root.selected);
                            if ((root.selected + 1) * Theme.row-height + list.viewport-y
                                > list.visible-height) {
                                list.viewport-y = list.visible-height
                                    - (root.selected + 1) * Theme.row-height;
                            }
                            return accept;
                        }
                        if (e.text == Key.UpArrow) {
                            root.selected = max(root.selected - 1, 0);
                            root.navigated(root.selected);
                            if (root.selected * Theme.row-height + list.viewport-y < 0px) {
                                list.viewport-y = 0px - root.selected * Theme.row-height;
                            }
                            return accept;
                        }
                        // A screenful at a time, and the ends.
                        if (e.text == Key.PageDown || e.text == Key.PageUp) {
                            root.selected = clamp(
                                root.selected + (e.text == Key.PageDown ? root.visible-rows : -root.visible-rows),
                                0,
                                root.rows.length - 1);
                            root.navigated(root.selected);
                            list.viewport-y = min(0px,
                                -(root.selected * Theme.row-height) + list.visible-height / 2);
                            return accept;
                        }
                        if (e.text == Key.Home || e.text == Key.End) {
                            root.selected = e.text == Key.Home ? 0 : root.rows.length - 1;
                            root.navigated(root.selected);
                            list.viewport-y = e.text == Key.Home
                                ? 0px
                                : min(0px, list.visible-height - root.rows.length * Theme.row-height);
                            return accept;
                        }
                        // The keys the menu says, where the field does not need
                        // them for its own text.
                        if (e.modifiers.control && (e.text == "+" || e.text == "=")) {
                            root.zoom-step(1);
                            return accept;
                        }
                        if (e.modifiers.control && e.text == "-") {
                            root.zoom-step(-1);
                            return accept;
                        }
                        if (e.modifiers.control && e.text == "0") {
                            root.zoom-step(0);
                            return accept;
                        }
                        if (e.text == Key.F2) {
                            root.key-action("rename");
                            return accept;
                        }
                        // Ctrl+G or Ctrl+Shift+F toggles the on-demand Grep capsule.
                        if (e.modifiers.control && !e.modifiers.alt
                                && (e.text == "g" || e.text == "G"
                                    || (e.modifiers.shift && (e.text == "f" || e.text == "F")))) {
                            root.grep-toggled();
                            return accept;
                        }
                        if (e.text == Key.Return && e.modifiers.control) {
                            root.key-action("folder");
                            return accept;
                        }
                        if (e.text == Key.Return) {
                            if (root.rows.length == 0 && root.similar-said != "") {
                                root.similar-clicked();
                                return accept;
                            }
                            // What was committed to is what the history takes.
                            root.query-committed();
                            root.activated(root.selected);
                            return accept;
                        }
                        if (e.text == Key.Escape && root.ask-open) {
                            // A question first: Escape is its no.
                            root.ask-open = false;
                            root.ask-answer(false);
                            return accept;
                        }
                        // Ctrl+, opens the settings, as in most programs.
                        if (e.text == "," && e.modifiers.control) {
                            root.tool-clicked("settings");
                            return accept;
                        }
                        if (e.text == Key.Escape && root.panel != "") {
                            // A panel first: Escape closes what is on top.
                            root.panel = "";
                            return accept;
                        }
                        if (e.text == Key.Escape && root.picked > 0) {
                            // Then the selection, before the query: the smaller undo.
                            root.pick-dropped();
                            return accept;
                        }
                        if (e.text == Key.Escape) {
                            if (self.text == "") {
                                return accept;
                            }
                            self.text = "";
                            root.query-changed("");
                            return accept;
                        }
                        return reject;
                    }
                }

                // Presses, drags and the pointer's place, by line and column:
                // the input underneath is one line, the drawing is up to three.
                q-press := TouchArea {
                    x: 0;
                    y: 0;
                    width: parent.width - (root.has-past ? 24px : 0px);
                    height: parent.height;
                    mouse-cursor: text;
                    property <int> anchor: 0;
                    function line-at(y: length) -> int {
                        return clamp(Math.floor((y - field.top) / root.q-pitch), 0, root.q-shown - 1);
                    }
                    function col-at(x: length) -> int {
                        return root.q-col(self.line-at(self.mouse-y), x - field.pad, true);
                    }
                    function track() {
                        if (self.pressed) {
                            input.set-selection-offsets(self.anchor,
                                root.q-hit(self.line-at(self.mouse-y), self.col-at(self.mouse-x)));
                        } else if (self.has-hover && !pair.over) {
                            root.q-hover(self.line-at(self.mouse-y),
                                root.q-col(self.line-at(self.mouse-y), self.mouse-x - field.pad, false));
                        }
                    }
                    changed mouse-x => { self.track(); }
                    changed mouse-y => { self.track(); }
                    changed has-hover => {
                        if (!self.has-hover && !pair.over) { root.q-hover(-1, -1); }
                    }
                    pointer-event(e) => {
                        if (e.kind != PointerEventKind.down) { return; }
                        input.focus();
                        if (e.button == PointerEventButton.right) {
                            root.query-menu-at(self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                            return;
                        }
                        if (e.button != PointerEventButton.left) { return; }
                        let o = root.q-hit(self.line-at(self.mouse-y), self.col-at(self.mouse-x));
                        if (e.modifiers.shift) {
                            input.set-selection-offsets(input.anchor-position-byte-offset, o);
                            return;
                        }
                        self.anchor = o;
                        input.set-selection-offsets(o, o);
                        root.plus-asked = true;
                        // A filter opens its lens when it is pressed.
                        root.q-pressed(self.line-at(self.mouse-y),
                            root.q-col(self.line-at(self.mouse-y), self.mouse-x - field.pad, false));
                    }
                    double-clicked => {
                        let w = root.q-word(self.line-at(self.mouse-y), self.col-at(self.mouse-x));
                        input.set-selection-offsets(w.from, w.to);
                    }
                }

                    // What says `Alt+↓` is there. Inside the field at its
                    // trailing edge, because the box stretches and a button
                    // outside it would move with every resize.
                    if root.has-past: Rectangle {
                        x: field.width - 26px;
                        width: 22px;
                        height: 22px;
                        y: (field.height - 22px) / 2;
                        border-radius: 3px;
                        background: chevron.has-hover || root.past-open ? Theme.hover : Theme.panel-2;
                        Image {
                            source: @image-url("icons/tools/chevron.svg");
                            colorize: root.past-open ? Theme.ink : Theme.ink-3;
                            width: 12px;
                            height: 12px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        chevron := TouchArea {
                            // The pointer, not the click: by the time a click
                            // lands, the list has already closed on blur.
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    root.past-toggled();
                                }
                            }
                        }
                    }


                    // Painted last, so a letter cannot cover it.
                    Rectangle {
                        x: field.pad + root.caret-x - 1px;
                        y: field.top + (root.caret-line - root.q-first) * root.q-pitch + 5px;
                        width: 2px;
                        height: root.q-pitch - 10px;
                        background: Theme.q-key;
                        visible: input.has-focus && field.caret-lit && root.sels.length == 0
                            && root.caret-line >= root.q-first && root.caret-line < root.q-first + root.q-shown;
                    }

                    // Over the caret after a press: a filter, here, in one more.
                    if root.plus-asked && input.has-focus && root.sels.length == 0 && !root.lens-open
                        && root.caret-line >= root.q-first && root.caret-line < root.q-first + root.q-shown: Rectangle {
                        x: clamp(field.pad + root.caret-x - 11px, 0px, field.width - 22px);
                        y: field.top + (root.caret-line - root.q-first) * root.q-pitch - 22px;
                        width: 22px;
                        height: 20px;
                        border-radius: 10px;
                        background: plus-hit.has-hover ? Theme.cap : Theme.panel;
                        border-width: 1px;
                        border-color: plus-hit.has-hover ? Theme.cap-ring : Theme.line;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000030;
                        drop-shadow-offset-y: 1px;
                        Text {
                            text: "+";
                            color: plus-hit.has-hover ? Theme.q-key : Theme.ink-2;
                            font-size: 15px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        plus-hit := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    root.plus-asked = false;
                                    root.lens-launch();
                                }
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.tip-owner = -3;
                                    root.tip-mono = false;
                                    root.tip-pending = root.word-add-filter;
                                    root.tip-x = self.absolute-position.x;
                                    root.tip-y = self.absolute-position.y - 30px;
                                } else if (root.tip-owner == -3) {
                                    root.tip-owner = -1;
                                    root.tip-pending = "";
                                    root.tip-text = "";
                                }
                            }
                        }
                    }

                    // Over the right end of the term the pointer is on: take
                    // it out, exclude it, or read a word a letter off.
                    pair := Rectangle {
                        property <bool> fz-hov: false;
                        property <bool> over: pair-bridge.has-hover
                            || (root.hov-fz && self.fz-hov)
                            || pair-neg.hovered
                            || pair-drop.hovered;
                        // Above the term, a capsule's as a word's: nothing is laid
                        // over what it holds, and nothing in the line moves.
                        visible: root.hov-on || self.over || field.pair-keep;
                        x: clamp(field.pad + root.hov-x - self.width + 5px, 0px, field.width - self.width);
                        y: field.top + root.hov-line * root.q-pitch - 24px;
                        width: pair-row.preferred-width + 4px;
                        height: 26px;
                        border-radius: 13px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.line;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000030;
                        drop-shadow-offset-y: 1px;
                        pair-bridge := TouchArea {
                            x: -8px;
                            y: -4px;
                            width: parent.width + 16px;
                            height: parent.height + 16px;
                        }
                        pair-row := HorizontalLayout {
                            padding: 2px;
                            spacing: 2px;
                            if root.hov-fz: PairButton {
                                label: "≈";
                                on: root.hov-fz-on;
                                changed hovered => { pair.fz-hov = self.hovered; }
                                pressed => { root.term-act("fz"); }
                            }
                            pair-neg := PairButton {
                                label: root.hov-not ? "+" : "!";
                                kind: 1;
                                pressed => { root.term-act("neg"); }
                            }
                            pair-drop := PairButton {
                                label: "✕";
                                kind: 2;
                                pressed => {
                                    field.pair-keep = false;
                                    root.term-act("drop");
                                }
                            }
                        }
                    }

                }

                // What the files hold is written, not chosen: it is a line
                // of its own under the field, in the same box, with the ways
                // of reading beside it. Hidden until asked for.
                Rectangle {
                    visible: root.grep-open;
                    height: root.q-inside;
                    background: Theme.cap-read;
                    border-bottom-left-radius: 8px;
                    border-bottom-right-radius: 8px;
                    border-width: Theme.hair;
                    border-color: grep-input.has-focus ? Theme.q-bad : Theme.cap-read-ring;
                    clip: true;

                    HorizontalLayout {
                        padding-right: 6px;
                        spacing: 6px;
                        Rectangle {
                            width: inside-head.preferred-width + 22px;
                            Rectangle {
                                opacity: 0.55;
                                background: Theme.cap-read-ring;
                            }
                            inside-head := HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        width: 16px;
                                        height: 16px;
                                        source: @image-url("icons/tools/lens-content.svg");
                                        colorize: Theme.q-bad;
                                    }
                                }
                                Text {
                                    text: root.word-inside;
                                    color: Theme.q-bad;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            clip: true;
                            if root.grep-pattern == "": Text {
                                width: parent.width;
                                height: parent.height;
                                text: root.word-grep-ph;
                                color: Theme.ink-3;
                                font-family: Fonts.mono;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            grep-input := TextInput {
                                width: parent.width;
                                height: parent.height;
                                text <=> root.grep-pattern;
                                font-family: Fonts.mono;
                                font-size: 14px;
                                color: Theme.ink;
                                selection-background-color: Theme.selection;
                                selection-foreground-color: Theme.ink;
                                single-line: true;
                                vertical-alignment: center;
                                edited => { root.grep-edited(self.text); }
                                key-pressed(e) => {
                                    if (e.text == Key.Escape) {
                                        root.grep-toggled();
                                        return accept;
                                    }
                                    if (e.modifiers.control && (e.text == "g" || e.text == "G")) {
                                        root.grep-toggled();
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                        }
                        for m in [
                            { id: "text", label: root.word-text },
                            { id: "regex", label: root.word-regex },
                            { id: "hex", label: root.word-hex },
                        ]: Rectangle {
                            y: 7px;
                            height: 22px;
                            width: mlbl.preferred-width + 10px;
                            border-radius: 5px;
                            background: root.grep-mode == m.id ? Theme.cap-read-ring : mtouch.has-hover ? Theme.hover : transparent;
                            border-width: Theme.hair;
                            border-color: Theme.cap-read-ring;
                            mlbl := Text {
                                text: m.label;
                                color: root.grep-mode == m.id ? Theme.ink : Theme.ink-3;
                                font-family: Fonts.mono;
                                font-size: 10.5px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            mtouch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.grep-mode-picked(m.id); }
                            }
                        }
                        Rectangle {
                            y: 7px;
                            height: 22px;
                            width: 24px;
                            border-radius: 5px;
                            background: root.grep-case ? Theme.cap-read-ring : ctouch.has-hover ? Theme.hover : transparent;
                            border-width: Theme.hair;
                            border-color: Theme.cap-read-ring;
                            Text {
                                text: "Aa";
                                color: root.grep-case ? Theme.ink : Theme.ink-3;
                                font-family: Fonts.mono;
                                font-size: 10.5px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ctouch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.grep-case-toggled(); }
                            }
                        }
                        Rectangle {
                            y: 7px;
                            height: 22px;
                            width: 24px;
                            border-radius: 5px;
                            background: root.grep-binary ? Theme.cap-read-ring : btouch.has-hover ? Theme.hover : transparent;
                            border-width: Theme.hair;
                            border-color: Theme.cap-read-ring;
                            Text {
                                text: "01";
                                color: root.grep-binary ? Theme.ink : Theme.ink-3;
                                font-family: Fonts.mono;
                                font-size: 10.5px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            btouch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.grep-bin-toggled(); }
                            }
                        }
                        Text {
                            text: root.grep-meter;
                            color: Theme.q-bad;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            y: 7px;
                            height: 22px;
                            width: 20px;
                            border-radius: 5px;
                            background: gxtouch.has-hover ? Theme.hover : transparent;
                            Text {
                                text: "×";
                                color: gxtouch.has-hover ? Theme.ink : Theme.ink-3;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            gxtouch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.grep-toggled(); }
                            }
                        }
                    }
                }
                }

                // One way into the filters, the same list `:` opens: where,
                // when, what kind, how big, a letter off, inside the file.
                filter-button := Rectangle {
                    height: 46px;
                    width: filter-row.preferred-width + 22px;
                    border-radius: 8px;
                    border-width: Theme.hair;
                    border-color: filter-hit.has-hover ? Theme.ink-3 : Theme.line;
                    background: filter-hit.has-hover ? Theme.hover : Theme.panel;
                    filter-row := HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        Text {
                            text: root.word-filter-button;
                            color: filter-hit.has-hover ? Theme.ink : Theme.ink-2;
                            font-size: 13px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 12px;
                                height: 12px;
                                source: @image-url("icons/tools/chevron.svg");
                                colorize: filter-hit.has-hover ? Theme.ink : Theme.ink-3;
                            }
                        }
                    }
                    filter-hit := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                input.focus();
                                root.lens-launch();
                            }
                        }
                    }
                }
            }

                // Under the bar, always one line: what would narrow the list on
                // the left; on the right what is being read and how it is shown.
                Rectangle {
                    height: 34px;
                    Rectangle {
                        y: 0px;
                        height: 1px;
                        background: Theme.line;
                    }
                    HorizontalLayout {
                        spacing: 0px;
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 8px;
                        if root.fix-said != "": Rectangle {
                            width: fix-text.preferred-width + 12px;
                            height: 18px;
                            y: 8px;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: Theme.q-bad;
                            fix-text := Text {
                                text: root.fix-said;
                                color: Theme.q-bad;
                                font-family: Fonts.mono;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.fix-taken(); }
                            }
                        }
                        if root.chips.length > 0 && root.fix-said == "" && !root.reading-warn: Text {
                            text: root.word-narrow;
                            color: Theme.ink-3;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if root.chips.length > 0 && root.fix-said == "" && !root.reading-warn: chip-flick := Flickable {
                            horizontal-stretch: 1;
                            interactive: false;
                            viewport-width: chip-row.preferred-width;
                            // The wheel moves the line sideways: it holds more
                            // than a window is wide.
                            function nudge(dx: length) {
                                chip-flick.viewport-x = clamp(chip-flick.viewport-x + dx,
                                    min(0px, chip-flick.width - chip-row.preferred-width), 0px);
                            }
                            chip-row := HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                // Every chip is one click: the term goes in, with Alt it
                                // goes in excluded. Where a kind of chip begins, its picture.
                                for c[ci] in root.chips: Rectangle {
                                    property <bool> lead: ci == 0 || root.chips[ci - 1].icon != c.icon;
                                    property <length> lead-w: self.lead ? (ci == 0 ? 22px : 30px) : 0px;
                                    y: 6px;
                                    height: 22px;
                                    width: self.lead-w + chip-text.preferred-width + chip-n.preferred-width + 21px;
                                    if self.lead: Rectangle {
                                        x: 0px;
                                        width: parent.lead-w;
                                        if ci > 0: Rectangle {
                                            x: 6px;
                                            width: 1px;
                                            height: 14px;
                                            y: 4px;
                                            background: Theme.line;
                                        }
                                        Image {
                                            x: ci > 0 ? 14px : 2px;
                                            y: 3px;
                                            width: 16px;
                                            height: 16px;
                                            colorize: Theme.ink-3;
                                            source: c.icon == "kind" ? @image-url("icons/tools/field-kind.svg")
                                                : c.icon == "ext" ? @image-url("icons/tools/field-ext.svg")
                                                : c.icon == "dm" ? @image-url("icons/tools/lens-time.svg")
                                                : c.icon == "size" ? @image-url("icons/tools/field-size.svg")
                                                : @image-url("icons/tools/folder.svg");
                                        }
                                    }
                                    Rectangle {
                                        x: parent.lead-w;
                                        width: parent.width - parent.lead-w;
                                        border-radius: 6px;
                                        border-width: Theme.hair;
                                        border-color: chip-touch.has-hover ? Theme.ink-3 : Theme.line;
                                        background: chip-touch.has-hover ? Theme.hover : transparent;
                                        chip-text := Text {
                                            x: 8px;
                                            text: c.label;
                                            color: chip-touch.has-hover ? Theme.ink : Theme.ink-2;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        chip-n := Text {
                                            x: 8px + chip-text.preferred-width + 5px;
                                            text: c.count;
                                            color: Theme.ink-3;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        chip-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            scroll-event(e) => {
                                                chip-flick.nudge(e.delta-x + e.delta-y);
                                                accept
                                            }
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                    root.narrow-taken(c.token, e.modifiers.alt);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.chips.length == 0 || root.fix-said != "" || root.reading-warn: Text {
                            text: root.reading;
                            color: root.reading-warn ? Theme.q-bad : Theme.ink-3;
                            font-size: 11.5px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        }
                    }
                }
            }
        }



        // A disk that came and has not been answered for, one at a time.
        if root.disk-question != "": Rectangle {
            height: 36px;
            background: Theme.panel;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 8px;

                Text {
                    text: root.disk-question;
                    color: Theme.ink;
                    font-size: Fonts.small;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.disk-yes;
                        asking: true;
                        clicked => { root.disk-answered("index"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.disk-later;
                        clicked => { root.disk-answered("later"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.disk-never;
                        clicked => { root.disk-answered("leave"); }
                    }
                }
            }
        }

        // The report: what a folder weighs, where the weight sits, how old it
        // is. One scrolling document, and capped to nothing rather than put in
        // an `if`, because an id inside one is out of scope.
        paper := ScrollView {
            visible: root.tab == "report";
            max-height: root.tab == "report" ? 100000px : 0px;
            min-height: 0px;
            // Said, not inferred: a `ScrollView` does not learn its content's
            // height from a layout inside it, so there would be no overflow.
            viewport-height: sheet.preferred-height;

            sheet := VerticalLayout {
            // Its natural height: a layout inside a `ScrollView` otherwise
            // stretches to fill it, and there is nothing to scroll.
            height: self.preferred-height;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 10px;

            // The scope, one segment a button: any ancestor is one press away.
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                height: 22px;

                for step[i] in root.crumb: Rectangle {
                    width: label.preferred-width + 12px;
                    border-radius: 3px;
                    background: steptouch.has-hover ? Theme.hover : transparent;

                    steptouch := TouchArea {
                        clicked => {
                            root.report-open(step.token);
                        }
                    }

                    label := Text {
                        text: step.label;
                        color: i == root.crumb.length - 1 ? Theme.ink : Theme.ink-3;
                        font-family: Fonts.mono;
                        font-size: 11.5px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }

            // 1. What the whole scope comes to. Large and light, with the two
            // quieter facts on its line.
            HorizontalLayout {
                spacing: 18px;
                alignment: start;

                Text {
                    text: root.report-total;
                    color: Theme.ink;
                    font-family: Fonts.mono;
                    font-size: 30px;
                    font-weight: 250;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.report-files;
                        color: Theme.ink-2;
                        font-size: 12.5px;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.report-took;
                        color: Theme.ink-3;
                        font-family: Fonts.mono;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                }
            }

            // 2. The scope's bytes by age: one bar, then the six words under it.
            // The only place the strip's width is published; the folder bar
            // below is the same width and is relabelled with it.
            Strip {
                segments: root.age-segs;
                kinds: false;
                changed width => {
                    root.strip-width = self.width;
                    root.report-resized();
                }
            }

            HorizontalLayout {
                height: 22px;
                spacing: 16px;
                alignment: start;

                for band[i] in root.age-key: HorizontalLayout {
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 2px;
                            background: Tones.age(i);
                        }
                    }
                    Text {
                        text: band.label;
                        color: Theme.ink-2;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: band.count;
                        color: Theme.ink;
                        font-size: 11.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            // 3. Where the bytes are: the same width again, cut by folder.
            Heading {
                label: root.head-bytes;
                aside: root.kids-aside;
            }

            Strip {
                segments: root.kid-segs;
                kinds: true;
            }

            // The children, heaviest first. The engine ordered them.
            Rectangle {
                height: 24px;
                background: Theme.panel;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }

                HorizontalLayout {
                    spacing: 10px;

                    Text {
                        text: root.head-folder;
                        color: Theme.ink-3;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                        width: 34%;
                    }
                    Text {
                        text: root.head-age;
                        color: Theme.ink-3;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                        width: root.age-bar;
                    }
                    Text {
                        text: root.head-size;
                        color: Theme.ink-3;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 90px;
                    }
                    Text {
                        text: root.head-share;
                        color: Theme.ink-3;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 70px;
                    }
                    Text {
                        text: root.head-files;
                        color: Theme.ink-3;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 80px;
                    }
                }
            }

            // At most two dozen — `top` in the request says so — so a plain
            // repeater: a `ListView` would scroll inside the report's scroll.
            VerticalLayout {
                spacing: 0px;

                for kid[i] in root.kids: Rectangle {
                    height: 30px;
                    background: !kid.rest && kidtouch.has-hover ? Theme.hover : transparent;

                    kidtouch := TouchArea {
                        enabled: !kid.rest;
                        clicked => {
                            root.report-open(kid.path);
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line-soft;
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        // The name, with its share of the heaviest behind it —
                        // the way a rail row carries its own bar.
                        Rectangle {
                            width: 34%;
                            min-width: 0px;

                            if kid.bar > 0: Rectangle {
                                x: 0;
                                y: 4px;
                                height: parent.height - 8px;
                                width: parent.width * kid.bar;
                                background: Theme.line;
                                border-radius: 2px;
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 6px;
                                spacing: 3px;

                                // Elide rather than cap: a `max-width` read
                                // from the cell that holds it is a binding loop.
                                Text {
                                    text: kid.name;
                                    color: kid.rest ? Theme.ink-3 : Theme.ink;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 0;
                                }
                                Text {
                                    text: kid.rest ? "" : "›";
                                    color: Theme.ink-3;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                        }

                        // The bytes by age, as one bar, in the six colours the
                        // rows and the ribbon use. Placed rather than laid out:
                        // widths taken from the parent's width are a binding loop.
                        VerticalLayout {
                            alignment: center;
                            width: root.age-bar;
                            if !kid.rest: Rectangle {
                                height: 12px;
                                Rectangle {
                                    x: 0;
                                    width: root.age-bar * kid.a0;
                                    height: parent.height;
                                    background: Theme.t0;
                                }
                                Rectangle {
                                    x: root.age-bar * kid.a0;
                                    width: root.age-bar * kid.a1;
                                    height: parent.height;
                                    background: Theme.t1;
                                }
                                Rectangle {
                                    x: root.age-bar * (kid.a0 + kid.a1);
                                    width: root.age-bar * kid.a2;
                                    height: parent.height;
                                    background: Theme.t2;
                                }
                                Rectangle {
                                    x: root.age-bar * (kid.a0 + kid.a1 + kid.a2);
                                    width: root.age-bar * kid.a3;
                                    height: parent.height;
                                    background: Theme.t3;
                                }
                                Rectangle {
                                    x: root.age-bar * (kid.a0 + kid.a1 + kid.a2 + kid.a3);
                                    width: root.age-bar * kid.a4;
                                    height: parent.height;
                                    background: Theme.t4;
                                }
                                Rectangle {
                                    x: root.age-bar * (kid.a0 + kid.a1 + kid.a2 + kid.a3 + kid.a4);
                                    width: root.age-bar * kid.a5;
                                    height: parent.height;
                                    background: Theme.t5;
                                }
                            }
                        }

                        Text {
                            text: kid.size;
                            color: kid.rest ? Theme.ink-3 : Theme.ink;
                            font-family: Fonts.mono;
                            font-size: 12px;
                            font-weight: kid.rest ? 400 : 650;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 90px;
                        }
                        Text {
                            text: kid.share;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 70px;
                        }
                        Text {
                            text: kid.files;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 80px;
                        }
                    }
                }
            }

            if root.kids.length == 0: Text {
                text: root.kids-empty;
                color: Theme.ink-3;
                font-size: Fonts.small;
                height: 40px;
                vertical-alignment: center;
            }

            Note {
                text: root.kids-note;
            }

            // 4. Two panels side by side: what kinds the weight is in, and the
            // heaviest files under here.
            HorizontalLayout {
                spacing: 28px;

                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    min-width: 260px;

                    Heading {
                        label: root.head-kinds;
                        aside: root.kinds-sampled;
                    }

                    // No `alignment`: the legend takes what the ring leaves,
                    // and a start-aligned row hands out preferred widths only.
                    HorizontalLayout {
                        spacing: 20px;

                        // The ring: one arc a slice, built in Rust in this
                        // box's own 150 units, so nothing here does
                        // trigonometry per frame.
                        Rectangle {
                            width: 150px;
                            height: 150px;

                            // Filled, never stroked: the software renderer's
                            // stroker does not come back from a stroked arc.
                            for slice[i] in root.report-kinds: Path {
                                width: 150px;
                                height: 150px;
                                viewbox-width: 150;
                                viewbox-height: 150;
                                commands: slice.commands;
                                fill: Tones.kind(slice.tone);
                            }

                            Text {
                                x: 0;
                                y: 58px;
                                width: parent.width;
                                height: 24px;
                                text: root.kinds-count;
                                color: Theme.ink;
                                font-size: 20px;
                                font-weight: 250;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Text {
                                x: 0;
                                y: 82px;
                                width: parent.width;
                                height: 14px;
                                text: root.kinds-word;
                                color: Theme.ink-3;
                                font-size: 12px;
                                font-weight: 500;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            // Capped so the counts stay beside their words: a
                            // legend as wide as the window puts a hand's width
                            // between the two halves of one line.
                            max-width: 300px;

                            for slice[i] in root.report-kinds: Rectangle {
                                height: 19px;
                                min-width: 0px;
                                background: slice.token != "" && kindtouch.has-hover
                                    ? Theme.hover : transparent;
                                border-radius: 2px;

                                kindtouch := TouchArea {
                                    enabled: slice.token != "";
                                    clicked => {
                                        root.tab = "search";
                                        root.facet-clicked(slice.token);
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 2px;
                                            background: Tones.kind(slice.tone);
                                        }
                                    }
                                    Text {
                                        text: slice.label;
                                        color: slice.token == "" ? Theme.ink-3 : Theme.ink-2;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: slice.count;
                                        color: Theme.ink-2;
                                        font-family: Fonts.mono;
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        width: 62px;
                                    }
                                    Text {
                                        text: slice.percent;
                                        color: Theme.ink-3;
                                        font-family: Fonts.mono;
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        width: 46px;
                                    }
                                }
                            }
                        }

                        // The width the capped legend does not want. Without it
                        // the whole column stops at the legend's ceiling and the
                        // panel beside it takes the rest of the window.
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    Note {
                        text: root.kinds-note;
                    }
                    Rectangle { }
                }

                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    min-width: 260px;

                    Heading {
                        label: root.head-biggest;
                    }

                    for big[i] in root.report-big: Rectangle {
                        height: 22px;
                        min-width: 0px;
                        background: bigtouch.has-hover ? Theme.hover : transparent;
                        border-radius: 2px;

                        if big.share > 0: Rectangle {
                            x: 0;
                            y: 2px;
                            height: parent.height - 4px;
                            width: parent.width * big.share;
                            background: Theme.line;
                            border-radius: 2px;
                        }

                        bigtouch := TouchArea {
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.right
                                    && e.kind == PointerEventKind.down) {
                                    root.big-menu-at(big.path,
                                        self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;

                            // Both capped by a constant, never by the width of
                            // the column: an uncapped file name asks for its
                            // whole length and takes the panel beside it with it.
                            Text {
                                text: big.name;
                                color: Theme.ink-2;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 0;
                                max-width: 260px;
                            }
                            Text {
                                text: big.dir;
                                color: Theme.ink-3;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: big.size;
                                color: Theme.ink;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                font-weight: 650;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                width: 76px;
                            }
                        }
                    }

                    Note {
                        text: root.biggest-note;
                    }
                    Rectangle { }
                }
            }

            // The way into a search scoped to this folder.
            Rectangle {
                background: Theme.panel-2;
                border-width: Theme.hair;
                border-color: Theme.line-soft;
                border-radius: 3px;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: root.head-jump;
                        color: Theme.ink-3;
                        font-size: 12px;
                        font-weight: 500;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "under:";
                            color: Theme.q-key;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.report-under;
                            color: Theme.ink-2;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        Push {
                            label: root.jump-label;
                            clicked => {
                                root.report-search();
                            }
                        }
                    }

                    Note {
                        text: root.jump-note;
                    }
                }
            }

            // The same file, several times over. Not run unasked: it is a walk
            // of every candidate.
            HorizontalLayout {
                spacing: 10px;
                height: 30px;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.head-dupes;
                        color: Theme.ink-3;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.dupes-open ? root.dupes-hide : root.dupes-show;
                        clicked => {
                            root.dupes-toggled();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.dupes-sum;
                        color: Theme.ink-3;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { }

                for floor[i] in root.dupe-floors: VerticalLayout {
                    alignment: center;
                    Push {
                        label: floor;
                        asking: i == root.dupe-floor;
                        clicked => {
                            root.dupes-floored(i);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.dupes-confirm;
                        clicked => {
                            root.dupes-read();
                        }
                    }
                }
            }

            if root.dupes-open: Text {
                text: root.dupes-note;
                color: Theme.ink-3;
                font-size: 11.5px;
                wrap: word-wrap;
            }

            if root.dupes-open: VerticalLayout {
                spacing: 10px;

                for group[i] in root.dupes: VerticalLayout {
                    spacing: 2px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: group.size;
                            color: Theme.ink;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            font-weight: 650;
                        }
                        Text {
                            text: group.times;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                        }
                        Rectangle { }
                        Text {
                            text: group.certainty;
                            color: group.proven ? Theme.t1 : Theme.q-bad;
                            font-family: Fonts.mono;
                            font-size: 11px;
                        }
                    }
                    Text {
                        text: group.paths;
                        color: Theme.ink-3;
                        font-family: Fonts.mono;
                        font-size: 11px;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }
            }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            visible: root.tab != "report";
            max-height: root.tab == "report" ? 0px : 100000px;

            // The rail: what the matching set consists of. Clicking a row adds
            // its term to the query rather than filtering behind its back.
            // Capped to nothing rather than put behind an `if`: `railview`
            // inside a conditional is out of scope for `scroll-rail`.
            Rectangle {
                // A fixed track: it carries counts that must not reflow while
                // the list beside it does.
                width: root.rail-w;
                background: Theme.ground;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.line;
                }

                // The rail put away: its whole edge brings it back.
                rail-back := TouchArea {
                    visible: false;
                    width: parent.width - 1px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.rail-shown = true;
                        root.panes-changed();
                    }
                    Rectangle {
                        background: rail-back.has-hover ? Theme.hover : transparent;
                    }
                    Text {
                        text: "›";
                        color: rail-back.has-hover ? Theme.ink : Theme.ink-3;
                        font-size: 15px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Scrolled: three sections and thirteen kinds do not fit at
                // 700px, and a rail that grew would push the ribbon off.
                railview := ScrollView {
                    visible: root.rail-shown;
                    // Told how tall it is, or there is no overflow to scroll.
                    viewport-height: rail.preferred-height;

                    rail := VerticalLayout {
                    height: self.preferred-height;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 0px;
                    padding-right: 0px;
                    spacing: 1px;
                    alignment: start;

                    // Where, not what: the scopes are this desktop's own folders,
                    // answered by the service, which runs where the files are.

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        Text {
                            text: root.scope-heading;
                            color: Theme.ink-3;
                            font-size: 12px;
                            font-weight: 500;
                            overflow: elide;
                            height: 18px;
                            horizontal-stretch: 1;
                        }
                        // Put the rail away; the status bar brings it back.
                        rail-x := TouchArea {
                            width: 22px;
                            height: 18px;
                            mouse-cursor: pointer;
                            clicked => {
                                root.rail-shown = false;
                                root.panes-changed();
                            }
                            Text {
                                text: "‹";
                                color: rail-x.has-hover ? Theme.ink : Theme.ink-3;
                                font-size: 15px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { height: 8px; }

                    for sc[i] in root.scopes: FacetRow {
                        icon: "place";
                        label: sc.label;
                        count: sc.count;
                        share: sc.share;
                        on: root.term-on(root.query, sc.token);
                        clicked => { root.facet-clicked(sc.token); }
                    }

                    Rectangle { height: 14px; }

                    // Indented by a layout, not by an `x`: moving the text
                    // right inside a box that stays put clips the first glyph.
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: root.scope-label;
                            color: Theme.ink-3;
                            font-size: 12px;
                            font-weight: 500;
                            overflow: elide;
                            height: 18px;
                        }
                    }

                    Rectangle { height: 8px; }

                    for f[i] in root.facets: FacetRow {
                        icon: f.icon;
                        label: f.label;
                        count: f.count;
                        share: f.share;
                        on: root.term-on(root.query, f.token);
                        clicked => { root.facet-clicked(f.token); }
                    }

                    // Three bands rather than a histogram: a size filter answers
                    // "what is taking the room" and "what is empty".
                    Rectangle { height: 12px; }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: root.size-heading;
                            color: Theme.ink-3;
                            font-size: 12px;
                            font-weight: 500;
                            overflow: elide;
                            height: 18px;
                        }
                    }

                    Rectangle { height: 8px; }

                    for sz[i] in root.sizes: FacetRow {
                        icon: "size";
                        label: sz.label;
                        count: sz.count;
                        share: sz.share;
                        on: root.term-on(root.query, sz.token);
                        clicked => { root.facet-clicked(sz.token); }
                    }
                    }

                }
            }

            // The results.
            VerticalLayout {
                spacing: 0px;
                // Allowed to be narrower than its columns, which is what lets
                // the preview panel take its 380px from the list.
                min-width: 0px;

                // Column headings, each of them a sort. Which columns and how
                // wide are `heads` and `cw`, both handed in from `scour-ui`.
                Rectangle {
                    // Shorter than a row and quieter: a ruler, not a row.
                    height: 28px;
                    background: Theme.panel;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        for h[i] in root.heads: Head {
                            which: h.id;
                            text: h.label;
                            sort: h.sort;
                            align-right: h.right;
                            // No line after the last: there is no column beyond it.
                            last: i == root.heads.length - 1;
                            w: root.cw[i];
                            sorted-by: root.sorted-by;
                            sorted-down: root.sorted-down;
                            dragged(c, d) => { root.column-dragged(c, d); }
                            reset(c) => { root.column-reset(c); }
                            clicked(k) => { root.sort-by(k); }
                        }

                        // Where a column would be. Its room is taken out of the
                        // lane — see `picker-w`.
                        Rectangle {
                            width: 16px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.columns-clicked(self.absolute-position.x,
                                        self.absolute-position.y + self.height);
                                }
                                Image {
                                    source: @image-url("icons/tools/columns.svg");
                                    colorize: parent.has-hover ? Theme.ink : Theme.ink-3;
                                    width: 14px;
                                    height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }

                list := ScrollView {
                    // The window draws its own, in the lane below. See `sb-`.
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    // Capped to nothing rather than put behind an `if`: an id
                    // inside a conditional is out of scope, and both views must
                    // stay readable by name.
                    visible: !root.grid && !root.grep-active;
                    // With `max-height`: a `ScrollView` asks for fifty pixels
                    // whatever it holds, so capping the height alone leaves a band.
                    min-height: 0px;
                    max-height: (root.grid || root.grep-active) ? 0px : 100000px;

                    // Slots that are never destroyed, not a `ListView`: that one
                    // drops the row scrolling out and builds the one scrolling
                    // in, and Slint repaints the whole window for every element
                    // it frees. Rust moves a slot to its new row — see `Slots`.
                    // The length is the whole result, so the scrollbar is too.
                    viewport-height: root.rows.length * Theme.row-height;
                    viewport-width: max(self.visible-width, root.row-w);
                    // The slots' origin, at the first row they cover. Inside it a
                    // slot is at most a screen down: positions a million rows
                    // down are past what a 32-bit float keeps to the pixel, and
                    // rows placed there drew 16px apart instead of 30.
                    Rectangle {
                        y: root.slot-from * Theme.row-height;
                        width: parent.width;
                        height: root.slots.length * Theme.row-height;
                        for slot in root.slots: slot-box := Rectangle {
                            property <int> i: slot.i;
                            property <Row> here: slot.row;
                            property <bool> path-hovered: false;
                            visible: slot.i >= 0;
                            x: 0px;
                            y: (i - root.slot-from) * Theme.row-height;
                            width: parent.width;
                            height: Theme.row-height;
                            // Never animated: selecting is where you are, not an
                            // event that happened to the list. The arrival wash is
                            // a separate layer with its own clock, below.
                            background: (here.picked || i == root.selected) ? Theme.selection
                                : rowtouch.has-hover ? Theme.hover
                                : transparent;

                            // The grid, when the settings ask for it: shown, not
                            // built, so a slot is never rebuilt — see `pool`.
                            Rectangle {
                                visible: root.grid-lines;
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.line-soft;
                            }
                            for h[ci] in root.heads: Rectangle {
                                visible: root.grid-columns && ci < root.heads.length - 1;
                                x: root.cx[ci] + root.cw[ci] + 4px;
                                y: 0px;
                                width: 1px;
                                height: parent.height;
                                background: Theme.line-soft;
                            }

                            // The arrival wash: translucent, so a row that is both
                            // new and selected shows both, and it fades away. Not
                            // while the list moves: a slot handed from a new row
                            // to an old one would fade on the wrong row.
                            Rectangle {
                                background: here.fresh ? Theme.t0.with-alpha(0.22) : transparent;
                                animate background {
                                    duration: root.moving ? 0ms : 1600ms;
                                    easing: ease-out;
                                }
                            }

                            // Where the keyboard is, which is not what is selected:
                            // a ring, because a fourth shade of blue would read as
                            // "more selected", which is not a thing.
                            // Shown, not built: a slot is never rebuilt, see `pool`.
                            Rectangle {
                                visible: i == root.selected && !here.picked;
                                background: transparent;
                                border-width: Theme.hair;
                                border-color: Theme.line;
                            }

                            rowtouch := TouchArea {
                                mouse-cursor: slot-box.path-hovered ? pointer : default;
                                clicked => {
                                    root.selected = i;
                                    root.focus-query();
                                    root.tip-text = root.tip-pending;
                                }
                                double-clicked => {
                                    root.selected = i;
                                    root.opened-at(i, self.mouse-x);
                                }
                                // Eight pixels from the press: past a click's wobble,
                                // short of anything a hand means as a selection.
                                moved => {
                                    if (!root.dragging-out
                                        && (abs(self.mouse-x - self.pressed-x) > 8px
                                            || abs(self.mouse-y - self.pressed-y) > 8px)) {
                                        root.dragging-out = true;
                                        root.drag-out(i, self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    }
                                }
                                // A press, not a click: a click carries no modifiers
                                // here, and `Ctrl` and `Shift` change what it means.
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.up) {
                                        root.dragging-out = false;
                                    }
                                    if (e.kind == PointerEventKind.down
                                        && e.button == PointerEventButton.left) {
                                        root.selected = i;
                                        root.pick(i, e.modifiers.control || e.modifiers.meta,
                                            e.modifiers.shift);
                                    }
                                    if (e.button == PointerEventButton.right
                                        && e.kind == PointerEventKind.down) {
                                        root.selected = i;
                                        // Right-clicking outside the selection selects what
                                        // was right-clicked: a menu must be about what is
                                        // under the pointer.
                                        root.menu-at(i, self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    }
                                }
                            }


                            // Where the file holds the text, under its name: the
                            // line's number, then the line with the find marked.
                            // Shown, not built, so a slot is never rebuilt.
                            Rectangle {
                                visible: root.tall && here.found.length > 0;
                                x: 12px + (root.iconed ? 42px : 0px);
                                y: root.base-row - 4px;
                                width: max(0px, parent.width - self.x - 12px);
                                height: Theme.row-height - root.base-row;
                                Text {
                                    x: 0px;
                                    width: 44px;
                                    height: parent.height;
                                    text: here.found.length > 0 ? here.found[0].line : "";
                                    color: Theme.ink-3;
                                    font-family: Fonts.mono;
                                    font-size: 11.5px;
                                    vertical-alignment: center;
                                }
                                Marked {
                                    x: 48px;
                                    width: max(0px, parent.width - 48px);
                                    height: parent.height;
                                    pre: here.found.length > 0 ? here.found[0].pre : "";
                                    hit: here.found.length > 0 ? here.found[0].hit : "";
                                    post: here.found.length > 0 ? here.found[0].post : "";
                                    colour: Theme.ink-2;
                                }
                            }

                            // The file's own line. On a tall row it keeps the
                            // usual height at the top, and the find goes below.
                            HorizontalLayout {
                                y: 0px;
                                height: root.tall ? root.base-row : Theme.row-height;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                // The kind's icon, spelled out one kind at a time:
                                // `@image-url` is resolved at build time. Tinted
                                // from `scour-ui`. A conditional rather than a zero
                                // width, which would still take the row's spacing.
                                if root.iconed: VerticalLayout {
                                    alignment: center;
                                    width: 34px;
                                    if root.system-icons && here.has-sys-icon: Image {
                                        x: 9px;
                                        width: 16px;
                                        height: 16px;
                                        source: here.sys-icon;
                                        image-fit: contain;
                                    }
                                    if !(root.system-icons && here.has-sys-icon): FileBadge {
                                        ktoken: here.ktoken;
                                        tint: here.tint;
                                        ext: here.ext;
                                    }
                                }

                                // One loop over the cells: which columns are shown
                                // is a person's choice. The name is found by `id`,
                                // and the icon's room comes out of the name's width.
                                // Over the headings, which change only when the columns
                                // do: a loop over the row's own cells would rebuild
                                // every cell of a slot each time the slot moved on.
                                for h[ci] in root.heads: HorizontalLayout {
                                    property <Cell> c: here.cells[ci];
                                    // As wide as its heading, icon included: taking
                                    // the icon off twice shifts every later column.
                                    width: max(0px, root.cw[ci] - (ci == 0 && root.iconed ? 42px : 0px));

                                    if h.id == "name": Marked {
                                        pre: c.pre;
                                        hit: c.hit;
                                        post: c.post;
                                        colour: Theme.ink;
                                        mono: false;
                                        size: 14px;
                                        weight: 500;
                                        width: parent.width;
                                        property <bool> under: rowtouch.has-hover
                                            && rowtouch.mouse-x >= root.cx[ci]
                                            && rowtouch.mouse-x < root.cx[ci] + root.cw[ci];
                                        changed under => {
                                            if (self.under && self.preferred-width > self.width) {
                                                root.tip-owner = i * 32 + ci;
                                                root.tip-mono = false;
                                                root.tip-pending = c.pre + c.hit + c.post;
                                                root.tip-x = rowtouch.absolute-position.x + rowtouch.mouse-x + 14px;
                                                root.tip-y = rowtouch.absolute-position.y + rowtouch.height + 2px;
                                                if (root.tip-text != "") {
                                                    root.tip-text = root.tip-pending;
                                                }
                                            } else if (self.under || root.tip-owner == i * 32 + ci) {
                                                root.tip-owner = -1;
                                                root.tip-pending = "";
                                                root.tip-text = "";
                                            }
                                        }
                                    }

                                    if h.id != "name": Rectangle {
                                        width: root.cw[ci];
                                        property <bool> is-path: h.id == "path";
                                        property <bool> under: rowtouch.has-hover
                                            && rowtouch.mouse-x >= root.cx[ci]
                                            && rowtouch.mouse-x < root.cx[ci] + root.cw[ci];
                                        changed under => {
                                            if (self.is-path) {
                                                slot-box.path-hovered = self.under;
                                            }
                                            if (self.under && (c.hint != "" || cell-txt.preferred-width > cell-txt.width)) {
                                                root.tip-owner = i * 32 + ci;
                                                root.tip-mono = c.mono && c.hint == "";
                                                root.tip-pending = c.hint != "" ? c.hint : c.text;
                                                root.tip-x = rowtouch.absolute-position.x + rowtouch.mouse-x + 14px;
                                                root.tip-y = rowtouch.absolute-position.y + rowtouch.height + 2px;
                                                if (root.tip-text != "") {
                                                    root.tip-text = root.tip-pending;
                                                }
                                            } else if (self.under || root.tip-owner == i * 32 + ci) {
                                                root.tip-owner = -1;
                                                root.tip-pending = "";
                                                root.tip-text = "";
                                            }
                                        }
                                        if self.is-path && self.under: Rectangle {
                                            x: -4px;
                                            y: 0px;
                                            width: parent.width + 8px;
                                            height: parent.height;
                                            background: Theme.q-key.with-alpha(
                                                (here.picked || i == root.selected) ? 0.16 : 0.11);
                                        }
                                        cell-txt := Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: c.text;
                                            // Only the folder is monospace: a path is read
                                            // a character at a time, a date or a size at a glance.
                                            color: parent.is-path && parent.under ? Theme.q-key
                                                 : c.dim ? Theme.ink-3
                                                 : c.mono ? Theme.ink-2 : Theme.ink-3;
                                            font-family: parent.is-path ? Fonts.mono : "";
                                            font-size: parent.is-path ? 12px : c.mono ? 12.5px : Fonts.small;
                                            horizontal-alignment: c.right ? right : left;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        if self.is-path && self.under && c.text != "": Rectangle {
                                            x: 0px;
                                            y: parent.height / 2 + 7px;
                                            width: min(cell-txt.preferred-width, parent.width);
                                            height: 1px;
                                            background: Theme.q-key.with-alpha(0.75);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // The same results as tiles. A second list rather than a second
                // shape for the first: a `ListView` is lazy about one repeater.
                // The one not showing is capped to no height rather than put in
                // an `if`, which would take its id out of scope.
                tiles := ListView {
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    visible: root.grid && !root.grep-active;
                    min-height: 0px;
                    max-height: (root.grid && !root.grep-active) ? 100000px : 0px;

                    for line[i] in root.lines: Rectangle {
                        height: root.tile-h;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;

                            for cell[c] in line: Rectangle {
                                width: root.tile-w;
                                height: root.tile-h;
                                // The tile is the selection, not the line: a line
                                // holds several results.
                                background: (cell.picked || (i * root.per-line + c) == root.selected)
                                    ? Theme.selection
                                    : tiletouch.has-hover ? Theme.hover
                                    : transparent;

                                // The arrival wash, on its own layer.
                                Rectangle {
                                    background: cell.fresh
                                        ? Theme.t0.with-alpha(0.22)
                                        : transparent;
                                    animate background { duration: 1600ms; easing: ease-out; }
                                }

                                // And where the keyboard is — see the table's
                                // rows for why a ring rather than a shade.
                                if (i * root.per-line + c) == root.selected: Rectangle {
                                    background: transparent;
                                    border-width: Theme.hair;
                                    border-color: Theme.focus;
                                }

                                tiletouch := TouchArea {
                                    clicked => {
                                        root.selected = i * root.per-line + c;
                                        root.focus-query();
                                    }
                                    double-clicked => {
                                        root.selected = i * root.per-line + c;
                                        root.activated(root.selected);
                                    }
                                    moved => {
                                        if (!root.dragging-out
                                            && (abs(self.mouse-x - self.pressed-x) > 8px
                                                || abs(self.mouse-y - self.pressed-y) > 8px)) {
                                            root.dragging-out = true;
                                            root.drag-out(i * root.per-line + c,
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.up) {
                                            root.dragging-out = false;
                                        }
                                        if (e.kind != PointerEventKind.down) {
                                            return;
                                        }
                                        root.selected = i * root.per-line + c;
                                        if (e.button == PointerEventButton.right) {
                                            root.menu-at(root.selected,
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                        } else if (e.button == PointerEventButton.left) {
                                            root.pick(root.selected,
                                                e.modifiers.control || e.modifiers.meta,
                                                e.modifiers.shift);
                                        }
                                    }
                                }

                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 4px;
                                    alignment: center;

                                    // The picture where there is one, the kind's
                                    // colour where there is not.
                                    Rectangle {
                                        height: root.pic;
                                        if cell.shot: Image {
                                            width: root.pic;
                                            height: root.pic;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: cell.thumb;
                                            // The whole picture: its shape is
                                            // part of what identifies it.
                                            image-fit: contain;
                                        }
                                        if cell.shot == false && root.system-icons && cell.has-sys-icon: Image {
                                            width: root.pic * 0.72;
                                            height: root.pic * 0.72;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: cell.sys-icon;
                                            image-fit: contain;
                                        }
                                        if cell.shot == false && !(root.system-icons && cell.has-sys-icon): Rectangle {
                                            width: root.pic * 0.55;
                                            height: root.pic * 0.55;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 5px;
                                            background: cell.tint;
                                            opacity: 0.5;
                                        }
                                    }

                                    Text {
                                        text: cell.name;
                                        color: Theme.ink;
                                        font-family: Fonts.mono;
                                        font-size: root.view-mode == "large" ? 12px : 11px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        height: 30px;
                                    }
                                }
                            }
                        }
                    }
                }
                // Stream of files and matching lines when the Grep capsule is active.
                VerticalLayout {
                    visible: root.grep-active;
                    min-height: 0px;
                    max-height: root.grep-active ? 100000px : 0px;
                    vertical-stretch: root.grep-active ? 1 : 0;

                    Rectangle {
                        height: 36px;
                        background: Theme.ground;
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.line;
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            Text {
                                text: root.grep-summary;
                                color: Theme.ink-2;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if root.grep-more-on: VerticalLayout {
                                alignment: center;
                                Push {
                                    label: root.word-read-more + " →";
                                    asking: true;
                                    clicked => { root.grep-more(); }
                                }
                            }
                        }
                    }

                    if root.grep-empty != "": Rectangle {
                        vertical-stretch: 1;
                        Text {
                            text: root.grep-empty;
                            color: Theme.ink-3;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if root.grep-empty == "": ListView {
                        vertical-stretch: 1;
                        for gitem in root.grep-items: Rectangle {
                            height: gitem.header ? 32px : 25px;
                            background: gitem.file-idx == root.grep-sel ? Theme.selection
                                : ghit.has-hover ? Theme.hover : gitem.header ? Theme.ground : transparent;
                            if gitem.header: Rectangle {
                                y: 0px;
                                height: 1px;
                                background: Theme.line-soft;
                            }
                            if gitem.header: HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                if root.iconed: VerticalLayout {
                                    alignment: center;
                                    width: 34px;
                                    FileBadge {
                                        ktoken: gitem.ktoken;
                                        tint: gitem.tint;
                                        ext: gitem.ext;
                                    }
                                }
                                for h[ci] in root.heads: HorizontalLayout {
                                    property <Cell> gc: ci < gitem.cells.length ? gitem.cells[ci] : { text: "" };
                                    width: max(0px, root.cw[ci] - (ci == 0 && root.iconed ? 42px : 0px));
                                    if h.id == "name": Text {
                                        width: parent.width;
                                        text: gc.pre + gc.hit + gc.post + "  (" + gitem.count + ")";
                                        color: Theme.ink;
                                        font-family: Fonts.mono;
                                        font-size: 12.5px;
                                        font-weight: 650;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if h.id != "name": Text {
                                        width: parent.width;
                                        text: gc.text;
                                        color: h.id == "path" ? Theme.ink-3 : Theme.ink-2;
                                        font-family: gc.mono ? Fonts.mono : "";
                                        font-size: gc.mono ? 11.5px : Fonts.small;
                                        horizontal-alignment: gc.right ? right : left;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                            if !gitem.header: HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 14px;
                                spacing: 10px;
                                Text {
                                    width: 44px;
                                    text: gitem.line;
                                    color: Theme.ink-3;
                                    font-family: Fonts.mono;
                                    font-size: 11.5px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Marked {
                                    horizontal-stretch: 1;
                                    height: parent.height;
                                    pre: gitem.pre;
                                    hit: gitem.hit;
                                    post: gitem.post;
                                    colour: Theme.ink-2;
                                }
                            }
                            ghit := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.grep-clicked(gitem.file-idx); }
                                double-clicked => { root.grep-opened(gitem.file-idx); }
                            }
                        }
                    }
                }

                // The first-run offer, under the list: bind a key once, and no
                // face asks again. It stays while an error has to be read.
                if root.key-nudge || root.key-nudge-error != "": Rectangle {
                    height: 38px;
                    background: Theme.panel;

                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.line;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.key-nudge-error != ""
                                    ? root.key-nudge-error : root.key-nudge-text;
                                color: root.key-nudge-error != "" ? Theme.q-not : Theme.ink-2;
                                font-size: 11.5px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { }

                        if root.key-nudge: VerticalLayout {
                            alignment: center;
                            Push {
                                label: root.key-nudge-yes;
                                clicked => { root.key-nudged(true); }
                            }
                        }

                        if root.key-nudge && root.key-nudge-other != "": VerticalLayout {
                            alignment: center;
                            Push {
                                label: root.key-nudge-other;
                                clicked => { root.key-nudged-other(); }
                            }
                        }

                        if root.key-nudge: VerticalLayout {
                            alignment: center;
                            Push {
                                label: root.key-nudge-no;
                                clicked => { root.key-nudged(false); }
                            }
                        }
                    }
                }
            }

            // The scrollbar's lane. Beside the list, never over it; the
            // arithmetic is in the `sb-` properties.
            VerticalLayout {
                width: 14px;

                // Level with the column headings, carrying their rule across.
                Rectangle {
                    height: 31px;
                    background: Theme.panel;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }
                }

                Rectangle {
                    background: Theme.panel;

                    thumb := Rectangle {
                        x: 4px;
                        width: 6px;
                        y: root.sb-y;
                        height: root.sb-thumb;
                        border-radius: 3px;
                        // Quiet until it is wanted.
                        background: grab.pressed ? Theme.ink-2
                            : grab.has-hover ? Theme.ink-3 : Theme.line;
                        visible: root.sb-span > 0px;
                        animate background { duration: 120ms; }
                    }

                    grab := TouchArea {
                        // Where the thumb was when this press began.
                        property <length> from;

                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                // A press on the track takes the thumb to the
                                // pointer; on the thumb it picks it up as it is.
                                if (self.mouse-y < thumb.y
                                    || self.mouse-y > thumb.y + thumb.height) {
                                    root.scroll-thumb-to(self.mouse-y - thumb.height / 2);
                                }
                                self.from = thumb.y;
                            }
                        }

                        moved => {
                            root.scroll-thumb-to(self.from + self.mouse-y - self.pressed-y);
                        }
                    }
                }
            }

            // The preview panel: 380px, shut by default, and the width and the
            // bounds are `scour_ui::preview`'s so every face agrees.
            if root.peeking: Rectangle {
                // Min and max, not `width`: the list's own minimum is wider than
                // the window, and a `width` is a preference the layout squeezes.
                min-width: root.peek-width;
                max-width: root.peek-width;
                horizontal-stretch: 0;
                background: Theme.panel-2;

                Rectangle {
                    x: 0;
                    width: peekgrip.has-hover || peekgrip.pressed ? 2px : 1px;
                    height: parent.height;
                    background: peekgrip.has-hover || peekgrip.pressed ? Theme.focus : Theme.line;
                }

                VerticalLayout {
                    padding-left: 1px;
                    spacing: 0px;

                    // The name, and the way out. Wrapped rather than truncated:
                    // the end of a name is what tells two versions apart.
                    Rectangle {
                        height: 46px;
                        background: Theme.panel-2;

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.line;
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 8px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;

                            Text {
                                text: root.peek-name;
                                color: Theme.ink;
                                font-size: 12.5px;
                                font-weight: 600;
                                wrap: word-wrap;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                Tool {
                                    glyph: "×";
                                    clicked => {
                                        root.peek-toggled();
                                    }
                                }
                            }
                        }
                    }

                    // What can be shown of the file: pages, picture, text, or note.
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 80px;

                        if root.peek-pages.length > 0: doc-box := Rectangle {
                            width: parent.width;
                            height: parent.height;
                            property <length> card-w: max(80px, self.width - 28px);
                            property <length> slot-h: max(80px, self.card-w * root.peek-aspect) + 12px;
                            property <int> current-page: clamp(
                                Math.floor((-doc-view.viewport-y + doc-view.visible-height * 0.35) / self.slot-h),
                                0,
                                max(0, root.peek-pages.length - 1));

                            changed current-page => {
                                root.peek-page-scrolled(self.current-page);
                            }

                            doc-view := ListView {
                                width: parent.width;
                                height: parent.height;
                                for page[idx] in root.peek-pages: Rectangle {
                                    width: doc-view.visible-width;
                                    height: doc-box.slot-h;

                                    Rectangle {
                                        x: 10px;
                                        y: 6px;
                                        width: max(60px, parent.width - 20px);
                                        height: parent.height - 12px;
                                        background: #ffffff;
                                        border-width: Theme.hair;
                                        border-color: Theme.line;
                                        border-radius: 3px;

                                        if page.ready: Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: page.shot;
                                            image-fit: contain;
                                        }

                                        if !page.ready: Text {
                                            text: page.number;
                                            color: #888888;
                                            font-size: 11.5px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                x: parent.width - self.width - 18px;
                                y: 10px;
                                width: page-badge.preferred-width + 14px;
                                height: 22px;
                                border-radius: 11px;
                                background: Theme.dark ? #16181dd9 : #ffffffd9;
                                border-width: Theme.hair;
                                border-color: Theme.line;
                                page-badge := Text {
                                    text: (doc-box.current-page + 1) + " / " + root.peek-pages.length;
                                    color: Theme.ink;
                                    font-family: Fonts.mono;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.peek-pages.length == 0 && root.peek-has-shot: Image {
                            width: parent.width - 24px;
                            height: parent.height - 24px;
                            x: 12px;
                            y: 12px;
                            source: root.peek-shot;
                            // The whole picture: a crop can remove the part being
                            // looked for.
                            image-fit: contain;
                        }

                        if root.peek-pages.length == 0 && !root.peek-has-shot && root.peek-text != "": Flickable {
                            width: parent.width;
                            height: parent.height;
                            // The wheel scrolls; a drag selects. An interactive
                            // flickable takes the drag for itself.
                            interactive: false;
                            viewport-width: self.width;
                            viewport-height: body.preferred-height;

                            body := VerticalLayout {
                                padding: 12px;
                                alignment: start;
                                // A field that cannot be typed into, so the text
                                // can be selected and copied.
                                TextInput {
                                    text: root.peek-text;
                                    read-only: true;
                                    // Read as the caret moves, not on change: a
                                    // `changed` handler missed the last step of a drag.
                                    cursor-position-changed(p) => {
                                        root.peek-from = self.anchor-position-byte-offset;
                                        root.peek-to = self.cursor-position-byte-offset;
                                    }
                                    key-pressed(e) => {
                                        if (e.modifiers.control && (e.text == "c" || e.text == "C")) {
                                            root.copy-span(self.text, self.anchor-position-byte-offset,
                                                self.cursor-position-byte-offset);
                                            return accept;
                                        }
                                        return reject;
                                    }
                                    single-line: false;
                                    color: Theme.ink-2;
                                    font-family: Fonts.mono;
                                    font-size: 11.5px;
                                    wrap: word-wrap;
                                    selection-background-color: Theme.selection;
                                    selection-foreground-color: Theme.ink;
                                }
                            }
                        }

                        if root.peek-pages.length == 0 && !root.peek-has-shot && root.peek-text == "": Text {
                            text: root.peek-note;
                            color: Theme.ink-3;
                            font-size: 11.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    // Where the file holds the text a `content:` query asked
                    // for: each place's line number and the line, the find marked.
                    if root.peek-found.length > 0: Rectangle {
                        vertical-stretch: 0;
                        background: Theme.panel;

                        Rectangle {
                            y: 0;
                            height: 1px;
                            background: Theme.line;
                        }

                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 9px;
                            padding-bottom: 9px;
                            spacing: 2px;
                            alignment: start;

                            Text {
                                text: root.word-found;
                                color: Theme.ink-3;
                                font-size: 11px;
                            }
                            for f in root.peek-found: Rectangle {
                                height: 20px;
                                Text {
                                    x: 0px;
                                    width: 40px;
                                    height: parent.height;
                                    text: f.line;
                                    color: Theme.ink-3;
                                    font-family: Fonts.mono;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Marked {
                                    x: 48px;
                                    width: max(0px, parent.width - 48px);
                                    height: parent.height;
                                    pre: f.pre;
                                    hit: f.hit;
                                    post: f.post;
                                    colour: Theme.ink-2;
                                }
                            }
                        }
                    }

                    // The facts, below the picture. Its own height, because a
                    // path wraps to four lines as readily as one; asking a named
                    // child for `preferred-height` from its parent is a circle.
                    Rectangle {
                        vertical-stretch: 0;
                        background: Theme.panel;

                        Rectangle {
                            y: 0;
                            height: 1px;
                            background: Theme.line;
                        }

                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 9px;
                            padding-bottom: 9px;
                            spacing: 3px;
                            alignment: start;

                            for fact in root.peek-facts: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: fact.label;
                                    color: Theme.ink-3;
                                    font-size: 11px;
                                    width: 74px;
                                    overflow: elide;
                                }
                                Text {
                                    text: fact.value;
                                    color: Theme.ink-2;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            
                // The edge that sets the width, 7px like a column's, and last so
                // it is above what the panel holds. The panel's edge moves with
                // the pointer, so each move is measured from where it now is.
                peekgrip := TouchArea {
                    x: 0;
                    width: 7px;
                    height: parent.height;
                    mouse-cursor: col-resize;
                    moved => {
                        if (self.pressed) {
                            root.peek-width = max(root.peek-min,
                                min(root.peek-max, root.peek-width - (self.mouse-x - self.pressed-x)));
                        }
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up) {
                            root.peek-resized(root.peek-width / 1px);
                        }
                    }
                    double-clicked => {
                        root.peek-width = 380px;
                        root.peek-resized(0);
                    }
                }
            }
        }

        // The time ribbon. Twenty-four bars on a logarithmic scale, so the last
        // day, week and year all have room on one screen. The edges are
        // `scour_ui::bar_edges`, shared with every other face.
        Rectangle {
            visible: root.tab != "report" && root.ribbon-shown;
            min-height: root.tab == "report" || !root.ribbon-shown ? 0px : 76px;
            max-height: root.tab == "report" || !root.ribbon-shown ? 0px : 76px;
            background: Theme.panel;

            // `y` said: a rectangle with only a height is centred in its
            // parent, and this line ran through the middle of the bars.
            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.line;
            }

            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 0px;

                HorizontalLayout {
                    Text {
                        text: root.ribbon-label;
                        color: Theme.ink-3;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                        height: 18px;
                    }
                    Rectangle { }
                    Text {
                        text: root.ribbon-hint;
                        color: Theme.ink-3;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    ribbon-x := TouchArea {
                        width: 22px;
                        height: 18px;
                        mouse-cursor: pointer;
                        clicked => {
                            root.ribbon-shown = false;
                            root.panes-changed();
                        }
                        Text {
                            text: "×";
                            color: ribbon-x.has-hover ? Theme.ink : Theme.ink-3;
                            font-size: 14px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 4px; }

                // The bars take what is left; the axis keeps its line.
                HorizontalLayout {
                    spacing: 3px;
                    alignment: stretch;

                    for b[i] in root.bars: Rectangle {
                        horizontal-stretch: 1;

                        // A bar is a filter: clicking adds a `dm:` term to the
                        // text. The oldest has no upper bound, so it does
                        // nothing and says so by not lighting up.
                        bartouch := TouchArea {
                            mouse-cursor: b.days > 0 ? pointer : default;
                            clicked => {
                                if (b.days > 0) {
                                    root.bar-clicked(b.days);
                                }
                            }
                        }
                        // Bottom-aligned, so twenty-four bars read as one shape.
                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                // A fixed ceiling, not a share of the parent:
                                // that is a binding loop. 22px leaves the axis
                                // its line inside the ribbon's 76.
                                height: b.count == 0 ? 2px
                                    : max(3px, 22px * b.count / max(1, root.bar-peak));
                                // One ink: the axis says how old, not the colour.
                                background: b.count == 0 ? Theme.line : Theme.ink-3;
                                // Lighter under the pointer: a bar that can be
                                // pressed says so before it is.
                                opacity: bartouch.has-hover && b.days > 0 ? 0.75 : 1.0;
                            }
                        }
                    }
                }

                // The axis. Five marks rather than twenty-four: the question is
                // only ever "how far back am I looking".
                HorizontalLayout {
                    padding-top: 3px;

                    Text {
                        text: root.axis-oldest;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: left;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-year;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-month;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-week;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.axis-today;
                        color: Theme.ink-3;
                        font-size: 10px;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        // The status bar: how many, how long, how big the index is. At the
        // foot, as a desktop puts it; the answer's count is its first word.
        Rectangle {
            height: 28px;
            background: Theme.ground;

            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.line;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;

                // Three claims of different weight: the count is the answer,
                // the cost wears the "today" hue, the walk stays quiet. `meter`
                // holds the sentences that are not numbers; never both at once.
                if root.notice != "": Text {
                    text: root.notice;
                    color: Theme.ink-2;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

                if root.notice == "" && root.meter-count != "": HorizontalLayout {
                    spacing: 6px;

                    Text {
                        text: root.meter-count;
                        color: Theme.ink;
                        font-size: 12.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-ms == "" ? "" : "·";
                        color: Theme.line;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-ms;
                        color: Theme.ink-3;
                        font-size: 11.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.meter-rows == "" ? "" : "·";
                        color: Theme.line;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    // Turning while files are read, and only then: a timer
                    // that ran always would be a window that never rests.
                    if root.reading-stage == 1: Text {
                        property <int> turn;
                        property <[string]> frames: ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
                        text: self.frames[self.turn];
                        color: Theme.q-key;
                        font-size: 12px;
                        vertical-alignment: center;
                        Timer {
                            interval: 90ms;
                            running: true;
                            triggered => { parent.turn = Math.mod(parent.turn + 1, 10); }
                        }
                    }
                    Text {
                        text: root.meter-rows;
                        color: root.reading-stage == 1 ? Theme.q-key : Theme.ink-3;
                        font-size: 11.5px;
                        font-weight: root.reading-stage == 1 ? 600 : 400;
                        vertical-alignment: center;
                    }
                    if root.reading-stage == 2: VerticalLayout {
                        alignment: center;
                        Push {
                            label: root.read-on;
                            plain: true;
                            clicked => { root.reread(false); }
                        }
                    }
                    if root.reading-stage > 0: VerticalLayout {
                        alignment: center;
                        Push {
                            label: root.read-again;
                            plain: true;
                            clicked => { root.reread(true); }
                        }
                    }
                    Text {
                        text: root.scanning == "" ? "" : "·";
                        color: Theme.line;
                        font-size: 11.5px;
                        vertical-alignment: center;
                    }
                    // The key colour: the one thing on this line still moving.
                    Text {
                        text: root.scanning;
                        color: Theme.q-key;
                        font-size: 11.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                if root.notice == "" && root.meter-count == "": Text {
                    text: root.meter;
                    color: Theme.ink-3;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

                // What the service is holding, not what it just answered.
                Text {
                    text: root.holding == "" ? "" : "  ·  " + root.holding;
                    color: Theme.ink-3;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle { }

                // A disk waiting for an answer, how every word is read, and
                // the two keys worth knowing. The rail and the ribbon, put
                // away, come back from Settings → List.
                if root.disk-said != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        width: disk-text.preferred-width + 16px;
                        border-radius: 6px;
                        border-width: Theme.hair;
                        border-color: Theme.q-bad;
                        disk-text := Text {
                            text: root.disk-said;
                            color: Theme.q-bad;
                            font-size: 11.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.tool-clicked("settings");
                                root.settings-section = "disks";
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        width: nar-text.preferred-width + 16px;
                        border-radius: 6px;
                        border-width: Theme.hair;
                        border-color: root.narrow-shown ? Theme.cap-ring : nar-touch.has-hover ? Theme.ink-3 : Theme.line;
                        background: root.narrow-shown ? Theme.cap : transparent;
                        nar-text := Text {
                            text: root.word-narrow-pill;
                            color: root.narrow-shown ? Theme.q-key : nar-touch.has-hover ? Theme.ink : Theme.ink-2;
                            font-size: 11.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        nar-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.narrow-toggled(); }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        width: typos-text.preferred-width + 16px;
                        border-radius: 6px;
                        border-width: Theme.hair;
                        border-color: typos-touch.has-hover ? Theme.ink-3 : Theme.line;
                        typos-text := Text {
                            text: root.typos-said;
                            color: typos-touch.has-hover ? Theme.ink : Theme.ink-2;
                            font-size: 11.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        typos-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.typos-picked(root.typos-choice == "" ? "always"
                                    : root.typos-choice == "always" ? "off" : "");
                            }
                        }
                    }
                }
                Text {
                    text: ":  " + root.word-filter-key + "    Alt+T  " + root.word-tab-key;
                    color: Theme.ink-3;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

                if root.note != "": Text {
                    text: root.note;
                    color: Theme.q-key;
                    font-size: 11.5px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.busy: Text {
                    text: "…";
                    color: Theme.focus;
                    font-size: 11.5px;
                    vertical-alignment: center;
                }

            }
        }

    }

        // What is selected, flush on top of the status bar at the left edge
        // like a browser's link preview: never hides the status line.
        if root.sel-shown: Rectangle {
            x: -Theme.hair;
            y: parent.height - 28px - self.height + Theme.hair;
            width: min(sel-line.preferred-width, max(180px, parent.width - root.peek-w - 12px));
            height: 28px;
            background: Theme.dark ? Theme.panel-2 : Theme.panel;
            border-width: Theme.hair;
            border-color: Theme.line;
            border-top-right-radius: 6px;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: -2px;
            drop-shadow-color: #0000001a;

            TouchArea {}

            sel-line := HorizontalLayout {
                padding-left: 10px + Theme.hair;
                padding-right: 10px;
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: "×";
                        plain: true;
                        clicked => { root.pick-dropped(); }
                    }
                }
                Rectangle {
                    border-radius: 4px;
                    background: pick-jump.has-hover ? Theme.hover : transparent;
                    pick-jump := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick-focused(); }
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: start;
                        Text {
                            text: root.picked-pre;
                            color: pick-jump.has-hover ? Theme.ink
                                : root.picked-n == "" ? Theme.ink-2 : Theme.ink-3;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: min(420px, max(80px, root.width - root.peek-w - 420px));
                        }
                        Text {
                            text: root.picked-n;
                            color: Theme.ink;
                            font-size: 12px;
                            font-weight: 650;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.picked-post;
                            color: pick-jump.has-hover ? Theme.ink-2 : Theme.ink-3;
                            font-size: 11.5px;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { width: 6px; }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.pick-copy;
                        plain: true;
                        clicked => { root.pick-copied(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Push {
                        label: root.pick-folders;
                        plain: true;
                        asking: root.pick-asking;
                        enabled: root.pick-folders-ok;
                        clicked => { root.pick-opened(); }
                    }
                }
            }
        }

        // What was searched before, hanging over what is under the query row —
        // which is why it is drawn here and not inside that row. Placed at the
        // field's own left edge, since the mark beside it has no fixed width.
        // This area puts it away; behind the list, so a press on a line lands.
        if root.past-open: TouchArea {
            width: parent.width;
            height: parent.height;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.past-open = false;
                }
            }
        }

        if root.past-open && root.past.length > 0: Rectangle {
            width: min(320px, max(220px, field.width * 0.55));
            x: clamp(field.absolute-position.x + field.width - self.width,
                8px, parent.width - self.width - 8px);
            y: field.absolute-position.y + field.height + 4px;
            height: min(root.past.length * 24px + 8px, 152px);
            background: Theme.panel-2;
            border-width: Theme.hair;
            border-color: Theme.line;
            border-radius: 8px;
            clip: true;
            drop-shadow-blur: 14px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 4px;

            TouchArea {}

            past-scroll := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-height: root.past.length * 24px + 8px;
                property <int> follow: root.past-picked;
                changed follow => {
                    let top = 4px + self.follow * 24px;
                    if (top + self.viewport-y < 0px) {
                        self.viewport-y = -top;
                    } else if (top + 24px + self.viewport-y > self.height) {
                        self.viewport-y = self.height - top - 24px;
                    }
                }
                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;
                    for line[i] in root.past: Rectangle {
                        height: 24px;
                        background: i == root.past-picked ? Theme.selection
                                  : row-touch.has-hover ? Theme.hover : transparent;
                        border-radius: 4px;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: line;
                            color: Theme.ink;
                            font-family: Fonts.mono;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    root.past-taken(line);
                                }
                            }
                        }
                    }
                }
            }
        }

        }


        // The lens: under the term the caret is on, expanding to a 2-column
        // Miller place explorer or interactive sparkline histogram when needed.
        if root.lens-open && (root.lens-kind == "place" || root.lens-rows.length > 0): Rectangle {
            x: clamp(field.absolute-position.x + field.pad + root.lens-x - 12px,
                8px, root.width - self.width - 8px);
            y: field.absolute-position.y + field.top + (root.lens-line + 1) * root.q-pitch + 4px;
            width: root.lens-kind == "place" ? min(680px, root.width - 20px)
                : (root.lens-kind == "time" || root.lens-kind == "size") ? min(470px, root.width - 20px)
                : min(430px, root.width - 20px);
            height: root.lens-kind == "place" ? min(370px, root.height - self.y - 16px)
                : min(lens-body.preferred-height, 410px);
            background: Theme.panel-2;
            border-width: Theme.hair;
            border-color: Theme.line;
            border-radius: 10px;
            clip: true;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0000005c;
            drop-shadow-offset-y: 6px;

            TouchArea {}

            if root.lens-kind == "place": VerticalLayout {
                HorizontalLayout {
                    vertical-stretch: 1;
                    // Left column: Disks + Places + OS Folder Picker
                    Rectangle {
                        width: 215px;
                        background: Theme.ground;
                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            height: parent.height;
                            background: Theme.line;
                        }
                        VerticalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 2px;
                            Flickable {
                                vertical-stretch: 1;
                                viewport-height: pleft-col.preferred-height;
                                pleft-col := VerticalLayout {
                                    for pl in root.lens-places: VerticalLayout {
                                        if pl.group != "": Rectangle {
                                            height: 20px;
                                            Text {
                                                x: 12px;
                                                text: pl.group;
                                                color: Theme.ink-3;
                                                font-size: 10.5px;
                                                font-weight: 650;
                                                vertical-alignment: bottom;
                                            }
                                        }
                                        Rectangle {
                                            height: 26px;
                                            background: pl.active ? Theme.selection : plhit.has-hover ? Theme.hover : transparent;
                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 10px;
                                                spacing: 6px;
                                                Text {
                                                    text: pl.label;
                                                    color: Theme.ink;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                                Text {
                                                    text: pl.sub;
                                                    color: pl.ask-disk ? Theme.q-key : Theme.ink-3;
                                                    font-family: Fonts.mono;
                                                    font-size: 10.5px;
                                                    font-weight: pl.ask-disk ? 600 : 400;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            plhit := TouchArea {
                                                mouse-cursor: pointer;
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                        root.lens-place-act(pl.ask-disk ? "disk" : "dir", pl.target);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Rectangle {
                                    height: 28px;
                                    border-radius: 6px;
                                    border-width: Theme.hair;
                                    border-color: pickhit.has-hover ? Theme.ink-3 : Theme.line;
                                    background: pickhit.has-hover ? Theme.hover : Theme.panel;
                                    Text {
                                        text: "📁 " + root.word-choose-folder;
                                        color: Theme.ink-2;
                                        font-size: 12px;
                                        font-weight: 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    pickhit := TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                root.lens-place-act("pick", root.lens-place-cur);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Right column: Breadcrumb + Direct switch + Weighted subfolders
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Rectangle {
                            height: 30px;
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.line-soft;
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 3px;
                                if root.lens-place-up != "": Rectangle {
                                    width: 20px;
                                    border-radius: 4px;
                                    background: uphit.has-hover ? Theme.hover : transparent;
                                    Text {
                                        text: "‹";
                                        color: Theme.ink-2;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    uphit := TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                root.lens-place-act("dir", root.lens-place-up);
                                            }
                                        }
                                    }
                                }
                                Flickable {
                                    horizontal-stretch: 1;
                                    interactive: false;
                                    viewport-width: crumb-row.preferred-width;
                                    crumb-row := HorizontalLayout {
                                        spacing: 2px;
                                        alignment: start;
                                        for cr[ci] in root.lens-crumbs: HorizontalLayout {
                                            spacing: 2px;
                                            if ci > 0: Text {
                                                text: "/";
                                                color: Theme.ink-3;
                                                font-family: Fonts.mono;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: crtxt.preferred-width + 8px;
                                                border-radius: 4px;
                                                background: crhit.has-hover ? Theme.hover : transparent;
                                                crtxt := Text {
                                                    text: cr.label;
                                                    color: ci == root.lens-crumbs.length - 1 ? Theme.ink : Theme.ink-2;
                                                    font-family: Fonts.mono;
                                                    font-size: 11.5px;
                                                    font-weight: ci == root.lens-crumbs.length - 1 ? 650 : 500;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                crhit := TouchArea {
                                                    mouse-cursor: pointer;
                                                    pointer-event(e) => {
                                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                            root.lens-place-act("dir", cr.path);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 20px;
                                        width: dirtxt.preferred-width + 12px;
                                        border-radius: 5px;
                                        border-width: Theme.hair;
                                        border-color: root.lens-place-direct ? Theme.cap-ring : Theme.line;
                                        background: root.lens-place-direct ? Theme.cap : dirhit.has-hover ? Theme.hover : transparent;
                                        dirtxt := Text {
                                            text: root.word-direct-only;
                                            color: root.lens-place-direct ? Theme.q-key : Theme.ink-3;
                                            font-size: 10.5px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        dirhit := TouchArea {
                                            mouse-cursor: pointer;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                    root.lens-place-act("flip", root.lens-place-cur);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Apply current folder row
                        Rectangle {
                            height: 28px;
                            background: curhit.has-hover ? Theme.selection : transparent;
                            curhit := TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        root.lens-place-act("choose", root.lens-place-cur);
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                Text {
                                    text: "✓ " + root.word-this-folder + " (" + root.lens-place-shown + ")";
                                    color: Theme.q-key;
                                    font-family: Fonts.mono;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                PairButton {
                                    y: 6px;
                                    label: "+";
                                    pressed => { root.lens-place-act("inc", root.lens-place-cur); }
                                }
                                PairButton {
                                    y: 6px;
                                    label: "!";
                                    pressed => { root.lens-place-act("exc", root.lens-place-cur); }
                                }
                            }
                        }

                        Flickable {
                            vertical-stretch: 1;
                            viewport-height: pdir-col.preferred-height;
                            pdir-col := VerticalLayout {
                                for d in root.lens-dirs: Rectangle {
                                    height: 26px;
                                    background: dhit.has-hover ? Theme.hover : transparent;
                                    if d.bar > 0: Rectangle {
                                        x: 8px;
                                        y: 3px;
                                        height: 20px;
                                        width: (parent.width - 16px) * d.bar * 0.88;
                                        border-radius: 3px;
                                        background: Theme.line-soft;
                                    }
                                    dhit := TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                root.lens-place-act("dir", d.path);
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        Text {
                                            text: d.name;
                                            color: Theme.ink;
                                            font-family: Fonts.mono;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: d.meta;
                                            color: Theme.ink-3;
                                            font-family: Fonts.mono;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        PairButton {
                                            y: 5px;
                                            label: "+";
                                            pressed => { root.lens-place-act("inc", d.path); }
                                        }
                                        PairButton {
                                            y: 5px;
                                            label: "!";
                                            pressed => { root.lens-place-act("exc", d.path); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    height: 26px;
                    Text {
                        text: root.lens-foot;
                        color: Theme.ink-3;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            lens-flick := Flickable {
                visible: root.lens-kind != "place";
                viewport-height: lens-body.preferred-height;
                property <int> sel: root.lens-sel;
                changed sel => {
                    let at = 30px + self.sel * 26px;
                    if (at + 30px + self.viewport-y > self.height) {
                        self.viewport-y = self.height - at - 30px;
                    }
                    if (at + self.viewport-y < 30px) {
                        self.viewport-y = min(0px, 30px - at);
                    }
                }
                lens-body := VerticalLayout {
                    padding-top: 4px;
                    padding-bottom: 4px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        height: 24px;
                        Text {
                            text: root.lens-title;
                            color: Theme.ink-2;
                            font-size: 11.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if !root.cal-open: Text {
                            text: root.lens-said;
                            color: Theme.ink-3;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        if root.lens-kind == "time": HorizontalLayout {
                            padding-left: 8px;
                            VerticalLayout {
                                alignment: center;
                                TextTool {
                                    height: 20px;
                                    label: root.word-calendar;
                                    on: root.cal-open;
                                    clicked => {
                                        root.cal-open = !root.cal-open;
                                        root.cal-from = -1;
                                        root.cal-to = -1;
                                        if (root.cal-open) {
                                            root.cal-opened();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Two months side by side: a press picks the first day, a
                    // second the last, the days between lit as the pointer moves.
                    if root.cal-open && root.lens-kind == "time": VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 2px;
                        padding-bottom: 8px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 20px;
                            alignment: center;
                            for mo[mi] in root.cal-months: VerticalLayout {
                                spacing: 2px;
                                HorizontalLayout {
                                    height: 26px;
                                    if mi == 0: CalArrow {
                                        label: "‹";
                                        clicked => { root.cal-shift(-1); }
                                    }
                                    if mi != 0: Rectangle { width: 24px; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: mo.title;
                                        color: Theme.ink;
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    if mi == root.cal-months.length - 1: CalArrow {
                                        label: "›";
                                        clicked => { root.cal-shift(1); }
                                    }
                                    if mi != root.cal-months.length - 1: Rectangle { width: 24px; }
                                }
                                HorizontalLayout {
                                    for wd in root.cal-week: Text {
                                        width: 28px;
                                        height: 18px;
                                        text: wd;
                                        color: Theme.ink-3;
                                        font-size: 10.5px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                for wk in [0, 1, 2, 3, 4, 5]: HorizontalLayout {
                                    for dd in [0, 1, 2, 3, 4, 5, 6]: CalCell {
                                        day: mo.days[wk * 7 + dd];
                                        from: root.cal-from;
                                        to: root.cal-to;
                                        hover: root.cal-hover;
                                        entered(n) => { root.cal-hover = n; }
                                        left(n) => {
                                            if (root.cal-hover == n) {
                                                root.cal-hover = -1;
                                            }
                                        }
                                        picked(n) => {
                                            if (root.cal-from < 0 || root.cal-to >= 0) {
                                                root.cal-from = n;
                                                root.cal-to = -1;
                                            } else {
                                                root.cal-to = n;
                                                root.lens-cal-range(root.cal-from, n);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Text {
                            text: root.cal-hint;
                            color: Theme.ink-3;
                            font-size: 10.5px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    // Interactive Sparkline Scrubber for Time & Size lenses
                    if !root.cal-open && (root.lens-kind == "time" || root.lens-kind == "size") && root.lens-rows.length > 0: VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 6px;
                        spacing: 3px;
                        spark-box := Rectangle {
                            height: 48px;
                            property <bool> dragging: false;
                            property <int> drag-a: root.lens-sel;
                            property <int> drag-b: root.lens-sel;
                            HorizontalLayout {
                                spacing: 5px;
                                for srow[si] in root.lens-rows: Rectangle {
                                    horizontal-stretch: 1;
                                    property <bool> lit: spark-box.dragging
                                        ? (si >= min(spark-box.drag-a, spark-box.drag-b) && si <= max(spark-box.drag-a, spark-box.drag-b))
                                        : si == root.lens-sel;
                                    Rectangle {
                                        width: parent.width;
                                        height: max(4px, (parent.height - 6px) * max(0.08, srow.bar));
                                        y: parent.height - self.height;
                                        border-radius: 3px;
                                        background: parent.lit ? Theme.q-key : Theme.k3.with-alpha(0.65);
                                    }
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                function idx-at(x: length) -> int {
                                    return clamp(
                                        Math.floor(x * root.lens-rows.length / max(1px, spark-box.width)),
                                        0,
                                        max(0, root.lens-rows.length - 1));
                                }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        let idx = self.idx-at(self.mouse-x);
                                        spark-box.dragging = true;
                                        spark-box.drag-a = idx;
                                        spark-box.drag-b = idx;
                                    }
                                    if (e.kind == PointerEventKind.up && spark-box.dragging) {
                                        spark-box.dragging = false;
                                        root.lens-spark-range(spark-box.drag-a, spark-box.drag-b);
                                    }
                                }
                                moved => {
                                    if (spark-box.dragging) {
                                        spark-box.drag-b = self.idx-at(self.mouse-x);
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 5px;
                            for srow in root.lens-rows: Text {
                                horizontal-stretch: 1;
                                text: srow.hint != "" ? srow.hint : srow.label;
                                color: Theme.ink-3;
                                font-family: Fonts.mono;
                                font-size: 10px;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }
                        Text {
                            text: root.word-spark-hint;
                            color: Theme.ink-3;
                            font-size: 10.5px;
                            horizontal-alignment: right;
                        }
                        Rectangle { height: 1px; background: Theme.line-soft; }
                    }

                    if !(root.cal-open && root.lens-kind == "time"): VerticalLayout {
                        for row[i] in root.lens-rows: VerticalLayout {
                            if row.group != "": Rectangle {
                                height: row.group == " " ? 7px : 20px;
                                Rectangle {
                                    visible: row.group == " ";
                                    y: 3px;
                                    height: 1px;
                                    background: Theme.line;
                                }
                                Text {
                                    x: 12px;
                                    visible: row.group != " ";
                                    text: row.group;
                                    color: Theme.ink-3;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: bottom;
                                    height: parent.height - 2px;
                                }
                            }
                            Rectangle {
                                height: 26px;
                                background: i == root.lens-sel ? Theme.selection
                                          : lens-touch.has-hover ? Theme.hover : transparent;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 7px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: row.label;
                                            color: row.zero || row.wait ? Theme.ink-3 : Theme.ink;
                                            font-size: 12.5px;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: row.hint;
                                            color: Theme.ink-3;
                                            font-family: Fonts.mono;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    if row.reads: Text {
                                        text: root.lens-foot == "" ? "" : root.lens-reads;
                                        color: Theme.q-bad;
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                    }
                                    if !row.reads: Rectangle {
                                        width: 56px;
                                        Rectangle {
                                            y: (parent.height - 5px) / 2;
                                            height: 5px;
                                            border-radius: 3px;
                                            background: row.n == "" ? transparent : Theme.line-soft;
                                            Rectangle {
                                                x: 0;
                                                width: parent.width * row.bar;
                                                height: parent.height;
                                                border-radius: 3px;
                                                background: Theme.k3;
                                            }
                                        }
                                    }
                                    if !row.reads: Text {
                                        width: 72px;
                                        text: row.n;
                                        color: row.zero ? Theme.ink-3 : Theme.ink-2;
                                        font-family: Fonts.mono;
                                        font-size: 11.5px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                                lens-touch := TouchArea {
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                            root.lens-pick(i, row.stays);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.lens-kind == "word": HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 6px;
                        Text {
                            text: root.typos-said;
                            color: Theme.ink-2;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Push {
                            label: root.typos-choice == "always" ? "✓" : "≈";
                            plain: true;
                            clicked => {
                                root.typos-picked(root.typos-choice == "" ? "always"
                                    : root.typos-choice == "always" ? "off" : "");
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 6px;
                        padding-bottom: 2px;
                        Text {
                            text: root.lens-foot;
                            color: Theme.ink-3;
                            font-size: 11.5px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // A press anywhere outside an open panel closes it, and goes no
        // further: it is not also a press on the row under it. Before the
        // panels, so a press on one reaches the panel first.
        if root.panel != "": TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { root.panel = ""; }
        }

        // The panels were here; the settings are a page of their own, below.
    // --- the question that comes before a change --------------------------
    // Same shape as the menu overlay: a full-window sheet so the click that
    // answers does not also land on the list. This one dims what is behind it.
    if root.ask-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000066;

        TouchArea {
            // Clicking away is "no": a stray press lands on the safe answer.
            clicked => {
                root.ask-open = false;
                root.ask-answer(false);
            }
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: 420px;
            height: ask-sheet.preferred-height;
            background: Theme.panel;
            border-width: Theme.hair;
            border-color: Theme.line;
            border-radius: 3px;
            drop-shadow-blur: 26px;
            drop-shadow-color: #00000080;

            // Swallows the click, or the sheet behind answers "no".
            TouchArea { }

            ask-sheet := VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: root.ask-title;
                    color: Theme.ink;
                    font-size: 14px;
                    font-weight: 650;
                    wrap: word-wrap;
                }
                Text {
                    text: root.ask-body;
                    color: Theme.ink-3;
                    font-family: Fonts.mono;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                if root.ask-typing: Rectangle {
                    height: 30px;
                    // The keys go here as it opens, from F2 as from the menu.
                    // A beat later, not in `init`: that runs mid-layout, and
                    // taking focus there asks for the layout being made.
                    Timer {
                        interval: 1ms;
                        triggered => {
                            self.running = false;
                            renaming.focus();
                            renaming.select-all();
                        }
                    }
                    border-radius: 3px;
                    border-width: Theme.hair;
                    border-color: Theme.focus;
                    background: Theme.panel-2;
                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        renaming := TextInput {
                            text <=> root.ask-text;
                            color: Theme.ink;
                            font-family: Fonts.mono;
                            font-size: 12.5px;
                            single-line: true;
                            vertical-alignment: center;
                            selection-background-color: Theme.selection;
                            selection-foreground-color: Theme.ink;
                            // Back to the query when it closes.
                            // Enter is yes, Escape no.
                            accepted => {
                                root.ask-open = false;
                                root.ask-answer(true);
                                root.focus-query();
                            }
                            function paste-here() {
                                let r = Clip.paste-into(self.text, self.anchor-position-byte-offset,
                                    self.cursor-position-byte-offset, true);
                                if (!r.ok) {
                                    self.paste();
                                    return;
                                }
                                self.text = r.text;
                                self.set-selection-offsets(r.caret, r.caret);
                            }
                            key-pressed(e) => {
                                // Caps Lock, as in `Field`.
                                if (e.modifiers.control && !e.modifiers.shift) {
                                    if (e.text == "v" || e.text == "V") { self.paste-here(); return accept; }
                                    if (e.text == "C") { self.copy(); return accept; }
                                    if (e.text == "X") { self.cut(); return accept; }
                                    if (e.text == "A") { self.select-all(); return accept; }
                                }
                                if (e.text == Key.Escape) {
                                    root.ask-open = false;
                                    root.ask-answer(false);
                                    root.focus-query();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }
                Rectangle { height: 4px; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: no-text.preferred-width + 26px;
                        height: 28px;
                        border-radius: 3px;
                        border-width: Theme.hair;
                        border-color: Theme.line;
                        background: no-hit.has-hover ? Theme.hover : transparent;
                        no-text := Text {
                            text: root.ask-no;
                            color: Theme.ink-2;
                            font-size: 12.5px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        no-hit := TouchArea {
                            clicked => {
                                root.ask-open = false;
                                root.ask-answer(false);
                                root.focus-query();
                            }
                        }
                    }

                    Rectangle {
                        width: yes-text.preferred-width + 26px;
                        height: 28px;
                        border-radius: 3px;
                        background: yes-hit.has-hover
                            ? Theme.danger.transparentize(0.78)
                            : Theme.danger.transparentize(0.88);
                        border-width: Theme.hair;
                        border-color: Theme.danger.transparentize(0.6);
                        yes-text := Text {
                            text: root.ask-yes;
                            color: Theme.danger;
                            font-size: 12.5px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        yes-hit := TouchArea {
                            clicked => {
                                root.ask-open = false;
                                root.ask-answer(true);
                                root.focus-query();
                            }
                        }
                    }
                }
            }
        }
    }


    // --- the settings page -------------------------------------------------
    // Over everything but the menu and the question, which can open from it.
    if root.panel == "settings": Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000066;

        TouchArea {
            clicked => { root.panel = ""; }
        }

        Rectangle {
            width: min(880px, root.width - 40px);
            height: min(640px, root.height - 40px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.dark ? Theme.panel-2 : Theme.panel;
            border-width: Theme.hair;
            border-color: Theme.line;
            border-radius: 10px;
            clip: true;
            drop-shadow-blur: 48px;
            drop-shadow-color: Theme.dark ? #000000a0 : #00000033;
            drop-shadow-offset-y: 18px;

            // Presses inside are the page's, not the scrim's.
            TouchArea { }

            HorizontalLayout {
                Rectangle {
                    width: 210px;
                    background: Theme.dark ? Theme.panel : Theme.panel-2;
                    VerticalLayout {
                        padding-top: 18px;
                        padding-bottom: 16px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 2px;
                        Text {
                            text: root.settings-title;
                            color: Theme.ink;
                            font-size: 16px;
                            font-weight: 600;
                            height: 34px;
                            x: 10px;
                        }
                        NavRow {
                            label: root.section-labels[0];
                            icon: @image-url("icons/tools/settings-general.svg");
                            on: root.settings-section == "general";
                            clicked => { root.settings-picked("general"); }
                        }
                        NavRow {
                            label: root.section-labels[1];
                            icon: @image-url("icons/tools/search.svg");
                            on: root.settings-section == "search";
                            clicked => { root.settings-picked("search"); }
                        }
                        NavRow {
                            label: root.section-labels[2];
                            icon: @image-url("icons/tools/detail.svg");
                            on: root.settings-section == "view";
                            clicked => { root.settings-picked("view"); }
                        }
                        NavRow {
                            label: root.section-labels[3];
                            icon: @image-url("icons/tools/disks.svg");
                            on: root.settings-section == "disks";
                            badge: root.disk-question != "" ? "1" : "";
                            clicked => { root.settings-picked("disks"); }
                        }
                        NavRow {
                            label: root.section-labels[4];
                            icon: @image-url("icons/tools/rules.svg");
                            on: root.settings-section == "rules";
                            clicked => { root.settings-picked("rules"); }
                        }
                        NavRow {
                            label: root.section-labels[5];
                            icon: @image-url("icons/tools/settings-keys.svg");
                            on: root.settings-section == "keys";
                            clicked => { root.settings-picked("keys"); }
                        }
                        NavRow {
                            label: root.section-labels[6];
                            icon: @image-url("icons/tools/index.svg");
                            on: root.settings-section == "index";
                            clicked => { root.settings-picked("index"); }
                        }
                        NavRow {
                            label: root.section-labels[7];
                            icon: @image-url("icons/tools/settings-performance.svg");
                            on: root.settings-section == "performance";
                            clicked => { root.settings-picked("performance"); }
                        }
                        NavRow {
                            label: root.section-labels[8];
                            icon: @image-url("icons/tools/settings-about.svg");
                            on: root.settings-section == "about";
                            clicked => { root.settings-picked("about"); }
                        }
                        Rectangle { vertical-stretch: 1; }
                        // A face chosen in General is started from here.
                        if root.armed-face != "": VerticalLayout {
                            spacing: 6px;
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-bottom: 4px;
                            Text {
                                text: root.restart-as + " " + (root.armed-face == "tui" ? root.face-tui : root.face-web);
                                color: Theme.ink-2;
                                font-size: 11.5px;
                                wrap: word-wrap;
                            }
                            Push {
                                label: root.word-restart;
                                asking: true;
                                clicked => { root.face-picked(root.armed-face); }
                            }
                        }
                        Text {
                            visible: root.armed-face == "";
                            text: root.settings-foot;
                            color: Theme.ink-3;
                            font-size: 11.5px;
                            wrap: word-wrap;
                            x: 10px;
                            width: parent.width - 20px;
                        }
                    }
                }
                Rectangle {
                    width: Theme.hair;
                    background: Theme.line;
                }

                VerticalLayout {
                    padding-top: 20px;
                    padding-left: 26px;
                    padding-right: 26px;
                    padding-bottom: 16px;
                    spacing: 4px;

                    Text {
                        text: root.section-labels[root.section-at];
                        color: Theme.ink;
                        font-size: 18px;
                        font-weight: 600;
                    }
                    Text {
                        text: root.section-leads[
                            root.section-at];
                        color: Theme.ink-2;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 8px; }

                    ScrollView {
                        vertical-stretch: 1;
                        viewport-height: page-body.preferred-height;
                        page-body := VerticalLayout {
                            spacing: 6px;
                            padding-right: 8px;
                            alignment: start;

                            if root.settings-section == "general": VerticalLayout {
                                spacing: 6px;
                                // How Scour runs on Windows: first, since it decides
                                // how fast the index is and whether it stays current.
                                if root.service-offered: Card {
                                    SettingRow {
                                        label: root.service-state;
                                        note: root.service-note;
                                        Push {
                                            label: root.service-push;
                                            asking: root.service-busy;
                                            clicked => {
                                                if (!root.service-busy) {
                                                    root.service-switch();
                                                }
                                            }
                                        }
                                    }
                                    // A service starts with Windows anyway.
                                    if !root.service-active: Rectangle { height: Theme.hair; background: Theme.line; }
                                    if !root.service-active: SettingRow {
                                        label: root.set-autostart;
                                        note: root.set-autostart-note;
                                        Choice {
                                            labels: root.grid-labels;
                                            values: ["on", "off"];
                                            value: root.autostart-on ? "on" : "off";
                                            picked(v) => { root.autostart-picked(v == "on"); }
                                        }
                                    }
                                }
                                Card {
                                    SettingRow {
                                        label: root.set-language;
                                        note: root.set-language-note;
                                        Choice {
                                            labels: root.lang-labels;
                                            values: root.lang-tokens;
                                            value: root.language-choice;
                                            picked(v) => { root.language-picked(v); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-face;
                                        note: root.set-face-note;
                                        Choice {
                                            labels: root.face-labels;
                                            values: ["window", "browser", "tui"];
                                            value: root.face-default;
                                            picked(v) => {
                                                root.face-default-picked(v);
                                                // Another face chosen: the foot offers to start it now.
                                                root.armed-face = v == "window" ? "" : v;
                                            }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-theme;
                                        note: root.set-theme-note;
                                        Choice {
                                            labels: root.theme-labels;
                                            values: ["", "light", "dark"];
                                            value: Theme.chosen;
                                            picked(v) => { root.theme-picked(v); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-zoom;
                                        note: root.set-zoom-note;
                                        Choice {
                                            labels: root.zoom-labels;
                                            values: ["0.9", "1", "1.1", "1.25", "1.5"];
                                            value: root.zoom-choice;
                                            picked(v) => { root.zoom-picked(v); }
                                        }
                                    }
                                }
                                SectionHead { text: root.set-switch; }
            VerticalLayout {
                spacing: 2px;
                alignment: start;

                FaceRow {
                    label: root.face-window;
                    aside: root.face-window-aside;
                    here: true;
                    ready: false;
                }
                FaceRow {
                    label: root.face-tui;
                    note: root.face-tui-note;
                    aside: root.face-tui-ready ? "" : root.face-tui-aside;
                    ready: root.face-tui-ready;
                    armed: root.armed-face == "tui";
                    picked => { root.armed-face = "tui"; }
                    confirmed => { root.face-picked("tui"); }
                }
                FaceRow {
                    label: root.face-web;
                    note: root.face-web-note;
                    armed: root.armed-face == "browser";
                    picked => { root.armed-face = "browser"; }
                    confirmed => { root.face-picked("browser"); }
                }

            }
        
                            }

                            if root.settings-section == "view": VerticalLayout {
                                spacing: 6px;
                                Card {
                                    SettingRow {
                                        label: root.set-layout;
                                        Choice {
                                            labels: root.layout-labels;
                                            values: ["detail", "icons", "large"];
                                            value: root.view-mode;
                                            picked(v) => { root.view-clicked(v); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-columns;
                                        note: root.set-columns-note;
                                        cols-push := Push {
                                            label: root.set-columns-push;
                                            clicked => {
                                                root.columns-clicked(
                                                    self.absolute-position.x,
                                                    self.absolute-position.y + self.height + 4px);
                                            }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-preview;
                                        note: root.set-preview-note;
                                        Choice {
                                            labels: root.grid-labels;
                                            values: ["on", "off"];
                                            value: root.preview-on ? "on" : "off";
                                            picked(v) => {
                                                if ((v == "on") != root.preview-on) {
                                                    root.peek-toggled();
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-refresh;
                                        note: root.set-refresh-note;
                                        Choice {
                                            labels: root.refresh-labels;
                                            values: ["1", "2", "5", "15", "60"];
                                            value: root.refresh-choice;
                                            picked(v) => { root.refresh-picked(v); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-system-icons;
                                        note: root.set-system-icons-note;
                                        Choice {
                                            labels: root.grid-labels;
                                            values: ["on", "off"];
                                            value: root.system-icons ? "on" : "off";
                                            picked(v) => { root.system-icons-picked(v == "on"); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-rail;
                                        note: root.set-rail-note;
                                        Choice {
                                            labels: root.grid-labels;
                                            values: ["on", "off"];
                                            value: root.rail-shown ? "on" : "off";
                                            picked(v) => {
                                                root.rail-shown = v == "on";
                                                root.panes-changed();
                                            }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-ribbon;
                                        note: root.set-ribbon-note;
                                        Choice {
                                            labels: root.grid-labels;
                                            values: ["on", "off"];
                                            value: root.ribbon-shown ? "on" : "off";
                                            picked(v) => {
                                                root.ribbon-shown = v == "on";
                                                root.panes-changed();
                                            }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-grid;
                                        note: root.set-grid-note;
                                        Choice {
                                            labels: root.grid-labels;
                                            values: ["on", "off"];
                                            value: root.grid-lines ? "on" : "off";
                                            picked(v) => { root.grid-picked(v == "on"); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-grid-columns;
                                        note: root.set-grid-columns-note;
                                        Choice {
                                            labels: root.grid-labels;
                                            values: ["on", "off"];
                                            value: root.grid-columns ? "on" : "off";
                                            picked(v) => { root.grid-columns-picked(v == "on"); }
                                        }
                                    }
                                }
                            }

                            if root.settings-section == "search": VerticalLayout {
                                spacing: 6px;
                                Card {
                                    SettingRow {
                                        label: root.set-accents;
                                        note: root.set-accents-note;
                                        Choice {
                                            labels: root.grid-labels;
                                            values: ["on", "off"];
                                            value: root.accents-ignored ? "on" : "off";
                                            picked(v) => { root.accents-picked(v == "on"); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-typos;
                                        note: root.set-typos-note;
                                        Choice {
                                            labels: root.typos-labels;
                                            values: ["off", "", "always"];
                                            value: root.typos-choice;
                                            picked(v) => { root.typos-picked(v); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-typos-rule;
                                        note: root.set-typos-rule-note;
                                        Choice {
                                            labels: root.typos-rule-labels;
                                            values: ["word", "strict"];
                                            value: root.typos-strict ? "strict" : "word";
                                            picked(v) => { root.typos-strict-picked(v == "strict"); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-field-words;
                                        note: root.set-field-words-note;
                                        Choice {
                                            labels: root.field-words-labels;
                                            values: ["icons", "words"];
                                            value: root.field-words ? "words" : "icons";
                                            picked(v) => { root.field-words-picked(v == "words"); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-tabs;
                                        note: root.set-tabs-note;
                                        Choice {
                                            labels: root.grid-labels;
                                            values: ["on", "off"];
                                            value: root.tabs-on ? "on" : "off";
                                            picked(v) => { root.tabs-picked(v == "on"); }
                                        }
                                    }
                                }
                                Rectangle { height: 6px; }
                                Text {
                                    text: root.set-search-hint;
                                    color: Theme.ink-3;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }

                            if root.settings-section == "disks": VerticalLayout {
                                spacing: 6px;
                                if root.disk-question != "": Rectangle {
                                    border-radius: 8px;
                                    border-width: Theme.hair;
                                    border-color: Theme.focus;
                                    background: Theme.focus.transparentize(0.9);
                                    HorizontalLayout {
                                        padding: 10px;
                                        spacing: 8px;
                                        Text {
                                            text: root.disk-question;
                                            color: Theme.ink;
                                            font-size: 12.5px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Push { label: root.disk-later; clicked => { root.disk-answered("later"); } }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Push { label: root.disk-never; clicked => { root.disk-answered("leave"); } }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Push { label: root.disk-yes; asking: true; clicked => { root.disk-answered("index"); } }
                                        }
                                    }
                                }
            VerticalLayout {
                spacing: 4px;
                alignment: start;

                Note { text: root.disks-note; }
                for d[i] in root.disks: DiskRow {
                    name: d.name;
                    aside: d.aside;
                    roots: d.roots;
                    on: d.on;
                    fixed: d.fixed;
                    status: d.status;
                    walking: d.walking;
                    toggled => { root.disk-toggled(d.id, !d.on); }
                    refresh => { root.rescan-root(d.root); }
                }
                if root.disks.length == 0: Note { text: root.disks-none; }
                Note { text: root.disks-after; }
            }
        
                                SectionHead { text: root.set-later; }
                                Card {
                                    SettingRow {
                                        label: root.set-removable;
                                        note: root.set-removable-note;
                                        Choice {
                                            labels: root.removable-labels;
                                            values: ["", "always", "never"];
                                            value: root.removable-choice;
                                            picked(v) => { root.policy-picked("removable", v); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-network;
                                        note: root.set-network-note;
                                        Choice {
                                            labels: root.network-labels;
                                            values: ["", "never"];
                                            value: root.network-choice;
                                            picked(v) => { root.policy-picked("network", v); }
                                        }
                                    }
                                }
                                SectionHead { text: root.set-folders; }
                                Text {
                                    text: root.set-folders-note;
                                    color: Theme.ink-3;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                for f in root.folder-rows: Card {
                                    HorizontalLayout {
                                        padding: 10px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text {
                                                text: f.path;
                                                color: f.on ? Theme.ink : Theme.ink-3;
                                                font-family: Fonts.mono;
                                                font-size: 12px;
                                                overflow: elide;
                                            }
                                            // How its last walk went; a share nobody may
                                            // read says so here instead of staying empty.
                                            Text {
                                                text: f.status;
                                                color: f.problem ? Theme.q-not : Theme.ink-3;
                                                font-size: 11.5px;
                                                overflow: elide;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Choice {
                                                height: 28px;
                                                labels: root.folder-on-labels;
                                                values: ["on", "off"];
                                                value: f.on ? "on" : "off";
                                                picked(v) => { root.folder-switched(f.path, v == "on"); }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Choice {
                                                height: 28px;
                                                labels: root.folder-watch-labels;
                                                values: ["on", "off"];
                                                value: f.watched ? "on" : "off";
                                                picked(v) => { root.folder-watched(f.path, v == "on"); }
                                            }
                                        }
                                        if f.walkable: VerticalLayout {
                                            alignment: center;
                                            Push {
                                                label: "↻";
                                                enabled: !f.walking;
                                                clicked => { root.rescan-root(f.path); }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Push { label: "×"; clicked => { root.folder-dropped(f.path); } }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    height: 28px;
                                    Rectangle {
                                        border-width: Theme.hair;
                                        border-radius: 4px;
                                        border-color: Theme.line;
                                        background: Theme.panel;
                                        clip: true;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            folder-field := Field {
                                                text <=> root.folder-typed;
                                                color: Theme.ink;
                                                font-family: Fonts.mono;
                                                font-size: 12px;
                                                single-line: true;
                                                vertical-alignment: center;
                                                selection-background-color: Theme.selection;
                                                selection-foreground-color: Theme.ink;
                                                edited => {
                                                    if (self.text.character-count > 400) {
                                                        self.text = "";
                                                    }
                                                }
                                                accepted => { root.folder-added(self.text); }
                                            }
                                        }
                                        if folder-field.text == "": Text {
                                            text: root.folder-hint;
                                            color: Theme.ink-3;
                                            font-family: Fonts.mono;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: parent.height;
                                        }
                                    }
                                    Push {
                                        label: root.folder-add;
                                        clicked => { root.folder-added(root.folder-typed); }
                                    }
                                }
                                if root.folder-error != "": Text {
                                    text: root.folder-error;
                                    color: Theme.q-not;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                // How often a folder that reports no changes is
                                // walked again: a share whose server sends none,
                                // one switched to "walk only".
                                Card {
                                    SettingRow {
                                        label: root.set-every;
                                        note: root.set-every-note;
                                        Choice {
                                            labels: root.every-labels;
                                            values: ["1", "5", "10", "30", "60"];
                                            value: root.every-choice;
                                            picked(v) => { root.policy-picked("every", v); }
                                        }
                                    }
                                }
                            }

                            if root.settings-section == "rules": VerticalLayout {
            VerticalLayout {
                spacing: 4px;
                alignment: start;

                // Three groups: what somebody added here, what a file says, and
                // what the program skips. Only the first can be deleted.
                Text {
                    text: root.rules-added-title;
                    color: Theme.ink;
                    font-size: 11px;
                    font-weight: 650;
                }
                Text {
                    text: root.rules-added-note;
                    color: Theme.ink-3;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                for r[i] in root.rules-added: RuleRow {
                    value: r.value;
                    off: r.off;
                    word: root.rules-off-word;
                    removable: true;
                    toggled => {
                        root.rule-toggled(r.id);
                    }
                    dropped => {
                        root.rule-dropped(r.kind, r.value);
                    }
                }

                // A rule is added as a name unless it starts with a slash, in
                // which case it is a path. Nothing subtler is guessed at.
                Rectangle { height: 4px; }

                HorizontalLayout {
                    spacing: 6px;
                    height: 26px;

                    Rectangle {
                        border-width: Theme.hair;
                        border-radius: 3px;
                        border-color: Theme.line;
                        background: Theme.panel;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;

                            fresh := Field {
                                color: Theme.ink;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                single-line: true;
                                vertical-alignment: center;
                                selection-background-color: Theme.selection;
                                selection-foreground-color: Theme.ink;
                                edited => {
                                    if (self.text.character-count > 400) {
                                        self.text = root.rule-kept;
                                    } else {
                                        root.rule-kept = self.text;
                                    }
                                }
                                accepted => {
                                    root.rule-added(self.text);
                                    self.text = "";
                                    root.rule-kept = "";
                                }
                            }
                        }

                        // Under the field, not beside it: a layout owns its
                        // children's positions, and this starts where the text does.
                        if fresh.text == "": Text {
                            text: root.rules-hint;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            x: 8px;
                            height: parent.height;
                        }
                    }

                    Push {
                        label: root.rules-add;
                        clicked => {
                            root.rule-added(fresh.text);
                            fresh.text = "";
                        }
                    }
                }

                Rectangle { height: 10px; }

                Text {
                    text: root.rules-config-title;
                    color: Theme.ink;
                    font-size: 11px;
                    font-weight: 650;
                }
                Text {
                    text: root.rules-config-note;
                    color: Theme.ink-3;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                for r[i] in root.rules-config: RuleRow {
                    value: r.value;
                    off: r.off;
                    word: root.rules-off-word;
                    toggled => {
                        root.rule-toggled(r.id);
                    }
                }

                Rectangle { height: 10px; }

                Text {
                    text: root.rules-builtin-title;
                    color: Theme.ink;
                    font-size: 11px;
                    font-weight: 650;
                }
                Text {
                    text: root.rules-builtin-note;
                    color: Theme.ink-3;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                for r[i] in root.rules-builtin: RuleRow {
                    value: r.value;
                    off: r.off;
                    word: root.rules-off-word;
                    toggled => {
                        root.rule-toggled(r.id);
                    }
                }
            }
        
                            }

                            if root.settings-section == "keys": VerticalLayout {
                                spacing: 6px;
                                SectionHead { text: root.key-title; }
                                Card {
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 6px;
                if root.key-bound: Text {
                    text: root.key-state;
                    color: Theme.q-key;
                    font-family: Fonts.mono;
                    font-size: 11.5px;
                }
                if !root.key-bound: Text {
                    text: root.key-state;
                    color: Theme.ink-3;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                // Nothing here can write the binding, so the command is handed
                // over instead: one line, selectable, and a button that copies.
                if root.key-command != "": HorizontalLayout {
                    spacing: 6px;
                    height: 26px;

                    Rectangle {
                        border-width: Theme.hair;
                        border-radius: 3px;
                        border-color: Theme.line;
                        background: Theme.panel;
                        clip: true;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;

                            TextInput {
                                text: root.key-command;
                                read-only: true;
                                color: Theme.ink-2;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                single-line: true;
                                vertical-alignment: center;
                                selection-background-color: Theme.selection;
                                selection-foreground-color: Theme.ink;
                            }
                        }
                    }

                    Push {
                        label: root.key-copy;
                        clicked => { root.key-command-copied(); }
                    }
                }

                if root.key-can-bind: HorizontalLayout {
                    spacing: 6px;
                    height: 26px;

                    Rectangle {
                        border-width: Theme.hair;
                        border-radius: 3px;
                        border-color: Theme.line;
                        background: Theme.panel;
                        // A combination is short, but the placeholder is a
                        // sentence and a layout does not clip its children.
                        clip: true;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;

                            combo := Field {
                                text <=> root.key-typed;
                                color: Theme.ink;
                                font-family: Fonts.mono;
                                font-size: 11.5px;
                                single-line: true;
                                vertical-alignment: center;
                                selection-background-color: Theme.selection;
                                selection-foreground-color: Theme.ink;
                                // Capped like the rule field, and for the same
                                // reason: the software renderer places glyphs
                                // at `i16`. A combination is a dozen characters.
                                edited => {
                                    if (self.text.character-count > 64) {
                                        self.text = root.key-kept;
                                    } else {
                                        root.key-kept = self.text;
                                        root.key-typed-changed(self.text);
                                    }
                                }
                                accepted => { root.key-bind-pressed(); }
                            }
                        }

                        if combo.text == "": Text {
                            text: root.key-hint;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            overflow: elide;
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                        }
                    }

                    Push {
                        label: root.key-bind;
                        clicked => { root.key-bind-pressed(); }
                    }

                    if root.key-bound: Push {
                        label: root.key-remove;
                        clicked => { root.key-remove-pressed(); }
                    }
                }

                if root.key-error != "": Text {
                    text: root.key-error;
                    color: Theme.q-not;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                if root.key-preview != "": Text {
                    text: "→ " + root.key-preview;
                    color: Theme.ink-3;
                    font-family: Fonts.mono;
                    font-size: 11.5px;
                }

                if root.key-later != "": Text {
                    text: root.key-later;
                    color: Theme.ink-3;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                                    }
                                }
                                SectionHead { text: root.set-help; }
            Text {
                text: root.help-body;
                color: Theme.ink-2;
                font-size: 12.5px;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        
                            }

                            if root.settings-section == "performance": VerticalLayout {
                                spacing: 6px;
                                Card {
                                    SettingRow {
                                        label: root.set-memory;
                                        note: root.set-memory-note;
                                        Choice {
                                            labels: root.memory-labels;
                                            values: ["", "now", "1m", "5m"];
                                            value: root.memory-choice;
                                            picked(v) => { root.perf-picked("memory", v); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-narrow;
                                        note: root.set-narrow-note;
                                        Choice {
                                            labels: root.grid-labels;
                                            values: ["on", "off"];
                                            value: root.narrow-on ? "on" : "off";
                                            picked(v) => { root.perf-picked("narrow", v); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-threads;
                                        note: root.set-threads-note;
                                        Choice {
                                            labels: root.threads-labels;
                                            values: ["0", "1", "2", "4", "8"];
                                            value: root.threads-choice;
                                            picked(v) => { root.perf-picked("threads", v); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    SettingRow {
                                        label: root.set-fresh;
                                        note: root.set-fresh-note;
                                        Choice {
                                            labels: root.fresh-labels;
                                            values: ["0", "1", "5", "15", "60"];
                                            value: root.fresh-choice;
                                            picked(v) => { root.perf-picked("fresh", v); }
                                        }
                                    }
                                }
                            }

                            if root.settings-section == "index": VerticalLayout {
                                spacing: 6px;
                                Card {
                                    SettingRow {
                                        label: root.set-index-where;
                                        note: root.index-dir + (root.index-facts != "" ? "\n" + root.index-facts : "");
                                        Push {
                                            label: root.set-index-open;
                                            enabled: root.index-dir != "";
                                            clicked => { root.index-open(); }
                                        }
                                    }
                                }
                                Card {
                                    SettingRow {
                                        label: root.set-index-tidy;
                                        note: root.set-index-tidy-note;
                                        Push {
                                            label: root.set-index-tidy-push;
                                            clicked => { root.index-tidy(); }
                                        }
                                    }
                                    Rectangle { height: Theme.hair; background: Theme.line; }
                                    index-reset-row := SettingRow {
                                        property <bool> sure;
                                        label: root.set-index-reset;
                                        note: self.sure ? root.set-index-reset-sure : root.set-index-reset-note;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            if !index-reset-row.sure: Push {
                                                label: root.set-index-reset-push;
                                                clicked => { index-reset-row.sure = true; }
                                            }
                                            if index-reset-row.sure: Push {
                                                label: root.set-index-cancel;
                                                plain: true;
                                                clicked => { index-reset-row.sure = false; }
                                            }
                                            if index-reset-row.sure: Push {
                                                label: root.set-index-reset-yes;
                                                asking: true;
                                                clicked => {
                                                    index-reset-row.sure = false;
                                                    root.index-reset();
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.index-said != "": Text {
                                    text: root.index-said;
                                    color: Theme.ink-3;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }

                            if root.settings-section == "about": VerticalLayout {
                                Text {
                                    text: root.about-body;
                                    color: Theme.ink-2;
                                    font-size: 12.5px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }

            // The way out, over the layout.
            close-hit := TouchArea {
                x: parent.width - 40px;
                y: 12px;
                width: 28px;
                height: 28px;
                mouse-cursor: pointer;
                clicked => { root.panel = ""; }
                Rectangle {
                    border-radius: 6px;
                    background: close-hit.has-hover ? Theme.hover : transparent;
                    Text {
                        text: "×";
                        color: close-hit.has-hover ? Theme.ink : Theme.ink-3;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Elevated Zero-Hit Similar Rescue Card when a search finds nothing.
    // Away while the lens is open: drawn above the card, they would lie over it.
    if root.similar-said != "" && root.panel == "" && !root.grep-active && !root.lens-open: Rectangle {
        x: list.absolute-position.x + (list.width - self.width) / 2;
        y: list.absolute-position.y + 68px;
        width: min(500px, list.width - 32px);
        height: sim-col.preferred-height + 24px;
        background: Theme.ground;
        border-radius: 10px;
        border-width: Theme.hair;
        border-color: Theme.line;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000033;
        drop-shadow-offset-y: 4px;

        sim-col := VerticalLayout {
            x: 16px;
            y: 12px;
            width: parent.width - 32px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.similar-said;
                    color: Theme.ink;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Rectangle {
                    height: 20px;
                    width: sqtxt.preferred-width + 12px;
                    border-radius: 5px;
                    background: Theme.cap;
                    sqtxt := Text {
                        text: root.similar-query;
                        color: Theme.q-key;
                        font-family: Fonts.mono;
                        font-size: 11.5px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Push {
                    label: root.similar-show;
                    asking: true;
                    clicked => { root.similar-clicked(); }
                }
                Push {
                    label: root.word-similar-always;
                    clicked => { root.typos-picked("always"); }
                }
            }
        }
    }


    // Nothing found: each filter, left out on its own, and what would then be
    // found. A press takes that filter out.
    if root.offers.length > 0 && root.panel == "" && !root.grep-active && !root.lens-open: Rectangle {
        x: list.absolute-position.x + (list.width - self.width) / 2;
        y: list.absolute-position.y + (root.similar-said != "" ? 168px : 104px);
        width: max(offers-col.preferred-width, 200px);
        height: offers-col.preferred-height;
        offers-col := VerticalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: root.offers-said;
                color: Theme.ink-3;
                font-size: 12.5px;
                horizontal-alignment: center;
            }
            for o[i] in root.offers: Rectangle {
                height: 26px;
                border-radius: 6px;
                border-width: Theme.hair;
                border-color: offer-touch.has-hover ? Theme.ink-3 : Theme.line;
                background: Theme.panel;
                // A layout, so the button is as wide as what it says.
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: o;
                        color: offer-touch.has-hover ? Theme.ink : Theme.ink-2;
                        font-size: 12.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                offer-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.offer-taken(i); }
                }
            }
        }
    }

    // Back to the top in one click, once the list has left it: how many files
    // arrived above meanwhile, when some did. Over the list's corner, above
    // everything but the menu.
    if root.first-row > 0 && root.panel == "": top-pill := Rectangle {
        x: (root.grid ? tiles.absolute-position.x + tiles.width : list.absolute-position.x + list.width)
            - self.width - 14px;
        y: (root.grid ? tiles.absolute-position.y + tiles.height : list.absolute-position.y + list.height)
            - self.height - 14px;
        width: pill-text.preferred-width + 26px;
        height: 30px;
        border-radius: 15px;
        background: pill-hit.has-hover ? Theme.hover : (Theme.dark ? Theme.panel-2 : Theme.panel);
        border-width: Theme.hair;
        border-color: root.new-above > 0 ? Theme.q-key : Theme.line;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #0000001a;
        pill-text := Text {
            text: root.new-above > 0
                ? "↑ " + root.new-above + " " + root.word-new
                : "↑ " + root.word-top;
            color: root.new-above > 0 ? Theme.q-key : Theme.ink-2;
            font-size: 12.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        pill-hit := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.new-above = 0;
                root.scroll-to(0px);
            }
        }
    }

    // --- the right-click menu --------------------------------------------
    // Last child of the window, which is what puts it on top: Slint draws
    // siblings in declaration order and has no z-index. The full-window sheet
    // under it stops the dismissing click reaching a row or a heading.
    if root.menu-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.menu-open = false;
                }
            }
        }

        Rectangle {
            // Kept on screen: near the pointer, never past the edge.
            x: min(root.menu-x, root.width - self.width - 8px);
            y: min(root.menu-y, root.height - self.height - 8px);
            width: 300px;
            height: items.preferred-height;
            // A step off the ground in either scheme, so it reads as above the
            // list rather than cut out of it.
            background: Theme.dark ? Theme.panel-2 : Theme.panel;
            border-width: Theme.hair;
            border-color: Theme.line;
            border-radius: 8px;
            // A popover's shadow: soft and far, not a dark rim.
            drop-shadow-blur: 32px;
            drop-shadow-color: Theme.dark ? #00000090 : #0000002e;
            drop-shadow-offset-y: 12px;

            items := VerticalLayout {
                padding: 6px;

                // What the menu is about. Not for the column picker, which is
                // about the table.
                if !root.menu-columns && root.menu-title != "": HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 10px;
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: Theme.dark ? Theme.line : Theme.panel-2;
                            Image {
                                width: 18px;
                                height: 18px;
                                source: root.menu-ktoken == "stack" ? @image-url("../../../crates/scour-ui/icons/menu/stack.svg")
                                    : root.menu-ktoken == "folder" ? @image-url("icons/folder.svg")
                                    : root.menu-ktoken == "doc" ? @image-url("icons/doc.svg")
                                    : root.menu-ktoken == "code" ? @image-url("icons/code.svg")
                                    : root.menu-ktoken == "image" ? @image-url("icons/image.svg")
                                    : root.menu-ktoken == "video" ? @image-url("icons/video.svg")
                                    : root.menu-ktoken == "media" ? @image-url("icons/media.svg")
                                    : root.menu-ktoken == "audio" ? @image-url("icons/audio.svg")
                                    : root.menu-ktoken == "archive" ? @image-url("icons/archive.svg")
                                    : root.menu-ktoken == "exec" ? @image-url("icons/exec.svg")
                                    : root.menu-ktoken == "data" ? @image-url("icons/data.svg")
                                    : root.menu-ktoken == "config" ? @image-url("icons/config.svg")
                                    : root.menu-ktoken == "font" ? @image-url("icons/font.svg")
                                    : root.menu-ktoken == "build" ? @image-url("icons/build.svg")
                                    : @image-url("icons/file.svg");
                                colorize: root.menu-ktoken == "stack" ? Theme.focus : root.menu-tint;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.menu-title;
                            color: Theme.ink;
                            font-size: 13.5px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: root.menu-detail;
                            color: Theme.ink-3;
                            font-family: Fonts.mono;
                            font-size: 11.5px;
                            overflow: elide;
                        }
                    }
                }

                // The strip: the few that are wanted most, a press away. Red
                // only under the pointer, as in the list.
                if !root.menu-columns && root.menu-strip.length > 0: HorizontalLayout {
                    spacing: 2px;
                    padding-bottom: 4px;

                    for s in root.menu-strip: Rectangle {
                        height: 56px;
                        horizontal-stretch: 1;
                        border-radius: 6px;
                        background: !press.has-hover ? transparent
                            : s.careful ? Theme.danger.transparentize(0.84)
                            : Theme.dark ? Theme.line : Theme.hover;

                        VerticalLayout {
                            alignment: center;
                            spacing: 5px;
                            HorizontalLayout {
                                alignment: center;
                                MenuIcon {
                                    name: s.icon;
                                    width: 18px;
                                    height: 18px;
                                    colorize: !press.has-hover ? Theme.ink-2
                                        : s.careful ? Theme.danger : Theme.ink;
                                }
                            }
                            Text {
                                text: s.label;
                                color: !press.has-hover ? Theme.ink-2
                                    : s.careful ? Theme.danger : Theme.ink;
                                font-size: 11.5px;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }

                        press := TouchArea {
                            clicked => {
                                root.menu-open = false;
                                root.menu-pick(s.id);
                            }
                        }
                    }
                }

                if !root.menu-columns && (root.menu-title != "" || root.menu-strip.length > 0): Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        x: 8px;
                        width: parent.width - 16px;
                        height: Theme.hair;
                        background: Theme.line;
                    }
                }

                for it[i] in root.menu: VerticalLayout {
                    // A rule where the group changes: the gap is what a hand
                    // travelling down the list stops at.
                    if it.rule: Rectangle {
                        height: 9px;
                        Rectangle {
                            y: 4px;
                            x: 8px;
                            width: parent.width - 16px;
                            height: Theme.hair;
                            background: Theme.line;
                        }
                    }

                    Rectangle {
                        height: 32px;
                        border-radius: 5px;
                        // Careful items look like the rest until the pointer is
                        // on one: red down the menu at rest reads as an alarm.
                        background: !hit.has-hover || it.off ? transparent
                            : it.careful ? Theme.danger.transparentize(0.84)
                            : Theme.dark ? Theme.line : Theme.hover;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 10px;

                            // A lane for the tick, kept even when empty, so a
                            // label does not shuffle sideways when switched on.
                            if root.menu-columns: Text {
                                text: it.on ? "✓" : "";
                                color: Theme.focus;
                                font-size: 13px;
                                vertical-alignment: center;
                                width: 14px;
                            }

                            // Signal in the ink: the drawing goes to full ink
                            // under the pointer and nothing else moves.
                            if it.icon != "": VerticalLayout {
                                alignment: center;
                                MenuIcon {
                                    name: it.icon;
                                    width: 16px;
                                    height: 16px;
                                    colorize: it.careful && hit.has-hover ? Theme.danger
                                        : hit.has-hover ? Theme.ink : Theme.ink-2;
                                }
                            }

                            Text {
                                text: it.label;
                                color: it.off ? Theme.ink-3
                                     : it.careful && hit.has-hover ? Theme.danger
                                     : Theme.ink;
                                opacity: it.off ? 0.55 : 1;
                                font-size: 13.5px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            // The shortcut, quieter than the label: it is there
                            // to be learned, not read. A label, so not in mono.
                            Text {
                                text: it.key;
                                color: Theme.ink-3;
                                font-size: 12px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        // Declared after the text, so it is above it: order is
                        // what decides which element takes the press.
                        hit := TouchArea {
                            enabled: !it.off;
                            clicked => {
                                root.menu-open = false;
                                if (root.menu-columns) {
                                    root.column-toggled(it.id);
                                } else {
                                    root.menu-pick(it.id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Never drawn: what `name-advance` and `cell-advance` measure.
    name-probe := Text {
        visible: false;
        text: "00000000000000000000";
        font-family: Fonts.mono;
        font-size: 13px;
    }
    kind-probe := Text {
        visible: false;
        text: root.kind-words;
        font-size: Fonts.small;
    }
    cell-probe := Text {
        visible: false;
        text: "00000000000000000000";
        font-family: Fonts.mono;
        font-size: 11.5px;
    }

    // A moment's rest before the tip appears; a click skips it.
    Timer {
        interval: 450ms;
        running: root.tip-pending != "" && root.tip-text == "";
        triggered => { root.tip-text = root.tip-pending; }
    }

    // Cell tooltip sized dynamically to its content up to the window's width;
    // `tip-probe` has no wrap so `preferred-width` avoids any layout cycle.
    tip-probe := Text {
        visible: false;
        text: root.tip-text;
        font-family: root.tip-mono ? Fonts.mono : "";
        font-size: root.tip-mono ? 11.5px : Fonts.small;
        overflow: elide;
    }

    if root.tip-text != "": Rectangle {
        property <length> cap-w: max(120px, min(880px, root.width - 16px));
        width: clamp(tip-probe.preferred-width + 22px, 44px, self.cap-w);
        height: tip-label.preferred-height + 12px;
        x: max(8px, min(root.tip-x, root.width - self.width - 8px));
        y: root.tip-y + self.height > root.height - 8px
            ? root.tip-y - self.height - Theme.row-height - 4px : root.tip-y;
        background: Theme.panel;
        border-width: Theme.hair;
        border-color: Theme.line;
        border-radius: 4px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000060;
        drop-shadow-offset-y: 4px;
        tip-label := Text {
            x: 10px;
            y: 6px;
            width: parent.width - 20px;
            text: root.tip-text;
            color: Theme.ink;
            font-family: root.tip-mono ? Fonts.mono : "";
            font-size: root.tip-mono ? 11.5px : Fonts.small;
            wrap: word-wrap;
        }
    }
}
