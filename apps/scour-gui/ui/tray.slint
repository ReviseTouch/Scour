// A small window to drag files from, for the faces that cannot start a drag
// themselves: a browser page is not allowed to hand out a file, and a
// terminal's window belongs to the terminal. `scour-gui --drag PATH…`.

import { Theme, Fonts } from "theme.slint";

export component DragTray inherits Window {
    title: "Scour";
    preferred-width: 380px;
    preferred-height: 112px;
    min-width: 280px;
    min-height: 96px;
    background: Theme.ground;

    /// The file's name, or how many there are.
    in property <string> name;
    /// Where it is and what it weighs.
    in property <string> detail;
    in property <string> hint;
    /// The kind's icon and colour, as a row draws them; empty for several.
    in property <string> ktoken;
    in property <brush> tint;
    /// Set while a press has become a drag, until the press ends.
    in-out property <bool> dragging;

    /// Pulled far enough to be a drag, with the pointer in the window.
    callback drag(length, length);
    callback close();

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close();
                return accept;
            }
            reject
        }
    }

    card := Rectangle {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        border-radius: 8px;
        background: area.pressed ? Theme.hover : Theme.panel;
        border-width: Theme.hair;
        border-color: area.has-hover ? Theme.focus : Theme.line;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 12px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 7px;
                    background: Theme.panel-2;
                    Image {
                        width: 20px;
                        height: 20px;
                        source: root.ktoken == "folder" ? @image-url("icons/folder.svg")
                            : root.ktoken == "doc" ? @image-url("icons/doc.svg")
                            : root.ktoken == "code" ? @image-url("icons/code.svg")
                            : root.ktoken == "image" ? @image-url("icons/image.svg")
                            : root.ktoken == "video" ? @image-url("icons/video.svg")
                            : root.ktoken == "media" ? @image-url("icons/media.svg")
                            : root.ktoken == "audio" ? @image-url("icons/audio.svg")
                            : root.ktoken == "archive" ? @image-url("icons/archive.svg")
                            : root.ktoken == "exec" ? @image-url("icons/exec.svg")
                            : root.ktoken == "data" ? @image-url("icons/data.svg")
                            : root.ktoken == "config" ? @image-url("icons/config.svg")
                            : root.ktoken == "font" ? @image-url("icons/font.svg")
                            : root.ktoken == "build" ? @image-url("icons/build.svg")
                            : @image-url("icons/file.svg");
                        colorize: root.tint;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text {
                    text: root.name;
                    color: Theme.ink;
                    font-size: 13.5px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.detail;
                    color: Theme.ink-3;
                    font-family: Fonts.mono;
                    font-size: 11.5px;
                    overflow: elide;
                }
                Text {
                    text: root.hint;
                    color: Theme.ink-2;
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }

        area := TouchArea {
            mouse-cursor: root.dragging ? MouseCursor.grabbing : MouseCursor.grab;
            // Six pixels from the press: a drag, not a click's wobble.
            moved => {
                if (!root.dragging
                    && (abs(self.mouse-x - self.pressed-x) > 6px
                        || abs(self.mouse-y - self.pressed-y) > 6px)) {
                    root.dragging = true;
                    root.drag(self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up) {
                    root.dragging = false;
                }
            }
        }
    }
}
