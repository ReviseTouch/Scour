// The parts the place lens is built of — a disk's colour and icon, a
// worded button, a tile, a folder's line — and the scope chip, which shows
// the same disks at the left of the query bar.

import { Theme, Fonts } from "theme.slint";
import { PlaceDir, DiskTile, ScopeDot, PlaceWords } from "types.slint";

// A disk's colour by the wire's kind, and the dot beside its state.
export global DiskInk {
    public pure function of(kind: string) -> brush {
        return kind == "system" ? Theme.disk-system
            : kind == "removable" ? Theme.disk-removable
            : kind == "network" ? Theme.disk-network
            : kind == "optical" ? Theme.disk-optical
            : Theme.disk-fixed;
    }

    public pure function state(shown: string) -> brush {
        return shown == "live" ? Theme.q-val
            : shown == "walking" ? Theme.focus
            : shown == "polled" || shown == "asking" ? Theme.q-bad
            : shown == "partly" ? Theme.q-key
            : Theme.ink-3;
    }
}

export component DiskIcon inherits Image {
    in property <string> kind;
    width: 16px;
    height: 16px;
    source: root.kind == "system" ? @image-url("icons/disks/system.svg")
        : root.kind == "removable" ? @image-url("icons/disks/removable.svg")
        : root.kind == "network" ? @image-url("icons/disks/network.svg")
        : root.kind == "optical" ? @image-url("icons/disks/optical.svg")
        : @image-url("icons/disks/fixed.svg");
    colorize: DiskInk.of(root.kind);
}

// A button that says what it does in a word.
export component WordButton inherits Rectangle {
    in property <string> label;
    in property <bool> strong;
    callback pressed();
    width: word.preferred-width + 14px;
    height: 20px;
    border-radius: 5px;
    border-width: root.strong ? 0px : Theme.hair;
    border-color: hit.has-hover ? Theme.ink-3 : Theme.line;
    background: root.strong ? (hit.has-hover ? Theme.q-key : Theme.focus)
        : hit.has-hover ? Theme.hover : Theme.panel;
    word := Text {
        text: root.label;
        color: root.strong ? Theme.panel : Theme.ink-2;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    hit := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pressed();
            }
        }
    }
}

// One disk: icon, name, `fs · root · size`, the roots of a disk indexed in
// part, and its state with the files counted — or, waiting, the question.
export component TileCard inherits Rectangle {
    in property <DiskTile> t;
    in property <bool> focused;
    in property <PlaceWords> words;
    // A press on it, and whether Ctrl was down.
    callback pick(bool);
    callback act(string);
    property <bool> asking: root.t.shown == "asking";
    border-radius: 8px;
    // The keys' line is a tint, as in every list; chosen is the disk's own ring.
    background: root.focused ? Theme.selection : Theme.panel;
    border-width: root.t.selected ? 1.5px : Theme.hair;
    border-color: root.t.selected ? DiskInk.of(root.t.kind) : Theme.line;
    opacity: root.t.choosable || root.asking || root.t.lit ? 1 : 0.6;

    // First, so the buttons laid over it take their own presses.
    TouchArea {
        mouse-cursor: root.t.choosable ? pointer : default;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left
                    && root.t.choosable) {
                root.pick(e.modifiers.control);
            }
        }
    }
    DiskIcon {
        x: 10px;
        y: 9px;
        kind: root.t.kind;
    }
    Text {
        x: 32px;
        y: 7px;
        width: parent.width - 32px - (root.asking ? badge.width + 14px : 34px);
        height: 20px;
        text: root.t.name;
        color: Theme.ink;
        font-size: 13px;
        font-weight: 650;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.t.choosable: Rectangle {
        x: parent.width - 26px;
        y: 10px;
        width: 16px;
        height: 16px;
        border-radius: 4px;
        border-width: 1.5px;
        border-color: root.t.selected ? DiskInk.of(root.t.kind) : Theme.line;
        background: root.t.selected ? DiskInk.of(root.t.kind) : transparent;
        Text {
            text: "✓";
            color: root.t.selected ? Theme.panel : transparent;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    badge := Rectangle {
        visible: root.asking;
        x: parent.width - self.width - 10px;
        y: 9px;
        width: root.asking ? badge-word.preferred-width + 10px : 0px;
        height: 16px;
        border-radius: 4px;
        background: DiskInk.of(root.t.kind);
        badge-word := Text {
            text: root.words.new-disk;
            color: Theme.panel;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 10px;
        y: 28px;
        width: parent.width - 20px;
        height: 16px;
        text: root.t.meta;
        color: Theme.ink-3;
        font-family: Fonts.mono;
        font-size: 10.5px;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.t.tags.length > 0: Rectangle {
        x: 10px;
        y: 46px;
        width: parent.width - 20px;
        height: 16px;
        clip: true;
        HorizontalLayout {
            spacing: 3px;
            alignment: start;
            for tag in root.t.tags: Rectangle {
                width: tag-word.preferred-width + 10px;
                border-radius: 4px;
                background: Theme.line-soft;
                tag-word := Text {
                    text: tag;
                    color: Theme.ink-2;
                    font-family: Fonts.mono;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    // The last line: the question, or the state and the files.
    Rectangle {
        x: 10px;
        y: parent.height - 26px;
        width: parent.width - 20px;
        height: 20px;
        if root.asking: HorizontalLayout {
            spacing: 5px;
            alignment: start;
            if root.t.index-it: WordButton {
                label: root.words.index-it;
                strong: true;
                pressed => { root.act("disk"); }
            }
            WordButton {
                label: root.words.not-now;
                pressed => { root.act("later"); }
            }
            WordButton {
                label: root.words.never;
                pressed => { root.act("never"); }
            }
        }
        if !root.asking: Rectangle {
            Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: DiskInk.state(root.t.shown);
            }
            Text {
                x: 12px;
                y: 0px;
                width: parent.width - 12px - right-side.width - 6px;
                height: parent.height;
                text: root.t.state;
                color: Theme.ink-2;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            right-side := Rectangle {
                x: parent.width - self.width;
                y: 0px;
                width: root.t.index-it ? index-button.width : files.preferred-width;
                height: parent.height;
                files := Text {
                    visible: !root.t.index-it;
                    text: root.t.files;
                    color: Theme.ink-2;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                index-button := WordButton {
                    visible: root.t.index-it;
                    x: 0px;
                    y: 0px;
                    label: root.words.index-it;
                    pressed => { root.act("disk"); }
                }
            }
        }
    }
}

// One line of the folder list: a bar for its weight, the name, the size,
// then Add and Exclude.
export component DirLine inherits Rectangle {
    in property <PlaceDir> d;
    in property <bool> focused;
    in property <PlaceWords> words;
    callback act(string, string);
    height: 26px;
    background: root.focused ? Theme.selection : hit.has-hover ? Theme.hover : transparent;
    if root.d.bar > 0: Rectangle {
        x: 8px;
        y: 3px;
        height: 20px;
        width: (parent.width - 16px) * root.d.bar * 0.6;
        border-radius: 3px;
        background: Theme.line-soft;
    }
    hit := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.act("dir", root.d.path);
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 5px;
        Text {
            text: root.d.name;
            color: Theme.ink;
            font-family: Fonts.mono;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.d.meta;
            color: Theme.ink-3;
            font-family: Fonts.mono;
            font-size: 11px;
            vertical-alignment: center;
        }
        WordButton {
            label: root.words.add;
            pressed => { root.act("inc", root.d.path); }
        }
        WordButton {
            label: root.words.exclude;
            pressed => { root.act("exc", root.d.path); }
        }
    }
}

// At the left of the query bar: a dot per disk the search can reach, and
// where it looks. A press opens the place lens.
export component ScopeChip inherits Rectangle {
    in property <[ScopeDot]> dots;
    in property <string> label;
    callback pressed();
    height: 26px;
    // As wide as what it says, to a limit: "Everywhere" in a fixed 124px was
    // half empty. The query beside it moves when the scope changes, only then.
    width: min(160px, chip-row.preferred-width);
    border-radius: 7px;
    border-width: Theme.hair;
    border-color: chip-hit.has-hover ? Theme.ink-3 : Theme.line;
    background: chip-hit.has-hover ? Theme.hover : Theme.ground;
    chip-row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 9px;
        spacing: 6px;
        if root.dots.length > 0: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 3px;
                height: 8px;
                for d in root.dots: Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: d.ring ? transparent : DiskInk.of(d.kind);
                    border-width: d.ring ? 1.5px : 0px;
                    border-color: DiskInk.of(d.kind);
                    opacity: d.lit ? 1 : 0.35;
                }
            }
        }
        Text {
            text: root.label;
            color: Theme.ink-2;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    chip-hit := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pressed();
            }
        }
    }
}
