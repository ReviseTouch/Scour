// Theme names for the window. `main.rs` fills both schemes at start-up from
// `scour_ui::DARK` and `scour_ui::LIGHT`; which one applies is bound here to
// the backend's colour scheme, so an open window follows the desktop.

import { Palette } from "std-widgets.slint";

// One scheme's worth of colour. Field-for-field with `scour_ui::Palette`.
export struct Scheme {
    ground: brush,
    panel: brush,
    panel-2: brush,
    line: brush,
    line-soft: brush,
    ink: brush,
    ink-2: brush,
    ink-3: brush,
    mark: brush,
    mark-ink: brush,
    pick: brush,
    focus: brush,
    hover: brush,
    danger: brush,
    t0: brush,
    t1: brush,
    t2: brush,
    t3: brush,
    t4: brush,
    t5: brush,
    q-key: brush,
    q-val: brush,
    q-glob: brush,
    q-term: brush,
    q-not: brush,
    q-bad: brush,
}

export global Theme {
    in property <bool> dark: Palette.color-scheme != ColorScheme.light;
    in property <Scheme> dark-scheme;
    in property <Scheme> light-scheme;

    // The one place the choice is made; everything below reads through it.
    out property <Scheme> c: dark ? dark-scheme : light-scheme;

    out property <brush> ground: c.ground;
    out property <brush> panel: c.panel;
    out property <brush> panel-2: c.panel-2;
    out property <brush> line: c.line;
    out property <brush> line-soft: c.line-soft;

    out property <brush> ink: c.ink;
    out property <brush> ink-2: c.ink-2;
    out property <brush> ink-3: c.ink-3;

    out property <brush> mark: c.mark;
    out property <brush> mark-ink: c.mark-ink;
    out property <brush> focus: c.focus;
    out property <brush> hover: c.hover;
    // Marks the one menu item that changes something. Not an error colour.
    out property <brush> danger: c.danger;
    // Selected-row tint, translucent: an opaque fill would bury the match wash.
    out property <brush> selection: c.pick;

    // --- age, oldest last -------------------------------------------------
    // Six ordinal steps, not a gradient: today, this week, or long ago.
    out property <brush> t0: c.t0;
    out property <brush> t1: c.t1;
    out property <brush> t2: c.t2;
    out property <brush> t3: c.t3;
    out property <brush> t4: c.t4;
    out property <brush> t5: c.t5;

    // --- the query line ---------------------------------------------------
    out property <brush> q-key: c.q-key;
    out property <brush> q-val: c.q-val;
    out property <brush> q-glob: c.q-glob;
    out property <brush> q-term: c.q-term;
    out property <brush> q-not: c.q-not;
    out property <brush> q-bad: c.q-bad;

    // --- metrics ----------------------------------------------------------
    // Filled from `scour_ui::METRICS`; both virtual lists are built on the pitch.
    in property <length> unit: 4px;
    in property <length> row-height: 30px;
    in property <length> radius: 6px;
}

export global Fonts {
    in property <string> mono: "monospace";
    in property <length> size: 13px;
    // Not shared with the other faces: this window's own second text size.
    out property <length> small: 11px;
}
