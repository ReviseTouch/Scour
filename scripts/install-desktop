#!/usr/bin/env bash
# Put Scour in the launcher, give it its icon, install the GNOME extension and
# bind Ctrl+" — the key left of `1` unshifted, hence `<Control>quotedbl` with no
# `<Shift>`. Per-user and repeatable; nothing outside `~/.local` and dconf.
#
#   scripts/install-desktop

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
share="${XDG_DATA_HOME:-$HOME/.local/share}"
icons="$share/icons/hicolor"
apps="$share/applications"
ext_uuid="scour@scour.local"

# ---------------------------------------------------------------- the icon
mkdir -p "$icons/scalable/apps"
cp "$root/assets/scour.svg" "$icons/scalable/apps/scour.svg"

if command -v rsvg-convert >/dev/null; then
    # Rasterised here: a 16-pixel icon scaled from an SVG at draw time is
    # softer than one rendered at that size.
    for n in 16 24 32 48 64 128 256; do
        mkdir -p "$icons/${n}x${n}/apps"
        rsvg-convert -w "$n" -h "$n" "$root/assets/scour.svg" \
            -o "$icons/${n}x${n}/apps/scour.png"
    done
else
    echo "install-desktop: rsvg-convert is missing; the SVG alone will have to do" >&2
fi
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -qtf "$icons" || true

# ------------------------------------------------------------ the launcher
mkdir -p "$apps"
cat > "$apps/scour.desktop" <<ENTRY
[Desktop Entry]
Type=Application
Name=Scour
GenericName=File Search
GenericName[tr]=Dosya Arama
Comment=Find any file on this machine, instantly
Comment[tr]=Bu makinedeki her dosyayı anında bul
Exec=$root/scripts/scour-app
Icon=scour
Terminal=false
Categories=Utility;FileTools;
Keywords=search;find;file;everything;
Keywords[tr]=ara;bul;dosya;arama;
StartupNotify=true
StartupWMClass=scour
ENTRY

# There is one Scour entry, not one per face.
rm -f "$apps/scour-app.desktop"
command -v update-desktop-database >/dev/null && update-desktop-database -q "$apps" || true

# ------------------------------------------------------------ the extension
if [[ -d $root/platform/gnome/$ext_uuid ]]; then
    dest="$share/gnome-shell/extensions/$ext_uuid"
    mkdir -p "$dest"
    cp "$root/platform/gnome/$ext_uuid"/* "$dest/"
    if command -v gnome-extensions >/dev/null; then
        # A newly copied extension is not listed until the shell rescans.
        gnome-extensions enable "$ext_uuid" 2>/dev/null \
            || echo "install-desktop: enable $ext_uuid after the next login" >&2
    fi
fi

# -------------------------------------------------------------- the hotkey
media=org.gnome.settings-daemon.plugins.media-keys
path=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/scour/
entry="$media.custom-keybinding:$path"

gsettings set "$entry" name 'Scour'
gsettings set "$entry" command "$root/scripts/scour-show"
gsettings set "$entry" binding '<Control>quotedbl'

# Anything else on the same accelerator is unbound: two commands on one is one
# of them silently losing.
current=$(gsettings get "$media" custom-keybindings)
python3 - "$path" "$current" <<'PY' | xargs -0 gsettings set "$media" custom-keybindings
import ast, subprocess, sys

want, current = sys.argv[1], sys.argv[2]
paths = [] if current.strip() in ("@as []", "[]") else ast.literal_eval(current)
kept = []
for p in paths:
    if p == want:
        continue
    key = f"org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:{p}"
    binding = subprocess.run(["gsettings", "get", key, "binding"],
                             capture_output=True, text=True).stdout.strip()
    if binding.strip("'") == "<Control>quotedbl":
        name = subprocess.run(["gsettings", "get", key, "name"],
                              capture_output=True, text=True).stdout.strip()
        print(f"install-desktop: {name} had Ctrl+\" and was unbound", file=sys.stderr)
        continue
    kept.append(p)
kept.append(want)
sys.stdout.write(("[" + ", ".join(f"'{p}'" for p in kept) + "]").replace("\n", "") + "\0")
PY

echo "Scour is in the launcher, and Ctrl+\" brings it forward."
