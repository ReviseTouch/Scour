#!/usr/bin/env bash
# Scour in a window of its own, without a browser around it: an installed
# browser under `--app`, with its own `--class` and profile.
#
#   scripts/scour-app

set -euo pipefail

# A fixed port, because `localStorage` is scoped to an origin and the port is
# part of one: on a system-picked port the page gets an empty store per launch.
# A second launch failing to bind is handled below by clearing the port.
PORT="${SCOUR_APP_PORT:-7621}"
PROFILE="${XDG_DATA_HOME:-$HOME/.local/share}/scour/app"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/target/release"
WEB="$(command -v scour-web || echo "$BIN_DIR/scour-web")"

if [[ ! -x $WEB ]]; then
    echo "scour-web is not built. cargo build --release -p scour-web" >&2
    exit 1
fi

# A bridge from a window that has since closed: a killed browser tells nobody.
pkill -f -- "scour-web --port $PORT" 2>/dev/null || true

# And the window that bridge belonged to: a profile has one owner, so a window
# whose process outlives it makes the next launch a stack of error dialogs.
# The pattern is this port's app URL, narrower than `--class=Scour` on purpose.
pkill -f -- "--app=http://127.0.0.1:$PORT/" 2>/dev/null || true
# Chromium lets go of the profile as it goes; starting before it has is the
# same failure by a shorter route.
sleep 0.4

# The token changes with every start, which is why the URL is read back.
log=$(mktemp -t scour-app.XXXXXX)
"$WEB" --port "$PORT" --no-open >"$log" 2>&1 &
bridge=$!
trap 'kill $bridge 2>/dev/null || true; rm -f "$log"' EXIT

url=""
for _ in $(seq 1 50); do
    url=$(grep -oE 'http://[^ ]+' "$log" | head -1 || true)
    [[ -n $url ]] && break
    sleep 0.1
done
if [[ -z $url ]]; then
    echo "the bridge did not come up:" >&2
    cat "$log" >&2
    exit 1
fi

browser=""
for b in chromium google-chrome-stable google-chrome brave vivaldi; do
    if command -v "$b" >/dev/null; then browser=$b; break; fi
done
if [[ -z $browser ]]; then
    # Firefox has no `--app`; `--kiosk` takes the whole screen but is not a tab.
    if command -v firefox >/dev/null; then
        exec firefox --kiosk --new-instance --profile "$PROFILE" "$url"
    fi
    echo "no browser found to host the window; the bridge is at $url" >&2
    exit 1
fi

mkdir -p "$PROFILE"

# A browser started against a locked profile hands its command line to the lock
# holder and exits successfully, so this kills the bridge and no window appears.
# A dead owner's lock is removed and the start retried once.
stale_lock() {
    local owner
    owner=$(readlink "$PROFILE/SingletonLock" 2>/dev/null) || return 1
    local pid=${owner##*-}
    [[ -n $pid ]] && ! kill -0 "$pid" 2>/dev/null
}

# The screen's own rate rather than XWayland's 60 Hz: 16.6 ms a frame through
# XWayland against 6.1 ms under Wayland, on one 165 Hz screen a minute apart.
# Only when the session is Wayland; asking under X11 opens no window.
WAYLAND_ARGS=()
if [[ ${XDG_SESSION_TYPE:-} == wayland && -n ${WAYLAND_DISPLAY:-} ]]; then
    WAYLAND_ARGS=(--ozone-platform=wayland)
fi

# A port for looking inside the running window, which `scripts/probe` speaks to.
# Off by default — it is a way in — and turned on with SCOUR_APP_DEBUG=9222.
DEBUG_ARGS=()
if [[ -n ${SCOUR_APP_DEBUG:-} ]]; then
    DEBUG_ARGS=(--remote-debugging-port="$SCOUR_APP_DEBUG" --remote-allow-origins='*')
fi

# `--password-store=basic`: otherwise the browser asks the desktop secret service
# for its cookie key at startup, which is a password prompt in front of a search
# box. It weakens saved passwords and cookies, of which this profile has none.
start_window() {
    if stale_lock; then
        rm -f "$PROFILE/SingletonLock" "$PROFILE/SingletonCookie" "$PROFILE/SingletonSocket"
    fi
    local began=$SECONDS
    "$browser" \
        --app="$url" \
        "${WAYLAND_ARGS[@]}" \
        --class=Scour \
        --user-data-dir="$PROFILE" \
        --password-store=basic \
        --no-first-run \
        --no-default-browser-check \
        --disable-features=TranslateUI \
        "${DEBUG_ARGS[@]}" \
        ${SCOUR_APP_EXTRA:-} \
        >/dev/null 2>&1
    # A window that lasted less than this was never a window.
    (( SECONDS - began < 3 ))
}

# Not `exec`: replacing this shell with the browser takes the trap with it, and
# the bridge then outlives every window that closes. Waiting costs a sleeping
# shell and cleans up after itself.
if start_window; then
    # It came straight back: let the last one finish dying, take its lock, retry.
    sleep 1
    rm -f "$PROFILE/SingletonLock" "$PROFILE/SingletonCookie" "$PROFILE/SingletonSocket"
    start_window || true
fi
