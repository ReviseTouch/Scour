#!/usr/bin/env bash
# Everything that has to be true before a commit.
#
#   scripts/check          format, lint, tests, and every target that is claimed
#   scripts/check --quick  the first three only
#
# **This exists because the CI is slower than you are.**
# `.github/workflows/ci.yml` has a three-platform matrix and now has somewhere
# to run — `origin` was added on 2026-08-07 — but it answers in minutes and
# after the fact. A workflow nobody runs is a claim nobody checks: the Windows
# build was broken twice in two days by changes that passed everything anybody
# actually ran, and the breakage was found by a reviewer rather than by a
# machine. This is the one that answers before the commit, not after it.
#
# The cross checks are `cargo check`, not `cargo test`: nothing here can run a
# Windows binary. They prove the code still compiles for a target, which is the
# difference between "unsupported" and "quietly rotting". What they cannot
# prove is that it *behaves* — see docs/ROADMAP.md on what Windows still needs
# before it is a platform rather than a compilation.

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# The desktop crate pulls in a toolkit per platform, and those are not in the
# local registry for targets this machine does not build for. Everything that
# is not the window is checked everywhere.
PORTABLE=(
    -p scour-core -p scour-query -p scour-config -p scour-index-native
    -p scour-source-fs -p scour-engine -p scour-ipc -p scour-proto
    -p scour-i18n -p scour-thumbs -p scourd -p scour -p scour-mcp -p scour-web
)

step() { printf '\n\033[1m%s\033[0m\n' "$*"; }

tmp=$(mktemp -t scour-page.XXXXXX.js)
trap 'rm -f "$tmp"' EXIT

step "format"
cargo fmt --check

step "lint"
cargo clippy --workspace --all-targets -- -D warnings

# **The page is a string until it is a program.** `page.html` is compiled into
# the bridge, so nothing in the Rust toolchain ever parses the JavaScript in
# it: a duplicate declaration ships, the browser refuses the whole script, and
# the window comes up blank with nothing reported anywhere. That happened, and
# it cost an hour of looking at a perfectly healthy service.
step "the page"
if command -v node >/dev/null; then
    python3 scripts/page-script.py > "$tmp"
    node --check "$tmp"
    echo "  page.html: the script parses"
else
    echo "  node is missing, so the page's script was not parsed" >&2
fi

step "tests"
cargo test --workspace

if [[ ${1:-} == --quick ]]; then
    echo
    echo "checked: format, lint, the page, tests. Targets skipped (--quick)."
    exit 0
fi

step "windows"
cargo check --offline --target x86_64-pc-windows-msvc --workspace

for target in x86_64-apple-darwin x86_64-linux-android; do
    step "$target"
    if ! cargo check --offline --target "$target" "${PORTABLE[@]}"; then
        echo "  (if this is a download failure rather than an error, run it once online)" >&2
        exit 1
    fi
done

echo
echo "All of it. Format, lint, ${#PORTABLE[@]} crates on three more targets."
