#!/usr/bin/env bash
# Everything that has to be true before a commit, minutes before CI says it.
#
#   scripts/check          format, lint, tests, and every target that is claimed
#   scripts/check --quick  the first three only
#
# The cross checks are `cargo check`: nothing here can run a Windows binary.

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# The desktop crate pulls in a toolkit per platform, which is not in the local
# registry for targets this machine does not build for.
PORTABLE=(
    -p scour-core -p scour-query -p scour-config -p scour-index-native
    -p scour-source-fs -p scour-engine -p scour-ipc -p scour-proto
    -p scour-i18n -p scour-thumbs -p scourd -p scour -p scour-mcp -p scour-web
)

step() { printf '\n\033[1m%s\033[0m\n' "$*"; }

tmp=$(mktemp -t scour-page.XXXXXX.js)
trap 'rm -f "$tmp"' EXIT

step "format"
cargo fmt --check

step "lint"
cargo clippy --workspace --all-targets -- -D warnings

# `page.html` is compiled into the bridge as a string, so nothing in the Rust
# toolchain parses its JavaScript: one duplicate declaration ships, the browser
# refuses the whole script, and the window comes up blank with nothing reported.
step "the page"
bash -n packaging/install-service.sh
if command -v node >/dev/null; then
    python3 scripts/page-script.py > "$tmp"
    node --check "$tmp"
    node --test packaging/tests/service-policy.test.cjs
    echo "  page.html: the script parses"
else
    echo "  node is missing, so the page's script was not parsed" >&2
fi

step "tests"
cargo test --workspace

if [[ ${1:-} == --quick ]]; then
    echo
    echo "checked: format, lint, the page, tests. Targets skipped (--quick)."
    exit 0
fi

step "windows"
cargo check --offline --target x86_64-pc-windows-msvc --workspace

for target in x86_64-apple-darwin x86_64-linux-android; do
    step "$target"
    if ! cargo check --offline --target "$target" "${PORTABLE[@]}"; then
        echo "  (if this is a download failure rather than an error, run it once online)" >&2
        exit 1
    fi
done

echo
echo "All of it. Format, lint, ${#PORTABLE[@]} crates on three more targets."
