#!/usr/bin/env python3
"""Where the comments are, and which blocks are long.

    scripts/comments                 # ratio per file, worst first
    scripts/comments path/to/file    # every block of 3+ lines in one file
    scripts/comments --min 6         # only blocks at least this long

The policy is in CLAUDE.md: a doc comment says what, in one or two lines; an
inline comment states an invariant or a number, in one; history is in git.
This does not enforce it — it says where to look.
"""
import re, subprocess, sys

def blocks(path):
    """(start_line, n_lines, first_text) for each run of comment lines."""
    rs = path.endswith((".rs", ".slint"))
    html = path.endswith(".html")
    if not (rs or html or path.endswith(".py") or "/" in path and path.startswith("scripts/")):
        return [], 0, 0
    out, code, com = [], 0, 0
    start, n, first, inblock = None, 0, "", False
    for i, line in enumerate(open(path, encoding="utf8", errors="replace"), 1):
        s = line.strip()
        is_com = False
        if inblock:
            is_com = True
            if "*/" in s or (html and "-->" in s):
                inblock = False
        elif rs and s.startswith(("//", "/*")):
            is_com = True
            if s.startswith("/*") and "*/" not in s: inblock = True
        elif html and s.startswith(("/*", "<!--", "//", "* ")):
            is_com = True
            if (s.startswith("/*") and "*/" not in s) or (s.startswith("<!--") and "-->" not in s): inblock = True
        elif not rs and not html and s.startswith("#") and not s.startswith("#!"):
            is_com = True
        if is_com:
            com += 1
            if start is None: start, n, first = i, 0, s.lstrip("/*!<- ").strip()[:70]
            n += 1
        else:
            if s: code += 1
            if start is not None:
                out.append((start, n, first)); start = None
    if start is not None: out.append((start, n, first))
    return out, code, com

def main():
    args = sys.argv[1:]
    least = 3
    if "--min" in args:
        i = args.index("--min"); least = int(args[i + 1]); del args[i:i + 2]
    if args:
        for f in args:
            bl, code, com = blocks(f)
            print(f"{f}: code {code}, comment {com} ({100*com/max(1,code):.0f}%)")
            for s, n, t in bl:
                if n >= least: print(f"  {s:6}  {n:3} lines  {t}")
        return
    files = subprocess.check_output(["git", "ls-files", "*.rs", "*.slint", "*.html", "scripts/*"], text=True).split()
    rows, tc, tm = [], 0, 0
    for f in files:
        bl, code, com = blocks(f)
        if code + com == 0: continue
        long = sum(n for _, n, _ in bl if n >= least)
        rows.append((com, code, long, f)); tc += code; tm += com
    rows.sort(reverse=True)
    print(f"{'comment':>8} {'code':>7} {'ratio':>6} {'in 3+ blocks':>12}  file")
    for com, code, long, f in rows[:40]:
        print(f"{com:8} {code:7} {100*com/max(1,code):5.0f}% {long:12}  {f}")
    print(f"\ntotal: comment {tm:,} / code {tc:,} = {100*tm/max(1,tc):.0f}%")
main()
