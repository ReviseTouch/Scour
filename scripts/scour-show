#!/usr/bin/env bash
# Bring Scour to the front, starting it if it is not running.
#
#   scripts/scour-show
#
# What the hotkey runs. Raising a window that already exists is done by the
# GNOME extension in `platform/gnome`, because under Wayland the compositor is
# the only thing that may move focus — the comment at the top of its
# `extension.js` lists what was tried before accepting that.
#
# Without the extension the window is closed and opened again, which is worse
# in principle and barely worse in practice: **370 ms**, measured, from launch
# to the page being served, and the query is restored from where the page left
# it. What it must not do is open a second window, which is what every other
# fallback ends up doing.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Spelled in pieces so that this script's own command line does not match the
# pattern it is about to search for. It did, and it killed the shell it was
# running in.
mark="--class=""Scour"

if gdbus call --session --dest org.scour.Shell \
    --object-path /org/scour/Shell \
    --method org.scour.Shell.Show >/dev/null 2>&1; then
    exit 0
fi

if pkill -f -- "$mark" 2>/dev/null; then
    # Give the browser a moment to let go of its profile lock; starting a
    # second one on top of it produces a window that never appears.
    for _ in $(seq 1 40); do
        pgrep -f -- "$mark" >/dev/null 2>&1 || break
        sleep 0.05
    done
fi

exec "$here/scour-app"
