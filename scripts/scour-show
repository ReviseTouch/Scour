#!/usr/bin/env bash
# Bring Scour to the front, starting it if it is not running — what the hotkey
# runs:  scripts/scour-show
#
# Raising an existing window needs the GNOME extension in `platform/gnome`: under
# Wayland only the compositor may move focus. Without it the window is closed and
# reopened, which costs 370 ms and must never leave two windows.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Spelled in pieces so this script's own command line does not match the pattern
# it is about to search for.
mark="--class=""Scour"

if gdbus call --session --dest org.scour.Shell \
    --object-path /org/scour/Shell \
    --method org.scour.Shell.Show >/dev/null 2>&1; then
    exit 0
fi

if pkill -f -- "$mark" 2>/dev/null; then
    # Let the browser release its profile lock: starting on top of it produces
    # a window that never appears.
    for _ in $(seq 1 40); do
        pgrep -f -- "$mark" >/dev/null 2>&1 || break
        sleep 0.05
    done
fi

exec "$here/scour-app"
